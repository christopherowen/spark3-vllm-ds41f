+"""Prepared vocabulary projection over exact 12-bit packed BF16 weights.
+
+``pack`` stores a BF16 weight in 12 bits per value with every bit preserved
+(see ``_format``); ``plan`` declares the projection geometry,
+``PreparationSession`` selects and primes one configuration, and
+``bind``/``run`` consume only its prepared ``Plan``. A token's logits are the
+same bits whatever the batch size.
+"""
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from ..._lib.meta import OpMeta, Provenance, install_lazy_api
+
+META = OpMeta(
+    name="packed_bf16_vocab_projection",
+    group="gemm",
+    api_style="prepared",
+    entry_points=(
+        "Caps",
+        "Plan",
+        "Binding",
+        "PackedBf16Weight",
+        "PackedBf16VocabProjectionConfig",
+        "PackedBf16VocabProjectionQuery",
+        "pack",
+        "unpack",
+        "plan",
+        "bind",
+        "run",
+        "is_supported",
+    ),
+    dtypes=("bf16",),
+    requires=("triton",),
+    provenance=Provenance(
+        repo="https://github.com/local-inference-lab/b12x",
+        commit="f8069b2c",
+        paths=("b12x/gemm/packed_bf16_vocab_projection",),
+    ),
+    test_path="tests/gemm/test_packed_bf16_vocab_projection.py",
+    since="1.3.0",
+)
+
+if TYPE_CHECKING:
+    from .api import (  # noqa: F401
+        Binding,
+        Caps,
+        PackedBf16VocabProjectionConfig,
+        PackedBf16VocabProjectionQuery,
+        PackedBf16Weight,
+        Plan,
+        bind,
+        is_supported,
+        pack,
+        plan,
+        run,
+        unpack,
+    )
+
+install_lazy_api(globals(), META)
diff --git a/b12x/gemm/packed_bf16_vocab_projection/_contracts.py b/b12x/gemm/packed_bf16_vocab_projection/_contracts.py
new file mode 100644
index 00000000..c2e26108
--- /dev/null
+++ b/b12x/gemm/packed_bf16_vocab_projection/_contracts.py
@@ -0,0 +1,97 @@
+"""Declarative and prepared packed BF16 vocabulary projection boundary."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+
+from b12x.preparation import FrozenMapping, Plan
+from b12x.preparation.types import require_prepared
+
+from ._format import PackedBf16Weight
+from ._kernel import packed_bf16_vocab_projection  # noqa: F401
+from ._tuning import PackedBf16VocabProjectionConfig
+
+
+def _canonical_device(device: torch.device | str) -> torch.device:
+    result = torch.device(device)
+    if result.type == "cuda" and result.index is None:
+        result = torch.device("cuda", torch.cuda.current_device())
+    return result
+
+
+@dataclass(frozen=True, kw_only=True)
+class Caps:
+    device: torch.device | str
+    max_tokens: int
+    in_features: int
+    out_features: int
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "device", _canonical_device(self.device))
+        for name in ("max_tokens", "in_features", "out_features"):
+            value = int(getattr(self, name))
+            if value <= 0:
+                raise ValueError(f"{name} must be positive, got {value}")
+            object.__setattr__(self, name, value)
+
+
+@dataclass(frozen=True, kw_only=True)
+class Binding:
+    plan: Plan
+    source: torch.Tensor
+    weight: PackedBf16Weight
+
+
+def plan(
+    caps: Caps, *, invocation: FrozenMapping = FrozenMapping(),
+    override: PackedBf16VocabProjectionConfig | None = None,
+) -> Plan:
+    """Declare projection preparation without resolving a configuration."""
+    from ._preparation import make_plan
+
+    return make_plan(caps, invocation=invocation, override=override)
+
+
+def _bind(caps: Caps, *, plan: Plan, source: torch.Tensor, weight: PackedBf16Weight) -> Binding:
+    if not isinstance(weight, PackedBf16Weight):
+        raise TypeError("weight must be a PackedBf16Weight")
+    if source.ndim != 2 or not 0 < source.shape[0] <= caps.max_tokens:
+        raise ValueError(f"source must have 1..{caps.max_tokens} rows, got {tuple(source.shape)}")
+    if source.shape[1] != caps.in_features or source.dtype != torch.bfloat16:
+        raise ValueError(f"source must be BF16 with K={caps.in_features}, got {source.dtype} {tuple(source.shape)}")
+    if (weight.out_features, weight.in_features) != (caps.out_features, caps.in_features):
+        raise ValueError(
+            f"weight must pack shape {(caps.out_features, caps.in_features)}, "
+            f"got {(weight.out_features, weight.in_features)}"
+        )
+    tensors = (("source", source), ("values", weight.values), ("exception_rows", weight.exception_rows),
+               ("exception_entries", weight.exception_entries), ("row_offsets", weight.row_offsets))
+    for name, tensor in tensors:
+        if tensor.device != caps.device:
+            raise ValueError(f"{name} must be on {caps.device}, got {tensor.device}")
+        if not tensor.is_contiguous():
+            raise ValueError(f"{name} must be contiguous")
+    if weight.row_offsets.numel() != caps.out_features + 1:
+        raise ValueError("row_offsets must have out_features + 1 entries")
+    return Binding(plan=plan, source=source, weight=weight)
+
+
+def bind(plan: Plan, *, source: torch.Tensor, weight: PackedBf16Weight) -> Binding:
+    """Bind live tensors to a fully prepared projection."""
+    state = require_prepared(plan, "gemm.packed_bf16_vocab_projection", source.device)
+    return state.bind(plan=plan, source=source, weight=weight)
+
+
+def run(binding: Binding) -> torch.Tensor:
+    """Run the configuration selected during preparation."""
+    if not isinstance(binding, Binding):
+        raise TypeError("binding must be Binding")
+    weight = binding.weight
+    return torch.ops.b12x.packed_bf16_vocab_projection(
+        binding.source, weight.values, weight.exception_rows, weight.exception_entries,
+        weight.row_offsets, weight.exponent_base, binding.plan.handle,
+    )
+
+
+__all__ = ["Binding", "Caps", "Plan", "bind", "plan", "run"]
diff --git a/b12x/gemm/packed_bf16_vocab_projection/_format.py b/b12x/gemm/packed_bf16_vocab_projection/_format.py

--- /dev/null
+++ b/b12x/gemm/packed_bf16_vocab_projection/_format.py
@@ -0,0 +1,138 @@
+"""Exact 12-bit storage for BF16 vocabulary weights.
+
+A BF16 value is a sign bit, an 8-bit exponent and a 7-bit mantissa. Each value
+here keeps its sign and mantissa in one byte and its exponent in a 4-bit code:
+code ``c`` in 1..15 means exponent ``base + c - 1`` for one 15-exponent window
+chosen per tensor, and code 0 means exponent 0 (zero and subnormal values keep
+their bits exactly). The rare values whose exponent falls outside the window
+are exceptions: their slot holds +0 and their exact BF16 bits sit in a per-row
+list that the projection adds after the main dot product.
+
+Row layout, ``K + K / 2`` bytes: the ``K`` sign-and-mantissa bytes, then the
+codes. Byte ``j`` of each 128-column group's 64 code bytes holds the code of
+column ``j`` in its low nibble and of column ``j + 64`` in its high nibble.
+
+``pack`` checks that unpacking reproduces every input bit and refuses
+otherwise, so a packed tensor is the checkpoint tensor, not an approximation.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+
+GROUP = 128
+WINDOW = 15
+_CHUNK_ROWS = 4_096
+
+
+@dataclass(frozen=True)
+class PackedBf16Weight:
+    """A packed ``[out_features, in_features]`` BF16 weight."""
+
+    values: torch.Tensor
+    exponent_base: int
+    exception_rows: torch.Tensor
+    exception_entries: torch.Tensor
+    row_offsets: torch.Tensor
+    exceptions: int
+
+    @property
+    def out_features(self) -> int:
+        return int(self.values.shape[0])
+
+    @property
+    def in_features(self) -> int:
+        return int(self.values.shape[1]) * 2 // 3
+
+
+def _check_weight(weight: torch.Tensor) -> None:
+    if weight.ndim != 2 or weight.dtype != torch.bfloat16:
+        raise TypeError("packing needs a 2-D torch.bfloat16 weight")
+    if not weight.is_cuda or not weight.is_contiguous():
+        raise ValueError("packing needs a contiguous CUDA weight")
+    if weight.shape[0] == 0 or weight.shape[1] == 0 or weight.shape[1] % GROUP:
+        raise ValueError(f"packing needs rows and K divisible by {GROUP}, got {tuple(weight.shape)}")
+
+
+def _bits(weight: torch.Tensor) -> torch.Tensor:
+    return weight.view(torch.int16).to(torch.int32) & 0xFFFF
+
+
+def _choose_base(weight: torch.Tensor) -> int:
+    """The window start covering the most nonzero exponents, the lowest on ties."""
+    hist = torch.zeros(256, dtype=torch.int64, device=weight.device)
+    for start in range(0, weight.shape[0], _CHUNK_ROWS):
+        exponent = (_bits(weight[start:start + _CHUNK_ROWS]) >> 7) & 0xFF
+        hist += torch.bincount(exponent.flatten(), minlength=256)
+    hist[0] = 0
+    windows = hist.unfold(0, WINDOW, 1).sum(1)
+    windows[0] = -1
+    return int(windows.argmax())
+
+
+def _pack_rows(bits: torch.Tensor, base: int):
+    rows, k = bits.shape
+    exponent = (bits >> 7) & 0xFF
+    inside = (exponent >= base) & (exponent < base + WINDOW)
+    exception = (exponent != 0) & ~inside
+    code = torch.where(inside, exponent - base + 1, 0)
+    low = torch.where(exception, 0, ((bits >> 8) & 0x80) | (bits & 0x7F))
+    code = code.view(rows, k // GROUP, 2, GROUP // 2)
+    codes = (code[:, :, 0] | (code[:, :, 1] << 4)).reshape(rows, k // 2)
+    values = torch.cat((low.to(torch.uint8), codes.to(torch.uint8)), dim=1)
+    row, column = exception.nonzero(as_tuple=True)
+    entries = ((column << 16) | bits[row, column]).to(torch.int32)
+    return values, row.to(torch.int32), entries
+
+
+def _unpack_rows(values: torch.Tensor, base: int, rows: torch.Tensor, entries: torch.Tensor) -> torch.Tensor:
+    count, width = values.shape
+    k = width * 2 // 3
+    low = values[:, :k].to(torch.int32)
+    codes = values[:, k:].to(torch.int32).view(count, k // GROUP, 1, GROUP // 2)
+    code = torch.cat((codes & 0xF, codes >> 4), dim=2).reshape(count, k)
+    exponent = torch.where(code == 0, 0, code + base - 1)
+    bits = ((low & 0x80) << 8) | (exponent << 7) | (low & 0x7F)
+    if entries.numel():
+        bits[rows.long(), (entries >> 16).long()] = entries & 0xFFFF
+    return bits.to(torch.int16).view(torch.bfloat16)
+
+
+def pack(weight: torch.Tensor) -> PackedBf16Weight:
+    """Pack ``weight`` exactly; raise if any value would not round-trip."""
+    _check_weight(weight)
+    out_features, in_features = map(int, weight.shape)
+    base = _choose_base(weight)
+    values = torch.empty((out_features, in_features + in_features // 2), dtype=torch.uint8, device=weight.device)
+    exception_rows, exception_entries = [], []
+    counts = torch.zeros(out_features, dtype=torch.int32, device=weight.device)
+    for start in range(0, out_features, _CHUNK_ROWS):
+        source = weight[start:start + _CHUNK_ROWS]
+        chunk, rows, entries = _pack_rows(_bits(source), base)
+        if not torch.equal(_unpack_rows(chunk, base, rows, entries).view(torch.int16), source.view(torch.int16)):
+            raise ValueError(f"packed BF16 rows {start}..{start + len(source)} do not round-trip")
+        values[start:start + len(source)] = chunk
+        counts[start:start + len(source)] = torch.bincount(rows, minlength=len(source)).to(torch.int32)
+        exception_rows.append(rows + start)
+        exception_entries.append(entries)
+    row_offsets = torch.zeros(out_features + 1, dtype=torch.int32, device=weight.device)
+    row_offsets[1:] = torch.cumsum(counts, 0)
+    rows = torch.cat(exception_rows)
+    entries = torch.cat(exception_entries)
+    exceptions = int(rows.numel())
+    if exceptions == 0:
+        # Kernels take a valid pointer even when the row offsets select nothing.
+        rows = torch.zeros(1, dtype=torch.int32, device=weight.device)
+        entries = torch.zeros(1, dtype=torch.int32, device=weight.device)
+    return PackedBf16Weight(values, base, rows.contiguous(), entries.contiguous(), row_offsets, exceptions)
+
+
+def unpack(packed: PackedBf16Weight) -> torch.Tensor:
+    """The exact BF16 weight that ``packed`` stores."""
+    count = packed.exceptions
+    return _unpack_rows(packed.values, packed.exponent_base,
+                        packed.exception_rows[:count], packed.exception_entries[:count])
+
+
+__all__ = ["GROUP", "PackedBf16Weight", "WINDOW", "pack", "unpack"]
diff --git a/b12x/gemm/packed_bf16_vocab_projection/_kernel.py b/b12x/gemm/packed_bf16_vocab_projection/_kernel.py
new file mode 100644
index 00000000..dded005f
--- /dev/null
+++ b/b12x/gemm/packed_bf16_vocab_projection/_kernel.py
@@ -0,0 +1,114 @@
+"""Triton projection over exact 12-bit packed BF16 vocabulary weights."""
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from b12x.preparation.types import plan_from_handle, require_prepared
+
+
+@triton.jit
+def _decode(low, code, base_minus_one):
+    low = low.to(tl.int32)
+    code = code.to(tl.int32)
+    exponent = tl.where(code == 0, 0, code + base_minus_one)
+    bits = ((low & 0x80) << 8) | (exponent << 7) | (low & 0x7F)
+    return bits.to(tl.int16).to(tl.bfloat16, bitcast=True)
+
+
+@triton.jit
+def _load_weight(pointer, mask, EVICT_FIRST: tl.constexpr):
+    if EVICT_FIRST:
+        return tl.load(pointer, mask=mask, other=0, eviction_policy="evict_first")
+    return tl.load(pointer, mask=mask, other=0)
+
+
+@triton.jit(do_not_specialize=["rows", "base_minus_one"])
+def _projection_kernel(
+    source,
+    values,
+    output,
+    exception_rows,
+    exception_entries,
+    row_offsets,
+    rows,
+    base_minus_one,
+    K: tl.constexpr,
+    N: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    STEP_K: tl.constexpr,
+    NUM_STAGES: tl.constexpr,
+    EVICT_FIRST: tl.constexpr,
+):
+    """Each output is its row's 128-column groups in order, then its exceptions.
+
+    That order does not depend on the token count or the tile configuration,
+    so a token's logits are the same bits in any batch.
+    """
+    vocab = tl.program_id(0) * BLOCK_N + tl.arange(0, BLOCK_N)
+    token = tl.program_id(1) * BLOCK_M + tl.arange(0, BLOCK_M)
+    vocab_mask = vocab < N
+    token_mask = token < rows
+    lane = tl.arange(0, 64)
+    weight_row = values + vocab.to(tl.int64)[:, None] * (K + K // 2)
+    accumulator = tl.zeros((BLOCK_N, BLOCK_M), tl.float32)
+    for step in tl.range(0, K // STEP_K, num_stages=NUM_STAGES):
+        for half in tl.static_range(STEP_K // 128):
+            group = step * (STEP_K // 128) + half
+            column = group * 128
+            low_a = _load_weight(weight_row + column + lane[None, :], vocab_mask[:, None], EVICT_FIRST)
+            low_b = _load_weight(weight_row + column + 64 + lane[None, :], vocab_mask[:, None], EVICT_FIRST)
+            codes = _load_weight(weight_row + K + group * 64 + lane[None, :], vocab_mask[:, None], EVICT_FIRST)
+            source_a = tl.load(source + token[None, :] * K + column + lane[:, None],
+                               mask=token_mask[None, :], other=0.0)
+            source_b = tl.load(source + token[None, :] * K + column + 64 + lane[:, None],
+                               mask=token_mask[None, :], other=0.0)
+            accumulator = tl.dot(_decode(low_a, codes & 0xF, base_minus_one), source_a, accumulator)
+            accumulator = tl.dot(_decode(low_b, codes >> 4, base_minus_one), source_b, accumulator)
+    first = tl.program_id(0) * BLOCK_N
+    start = tl.load(row_offsets + first)
+    end = tl.load(row_offsets + tl.minimum(first + BLOCK_N, N))
+    for index in range(start, end):
+        row = tl.load(exception_rows + index)
+        entry = tl.load(exception_entries + index)
+        value = (entry & 0xFFFF).to(tl.int16).to(tl.bfloat16, bitcast=True).to(tl.float32)
+        hidden = tl.load(source + token * K + (entry >> 16), mask=token_mask, other=0.0).to(tl.float32)
+        accumulator = tl.where((vocab == row)[:, None], accumulator + value * hidden[None, :], accumulator)
+    tl.store(output + token[None, :] * N + vocab[:, None], accumulator.to(tl.bfloat16),
+             mask=vocab_mask[:, None] & token_mask[None, :])
+
+
+@torch.library.custom_op("b12x::packed_bf16_vocab_projection", mutates_args=())
+def packed_bf16_vocab_projection(
+    source: torch.Tensor,
+    values: torch.Tensor,
+    exception_rows: torch.Tensor,
+    exception_entries: torch.Tensor,
+    row_offsets: torch.Tensor,
+    exponent_base: int,
+    plan_handle: int,
+) -> torch.Tensor:
+    """Execute the prepared projection."""
+    state = require_prepared(
+        plan_from_handle(plan_handle), "gemm.packed_bf16_vocab_projection", source.device,
+    )
+    return state.run(source, values, exception_rows, exception_entries, row_offsets, exponent_base)
+
+
+@packed_bf16_vocab_projection.register_fake
+def _packed_bf16_vocab_projection_fake(
+    source: torch.Tensor,
+    values: torch.Tensor,
+    exception_rows: torch.Tensor,
+    exception_entries: torch.Tensor,
+    row_offsets: torch.Tensor,
+    exponent_base: int,
+    plan_handle: int,
+) -> torch.Tensor:
+    del exception_rows, exception_entries, row_offsets, exponent_base, plan_handle
+    return source.new_empty((source.shape[0], values.shape[0]))
+
+
+__all__ = ["packed_bf16_vocab_projection"]

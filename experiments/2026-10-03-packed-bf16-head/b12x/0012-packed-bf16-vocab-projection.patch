+"""Public surface for :mod:`b12x.gemm.packed_bf16_vocab_projection`."""
+from __future__ import annotations
+
+from b12x.preparation import Plan
+
+from ..._lib.gating import default_is_supported
+from . import META
+from ._contracts import Binding, Caps, bind, plan, run
+from ._format import PackedBf16Weight, pack, unpack
+from ._tuning import PackedBf16VocabProjectionConfig, PackedBf16VocabProjectionQuery

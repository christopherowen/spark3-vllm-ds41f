new file mode 100644
index 00000000..7c314f68
--- /dev/null
+++ b/b12x/gemm/packed_bf16_vocab_projection/_preparation.py
@@ -0,0 +1,99 @@
+"""Packed BF16 vocabulary projection declaration and prepared state."""
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+
+import torch
+
+from b12x._lib.compile_pool import CompileJob
+from b12x.preparation import FrozenMapping, MemoryRequirements, Plan
+
+from ._contracts import Binding, Caps, _bind
+from ._tuning import TUNING, PackedBf16VocabProjectionConfig, PackedBf16VocabProjectionQuery, block_m
+
+
+def compile_projection(query_payload, config_payload, ordinal):
+    """Compile exactly the selected projection kernel."""
+    from . import _kernel
+
+    query = PackedBf16VocabProjectionQuery(**dict(query_payload))
+    config = PackedBf16VocabProjectionConfig.from_config(FrozenMapping(config_payload))
+    TUNING.validate_query(query, None)
+    TUNING.validate_config(query, config, None)
+    tile_m = block_m(query.max_tokens)
+    with torch.cuda.device(ordinal):
+        return {"projection": _kernel._projection_kernel.warmup(
+            torch.bfloat16, torch.uint8, torch.bfloat16, torch.int32, torch.int32, torch.int32,
+            query.max_tokens, 112,
+            K=query.in_features, N=query.out_features, BLOCK_N=config.block_n, BLOCK_M=tile_m,
+            STEP_K=config.step_k, NUM_STAGES=config.num_stages, EVICT_FIRST=config.evict_first,
+            num_warps=config.num_warps,
+            grid=(triton_cdiv(query.out_features, config.block_n), triton_cdiv(query.max_tokens, tile_m), 1),
+        )}
+
+
+def triton_cdiv(value: int, divisor: int) -> int:
+    return (int(value) + divisor - 1) // divisor
+
+
+@dataclass(frozen=True)
+class _PreparedProjection:
+    caps: Caps
+    query: PackedBf16VocabProjectionQuery
+    config: PackedBf16VocabProjectionConfig
+    runner: Callable[..., torch.Tensor]
+
+    def bind(self, *, plan, source, weight) -> Binding:
+        return _bind(self.caps, plan=plan, source=source, weight=weight)
+
+    def run(self, source, values, exception_rows, exception_entries, row_offsets, exponent_base) -> torch.Tensor:
+        return self.runner(source, values, exception_rows, exception_entries, row_offsets, exponent_base)
+
+
+def make_plan(caps: Caps, *, invocation=FrozenMapping(), override=None) -> Plan:
+    if not isinstance(caps, Caps):
+        raise TypeError("caps must be packed_bf16_vocab_projection.Caps")
+    invocation = FrozenMapping(invocation)
+    if invocation:
+        raise ValueError("packed BF16 vocabulary projection has no invocation metadata")
+    query = PackedBf16VocabProjectionQuery(
+        max_tokens=caps.max_tokens, in_features=caps.in_features, out_features=caps.out_features,
+    )
+
+    def compile_jobs(config, device):
+        return (CompileJob.create(
+            "b12x.gemm.packed_bf16_vocab_projection._preparation:compile_projection",
+            TUNING.encode_query(query), config.to_dict(), device.ordinal,
+        ),)
+
+    def materialize(selection, device):
+        config = selection.config
+        launcher = compile_projection(TUNING.encode_query(query), config.to_dict(), device.ordinal)["projection"]
+        tile_m = block_m(query.max_tokens)
+        n_tiles = triton_cdiv(query.out_features, config.block_n)
+
+        def runner(source, values, exception_rows, exception_entries, row_offsets, exponent_base):
+            rows = int(source.shape[0])
+            if rows < 1 or rows > query.max_tokens:
+                raise ValueError("vocabulary projection source rows differ from preparation")
+            output = torch.empty((rows, query.out_features), dtype=torch.bfloat16, device=source.device)
+            launcher[(n_tiles, triton_cdiv(rows, tile_m), 1)](
+                source, values, output, exception_rows, exception_entries, row_offsets,
+                rows, int(exponent_base) - 1,
+                query.in_features, query.out_features, config.block_n, tile_m,
+                config.step_k, config.num_stages, config.evict_first,
+            )
+            return output
+
+        return _PreparedProjection(caps, query, config, runner)
+
+    return Plan(
+        contract=TUNING, query=query, invocation=invocation, override=override,
+        _compile_jobs=compile_jobs,
+        _memory_requirements=lambda config, device: MemoryRequirements(),
+        _materialize=materialize, _device=caps.device,
+    )
+
+
+__all__ = ["compile_projection", "make_plan"]

--- /dev/null
+++ b/b12x/gemm/packed_bf16_vocab_projection/_tuning.py
@@ -0,0 +1,160 @@
+"""Configuration contract for the packed BF16 vocabulary projection."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from b12x.preparation import (
+    DeviceIdentity,
+    FrozenMapping,
+    Knob,
+    ParameterBinding,
+    TuningContract,
+)
+
+from ._format import GROUP
+
+MAX_TOKENS_PER_TILE = 64
+SHARED_MEMORY_LIMIT = 101_376  # SM120/SM121 dynamic shared memory per block
+_BLOCK_N = (16, 32, 64)
+_STEP_K = (128, 256)
+_WARPS = (2, 4, 8)
+_STAGES = (2, 3, 4, 5, 6)
+
+
+@dataclass(frozen=True, kw_only=True)
+class PackedBf16VocabProjectionQuery:
+    max_tokens: int
+    in_features: int
+    out_features: int
+
+
+@dataclass(frozen=True, kw_only=True)
+class PackedBf16VocabProjectionConfig:
+    block_n: int
+    step_k: int
+    num_warps: int
+    num_stages: int
+    evict_first: bool
+
+    @classmethod
+    def from_config(cls, payload: FrozenMapping) -> "PackedBf16VocabProjectionConfig":
+        expected = set(cls.__dataclass_fields__)
+        if set(payload) != expected:
+            raise ValueError(f"packed BF16 vocabulary projection configs require {sorted(expected)}")
+        return cls(
+            block_n=int(payload["block_n"]),
+            step_k=int(payload["step_k"]),
+            num_warps=int(payload["num_warps"]),
+            num_stages=int(payload["num_stages"]),
+            evict_first=bool(payload["evict_first"]),
+        )
+
+    def to_dict(self) -> dict[str, object]:
+        return {
+            "block_n": self.block_n,
+            "step_k": self.step_k,
+            "num_warps": self.num_warps,
+            "num_stages": self.num_stages,
+            "evict_first": self.evict_first,
+        }
+
+
+def block_m(max_tokens: int) -> int:
+    """Token tile: one tile up to 64 rows, so weights are read once."""
+    return min(max(16, 1 << (int(max_tokens) - 1).bit_length()), MAX_TOKENS_PER_TILE)
+
+
+def shared_memory_bytes(config: "PackedBf16VocabProjectionConfig", max_tokens: int) -> int:
+    """Triton's pipelined staging plus the decoded-weight layout buffer.
+
+    Matches the compiler's reported requirement for every configuration of
+    the GB10 sweep (Triton 3.7): ``stages - 1`` buffers of packed weights and
+    BF16 source columns per K step, and one BF16 half-group of weights.
+    """
+    per_step = config.step_k * (config.block_n * 3 // 2 + 2 * block_m(max_tokens))
+    return (config.num_stages - 1) * per_step + 128 * config.block_n
+
+
+def _encode(query: PackedBf16VocabProjectionQuery) -> dict[str, object]:
+    return {name: getattr(query, name) for name in PackedBf16VocabProjectionQuery.__dataclass_fields__}
+
+
+def _default_config(
+    query: PackedBf16VocabProjectionQuery,
+    _device: DeviceIdentity | None,
+) -> PackedBf16VocabProjectionConfig:
+    # Measured on GB10 for DS4.1 vocabulary shards (32,320 and 43,092 rows, K=5,120).
+    step_k = 256 if query.in_features % 256 == 0 else 128
+    if query.max_tokens <= 16:
+        return PackedBf16VocabProjectionConfig(block_n=16, step_k=step_k, num_warps=4, num_stages=6, evict_first=True)
+    if query.max_tokens <= 32:
+        return PackedBf16VocabProjectionConfig(block_n=16, step_k=step_k, num_warps=4, num_stages=4, evict_first=True)
+    return PackedBf16VocabProjectionConfig(block_n=32, step_k=step_k, num_warps=8, num_stages=3, evict_first=False)
+
+
+def _validate_query(query: PackedBf16VocabProjectionQuery, _device: DeviceIdentity | None) -> None:
+    if not isinstance(query, PackedBf16VocabProjectionQuery):
+        raise TypeError("query must be PackedBf16VocabProjectionQuery")
+    if query.max_tokens <= 0 or query.out_features <= 0:
+        raise ValueError("max_tokens and out_features must be positive")
+    if query.in_features <= 0 or query.in_features % GROUP:
+        raise ValueError(f"in_features must be a positive multiple of {GROUP}")
+
+
+def _validate_config(
+    query: PackedBf16VocabProjectionQuery,
+    config: PackedBf16VocabProjectionConfig,
+    _device: DeviceIdentity | None,
+) -> None:
+    if not isinstance(config, PackedBf16VocabProjectionConfig):
+        raise TypeError("config must be PackedBf16VocabProjectionConfig")
+    if config.block_n not in _BLOCK_N:
+        raise ValueError(f"unsupported block_n {config.block_n}")
+    if config.step_k not in _STEP_K or query.in_features % config.step_k:
+        raise ValueError(f"step_k {config.step_k} must be one of {_STEP_K} and divide K")
+    if config.num_warps not in _WARPS:
+        raise ValueError(f"unsupported warp count {config.num_warps}")
+    if config.num_stages not in _STAGES:
+        raise ValueError(f"unsupported stage count {config.num_stages}")
+    if shared_memory_bytes(config, query.max_tokens) > SHARED_MEMORY_LIMIT:
+        raise ValueError(f"configuration {config} needs more shared memory than SM12x provides")
+
+
+def _tuning_parameters(query, _device):
+    return {"step_k": tuple(step for step in _STEP_K if query.in_features % step == 0)}
+
+
+TUNING = TuningContract(
+    component_id="gemm.packed_bf16_vocab_projection",
+    query_schema_version=1,
+    config_schema_version=1,
+    query_fields=frozenset(PackedBf16VocabProjectionQuery.__dataclass_fields__),
+    config_fields=frozenset(PackedBf16VocabProjectionConfig.__dataclass_fields__),
+    encode_query=_encode,
+    encode_config=PackedBf16VocabProjectionConfig.to_dict,
+    decode_config=PackedBf16VocabProjectionConfig.from_config,
+    validate_query=_validate_query,
+    validate_config=_validate_config,
+    default_config=_default_config,
+    candidate_contract_version=1,
+    knobs=(
+        Knob(name="block_n", values=_BLOCK_N, binding=ParameterBinding.COMPILE),
+        Knob(name="step_k", values=None, binding=ParameterBinding.COMPILE),
+        Knob(name="num_warps", values=_WARPS, binding=ParameterBinding.COMPILE),
+        Knob(name="num_stages", values=_STAGES, binding=ParameterBinding.COMPILE),
+        Knob(name="evict_first", values=(False, True), binding=ParameterBinding.COMPILE),
+    ),
+    parameters=_tuning_parameters,
+)
+
+
+__all__ = [
+    "MAX_TOKENS_PER_TILE",
+    "SHARED_MEMORY_LIMIT",
+    "TUNING",
+    "PackedBf16VocabProjectionConfig",
+    "PackedBf16VocabProjectionQuery",
+    "block_m",
+    "shared_memory_bytes",
+]

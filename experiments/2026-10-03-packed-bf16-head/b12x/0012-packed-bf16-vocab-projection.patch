index 00000000..9a5ba038
--- /dev/null
+++ b/tests/gemm/test_packed_bf16_vocab_projection.py
@@ -0,0 +1,164 @@
+from __future__ import annotations
+
+import itertools
+
+import pytest
+import torch
+
+from b12x.gemm import packed_bf16_vocab_projection as projection
+from b12x.gemm.packed_bf16_vocab_projection._tuning import (
+    SHARED_MEMORY_LIMIT,
+    TUNING,
+    block_m,
+    shared_memory_bytes,
+)
+from b12x.preparation import DeviceIdentity, PreparationSession, PreparedCall
+
+cuda_required = pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+
+Config = projection.PackedBf16VocabProjectionConfig
+
+
+def _weight(rows: int, k: int, *, seed: int = 0, infinities: bool = False) -> torch.Tensor:
+    """Vocabulary-like weights plus the value classes the format must keep."""
+    generator = torch.Generator(device="cuda").manual_seed(seed)
+    weight = (torch.randn(rows, k, device="cuda", generator=generator) * 0.02).to(torch.bfloat16)
+    bits = weight.view(torch.int16)
+    # Zeros, subnormals, values far below and above the exponent window, and +-1.
+    specials = [0x0000, -0x8000, 0x0001, -0x7FFF, 0x007F, 0x0080, 0x2000, 0x1000, 0x3F80, -0x4080, 0x4500]
+    if infinities:
+        specials += [0x7F7F, 0x7F80, -0x0080]
+    specials = torch.tensor(specials, dtype=torch.int16, device="cuda")
+    bits[3, : specials.numel()] = specials
+    bits[7, 64: 64 + specials.numel()] = specials
+    # Rows with more out-of-window values than a projection tile has rows:
+    # large ones dominate the row's logit, tiny ones barely move it.
+    bits[rows - 2, ::3] = 0x4100
+    bits[rows - 5, 1::4] = 0x2000
+    return weight
+
+
+def _prepared(caps: projection.Caps, config: Config | None):
+    declaration = projection.plan(caps, override=config)
+    source = torch.zeros((caps.max_tokens, caps.in_features), device="cuda", dtype=torch.bfloat16)
+    packed = projection.pack(torch.zeros((caps.out_features, caps.in_features), device="cuda",
+                                         dtype=torch.bfloat16))
+    session = PreparationSession(device=caps.device, autotune=False, compile_workers=2)
+    session.__enter__()
+
+    def prepare_call(state):
+        return PreparedCall(run=lambda: state.run(source, packed.values, packed.exception_rows,
+                                                  packed.exception_entries, packed.row_offsets,
+                                                  packed.exponent_base))
+
+    session.prepare((declaration.request(name="vocab", prepare_call=prepare_call),))
+    return declaration, session
+
+
+def test_shared_memory_estimate_matches_compiler_limits() -> None:
+    # Requirements the compiler reported on GB10 for configurations that do not fit.
+    for (block_n, tokens, stages, step), required in {
+        (16, 16, 8, 256): 102_400, (32, 16, 6, 256): 106_496, (64, 64, 3, 256): 122_880,
+        (16, 64, 8, 128): 138_240, (64, 32, 6, 128): 110_592, (32, 32, 6, 256): 147_456,
+    }.items():
+        config = Config(block_n=block_n, step_k=step, num_warps=4, num_stages=stages, evict_first=True)
+        assert shared_memory_bytes(config, tokens) == required
+    query = projection.PackedBf16VocabProjectionQuery(max_tokens=16, in_features=5_120, out_features=32_320)
+    with pytest.raises(ValueError, match="shared memory"):
+        TUNING.validate_config(query, Config(block_n=32, step_k=256, num_warps=4, num_stages=6,
+                                             evict_first=True), None)
+
+
+def test_default_config_covers_decode_token_counts() -> None:
+    device = DeviceIdentity(vendor="nvidia", compute_capability=(12, 1), sm_count=48, product_name="GB10")
+    for tokens in (1, 6, 16, 32, 48):
+        query = projection.PackedBf16VocabProjectionQuery(max_tokens=tokens, in_features=5_120,
+                                                          out_features=32_320)
+        config = TUNING.configure(query, device=device).default
+        TUNING.validate_config(query, config, device)
+        assert config.step_k == 256
+    assert [block_m(n) for n in (1, 16, 17, 48, 64, 65, 200)] == [16, 16, 32, 64, 64, 64, 64]
+
+
+@cuda_required
+def test_pack_round_trips_every_bit() -> None:
+    weight = _weight(512, 640, infinities=True)
+    packed = projection.pack(weight)
+    assert packed.values.shape == (512, 960)
+    assert packed.exceptions > 300
+    assert torch.equal(projection.unpack(packed).view(torch.int16), weight.view(torch.int16))
+    offsets = packed.row_offsets.cpu()
+    assert offsets[0] == 0 and offsets[-1] == packed.exceptions
+    assert torch.all(offsets[1:] >= offsets[:-1])
+
+
+@cuda_required
+def test_pack_without_exceptions_and_rejects_bad_shapes() -> None:
+    weight = torch.full((16, 128), 0.5, device="cuda", dtype=torch.bfloat16)
+    packed = projection.pack(weight)
+    assert packed.exceptions == 0 and packed.exception_rows.numel() == 1
+    assert torch.equal(projection.unpack(packed), weight)
+    with pytest.raises(ValueError):
+        projection.pack(torch.zeros((16, 96), device="cuda", dtype=torch.bfloat16))
+    with pytest.raises(TypeError):
+        projection.pack(torch.zeros((16, 128), device="cuda", dtype=torch.float16))
+
+
+def _project(packed, source, max_tokens, config=None):
+    caps = projection.Caps(device="cuda", max_tokens=max_tokens, in_features=source.shape[1],
+                           out_features=packed.out_features)
+    declaration, session = _prepared(caps, config)
+    try:
+        return projection.run(projection.bind(declaration, source=source.contiguous(), weight=packed))
+    finally:
+        session.__exit__(None, None, None)
+
+
+@cuda_required
+def test_projection_matches_reference_and_is_batch_and_config_invariant() -> None:
+    torch.manual_seed(3)
+    k, n = 512, 4_100
+    packed = projection.pack(_weight(n, k, seed=5))
+    source = torch.randn(80, k, device="cuda", dtype=torch.bfloat16)
+    reference = source.float() @ projection.unpack(packed).float().T
+    # Each token's logits computed alone, with the default single-token configuration.
+    probes = (0, 4, 36, 79)
+    alone = {row: _project(packed, source[row:row + 1], 1)[0] for row in probes}
+    configs = [
+        Config(block_n=block_n, step_k=step_k, num_warps=warps, num_stages=stages, evict_first=evict)
+        for block_n, step_k, (warps, stages), evict in itertools.product(
+            (16, 32, 64), (128, 256), ((2, 2), (4, 6)), (False, True))
+    ]
+    for tokens, max_tokens in ((1, 1), (5, 6), (37, 48), (80, 80)):
+        fitting = [c for c in configs if shared_memory_bytes(c, max_tokens) <= SHARED_MEMORY_LIMIT]
+        for config in [None] + (fitting if tokens in (1, 37) else []):
+            actual = _project(packed, source[:tokens], max_tokens, config)
+            torch.testing.assert_close(actual.float(), reference[:tokens], rtol=1e-2, atol=2e-2)
+            for row in probes:
+                if row < tokens:
+                    assert torch.equal(actual[row].view(torch.int16), alone[row].view(torch.int16)), (
+                        tokens, config, row)
+
+
+@cuda_required
+def test_prepared_projection_replays_graph() -> None:
+    torch.manual_seed(4)
+    k, n = 256, 4_096
+    packed = projection.pack(_weight(n, k, seed=9))
+    source = torch.randn(6, k, device="cuda", dtype=torch.bfloat16)
+    caps = projection.Caps(device="cuda", max_tokens=6, in_features=k, out_features=n)
+    declaration, session = _prepared(caps, None)
+    try:
+        binding = projection.bind(declaration, source=source, weight=packed)
+        expected = projection.run(binding).clone()
+        graph = torch.cuda.CUDAGraph()
+        with session.capture(), torch.cuda.graph(graph):
+            actual = projection.run(binding)
+        actual.fill_(float("nan"))
+        graph.replay()
+        torch.cuda.synchronize()
+    finally:
+        session.__exit__(None, None, None)
+    assert torch.equal(actual.view(torch.int16), expected.view(torch.int16))
+    reference = source.float() @ projection.unpack(packed).float().T
+    torch.testing.assert_close(actual.float(), reference, rtol=1e-2, atol=2e-2)

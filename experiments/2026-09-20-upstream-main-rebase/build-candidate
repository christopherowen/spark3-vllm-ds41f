#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
experiment_root="$repo_root/experiments/2026-09-20-upstream-main-rebase"
source_root=${SOURCE_ROOT:-"$repo_root/.work/experiments/2026-09-20-upstream-main-rebase"}
mode=${1:-build}
case "$mode" in
  build|check) ;;
  *) echo "usage: $0 [build|check]" >&2; exit 2 ;;
esac

vllm_base=d05da62e9ccdf8e342b15bf6785d83224cc165af
b12x_base=0f3a8cbfd1c11d27f04e3ab37a802d522f4f1c68
vllm_head=d7e22286ffc9299800e4e448ee525a0b5259f738
b12x_head=c90ba030f2ab4a17959afd05461449ca47259242
vllm_tree=b99e514fd55976432f442a0c2a7a21732842f7c1
b12x_tree=a1523b067b4df679f9aa23d543fa324dc00770f0

for project in vllm b12x; do
  source_path="$source_root/$project"
  if [ ! -d "$source_path/.git" ]; then
    echo "missing prepared source: $source_path" >&2
    echo "run $experiment_root/prepare-sources first" >&2
    exit 1
  fi
  git -C "$source_path" diff --quiet
  git -C "$source_path" diff --cached --quiet
done

actual_vllm_tree=$(git -C "$source_root/vllm" rev-parse HEAD^{tree})
actual_b12x_tree=$(git -C "$source_root/b12x" rev-parse HEAD^{tree})
actual_vllm_head=$(git -C "$source_root/vllm" rev-parse HEAD)
actual_b12x_head=$(git -C "$source_root/b12x" rev-parse HEAD)
if [ "$actual_vllm_head" != "$vllm_head" ]; then
  echo "vLLM revision mismatch: expected $vllm_head, got $actual_vllm_head" >&2
  exit 1
fi
if [ "$actual_b12x_head" != "$b12x_head" ]; then
  echo "B12X revision mismatch: expected $b12x_head, got $actual_b12x_head" >&2
  exit 1
fi
if [ "$actual_vllm_tree" != "$vllm_tree" ]; then
  echo "vLLM tree mismatch: expected $vllm_tree, got $actual_vllm_tree" >&2
  exit 1
fi
if [ "$actual_b12x_tree" != "$b12x_tree" ]; then
  echo "B12X tree mismatch: expected $b12x_tree, got $actual_b12x_tree" >&2
  exit 1
fi

if [ "$mode" = check ]; then
  echo "candidate source trees match recorded identities"
  exit 0
fi

deployment_commit=$(git -C "$repo_root" rev-parse HEAD)
deployment_short=$(printf '%s' "$deployment_commit" | cut -c1-12)
vllm_short=$(printf '%s' "$vllm_head" | cut -c1-12)
b12x_short=$(printf '%s' "$b12x_head" | cut -c1-12)
tag=${CANDIDATE_TAG:-"vllm-ds41f-upstream-main:$vllm_short-$b12x_short-d$deployment_short"}

exec docker buildx build \
  --platform linux/arm64 \
  --load \
  --build-context "vllm-source=$source_root/vllm" \
  --build-context "b12x-source=$source_root/b12x" \
  --build-arg "VLLM_BASE=$vllm_base" \
  --build-arg "VLLM_PATCH_HEAD=$vllm_head" \
  --build-arg "VLLM_TREE=$vllm_tree" \
  --build-arg "B12X_BASE=$b12x_base" \
  --build-arg "B12X_PATCH_HEAD=$b12x_head" \
  --build-arg "B12X_TREE=$b12x_tree" \
  --build-arg "DEPLOYMENT_COMMIT=$deployment_commit" \
  --tag "$tag" \
  --file "$experiment_root/Dockerfile" \
  "$experiment_root"

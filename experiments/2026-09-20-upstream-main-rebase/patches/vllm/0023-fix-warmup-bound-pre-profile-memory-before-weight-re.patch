@@ -1092,6 +1092,20 @@ class JitWarmupRegistry:
     def __len__(self) -> int:
         return sum(len(registrations) for registrations in self._registrations.values())
 
+    @classmethod
+    def warmup_active(cls) -> bool:
+        """Compile registrations captured by the active model-construction phase.
+
+        Returns ``True`` when a registry was active. Model loaders use this hook
+        after constructing a model but before loading its weights, when compiler
+        processes have substantially more host-memory headroom.
+        """
+        registry = cls._active.get()
+        if registry is None:
+            return False
+        registry.warmup()
+        return True
+
     def warmup(self) -> None:
         """Expand registrations and compile each wrapper/key pair once."""
         from tqdm import tqdm

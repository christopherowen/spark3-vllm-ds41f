+from types import SimpleNamespace
+from typing import Any, cast
+
+import torch.nn as nn
+
+import vllm.model_executor.model_loader.base_loader as base_loader
+from vllm.model_executor.model_loader.base_loader import BaseModelLoader
+from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+
+
+class _Loader(BaseModelLoader):
+    def download_model(self, model_config) -> None:
+        pass
+
+    def load_weights(self, model, model_config) -> None:
+        pass
+
+
+def test_create_model_warms_active_registry_before_return(monkeypatch) -> None:
+    events: list[str] = []
+    model = nn.Module()
+    config = SimpleNamespace(
+        kernel_config=SimpleNamespace(enable_jit_warmup=True),
+    )
+    registry = JitWarmupRegistry(config)
+    monkeypatch.setattr(
+        base_loader,
+        "initialize_model",
+        lambda **_: events.append("construct") or model,
+    )
+    monkeypatch.setattr(base_loader, "log_online_quantization", lambda *_: None)
+    monkeypatch.setattr(base_loader, "log_model_inspection", lambda *_: None)
+    monkeypatch.setattr(
+        base_loader,
+        "current_platform",
+        SimpleNamespace(is_cuda_alike=lambda: True, is_xpu=lambda: False),
+    )
+    monkeypatch.setattr(registry, "warmup", lambda: events.append("warmup"))
+    monkeypatch.setattr(
+        base_loader.torch.accelerator,
+        "synchronize",
+        lambda: events.append("synchronize"),
+    )
+    monkeypatch.setattr(
+        base_loader.torch.accelerator,
+        "empty_cache",
+        lambda: events.append("empty_cache"),
+    )
+    monkeypatch.setattr(base_loader.gc, "collect", lambda: events.append("gc"))
+
+    loader = _Loader(cast(Any, object()))
+    with registry.activate():
+        assert loader.create_model(config, cast(Any, object())) is model
+
+    assert events == ["construct", "warmup", "synchronize", "gc", "empty_cache"]
+
+
+def test_create_model_does_not_warm_when_disabled(monkeypatch) -> None:
+    model = nn.Module()
+    config = SimpleNamespace(
+        kernel_config=SimpleNamespace(enable_jit_warmup=False),
+    )
+    registry = JitWarmupRegistry(config)
+    monkeypatch.setattr(base_loader, "initialize_model", lambda **_: model)
+    monkeypatch.setattr(base_loader, "log_online_quantization", lambda *_: None)
+    monkeypatch.setattr(base_loader, "log_model_inspection", lambda *_: None)
+    monkeypatch.setattr(
+        registry,
+        "warmup",
+        lambda: (_ for _ in ()).throw(AssertionError("warmup must stay disabled")),
+    )
+
+    loader = _Loader(cast(Any, object()))
+    with registry.activate():
+        assert loader.create_model(config, cast(Any, object())) is model

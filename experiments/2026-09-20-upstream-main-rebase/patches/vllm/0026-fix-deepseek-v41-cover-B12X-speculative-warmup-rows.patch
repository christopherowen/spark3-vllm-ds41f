+def test_b12x_decode_plan_covers_dspark_warmup_rows() -> None:
+    config = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            num_speculative_tokens=3,
+            parallel_drafting=False,
+        ),
+        scheduler_config=SimpleNamespace(max_num_seqs=8),
+        compilation_config=SimpleNamespace(max_cudagraph_capture_size=0),
+    )
+
+    # Serving decode is 8 * (1 + 3) = 32 rows. Kernel warmup deliberately
+    # exercises one additional row per request, for 8 * 5 = 40.
+    assert _decode_plan_row_capacity(config) == 40
+
+
+def test_b12x_decode_plan_keeps_larger_graph_capacity() -> None:
+    config = SimpleNamespace(
+        speculative_config=None,
+        scheduler_config=SimpleNamespace(max_num_seqs=8),
+        compilation_config=SimpleNamespace(max_cudagraph_capture_size=64),
+    )
+
+    assert _decode_plan_row_capacity(config) == 64
+
+
+def test_b12x_decode_caps_use_row_capacity_not_request_count() -> None:
+    recorded_caps = []
+
+    class FakeMLA:
+        @staticmethod
+        def Caps(**kwargs):
+            return SimpleNamespace(**kwargs)
+
+        @staticmethod
+        def invocation_from_descriptors(**kwargs):
+            return kwargs
+
+        @staticmethod
+        def plan(caps, *, invocation):
+            del invocation
+            recorded_caps.append(caps)
+            return caps
+
+    attention = object.__new__(DeepseekV41B12xAttention)
+    torch.nn.Module.__init__(attention)
+    attention._b12x = FakeMLA()
+    attention.n_local_heads = 24
+    attention.head_dim = 512
+    attention.max_model_len = 131072
+    attention.swa_cache_layer = SimpleNamespace(block_size=128)
+    attention._vllm_config = SimpleNamespace(
+        scheduler_config=SimpleNamespace(max_num_seqs=8),
+        cache_config=SimpleNamespace(block_size=128),
+    )
+    cache = torch.empty((2, 128), dtype=torch.uint8)
+
+    attention._plan(
+        mode="decode",
+        rows=40,
+        swa_width=3328,
+        swa_cache=cache,
+        indexed_cache=None,
+        indexed_width=0,
+        indexed_page_size=1,
+    )
+    attention._plan(
+        mode="extend",
+        rows=8192,
+        swa_width=32768,
+        swa_cache=cache,
+        indexed_cache=None,
+        indexed_width=0,
+        indexed_page_size=1,
+    )
+
+    assert recorded_caps[0].max_batch == 40
+    assert recorded_caps[0].decode_row_capacity == 40
+    assert recorded_caps[1].max_batch == 8
+    assert recorded_caps[1].decode_row_capacity is None
+
+
 def test_disk_engram_routes_immutable_checkpoint_ranges() -> None:
     class DiskTable:

diff --git a/vllm/models/deepseek_v41/nvidia/b12x_attention.py b/vllm/models/deepseek_v41/nvidia/b12x_attention.py
index 3ff78288f..3315bd2d4 100644
--- a/vllm/models/deepseek_v41/nvidia/b12x_attention.py
+++ b/vllm/models/deepseek_v41/nvidia/b12x_attention.py
@@ -154,6 +154,32 @@ def _flatten_cache(cache: torch.Tensor, *, name: str) -> torch.Tensor:
     return cache.view(cache.shape[0], -1)
 
 
+def _decode_plan_row_capacity(vllm_config: VllmConfig) -> int:
+    """Bound every decode-shaped batch exercised before serving.
+
+    Ordinary speculative decode uses ``1 + speculative_tokens`` rows per
+    request (twice the speculative width for parallel drafting).  vLLM's
+    kernel warmup deliberately adds one more row per request so the synthetic
+    prefill is distinct from a uniform decode.  DSpark can still present that
+    non-causal warmup through the decode-shaped SWA metadata, so prepare the
+    small decode plan for both shapes before weights are resident.
+    """
+    spec_config = vllm_config.speculative_config
+    speculative_tokens = (
+        0 if spec_config is None else int(spec_config.num_speculative_tokens)
+    )
+    spec_multiplier = (
+        2 if spec_config is not None and spec_config.parallel_drafting else 1
+    )
+    decode_query_len = 1 + spec_multiplier * speculative_tokens
+    warmup_query_len = decode_query_len + 1
+    return max(
+        1,
+        vllm_config.scheduler_config.max_num_seqs * warmup_query_len,
+        int(vllm_config.compilation_config.max_cudagraph_capture_size or 0),
+    )
+
+
 class DeepseekV41B12xAttention(DeepseekV4Attention):
     """Upstream V4.1 semantics with B12X's SM12x sparse-attention kernel."""
 
@@ -273,13 +299,20 @@ class DeepseekV41B12xAttention(DeepseekV4Attention):
             attn_sink_present=True,
             output_mode="provided",
         )
+        # B12X's compressed decode contract names this capacity ``max_batch``
+        # but validates it against Q rows. Extend mode uses request batches.
+        max_batch = (
+            rows
+            if mode == "decode"
+            else self._vllm_config.scheduler_config.max_num_seqs
+        )
         plan = mla.plan(
             mla.Caps(
                 device=swa_cache.device,
                 num_q_heads=self.n_local_heads,
                 max_q_rows=rows,
                 max_width=swa_width + indexed_width,
-                max_batch=self._vllm_config.scheduler_config.max_num_seqs,
+                max_batch=max_batch,
                 max_page_table_width=max_page_table_width,
                 swa_width=swa_width,
                 indexed_width=indexed_width,
@@ -317,15 +350,7 @@ class DeepseekV41B12xAttention(DeepseekV4Attention):
         speculative_tokens = (
             0 if spec_config is None else int(spec_config.num_speculative_tokens)
         )
-        spec_multiplier = (
-            2 if spec_config is not None and spec_config.parallel_drafting else 1
-        )
-        decode_query_len = 1 + spec_multiplier * speculative_tokens
-        decode_rows = max(
-            1,
-            self._vllm_config.scheduler_config.max_num_seqs * decode_query_len,
-            int(self._vllm_config.compilation_config.max_cudagraph_capture_size or 0),
-        )
+        decode_rows = _decode_plan_row_capacity(self._vllm_config)
         extend_rows = self.max_num_batched_tokens
         decode_swa_width = (
             get_dspark_swa_index_width(self.window_size, speculative_tokens)

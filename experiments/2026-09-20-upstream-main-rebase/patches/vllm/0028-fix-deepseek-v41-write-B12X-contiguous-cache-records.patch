+    current.write_cache = lambda *args, **kwargs: None
     monkeypatch.setattr(b12x_attention.DeepseekV4Attention, "__init__", initialize_base)
     monkeypatch.setattr(
         b12x_attention, "get_b12x_compressed_sparse_mla", lambda: current
@@ -152,6 +158,119 @@ def test_flatten_cache_preserves_packed_page_storage() -> None:
         _flatten_cache(cache.to(torch.bfloat16), name="test cache")
 
 
+class _RecordingRotary(torch.nn.Module):
+    def __init__(self) -> None:
+        super().__init__()
+        self.positions = []
+
+    def forward(self, positions, query, key=None):
+        self.positions.append(positions.clone())
+        query.add_(1)
+        if key is not None:
+            key.add_(2)
+        return query, key
+
+
+class _RecordingMLA:
+    def __init__(self) -> None:
+        self.writes = []
+
+    def write_cache(self, kv, cache, slot_mapping, **kwargs):
+        self.writes.append((kv.clone(), cache, slot_mapping.clone(), kwargs))
+
+
+def test_b12x_writes_swa_in_its_contiguous_record_layout(monkeypatch) -> None:
+    attention = object.__new__(DeepseekV41B12xAttention)
+    torch.nn.Module.__init__(attention)
+    attention._b12x = _RecordingMLA()
+    attention.rotary_emb = _RecordingRotary()
+    attention.swa_cache_layer = SimpleNamespace(
+        prefix="model.layers.0.swa",
+        block_size=32,
+        kv_cache=torch.empty((2, 32, 528), dtype=torch.uint8),
+    )
+    attention._ensure_plans = lambda: SimpleNamespace(swa_writer="swa-plan")
+    slots = torch.tensor([7, 8], dtype=torch.int64)
+    monkeypatch.setattr(
+        b12x_attention,
+        "get_forward_context",
+        lambda: SimpleNamespace(
+            attn_metadata={
+                attention.swa_cache_layer.prefix: SimpleNamespace(slot_mapping=slots)
+            }
+        ),
+    )
+    q = torch.zeros((2, 24, 512), dtype=torch.bfloat16)
+    kv = torch.zeros((2, 512), dtype=torch.bfloat16)
+
+    actual = attention._fused_qnorm_rope_kv_insert(
+        q,
+        kv,
+        torch.tensor([3, 4], dtype=torch.int64),
+        b12x_attention.get_forward_context().attn_metadata,
+    )
+
+    assert actual is q
+    assert torch.equal(q, torch.ones_like(q))
+    write_kv, write_cache, write_slots, kwargs = attention._b12x.writes[0]
+    assert torch.equal(write_kv, torch.full_like(kv, 2))
+    assert write_cache.shape == (2, 32 * 528)
+    assert torch.equal(write_slots, slots)
+    assert kwargs == {
+        "plan": "swa-plan",
+        "page_size": 32,
+        "cache_kind": "swa",
+        "cache_format": "deepseek_v41",
+    }
+
+
+def test_b12x_writes_rotated_compressed_rows_without_mutating_indexer_input(
+    monkeypatch,
+) -> None:
+    attention = object.__new__(DeepseekV41B12xAttention)
+    torch.nn.Module.__init__(attention)
+    attention._b12x = _RecordingMLA()
+    attention.rotary_emb = _RecordingRotary()
+    attention.compress_ratio = 2
+    attention.compressor = SimpleNamespace(k_cache_prefix="model.layers.1.attn")
+    attention.is_kv_source = True
+    attention.kv_cache = torch.empty((2, 64, 288), dtype=torch.uint8)
+    attention._vllm_config = SimpleNamespace(
+        cache_config=SimpleNamespace(block_size=128)
+    )
+    attention._ensure_plans = lambda: SimpleNamespace(indexed_writer="indexed-plan")
+    slots = torch.tensor([-1, 7, -1, 8], dtype=torch.int64)
+    monkeypatch.setattr(
+        b12x_attention,
+        "get_forward_context",
+        lambda: SimpleNamespace(
+            attn_metadata={
+                attention.compressor.k_cache_prefix: SimpleNamespace(slot_mapping=slots)
+            }
+        ),
+    )
+    latent = torch.zeros((4, 512), dtype=torch.bfloat16)
+    positions = torch.tensor([0, 1, 2, 3], dtype=torch.int64)
+
+    attention._insert_compressed_cache(latent, positions)
+
+    assert torch.equal(latent, torch.zeros_like(latent))
+    assert torch.equal(
+        attention.rotary_emb.positions[0],
+        torch.tensor([0, 0, 2, 2], dtype=torch.int64),
+    )
+    write_kv, write_cache, write_slots, kwargs = attention._b12x.writes[0]
+    assert torch.equal(write_kv, torch.ones_like(write_kv))
+    assert write_cache.shape == (2, 64 * 288)
+    assert torch.equal(write_slots, slots)
+    assert kwargs == {
+        "plan": "indexed-plan",
+        "page_size": 64,
+        "cache_kind": "indexed",
+        "cache_format": "deepseek_v41",
+    }
+
+
 def test_b12x_swa_only_layer_ignores_shared_indexer_output(monkeypatch) -> None:
     attention = object.__new__(DeepseekV41B12xAttention)
     torch.nn.Module.__init__(attention)
diff --git a/vllm/models/deepseek_v41/attention.py b/vllm/models/deepseek_v41/attention.py

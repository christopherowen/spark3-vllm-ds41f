From 891dfb6cb1f9e7fa61547081ba346dcec405a275 Mon Sep 17 00:00:00 2001
From: Christopher Owen <root@your.mom>
Date: Tue, 22 Sep 2026 14:13:07 +0200
Subject: [PATCH] fix(deepseek-v41): skip indexed path for B12X SWA-only layers

Upstream base: d05da62e9ccdf8e342b15bf6785d83224cc165af

A shared indexer buffer can be populated by indexed layers in the same model. SWA-only layers have compress_ratio == 0 and no compressed cache, so feeding that buffer to the B12X adapter incorrectly selects the indexed path and divides the page size by zero.

Keep the indexed inputs absent for SWA-only layers, matching their cache plan and upstream attention semantics. This changes no weights or arithmetic for indexed layers.

Test: targeted model-free regression in the patch-0024 immutable image (1 passed).

Upstream status: contribution candidate after cold/warm qualification.
---
 tests/models/test_deepseek_v41_b12x.py        | 39 +++++++++++++++++++
 .../deepseek_v41/nvidia/b12x_attention.py     |  5 ++-
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/tests/models/test_deepseek_v41_b12x.py b/tests/models/test_deepseek_v41_b12x.py
index d0a1882ba..0a39ad045 100644
--- a/tests/models/test_deepseek_v41_b12x.py
+++ b/tests/models/test_deepseek_v41_b12x.py
@@ -151,6 +151,45 @@ def test_flatten_cache_preserves_packed_page_storage() -> None:
         _flatten_cache(cache.to(torch.bfloat16), name="test cache")
 
 
+def test_b12x_swa_only_layer_ignores_shared_indexer_output(monkeypatch) -> None:
+    attention = object.__new__(DeepseekV41B12xAttention)
+    torch.nn.Module.__init__(attention)
+    attention.compress_ratio = 0
+    attention.topk_indices_buffer = torch.tensor([[7, 11]], dtype=torch.int32)
+    attention.prefix = "model.layers.0.attn"
+    attention.swa_cache_layer = SimpleNamespace(prefix="model.layers.0.swa")
+    attention._ensure_plans = lambda: SimpleNamespace(decode=object(), extend=object())
+
+    calls = []
+    attention._run_attention = lambda **kwargs: calls.append(kwargs)
+    swa = SimpleNamespace(
+        num_decode_tokens=1,
+        decode_swa_indices=torch.zeros((1, 1), dtype=torch.int32),
+        decode_swa_lens=torch.ones((1,), dtype=torch.int32),
+        token_to_req_indices=torch.zeros((1,), dtype=torch.int32),
+        is_valid_token=torch.ones((1,), dtype=torch.bool),
+        block_table=torch.zeros((1, 1), dtype=torch.int32),
+        num_decodes=1,
+        num_prefill_tokens=0,
+    )
+    monkeypatch.setattr(
+        b12x_attention,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata={attention.swa_cache_layer.prefix: swa}),
+    )
+
+    attention.forward_mqa(
+        torch.zeros((1, 24, 512), dtype=torch.bfloat16),
+        torch.empty(0),
+        torch.empty(0, dtype=torch.int64),
+        torch.empty((1, 24, 512), dtype=torch.bfloat16),
+    )
+
+    assert len(calls) == 1
+    assert calls[0]["indexed_indices"] is None
+    assert calls[0]["indexed_cache"] is None
+
+
 def test_disk_engram_routes_immutable_checkpoint_ranges() -> None:
     class DiskTable:
         def __init__(self) -> None:
diff --git a/vllm/models/deepseek_v41/nvidia/b12x_attention.py b/vllm/models/deepseek_v41/nvidia/b12x_attention.py
index e976fde2a..3ff78288f 100644
--- a/vllm/models/deepseek_v41/nvidia/b12x_attention.py
+++ b/vllm/models/deepseek_v41/nvidia/b12x_attention.py
@@ -594,7 +594,10 @@ class DeepseekV41B12xAttention(DeepseekV4Attention):
                 name="DeepSeek V4.1 compressed cache",
             )
         )
-        topk = self.topk_indices_buffer
+        # A mixed layer stack may populate the shared indexer output even when
+        # this particular layer is SWA-only.  Do not route those indices into
+        # an absent compressed cache (compress_ratio == 0).
+        topk = None if self.compress_ratio == 0 else self.topk_indices_buffer
         if self.compress_ratio > 0 and topk is None:
             raise RuntimeError("DeepSeek V4.1 B12X requires indexer top-k output")
         if swa.token_to_req_indices is None or swa.is_valid_token is None:

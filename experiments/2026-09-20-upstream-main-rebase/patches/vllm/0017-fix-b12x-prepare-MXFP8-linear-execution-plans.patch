+    def _preparation_request(
+        self,
+        layer: torch.nn.Module,
+        token_counts: tuple[int, ...],
+        output_dtype: torch.dtype,
+    ) -> tuple[object, tuple[int, ...]]:
+        if output_dtype != torch.bfloat16:
+            raise ValueError("b12x ModelOpt MXFP8 linear requires bfloat16 activations")
+        counts = tuple(sorted({int(count) for count in token_counts if int(count) > 0}))
+        if not counts:
+            raise ValueError("b12x MXFP8 preparation requires positive token counts")
+
+        packed_weight = layer.b12x_mxfp8_packed_weight
+        device = torch.device(packed_weight.weight.values.device)
+        plan_key = (counts, output_dtype, id(packed_weight))
+        plan = (
+            getattr(layer, "b12x_mxfp8_plan", None)
+            if getattr(layer, "b12x_mxfp8_plan_key", None) == plan_key
+            else None
+        )
+        blockscaled = _import_b12x_blockscaled()
+        assert blockscaled is not None
+        if plan is None:
+            capacity = max(counts)
+            source = torch.empty(
+                (capacity, int(packed_weight.in_features)),
+                dtype=output_dtype,
+                device=device,
+            )
+            query = blockscaled.query_from_call(
+                source,
+                packed_weight,
+                activation_mode="quantized",
+            )
+            plan = blockscaled.plan_regimes(
+                query,
+                exact_m=tuple(count for count in counts if count < capacity),
+            )
+            layer.b12x_mxfp8_plan = plan
+            layer.b12x_mxfp8_plan_key = plan_key
+
+        from b12x.preparation import PreparedCall
+
+        def prepare_call(tokens: int):
+            source = torch.zeros(
+                (tokens, int(packed_weight.in_features)),
+                dtype=output_dtype,
+                device=device,
+            )
+
+            def factory(state):
+                return PreparedCall(
+                    run=lambda: state.run(
+                        source,
+                        packed_weight.weight.values,
+                        packed_weight.weight.scale_mma,
+                        None,
+                    )
+                )
+
+            return factory
+
+        calls = {tokens: prepare_call(tokens) for tokens in plan.token_counts}
+        return (
+            plan.request(
+                name=f"mxfp8_linear:{id(layer)}",
+                prepare_calls=calls,
+                benchmark_calls=calls,
+            ),
+            counts,
+        )

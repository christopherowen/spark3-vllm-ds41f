--- /dev/null
+++ b/vllm/models/deepseek_v41/virtual_heads.py
@@ -0,0 +1,112 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Quality-preserving attention padding for DeepSeek V4.1."""
+
+import torch
+
+_E8M0 = getattr(torch, "float8_e8m0fnu", None)
+
+
+def _fill_zero_group(destination: torch.Tensor) -> None:
+    """Write the encoded zero used by a virtual output-projection group."""
+    if destination.element_size() == 1:
+        fill = 127 if _E8M0 is not None and destination.dtype == _E8M0 else 0
+        destination.view(torch.uint8).fill_(fill)
+    else:
+        destination.zero_()
+
+
+def _virtual_source(config) -> dict | None:
+    """Return the unpadded attention geometry recorded in the model config."""
+    for candidate in (config, getattr(config, "text_config", None)):
+        value = (
+            getattr(candidate, "virtual_heads_from", None)
+            if candidate is not None
+            else None
+        )
+        if value:
+            return value if isinstance(value, dict) else dict(value)
+    return None
+
+
+def _wrap_parameter(
+    parameter: torch.nn.Parameter,
+    dim: int,
+    real_groups: int,
+    padded_groups: int,
+    mode: str,
+    tp_rank: int,
+    tp_size: int,
+) -> bool:
+    """Replace one loader with a group-aware TP loader."""
+    original = getattr(parameter, "weight_loader", None)
+    if original is None:
+        return False
+
+    if padded_groups % tp_size:
+        raise ValueError("virtual attention groups must divide tensor parallel size")
+
+    def loader(param, loaded_weight, *args, **kwargs):
+        if loaded_weight.ndim <= dim or loaded_weight.shape[dim] % real_groups:
+            return original(param, loaded_weight, *args, **kwargs)
+
+        group_width = loaded_weight.shape[dim] // real_groups
+        local_groups = padded_groups // tp_size
+        if param.data.shape[dim] != local_groups * group_width:
+            return original(param, loaded_weight, *args, **kwargs)
+
+        first_group = tp_rank * local_groups
+        virtual_count = padded_groups - real_groups
+        for local_group in range(local_groups):
+            global_group = first_group + local_group
+            destination = param.data.narrow(dim, local_group * group_width, group_width)
+            if global_group < real_groups:
+                source_group = global_group
+            elif mode == "duplicate":
+                source_group = global_group - virtual_count
+            elif mode == "zero":
+                _fill_zero_group(destination)
+                continue
+            else:
+                raise ValueError(f"unknown virtual-head padding mode {mode!r}")
+            source = loaded_weight.narrow(dim, source_group * group_width, group_width)
+            destination.copy_(source)
+
+    try:
+        parameter.weight_loader = loader
+    except AttributeError:
+        parameter._weight_loader = loader
+    return True
+
+
+def wrap_attention(attention, tp_size: int, config) -> int:
+    """Pad virtual attention groups before standard TP loaders shard weights."""
+    source = _virtual_source(config)
+    if tp_size <= 1 or not source:
+        return 0
+    real_groups = int(source["o_groups"])
+    padded_groups = int(attention.n_groups)
+    if padded_groups <= real_groups:
+        return 0
+
+    wrapped = 0
+    specifications = (
+        (attention.wq_b, "output_dim", "duplicate"),
+        (attention.wo_a, "output_dim", "duplicate"),
+        (attention.wo_b, "input_dim", "zero"),
+    )
+    for linear, attribute, mode in specifications:
+        for parameter in linear.parameters(recurse=False):
+            dim = getattr(parameter, attribute, None)
+            if dim is None:
+                dim = 0 if attribute == "output_dim" else 1
+            wrapped += _wrap_parameter(
+                parameter,
+                dim,
+                real_groups,
+                padded_groups,
+                mode,
+                linear.tp_rank,
+                tp_size,
+            )
+    return wrapped

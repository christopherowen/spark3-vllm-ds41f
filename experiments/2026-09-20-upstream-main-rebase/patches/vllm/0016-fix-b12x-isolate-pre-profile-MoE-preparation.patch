--- a/vllm/utils/b12x.py
+++ b/vllm/utils/b12x.py
@@ -17,7 +17,6 @@ class B12xWarmupUnit:
     name: str
     key: Hashable
     compile: Callable[[], None]
-    pre_profile: bool = False
 
 
 _HAS_B12X = importlib.util.find_spec("b12x") is not None

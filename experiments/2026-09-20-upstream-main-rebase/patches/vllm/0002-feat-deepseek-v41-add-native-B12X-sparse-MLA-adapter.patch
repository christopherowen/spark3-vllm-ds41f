+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import vllm.models.deepseek_v41.nvidia.b12x_attention as b12x_attention
+import vllm.models.deepseek_v41.nvidia.model as nvidia_model
+from vllm.models.deepseek_v41.attention import _use_v41_mxfp8_kv_record
+from vllm.models.deepseek_v41.nvidia.b12x_attention import (
+    DeepseekV41B12xAttention,
+    DeepseekV41B12xBackend,
+    _flatten_cache,
+)
+from vllm.platforms.interface import DeviceCapability
+from vllm.v1.attention.backends.registry import AttentionBackendEnum
+
+
+def _combination_kwargs() -> dict[str, object]:
+    return {
+        "head_size": 512,
+        "dtype": torch.bfloat16,
+        "kv_cache_dtype": "nvfp4_ds_mla",
+        "block_size": 64,
+        "use_mla": True,
+        "has_sink": True,
+        "use_sparse": True,
+        "use_mm_prefix": False,
+        "device_capability": DeviceCapability(12, 1),
+    }
+
+
+def test_b12x_backend_requires_current_prepared_api(monkeypatch) -> None:
+    monkeypatch.setattr(b12x_attention, "get_b12x_compressed_sparse_mla", lambda: None)
+    assert "current B12X source tree" in (
+        DeepseekV41B12xBackend.supports_combination(**_combination_kwargs()) or ""
+    )
+
+    legacy = SimpleNamespace(is_supported=lambda: True)
+    monkeypatch.setattr(
+        b12x_attention, "get_b12x_compressed_sparse_mla", lambda: legacy
+    )
+    assert "prepared-plan API" in (
+        DeepseekV41B12xBackend.supports_combination(**_combination_kwargs()) or ""
+    )
+
+    current = SimpleNamespace(
+        invocation_from_descriptors=lambda **kwargs: kwargs,
+        is_supported=lambda: True,
+    )
+    monkeypatch.setattr(
+        b12x_attention, "get_b12x_compressed_sparse_mla", lambda: current
+    )
+    assert DeepseekV41B12xBackend.supports_combination(**_combination_kwargs()) is None
+
+
+def test_b12x_backend_rejects_wrong_architecture_and_activation_dtype(
+    monkeypatch,
+) -> None:
+    module = SimpleNamespace(
+        invocation_from_descriptors=lambda **kwargs: kwargs,
+        is_supported=lambda: True,
+    )
+    monkeypatch.setattr(
+        b12x_attention, "get_b12x_compressed_sparse_mla", lambda: module
+    )
+    kwargs = _combination_kwargs()
+    kwargs["device_capability"] = DeviceCapability(10, 0)
+    assert "SM120 or SM121" in (
+        DeepseekV41B12xBackend.supports_combination(**kwargs) or ""
+    )
+    kwargs["device_capability"] = DeviceCapability(12, 1)
+    kwargs["dtype"] = torch.float16
+    assert "bfloat16" in (DeepseekV41B12xBackend.supports_combination(**kwargs) or "")
+
+
+def test_b12x_selection_is_explicit_and_does_not_fall_back(monkeypatch) -> None:
+    config = SimpleNamespace(
+        attention_config=SimpleNamespace(backend=AttentionBackendEnum.B12X)
+    )
+    monkeypatch.setattr(
+        nvidia_model.current_platform,
+        "get_device_capability",
+        lambda: DeviceCapability(12, 1),
+    )
+    assert nvidia_model._select_dsv4_attn_cls(config) is DeepseekV41B12xAttention
+
+    monkeypatch.setattr(
+        nvidia_model.current_platform,
+        "get_device_capability",
+        lambda: DeviceCapability(10, 0),
+    )
+    with pytest.raises(ValueError, match="SM120/SM121"):
+        nvidia_model._select_dsv4_attn_cls(config)
+
+
+def test_b12x_uses_native_tp3_heads_and_v41_cache_abi() -> None:
+    attention = object.__new__(DeepseekV41B12xAttention)
+    assert attention.get_padded_num_q_heads(24) == 24
+    assert attention.packed_kv_cache_dtype == "nvfp4_ds_mla"
+    assert attention.uses_v41_mxfp8_kv_record
+    assert _use_v41_mxfp8_kv_record("nvfp4_ds_mla")
+
+
+def test_flatten_cache_preserves_packed_page_storage() -> None:
+    cache = torch.empty((3, 64, 528), dtype=torch.uint8)
+    flattened = _flatten_cache(cache, name="test cache")
+    assert flattened.shape == (3, 64 * 528)
+    assert flattened.data_ptr() == cache.data_ptr()
+
+    with pytest.raises(TypeError, match="uint8 packed storage"):
+        _flatten_cache(cache.to(torch.bfloat16), name="test cache")

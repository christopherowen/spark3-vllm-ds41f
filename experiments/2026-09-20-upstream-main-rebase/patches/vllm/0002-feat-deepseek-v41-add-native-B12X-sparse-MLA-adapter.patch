diff --git a/vllm/models/deepseek_v41/nvidia/b12x_attention.py b/vllm/models/deepseek_v41/nvidia/b12x_attention.py
new file mode 100644
index 0000000000..9ad8271298
--- /dev/null
+++ b/vllm/models/deepseek_v41/nvidia/b12x_attention.py
@@ -0,0 +1,638 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek V4.1 sparse attention through current B12X prepared plans.
+
+This adapter deliberately keeps the upstream V4.1 model, compressor, indexer,
+cache allocator, and output projection.  B12X owns only the sparse attention
+kernel and its caller-owned scratch.  That boundary makes the integration
+small enough to upstream and prevents an explicit ``B12X`` selection from
+silently running the FlashInfer implementation.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, ClassVar, cast
+
+import torch
+
+from vllm.config import VllmConfig
+from vllm.config.cache import CacheDType
+from vllm.forward_context import get_forward_context
+from vllm.models.deepseek_v4.nvidia.ops.o_proj import (
+    compute_fp8_einsum_recipe,
+    deep_gemm_fp8_o_proj,
+)
+from vllm.models.deepseek_v41.attention import DeepseekV4Attention
+from vllm.models.deepseek_v41.common.ops import (
+    compute_global_topk_indices_and_lens,
+)
+from vllm.models.deepseek_v41.sparse_mla import (
+    DeepseekV4SparseMLABackend,
+    DeepseekV4SparseMLAMetadataBuilder,
+    DeepseekV41SparseSWAMetadataBuilder,
+)
+from vllm.platforms.interface import DeviceCapability
+from vllm.utils.b12x import B12xWarmupUnit, get_b12x_compressed_sparse_mla
+from vllm.utils.math_utils import cdiv
+from vllm.v1.attention.backend import AttentionCGSupport, MultipleOf
+from vllm.v1.attention.backends.mla.compressor_utils import (
+    get_dspark_swa_index_width,
+)
+from vllm.v1.attention.backends.mla.sparse_swa import DeepseekSparseSWABackend
+from vllm.v1.worker.workspace import current_workspace_manager
+
+if TYPE_CHECKING:
+    from vllm.v1.attention.backends.mla.sparse_swa import DeepseekSparseSWAMetadata
+
+
+class DeepseekV41B12xSparseMLAMetadataBuilder(DeepseekV4SparseMLAMetadataBuilder):
+    _cudagraph_support: ClassVar[AttentionCGSupport] = AttentionCGSupport.ALWAYS
+
+
+class DeepseekV41B12xBackend(DeepseekV4SparseMLABackend):
+    """Metadata/cache contract for B12X's native V4.1 attention kernel."""
+
+    supported_kv_cache_dtypes: ClassVar[list[CacheDType]] = [
+        "auto",
+        "fp8",
+        "nvfp4_ds_mla",
+    ]
+
+    @staticmethod
+    def get_name() -> str:
+        return "B12X_DSV41"
+
+    @staticmethod
+    def get_builder_cls() -> type[DeepseekV41B12xSparseMLAMetadataBuilder]:
+        return DeepseekV41B12xSparseMLAMetadataBuilder
+
+    @staticmethod
+    def get_supported_kernel_block_sizes() -> list[int | MultipleOf]:
+        return [MultipleOf(32)]
+
+    @classmethod
+    def supports_compute_capability(cls, capability: DeviceCapability) -> bool:
+        return capability.major == 12
+
+    @classmethod
+    def supports_combination(
+        cls,
+        head_size: int,
+        dtype: torch.dtype,
+        kv_cache_dtype: CacheDType | None,
+        block_size: int | None,
+        use_mla: bool,
+        has_sink: bool,
+        use_sparse: bool,
+        use_mm_prefix: bool,
+        device_capability: DeviceCapability,
+    ) -> str | None:
+        if device_capability.major != 12:
+            return "B12X_DSV41 requires SM120 or SM121"
+        if dtype != torch.bfloat16:
+            return "B12X_DSV41 requires bfloat16 activations"
+        if kv_cache_dtype not in (None, "auto", "fp8", "nvfp4_ds_mla"):
+            return "B12X_DSV41 requires the V4.1 MXFP8/NVFP4 cache"
+        module = get_b12x_compressed_sparse_mla()
+        if module is None:
+            return "Install the current B12X source tree"
+        if not callable(getattr(module, "invocation_from_descriptors", None)):
+            return "B12X_DSV41 requires B12X's prepared-plan API"
+        if not module.is_supported():
+            return "B12X compressed sparse MLA is not supported on this device"
+        return None
+
+
+class DeepseekV41B12xSWAMetadataBuilder(DeepseekV41SparseSWAMetadataBuilder):
+    _cudagraph_support: ClassVar[AttentionCGSupport] = AttentionCGSupport.ALWAYS
+
+
+class DeepseekV41B12xSWABackend(DeepseekSparseSWABackend):
+    @staticmethod
+    def get_name() -> str:
+        return "B12X_DSV41_SWA"
+
+    @staticmethod
+    def get_builder_cls() -> type[DeepseekV41B12xSWAMetadataBuilder]:
+        return DeepseekV41B12xSWAMetadataBuilder
+
+
+@dataclass(frozen=True)
+class _PlanSet:
+    decode: Any
+    extend: Any
+    decode_rows: int
+    extend_rows: int
+    decode_swa_width: int
+    extend_swa_width: int
+    indexed_width: int
+
+
+_PLAN_CACHE: dict[tuple[Any, ...], Any] = {}
+
+
+def _alignment(tensor: torch.Tensor) -> int:
+    pointer = tensor.data_ptr()
+    return min(16, pointer & -pointer) if pointer else 16
+
+
+def _descriptor(tensor: torch.Tensor) -> dict[str, object]:
+    return {
+        "shape": tuple(int(value) for value in tensor.shape),
+        "stride": tuple(int(value) for value in tensor.stride()),
+        "alignment": _alignment(tensor),
+        "dtype": str(tensor.dtype).removeprefix("torch."),
+    }
+
+
+def _flatten_cache(cache: torch.Tensor, *, name: str) -> torch.Tensor:
+    if cache.dtype != torch.uint8:
+        raise TypeError(f"{name} must use uint8 packed storage, got {cache.dtype}")
+    if cache.ndim < 2:
+        raise ValueError(f"{name} must have a page dimension")
+    return cache.view(cache.shape[0], -1)
+
+
+class DeepseekV41B12xAttention(DeepseekV4Attention):
+    """Upstream V4.1 semantics with B12X's SM12x sparse-attention kernel."""
+
+    backend_cls = DeepseekV41B12xBackend
+    swa_backend_cls = DeepseekV41B12xSWABackend
+    use_fp8_ds_mla_layout: ClassVar[bool] = True
+
+    @property
+    def packed_kv_cache_dtype(self) -> CacheDType:
+        # B12X's V4.1 ABI stores 528-byte MXFP8 SWA rows and 288-byte NVFP4
+        # compressed rows.  This changes cache representation, not checkpoint
+        # weights or model arithmetic.
+        return "nvfp4_ds_mla"
+
+    @property
+    def uses_v41_mxfp8_kv_record(self) -> bool:
+        return True
+
+    @classmethod
+    def get_padded_num_q_heads(cls, num_heads: int) -> int:
+        # Current B12X has native 24-head TP3 partitions; no virtual compute
+        # heads are needed at the kernel boundary.
+        return num_heads
+
+    def __init__(self, vllm_config: VllmConfig, *args, **kwargs) -> None:
+        self._vllm_config = vllm_config
+        super().__init__(vllm_config, *args, **kwargs)
+        if self.kv_cache_dtype != "nvfp4_ds_mla":
+            raise ValueError(
+                "DeepSeek V4.1 B12X requires --kv-cache-dtype auto, fp8, or "
+                "nvfp4_ds_mla so its MXFP8/NVFP4 cache ABI is unambiguous."
+            )
+        self._b12x = get_b12x_compressed_sparse_mla()
+        if self._b12x is None or not callable(
+            getattr(self._b12x, "invocation_from_descriptors", None)
+        ):
+            raise RuntimeError(
+                "DeepSeek V4.1 B12X requires the current prepared-plan API; "
+                "the published legacy B12X 1.3 interface is not sufficient."
+            )
+        self._plans: _PlanSet | None = None
+        self._einsum_recipe, self._tma_aligned_scales = compute_fp8_einsum_recipe(
+            self._o_proj_block_size
+        )
+        # The generic warmup driver calls this provider after KV caches bind and
+        # before CUDA graph capture.
+        self.b12x_warmup_provider = self
+
+    def _o_proj(self, attn_out: torch.Tensor, positions: torch.Tensor) -> torch.Tensor:
+        return deep_gemm_fp8_o_proj(
+            attn_out[:, : self.n_local_heads, :],
+            positions,
+            self.rotary_emb.cos_sin_cache,
+            self.wo_a,
+            self.wo_b,
+            n_groups=self.n_local_groups,
+            heads_per_group=self.n_local_heads // self.n_local_groups,
+            nope_dim=self.nope_head_dim,
+            rope_dim=self.rope_head_dim,
+            o_lora_rank=self.o_lora_rank,
+            einsum_recipe=self._einsum_recipe,
+            tma_aligned_scales=self._tma_aligned_scales,
+        )
+
+    def _plan(
+        self,
+        *,
+        mode: str,
+        rows: int,
+        swa_width: int,
+        swa_cache: torch.Tensor,
+        indexed_cache: torch.Tensor | None,
+        indexed_width: int,
+        indexed_page_size: int,
+    ) -> Any:
+        mla = self._b12x
+        assert mla is not None
+        swa_page_size = self.swa_cache_layer.block_size
+        max_page_table_width = max(
+            1,
+            cdiv(
+                self.max_model_len,
+                self._vllm_config.cache_config.block_size,
+            ),
+        )
+        cache_key = (
+            str(swa_cache.device),
+            mode,
+            rows,
+            self.n_local_heads,
+            swa_width,
+            indexed_width,
+            swa_page_size,
+            indexed_page_size,
+            max_page_table_width,
+            tuple(_descriptor(swa_cache).items()),
+            None
+            if indexed_cache is None
+            else tuple(_descriptor(indexed_cache).items()),
+        )
+        plan = _PLAN_CACHE.get(cache_key)
+        if plan is not None:
+            return plan
+        q_descriptor = {
+            "shape": (rows, self.n_local_heads, self.head_dim),
+            "stride": (self.n_local_heads * self.head_dim, self.head_dim, 1),
+            "alignment": 16,
+            "dtype": "bfloat16",
+        }
+        invocation = mla.invocation_from_descriptors(
+            q=q_descriptor,
+            swa_cache=_descriptor(swa_cache),
+            indexed_cache=(
+                None if indexed_cache is None else _descriptor(indexed_cache)
+            ),
+            attn_sink_present=True,
+            output_mode="provided",
+        )
+        plan = mla.plan(
+            mla.Caps(
+                device=swa_cache.device,
+                num_q_heads=self.n_local_heads,
+                max_q_rows=rows,
+                max_width=swa_width + indexed_width,
+                max_batch=self._vllm_config.scheduler_config.max_num_seqs,
+                max_page_table_width=max_page_table_width,
+                swa_width=swa_width,
+                indexed_width=indexed_width,
+                swa_page_size=swa_page_size,
+                indexed_page_size=indexed_page_size,
+                cache_format="deepseek_v41",
+                mode=mode,
+                decode_row_capacity=rows if mode == "decode" else None,
+                use_cuda_graph=True,
+            ),
+            invocation=invocation,
+        )
+        _PLAN_CACHE[cache_key] = plan
+        return plan
+
+    def _ensure_plans(self) -> _PlanSet:
+        if self._plans is not None:
+            return self._plans
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                "DeepSeek V4.1 B12X plans must be declared before CUDA graph capture"
+            )
+        swa_cache = _flatten_cache(
+            self.swa_cache_layer.kv_cache, name="DeepSeek V4.1 SWA cache"
+        )
+        indexed_cache = (
+            None
+            if self.compress_ratio == 0
+            else _flatten_cache(
+                self._compressed_kv_cache(),
+                name="DeepSeek V4.1 compressed cache",
+            )
+        )
+        spec_config = self._vllm_config.speculative_config
+        speculative_tokens = (
+            0 if spec_config is None else int(spec_config.num_speculative_tokens)
+        )
+        spec_multiplier = (
+            2 if spec_config is not None and spec_config.parallel_drafting else 1
+        )
+        decode_query_len = 1 + spec_multiplier * speculative_tokens
+        decode_rows = max(
+            1,
+            self._vllm_config.scheduler_config.max_num_seqs * decode_query_len,
+            int(self._vllm_config.compilation_config.max_cudagraph_capture_size or 0),
+        )
+        extend_rows = self.max_num_batched_tokens
+        decode_swa_width = (
+            get_dspark_swa_index_width(self.window_size, speculative_tokens)
+            if self._vllm_config.attention_config.use_non_causal
+            else self.window_size
+        )
+        extend_swa_width = self.window_size
+        indexed_width = (
+            0
+            if self.compress_ratio == 0
+            else int(self._vllm_config.model_config.hf_config.index_topk)
+        )
+        indexed_page_size = max(
+            1,
+            self._vllm_config.cache_config.block_size // max(self.compress_ratio, 1),
+        )
+        decode = self._plan(
+            mode="decode",
+            rows=decode_rows,
+            swa_width=decode_swa_width,
+            swa_cache=swa_cache,
+            indexed_cache=indexed_cache,
+            indexed_width=indexed_width,
+            indexed_page_size=indexed_page_size,
+        )
+        extend = self._plan(
+            mode="extend",
+            rows=extend_rows,
+            swa_width=extend_swa_width,
+            swa_cache=swa_cache,
+            indexed_cache=indexed_cache,
+            indexed_width=indexed_width,
+            indexed_page_size=indexed_page_size,
+        )
+        self._plans = _PlanSet(
+            decode=decode,
+            extend=extend,
+            decode_rows=decode_rows,
+            extend_rows=extend_rows,
+            decode_swa_width=decode_swa_width,
+            extend_swa_width=extend_swa_width,
+            indexed_width=indexed_width,
+        )
+        for plan in (decode, extend):
+            requests = [
+                (tuple(spec.shape), spec.dtype) for spec in plan.scratch_specs()
+            ]
+            if indexed_width:
+                requests.extend(
+                    [
+                        ((plan.query.query_rows, indexed_width), torch.int32),
+                        ((plan.query.query_rows,), torch.int32),
+                    ]
+                )
+            current_workspace_manager().get_simultaneous(*requests)
+        return self._plans
+
+    def get_b12x_warmup_unit(
+        self,
+        layer: object,
+        token_counts: tuple[int, ...],
+        output_dtype: torch.dtype,
+    ) -> B12xWarmupUnit:
+        del token_counts, output_dtype
+        if layer is not self:
+            raise ValueError("DeepSeek V4.1 B12X warmup owner mismatch")
+        plans = self._ensure_plans()
+        key = (
+            "DSV41_MLA",
+            plans.decode,
+            plans.extend,
+        )
+        return B12xWarmupUnit(
+            name="DeepSeek V4.1 sparse MLA",
+            key=key,
+            compile=self._prepare_plans,
+        )
+
+    def _prepare_plans(self) -> None:
+        from b12x.preparation import PreparedCall, prepare_default
+
+        plans = self._ensure_plans()
+        mla = self._b12x
+        assert mla is not None
+        swa_cache = _flatten_cache(
+            self.swa_cache_layer.kv_cache, name="DeepSeek V4.1 SWA cache"
+        )
+        indexed_cache = (
+            None
+            if self.compress_ratio == 0
+            else _flatten_cache(
+                self._compressed_kv_cache(),
+                name="DeepSeek V4.1 compressed cache",
+            )
+        )
+
+        for mode, plan, swa_width in (
+            ("decode", plans.decode, plans.decode_swa_width),
+            ("extend", plans.extend, plans.extend_swa_width),
+        ):
+            if plan.prepared is not None:
+                continue
+
+            def prepare(state, *, plan=plan, swa_width=swa_width):
+                device = swa_cache.device
+                q = torch.zeros(
+                    (1, self.n_local_heads, self.head_dim),
+                    dtype=torch.bfloat16,
+                    device=device,
+                )
+                out = torch.empty_like(q)
+                swa_indices = torch.full(
+                    (1, swa_width), -1, dtype=torch.int32, device=device
+                )
+                swa_lengths = torch.zeros(1, dtype=torch.int32, device=device)
+                kwargs: dict[str, torch.Tensor] = {}
+                if plans.indexed_width:
+                    kwargs = {
+                        "indexed_indices": torch.full(
+                            (1, plans.indexed_width),
+                            -1,
+                            dtype=torch.int32,
+                            device=device,
+                        ),
+                        "indexed_lengths": torch.zeros(
+                            1, dtype=torch.int32, device=device
+                        ),
+                    }
+                scratch = [
+                    torch.empty(spec.shape, dtype=spec.dtype, device=device)
+                    for spec in state.scratch_specs()
+                ]
+                binding = state.bind_for_preparation(
+                    scratch=scratch,
+                    q=q,
+                    swa_indices=swa_indices,
+                    swa_lengths=swa_lengths,
+                    **kwargs,
+                )
+                return PreparedCall(
+                    run=lambda: state.run(
+                        binding,
+                        swa_k_cache=swa_cache,
+                        swa_page_size=self.swa_cache_layer.block_size,
+                        indexed_k_cache=indexed_cache,
+                        indexed_page_size=(
+                            self._vllm_config.cache_config.block_size
+                            // max(self.compress_ratio, 1)
+                        ),
+                        sm_scale=self.scale,
+                        attn_sink=self.attn_sink,
+                        out=out,
+                    ),
+                    output=out,
+                    owners=(*scratch, binding),
+                )
+
+            prepare_default(
+                plan.request(
+                    name=f"{self.prefix}.b12x_mla.{mode}",
+                    prepare_call=prepare,
+                )
+            )
+
+    def _run_attention(
+        self,
+        *,
+        plan: Any,
+        q: torch.Tensor,
+        output: torch.Tensor,
+        swa_indices: torch.Tensor,
+        swa_lengths: torch.Tensor,
+        token_to_req_indices: torch.Tensor,
+        is_valid_token: torch.Tensor,
+        block_table: torch.Tensor,
+        indexed_indices: torch.Tensor | None,
+        indexed_cache: torch.Tensor | None,
+    ) -> None:
+        mla = self._b12x
+        assert mla is not None
+        requests = [(tuple(spec.shape), spec.dtype) for spec in plan.scratch_specs()]
+        if indexed_indices is not None:
+            requests = [
+                (tuple(indexed_indices.shape), torch.int32),
+                ((indexed_indices.shape[0],), torch.int32),
+                *requests,
+            ]
+        workspace = current_workspace_manager().get_simultaneous(*requests)
+        offset = 0
+        bind_kwargs: dict[str, torch.Tensor] = {}
+        if indexed_indices is not None:
+            physical_indices = workspace[0]
+            indexed_lengths = workspace[1]
+            compute_global_topk_indices_and_lens(
+                indexed_indices,
+                token_to_req_indices,
+                block_table,
+                self._vllm_config.cache_config.block_size // self.compress_ratio,
+                is_valid_token,
+                out=(physical_indices, indexed_lengths),
+            )
+            bind_kwargs = {
+                "indexed_indices": physical_indices,
+                "indexed_lengths": indexed_lengths,
+            }
+            offset = 2
+        scratch = workspace[offset:]
+        binding = mla.bind(
+            plan,
+            scratch=scratch,
+            q=q,
+            swa_indices=swa_indices,
+            swa_lengths=swa_lengths,
+            **bind_kwargs,
+        )
+        mla.run(
+            binding=binding,
+            swa_k_cache=_flatten_cache(
+                self.swa_cache_layer.kv_cache,
+                name="DeepSeek V4.1 SWA cache",
+            ),
+            swa_page_size=self.swa_cache_layer.block_size,
+            indexed_k_cache=indexed_cache,
+            indexed_page_size=(
+                None
+                if indexed_cache is None
+                else self._vllm_config.cache_config.block_size // self.compress_ratio
+            ),
+            sm_scale=self.scale,
+            attn_sink=self.attn_sink,
+            out=output,
+        )
+
+    def forward_mqa(
+        self,
+        q: torch.Tensor,
+        kv: torch.Tensor,
+        positions: torch.Tensor,
+        output: torch.Tensor,
+    ) -> None:
+        del kv, positions
+        context = get_forward_context()
+        if context.attn_metadata is None:
+            output.zero_()
+            return
+        if q.dtype != torch.bfloat16 or output.dtype != torch.bfloat16:
+            raise TypeError("DeepSeek V4.1 B12X attention requires bfloat16 Q/output")
+        if not q.is_contiguous() or not output.is_contiguous():
+            raise ValueError("DeepSeek V4.1 B12X requires contiguous Q/output")
+        metadata = context.attn_metadata
+        if not isinstance(metadata, dict):
+            output.zero_()
+            return
+        swa = cast(
+            "DeepseekSparseSWAMetadata | None",
+            metadata.get(self.swa_cache_layer.prefix),
+        )
+        if swa is None:
+            raise RuntimeError("DeepSeek V4.1 B12X SWA metadata is missing")
+        plans = self._ensure_plans()
+        indexed_cache = (
+            None
+            if self.compress_ratio == 0
+            else _flatten_cache(
+                self._compressed_kv_cache(),
+                name="DeepSeek V4.1 compressed cache",
+            )
+        )
+        topk = self.topk_indices_buffer
+        if self.compress_ratio > 0 and topk is None:
+            raise RuntimeError("DeepSeek V4.1 B12X requires indexer top-k output")
+        if swa.token_to_req_indices is None or swa.is_valid_token is None:
+            raise RuntimeError("DeepSeek V4.1 B12X token metadata is incomplete")
+
+        decode_tokens = swa.num_decode_tokens
+        if decode_tokens:
+            if swa.decode_swa_indices is None or swa.decode_swa_lens is None:
+                raise RuntimeError("DeepSeek V4.1 B12X decode metadata is incomplete")
+            self._run_attention(
+                plan=plans.decode,
+                q=q[:decode_tokens],
+                output=output[:decode_tokens],
+                swa_indices=swa.decode_swa_indices,
+                swa_lengths=swa.decode_swa_lens,
+                token_to_req_indices=swa.token_to_req_indices[:decode_tokens],
+                is_valid_token=swa.is_valid_token[:decode_tokens],
+                block_table=swa.block_table[: swa.num_decodes],
+                indexed_indices=(None if topk is None else topk[:decode_tokens]),
+                indexed_cache=indexed_cache,
+            )
+
+        prefill_tokens = swa.num_prefill_tokens
+        if prefill_tokens:
+            if swa.prefill_swa_indices is None or swa.prefill_swa_lens is None:
+                raise RuntimeError("DeepSeek V4.1 B12X prefill metadata is incomplete")
+            token_slice = slice(decode_tokens, decode_tokens + prefill_tokens)
+            self._run_attention(
+                plan=plans.extend,
+                q=q[token_slice],
+                output=output[token_slice],
+                swa_indices=swa.prefill_swa_indices,
+                swa_lengths=swa.prefill_swa_lens,
+                token_to_req_indices=swa.token_to_req_indices[token_slice],
+                is_valid_token=swa.is_valid_token[token_slice],
+                block_table=swa.block_table,
+                indexed_indices=(None if topk is None else topk[token_slice]),
+                indexed_cache=indexed_cache,
+            )
+
+
+__all__ = ["DeepseekV41B12xAttention", "DeepseekV41B12xBackend"]

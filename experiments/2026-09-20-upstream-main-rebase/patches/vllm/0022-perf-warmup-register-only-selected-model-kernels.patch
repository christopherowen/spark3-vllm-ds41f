+def test_b12x_attention_warmup_uses_bound_page_size(monkeypatch) -> None:
+    impl = object.__new__(B12xPagedAttentionImpl)
+    impl.num_heads = 8
+    impl.num_kv_heads = 2
+    impl.head_size = 128
+    impl.output_head_size = 128
+    impl.window_left = -1
+    impl.sinks = None
+    impl.dtype = torch.bfloat16
+    impl.kv_cache_dtype = "auto"
+    impl.kv_torch_dtype = torch.bfloat16
+    impl.device = torch.device("cpu")
+    compiled = []
+    monkeypatch.setattr(
+        impl,
+        "_compile_paged_extend_entry",
+        lambda page_size: compiled.append(page_size),
+    )
+    layer = SimpleNamespace(
+        kv_cache=torch.empty((3, 2, 64, 2 * 128), dtype=torch.bfloat16)
+    )
+
+    unit = impl.get_b12x_warmup_unit(layer, (1, 8), torch.bfloat16)
+    unit.compile()
+
+    assert unit.name == "paged attention"
+    assert unit.key[-1] == 64
+    assert compiled == [64]
+

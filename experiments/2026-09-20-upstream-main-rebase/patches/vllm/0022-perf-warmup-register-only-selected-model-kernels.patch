+def test_flashinfer_autotune_is_registered_by_selected_linear_backend():
+    from vllm.model_executor.kernels import linear
+
+    registry = JitWarmupRegistry(SimpleNamespace())
+    with registry.activate():
+        linear._register_linear_warmup_features(linear.B12xMxfp8LinearKernel)
+    assert not registry.has_feature(FLASHINFER_AUTOTUNE_FEATURE)
+
+    with registry.activate():
+        linear._register_linear_warmup_features(
+            linear.FlashInferCutedslMxfp8LinearKernel
+        )
+    assert registry.has_feature(FLASHINFER_AUTOTUNE_FEATURE)
+
+
+def test_flashinfer_autotune_is_registered_by_selected_moe_backend():
+    from vllm.model_executor.layers.fused_moe.modular_kernel import FusedMoEExperts
+
+    registry = JitWarmupRegistry(SimpleNamespace())
+    non_flashinfer = SimpleNamespace(requires_flashinfer_autotune=False)
+    flashinfer = SimpleNamespace(requires_flashinfer_autotune=True)
+
+    with registry.activate():
+        FusedMoEExperts._register_warmup_features(non_flashinfer)
+    assert not registry.has_feature(FLASHINFER_AUTOTUNE_FEATURE)
+
+    with registry.activate():
+        FusedMoEExperts._register_warmup_features(flashinfer)
+    assert registry.has_feature(FLASHINFER_AUTOTUNE_FEATURE)
+
+

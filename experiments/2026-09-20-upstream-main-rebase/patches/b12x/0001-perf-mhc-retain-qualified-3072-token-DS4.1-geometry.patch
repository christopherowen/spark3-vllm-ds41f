From 348145ea8b6adaea7c32b1b87898ff59b5d43380 Mon Sep 17 00:00:00 2001
From: Christopher Owen <root@your.mom>
Date: Sun, 20 Sep 2026 14:32:40 +0200
Subject: [PATCH 1/3] perf(mhc): retain qualified 3072-token DS4.1 geometry

Carry the measured 3072-token DS4.1 prefill selection through the new preparation/tuning architecture and cover it beside the 4096-token policy.

Assisted-by: OpenAI Codex <noreply@openai.com>
---
 b12x/norm/mhc/_tuning.py                    |  2 +-
 tests/preparation/test_tuning_predicates.py | 28 +++++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/b12x/norm/mhc/_tuning.py b/b12x/norm/mhc/_tuning.py
index c184a60f..bc64bf3a 100644
--- a/b12x/norm/mhc/_tuning.py
+++ b/b12x/norm/mhc/_tuning.py
@@ -123,7 +123,7 @@ def _projection_default_config(
     if hidden_size == 5_120 and tokens == 128:
         return _tf32_config(backend=backend, tile_m=32, tile_n=8, tile_k=256,
                             num_stages=1, num_m_warps=2, num_n_warps=1, k_splits=8)
-    if hidden_size == 5_120 and tokens == 4_096:
+    if hidden_size == 5_120 and tokens in (3_072, 4_096):
         return _tf32_config(backend=backend, tile_m=64, tile_n=24, tile_k=64,
                             num_stages=2, num_m_warps=4, num_n_warps=1, k_splits=4)
     if hidden_size == 4_096 and tokens >= 8_192:
diff --git a/tests/preparation/test_tuning_predicates.py b/tests/preparation/test_tuning_predicates.py
index f71b191d..0572573d 100644
--- a/tests/preparation/test_tuning_predicates.py
+++ b/tests/preparation/test_tuning_predicates.py
@@ -334,6 +334,34 @@ def test_mhc_predicates_remove_inactive_work_without_rejecting_useful_tails():
         )
 
 
+@pytest.mark.parametrize("tokens", [3072, 4096])
+def test_mhc_ds41_prefill_capacities_share_qualified_geometry(tokens):
+    from b12x.norm.mhc import _tuning as component
+
+    query = component.MhcQuery(
+        dtype="bfloat16",
+        max_tokens=tokens,
+        hidden_size=5120,
+        split_k=80,
+        operation="post_pre",
+        has_norm_weight=True,
+        norm_eps=1e-6,
+    )
+
+    config = component._projection_default_config(query, None)
+
+    assert config == component.MhcConfig(
+        backend="tf32_tma",
+        projection_tile_m=64,
+        projection_tile_n=24,
+        projection_tile_k=64,
+        projection_num_stages=2,
+        projection_num_m_warps=4,
+        projection_num_n_warps=1,
+        projection_k_splits=4,
+    )
+
+
 @pytest.mark.parametrize("tile_k", [8, 16])
 @pytest.mark.parametrize("operation", ["pre", "post_pre"])
 def test_mhc_tf32_rejects_short_weight_rows(tile_k, operation):

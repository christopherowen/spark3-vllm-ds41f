#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
experiment_root="$repo_root/experiments/2026-09-20-upstream-main-rebase"
destination_root=${1:-"$repo_root/.work/experiments/2026-09-20-upstream-main-rebase"}
temporary=

cleanup() {
  if [ -n "$temporary" ]; then
    rm -rf -- "$temporary"
  fi
}
trap cleanup EXIT HUP INT TERM

prepare() {
  name=$1
  upstream=$2
  base=$3
  expected_tree=$4
  shift 4

  destination="$destination_root/$name"
  if [ -e "$destination" ]; then
    echo "refusing to replace existing candidate: $destination" >&2
    exit 1
  fi

  mkdir -p "$destination_root"
  temporary=$(mktemp -d "$destination_root/.${name}.XXXXXX")
  git -C "$temporary" init --quiet
  git -C "$temporary" remote add upstream "$upstream"
  git -C "$temporary" fetch --quiet --filter=blob:none --no-tags upstream "$base"
  git -C "$temporary" switch --quiet --create spark3/ds41f-tp3 FETCH_HEAD

  for patch in "$@"; do
    git -C "$temporary" am --quiet "$experiment_root/$patch"
  done

  actual_tree=$(git -C "$temporary" rev-parse HEAD^{tree})
  if [ "$actual_tree" != "$expected_tree" ]; then
    echo "$name tree mismatch: expected $expected_tree, got $actual_tree" >&2
    exit 1
  fi

  git -C "$temporary" submodule update --init --recursive
  mv -- "$temporary" "$destination"
  temporary=
  echo "prepared $name at $destination"
}

prepare \
  vllm \
  https://github.com/vllm-project/vllm.git \
  d05da62e9ccdf8e342b15bf6785d83224cc165af \
  0b2a255f44e816178e8f3a2f0eb6ffbb9aca1576 \
  patches/vllm/0001-model-support-quality-preserving-DeepSeek-V4.1-TP3-p.patch \
  patches/vllm/0002-feat-deepseek-v41-add-native-B12X-sparse-MLA-adapter.patch \
  patches/vllm/0003-feat-distributed-port-RoCEnante-to-prepared-B12X-pla.patch

prepare \
  b12x \
  https://github.com/local-inference-lab/b12x.git \
  0f3a8cbfd1c11d27f04e3ab37a802d522f4f1c68 \
  4dbbf9f0eb784f379d0bc38db8195dd65088aaaa \
  patches/b12x/0001-perf-mhc-retain-qualified-3072-token-DS4.1-geometry.patch \
  patches/b12x/0002-feat-rocenante-route-switchless-peers-by-local-HCA.patch \
  patches/b12x/0003-build-align-CUTLASS-DSL-with-vLLM-main.patch

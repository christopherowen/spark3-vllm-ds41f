+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from unittest.mock import Mock
+
+import torch
+
+from vllm.model_executor.layers.fused_moe.router.gate_linear import GateLinear
+from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+
+
+def _gate(*, shape: tuple[int, int], enabled: bool) -> GateLinear:
+    gate = object.__new__(GateLinear)
+    object.__setattr__(gate, "weight", torch.empty(shape, dtype=torch.bfloat16))
+    object.__setattr__(gate, "input_size", shape[1])
+    object.__setattr__(gate, "output_size", shape[0])
+    object.__setattr__(gate, "allow_ll_bf16_gemm", enabled)
+    return gate
+
+
+def test_ll_bf16_warmup_is_registered_only_by_runtime_eligible_gate(
+    monkeypatch,
+) -> None:
+    from vllm.model_executor.kernels.linear.cute_dsl import ll_bf16
+
+    registry = JitWarmupRegistry(object())
+    compile_many = Mock()
+    monkeypatch.setattr(ll_bf16.ll_bf16_gemm_warmup, "compile_many", compile_many)
+
+    with registry.activate():
+        _gate(shape=(384, 5120), enabled=True)._register_ll_bf16_warmup()
+        _gate(shape=(256, 4096), enabled=False)._register_ll_bf16_warmup()
+
+    registry.warmup()
+
+    compile_many.assert_called_once()
+    keys = compile_many.call_args.args[0]
+    assert keys == dict.fromkeys(
+        ll_bf16.ll_bf16_gemm_warmup.get_warmup_keys(
+            shapes=((5120, 384),),
+            m_values=range(1, 17),
+        )
+    )

+class LLBf16Warmup(VllmJitKernel[LLBf16Gemm.CompileKey]):
+    """Registry adapter for the runtime-owned ll_bf16 kernel cache."""
+
+    CompileKey = LLBf16Gemm.CompileKey
+
+    def __init__(self, kernel: LLBf16Gemm) -> None:
+        self.kernel = kernel
+        super().__init__()
+
+    def get_warmup_keys(
+        self,
+        *,
+        shapes: Iterable[tuple[int, int]],
+        m_values: Iterable[int],
+    ) -> list[LLBf16Gemm.CompileKey]:
+        return self.kernel.get_warmup_keys(shapes=shapes, m_values=m_values)
+
+    def compile(self, compile_key: LLBf16Gemm.CompileKey) -> None:
+        self.kernel.compile(compile_key)
+
+

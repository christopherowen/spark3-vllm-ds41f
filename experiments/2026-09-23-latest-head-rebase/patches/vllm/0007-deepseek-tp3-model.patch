+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.model_executor.weight_transfer import (
+    copy_weight,
+    materialize_weight,
+    weight_transfer,
+)
+from vllm.models.deepseek_v41.virtual_heads import (
+    _E8M0,
+    _fill_zero_group,
+    _wrap_parameter,
+    wrap_attention,
+)
+
+
+def _parameter(shape: tuple[int, ...], dimension: str, dim: int):
+    parameter = torch.nn.Parameter(torch.empty(shape), requires_grad=False)
+    setattr(parameter, dimension, dim)
+    parameter.weight_loader = lambda param, weight: copy_weight(param.data, weight)
+    return parameter
+
+
+def _linear(shape: tuple[int, ...], dimension: str, dim: int, tp_rank: int):
+    linear = torch.nn.Module()
+    linear.register_parameter("weight", _parameter(shape, dimension, dim))
+    linear.tp_rank = tp_rank
+    return linear
+
+
+def test_virtual_group_duplicates_inputs_and_zeros_output() -> None:
+    attention = SimpleNamespace(
+        n_groups=9,
+        wq_b=_linear((3, 2), "output_dim", 0, 2),
+        wo_a=_linear((3, 2), "output_dim", 0, 2),
+        wo_b=_linear((2, 3), "input_dim", 1, 2),
+    )
+    config = SimpleNamespace(virtual_heads_from={"o_groups": 8})
+
+    assert wrap_attention(attention, 3, config) == 3
+
+    input_weight = torch.arange(16, dtype=torch.float32).reshape(8, 2)
+    output_weight = torch.arange(16, dtype=torch.float32).reshape(2, 8)
+    attention.wq_b.weight.weight_loader(attention.wq_b.weight, input_weight)
+    attention.wo_a.weight.weight_loader(attention.wo_a.weight, input_weight)
+    attention.wo_b.weight.weight_loader(attention.wo_b.weight, output_weight)
+
+    expected_input = input_weight[[6, 7, 7]]
+    assert torch.equal(attention.wq_b.weight, expected_input)
+    assert torch.equal(attention.wo_a.weight, expected_input)
+    assert torch.equal(attention.wo_b.weight[:, :2], output_weight[:, 6:8])
+    assert torch.count_nonzero(attention.wo_b.weight[:, 2]) == 0
+
+
+@pytest.mark.parametrize(
+    ("tp_rank", "expected_groups"),
+    [(0, [0, 1, 2]), (1, [3, 4, 5]), (2, [6, 7, 7])],
+)
+def test_duplicate_loader_maps_each_tp_rank(tp_rank, expected_groups) -> None:
+    parameter = _parameter((3, 2), "output_dim", 0)
+    assert _wrap_parameter(parameter, 0, 8, 9, "duplicate", tp_rank, 3)
+
+    weight = torch.arange(16, dtype=torch.float32).reshape(8, 2)
+    parameter.weight_loader(parameter, weight)
+    assert torch.equal(parameter, weight[expected_groups])
+
+
+def test_duplicate_loader_routes_only_selected_lazy_groups() -> None:
+    parameter = _parameter((3, 2), "output_dim", 0)
+    assert _wrap_parameter(parameter, 0, 8, 9, "duplicate", 2, 3)
+
+    expected = torch.arange(16, dtype=torch.float32).reshape(8, 2)
+    source = torch.empty_like(expected, device="meta")
+
+    class Writer:
+        offsets = []
+
+        def __call__(self, destination, loaded):
+            self.offsets.append(loaded.storage_offset())
+            destination.copy_(
+                expected.as_strided(
+                    loaded.shape,
+                    loaded.stride(),
+                    loaded.storage_offset(),
+                )
+            )
+            return True
+
+        def flush(self):
+            pass
+
+    writer = Writer()
+    with weight_transfer(writer):
+        parameter.weight_loader(parameter, source)
+
+    assert writer.offsets == [12, 14]
+    assert torch.equal(parameter, expected[[6, 7, 7]])
+
+
+def test_virtual_loader_composes_with_scale_row_expansion() -> None:
+    parameter = _parameter((5120, 48), "input_dim", 1)
+
+    def scale_loader(param, loaded):
+        loaded = materialize_weight(loaded).repeat_interleave(32, dim=0)
+        copy_weight(param.data, loaded)
+
+    parameter.weight_loader = scale_loader
+    assert _wrap_parameter(parameter, 1, 8, 9, "duplicate", 2, 3)
+
+    expected = torch.arange(160 * 128, dtype=torch.float32).reshape(160, 128)
+    source = torch.empty_like(expected, device="meta")
+
+    class Writer:
+        offsets = []
+
+        def __call__(self, destination, loaded):
+            return False
+
+        def materialize(self, loaded):
+            self.offsets.append(loaded.storage_offset())
+            return expected.as_strided(
+                loaded.shape,
+                loaded.stride(),
+                loaded.storage_offset(),
+            ).clone()
+
+        def flush(self):
+            pass
+
+    writer = Writer()
+    with weight_transfer(writer):
+        parameter.weight_loader(parameter, source)
+
+    selected = torch.cat((expected[:, 96:112], expected[:, 112:128]), dim=1)
+    selected = torch.cat((selected, expected[:, 112:128]), dim=1)
+    assert writer.offsets == [96, 112]
+    assert torch.equal(parameter, selected.repeat_interleave(32, dim=0))
+
+
+def test_virtual_padding_is_opt_in() -> None:
+    attention = SimpleNamespace(n_groups=9)
+    assert wrap_attention(attention, 3, SimpleNamespace()) == 0
+    assert (
+        wrap_attention(
+            attention,
+            1,
+            SimpleNamespace(virtual_heads_from={"o_groups": 8}),
+        )
+        == 0
+    )
+
+
+def test_virtual_groups_must_divide_tp_size() -> None:
+    parameter = _parameter((3, 2), "output_dim", 0)
+    with pytest.raises(ValueError, match="must divide tensor parallel size"):
+        _wrap_parameter(parameter, 0, 8, 10, "duplicate", 2, 3)
+
+
+@pytest.mark.skipif(_E8M0 is None, reason="Torch does not expose E8M0")
+def test_e8m0_zero_uses_unit_scale_encoding() -> None:
+    scales = torch.empty(4, dtype=_E8M0)
+    _fill_zero_group(scales)
+    assert torch.equal(
+        scales.view(torch.uint8), torch.full((4,), 127, dtype=torch.uint8)
+    )

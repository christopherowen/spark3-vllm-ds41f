-def _use_v41_mxfp8_kv_record() -> bool:
-    return current_platform.is_device_capability_family(100)
+# rounded to the kernel's 512 B TMA stride -- in its SM100 sparse-decode
+# kernels. NVFP4 explicitly names the V4.1 split record and may be supplied by
+# another backend. Other fp8_ds_mla providers keep the V4 record: 448 fp8 NoPE
+# + 64 bf16 RoPE plus 7 UE8M0 scales of 64 dims and a pad byte (584 B, 576 B
+# pages).
+def _use_v41_mxfp8_kv_record(
+    kv_cache_dtype: CacheDType | None = None,
+) -> bool:
+    # NVFP4 is defined only for the V4.1 split record: MXFP8 SWA plus an
+    # NVFP4 compressed cache. Unlike fp8_ds_mla, its identity is sufficient
+    # to select the 528-byte SWA ABI on providers outside SM100.
+    return kv_cache_dtype == "nvfp4_ds_mla" or (
+        current_platform.is_device_capability_family(100)
+    )
 
 

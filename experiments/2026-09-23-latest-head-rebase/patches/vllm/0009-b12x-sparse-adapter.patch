+def test_outer_model_preserves_disk_engram_descriptor_to_leaf(monkeypatch) -> None:
+    class RecordingEmbedding(torch.nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.received: list[tuple[str, torch.Tensor]] = []
+
+        def load_weights(self, weights) -> set[str]:

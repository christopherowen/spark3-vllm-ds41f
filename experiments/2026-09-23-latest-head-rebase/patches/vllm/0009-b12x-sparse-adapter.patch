+def test_disk_engram_routes_immutable_checkpoint_ranges() -> None:
+    class DiskTable:
+        def __init__(self) -> None:
+            self.shards = []
+
+        def add_shard(self, index, path, offset, *, scale=False) -> None:
+            self.shards.append((index, path, offset, scale))
+
+    embedding = object.__new__(ParallelEngramEmbedding)
+    torch.nn.Module.__init__(embedding)
+    embedding.disk_plan = SimpleNamespace(
+        query=SimpleNamespace(table_rows=7),
+    )
+    embedding.disk_table = DiskTable()
+    weight = file_source_tensor(
+        FileTensorSource("weights.safetensors", 4096, (7, 256), torch.float8_e4m3fn)
+    )
+    scale = file_source_tensor(
+        FileTensorSource("scales.safetensors", 8192, (7, 8), torch.float8_e8m0fnu)
+    )
+
+    loaded = embedding.load_weights((("weight", weight), ("weight_scale_inv", scale)))
+
+    assert loaded == {"weight", "weight_scale_inv"}
+    assert embedding.disk_table.shards == [
+        (0, "weights.safetensors", 4096, False),
+        (0, "scales.safetensors", 8192, True),
+    ]
+

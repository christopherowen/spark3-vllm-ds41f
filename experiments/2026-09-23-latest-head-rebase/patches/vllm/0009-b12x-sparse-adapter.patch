+def test_disk_engram_descriptor_reaches_leaf_loader(monkeypatch) -> None:
+    class RecordingEmbedding(torch.nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.received: list[tuple[str, object]] = []
+
+        def load_weights(self, weights) -> set[str]:
+            current = list(weights)
+            self.received.extend(current)
+            return {name for name, _value in current}
+
+    model = object.__new__(DeepseekV4Model)
+    torch.nn.Module.__init__(model)
+    embedding = RecordingEmbedding()
+    layer = torch.nn.Module()
+    layer.engram = torch.nn.Module()
+    layer.engram.embed_tokens = embedding
+    model.layers = torch.nn.ModuleList([torch.nn.Identity(), layer])
+    model.disk_engram = True
+    model.config = SimpleNamespace(num_attention_heads=24)
+    model.quant_config = None
+    model.use_sequence_parallel = False
+    model.get_expert_mapping = lambda: []
+    monkeypatch.setattr(nvidia_model, "get_tensor_model_parallel_world_size", lambda: 3)
+    monkeypatch.setattr(nvidia_model, "get_tensor_model_parallel_rank", lambda: 0)
+    monkeypatch.setattr(nvidia_model, "is_pp_missing_parameter", lambda *_args: False)
+    weight_descriptor = object()
+    scale_descriptor = object()
+
+    loaded = model.load_weights(
+        (
+            ("layers.1.engram.embed_tokens.weight", weight_descriptor),
+            ("layers.1.engram.embed_tokens.weight_scale_inv", scale_descriptor),
+        )
+    )
+
+    assert loaded == {
+        "layers.1.engram.embed_tokens.weight",
+        "layers.1.engram.embed_tokens.weight_scale_inv",
+    }
+    assert embedding.received == [
+        ("weight", weight_descriptor),
+        ("weight_scale_inv", scale_descriptor),
+    ]
+

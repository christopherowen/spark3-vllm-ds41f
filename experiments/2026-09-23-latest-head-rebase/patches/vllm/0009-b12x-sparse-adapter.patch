+class _RecordingRotary(torch.nn.Module):
+    def __init__(self) -> None:
+        super().__init__()
+        self.positions = []
+
+    def forward(self, positions, query, key=None):
+        self.positions.append(positions.clone())
+        assert query.ndim == 3
+        query.add_(1)
+        if key is not None:
+            assert key.ndim == 3
+            assert key.shape[-2] == 1
+            key.add_(2)
+        return query, key
+
+
+class _RecordingMLA:
+    def __init__(self) -> None:
+        self.writes = []
+
+    def write_cache(self, kv, cache, slot_mapping, **kwargs):
+        self.writes.append((kv.clone(), cache, slot_mapping.clone(), kwargs))
+

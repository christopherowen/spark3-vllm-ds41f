+def test_b12x_maps_indexed_positions_through_shared_compressed_cache(
+    monkeypatch,
+) -> None:
+    attention = object.__new__(DeepseekV41B12xAttention)
+    torch.nn.Module.__init__(attention)
+    attention.compress_ratio = 2
+    attention.compressed_cache_prefix = "model.layers.2.attn"
+    attention.swa_cache_layer = SimpleNamespace(
+        prefix="model.layers.3.attn.swa_cache",
+        kv_cache=torch.empty((2, 32, 528), dtype=torch.uint8),
+    )
+    attention.topk_indices_buffer = torch.tensor([[0], [1]], dtype=torch.int32)
+    attention._compressed_kv_cache = lambda: torch.empty(
+        (2, 64, 528), dtype=torch.uint8
+    )
+    attention._ensure_plans = lambda: SimpleNamespace(decode="decode", extend="extend")
+    calls = []
+    attention._run_attention = lambda **kwargs: calls.append(kwargs)
+    swa_table = torch.tensor([[3, 0]], dtype=torch.int32)
+    compressed_table = torch.tensor([[7, 0]], dtype=torch.int32)
+    swa = SimpleNamespace(
+        block_table=swa_table,
+        token_to_req_indices=torch.zeros(2, dtype=torch.int32),
+        is_valid_token=torch.ones(2, dtype=torch.bool),
+        num_decode_tokens=1,
+        num_decodes=1,
+        decode_swa_indices=torch.zeros((1, 1), dtype=torch.int32),
+        decode_swa_lens=torch.ones(1, dtype=torch.int32),
+        num_prefill_tokens=1,
+        prefill_swa_indices=torch.zeros((1, 1), dtype=torch.int32),
+        prefill_swa_lens=torch.ones(1, dtype=torch.int32),
+    )
+    monkeypatch.setattr(
+        b12x_attention,
+        "get_forward_context",
+        lambda: SimpleNamespace(
+            attn_metadata={
+                attention.swa_cache_layer.prefix: swa,
+                attention.compressed_cache_prefix: SimpleNamespace(
+                    block_table=compressed_table
+                ),
+            }
+        ),
+    )
+
+    q = torch.zeros((2, 1, 1), dtype=torch.bfloat16)
+    attention.forward_mqa(q, q, torch.arange(2), torch.empty_like(q))
+
+    assert [call["plan"] for call in calls] == ["decode", "extend"]
+    assert all(torch.equal(call["block_table"], compressed_table) for call in calls)
+    assert all(call["indexed_indices"] is not None for call in calls)

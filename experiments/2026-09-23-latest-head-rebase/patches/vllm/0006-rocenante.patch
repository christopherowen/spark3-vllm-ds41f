+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+from unittest.mock import sentinel
+
+import pytest
+import torch
+
+import vllm.distributed.device_communicators.b12x_roce_all_reduce as roce_adapter
+from vllm.distributed.device_communicators.b12x_roce_all_reduce import (
+    B12xRoceAllReduce,
+    _parse_byte_size,
+)
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (64, 64),
+        ("64B", 64),
+        ("2KB", 2_048),
+        ("2KiB", 2_048),
+        ("4MB", 4 * 1024 * 1024),
+        ("4MiB", 4 * 1024 * 1024),
+    ],
+)
+def test_parse_byte_size(value, expected: int) -> None:
+    assert _parse_byte_size(value) == expected
+
+
+@pytest.mark.parametrize("value", [0, "0", "-1", "2XB", ""])
+def test_parse_byte_size_rejects_invalid_values(value) -> None:
+    with pytest.raises(ValueError):
+        _parse_byte_size(value)
+
+
+def test_capability_vote_rejects_rank_local_failure(monkeypatch) -> None:
+    communicator = object.__new__(B12xRoceAllReduce)
+    communicator.world_size = 3
+    communicator.group = object()
+
+    def gather(votes, local, *, group) -> None:
+        assert local == (None, (2_000_000, 4_000_000))
+        assert group is communicator.group
+        votes[:] = [local, ("RDMA device unavailable", None), local]
+
+    monkeypatch.setattr(roce_adapter.dist, "all_gather_object", gather)
+    assert communicator._exchange_vote(None, (2_000_000, 4_000_000)) == (
+        "rank 1: RDMA device unavailable"
+    )
+
+
+def test_capability_vote_rejects_different_limits(monkeypatch) -> None:
+    communicator = object.__new__(B12xRoceAllReduce)
+    communicator.world_size = 3
+    communicator.group = object()
+
+    def gather(votes, local, *, group) -> None:
+        votes[:] = [local, local, (None, (2_000_000, 16_000_000))]
+
+    monkeypatch.setattr(roce_adapter.dist, "all_gather_object", gather)
+    reason = communicator._exchange_vote(None, (2_000_000, 4_000_000))
+    assert reason is not None
+    assert "size limits differ across ranks" in reason
+    assert "rank 2" in reason
+
+
+def test_dispatch_uses_prepared_plan_and_preserves_fallback() -> None:
+    calls = []
+    plan = SimpleNamespace(prepared=object())
+    runtime = SimpleNamespace(
+        should_allreduce=lambda tensor: tensor == "small",
+        all_reduce=lambda tensor, *, plan: calls.append((tensor, plan)) or "reduced",
+    )
+    communicator = object.__new__(B12xRoceAllReduce)
+    communicator.disabled = False
+    communicator._runtime = runtime
+    communicator._plan = plan
+    communicator._announced_reduce = True
+
+    assert communicator.should_custom_ar("small")
+    assert not communicator.should_custom_ar("large")
+    assert communicator.custom_all_reduce("large") is None
+    assert communicator.custom_all_reduce("small") == "reduced"
+    assert calls == [("small", plan)]
+
+
+def test_roce_plan_is_eligible_for_pre_profile_preparation() -> None:
+    assert (
+        B12xRoceAllReduce.get_b12x_pre_profile_unit
+        is B12xRoceAllReduce.get_b12x_warmup_unit
+    )
+
+
+def test_roce_plan_rendezvouses_after_materialization_before_priming(
+    monkeypatch,
+) -> None:
+    import b12x.preparation as b12x_preparation
+    from b12x.comm.roce import _preparation
+
+    events = []
+    communicator = object.__new__(B12xRoceAllReduce)
+    communicator.device = torch.device("cpu")
+    communicator.group = sentinel.group
+    communicator.global_ranks = (0, 1, 2)
+
+    monkeypatch.setattr(
+        roce_adapter.dist,
+        "barrier",
+        lambda *, group: events.append(("barrier", group)),
+    )
+
+    def prepared_call(state, *, inp):
+        del state, inp
+        return SimpleNamespace(
+            run=lambda: events.append("all_reduce"),
+            output=sentinel.reduce_output,
+        )
+
+    def prepared_gather_call(state, *, inp):
+        del state, inp
+        return SimpleNamespace(
+            run=lambda: events.append("all_gather"),
+            output=sentinel.gather_output,
+        )
+
+    monkeypatch.setattr(_preparation, "prepared_call", prepared_call)
+    monkeypatch.setattr(_preparation, "prepared_gather_call", prepared_gather_call)
+
+    def prepare_default(request) -> None:
+        events.append("materialized")
+        request.prepare_call(sentinel.state).run()
+
+    monkeypatch.setattr(b12x_preparation, "prepare_default", prepare_default)
+    plan = SimpleNamespace(
+        prepared=None,
+        request=lambda **kwargs: SimpleNamespace(**kwargs),
+    )
+
+    communicator._prepare_plan(plan)
+
+    assert events == [
+        "materialized",
+        ("barrier", sentinel.group),
+        "all_reduce",
+        "all_reduce",
+        "all_reduce",
+        "all_gather",
+    ]
diff --git a/vllm/distributed/device_communicators/b12x_roce_all_reduce.py b/vllm/distributed/device_communicators/b12x_roce_all_reduce.py

index 0000000000..cc286e5c3f
--- /dev/null
+++ b/vllm/distributed/device_communicators/b12x_roce_all_reduce.py
@@ -0,0 +1,328 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""B12X RoCEnante adapter for switchless multi-node tensor parallelism."""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Sequence
+from contextlib import contextmanager
+from typing import Any
+
+import torch
+import torch.distributed as dist
+from torch.distributed import ProcessGroup
+
+import vllm.envs as envs
+from vllm.distributed.parallel_state import in_the_same_node_as
+from vllm.logger import init_logger
+from vllm.utils.b12x import B12xWarmupUnit
+
+logger = init_logger(__name__)
+
+REQUIRED_B12X_ROCE_API_VERSION = 1
+_BYTE_SIZE_RE = re.compile(r"^\s*(\d+)\s*([kmgt]?i?b?)?\s*$", re.IGNORECASE)
+_BYTE_SIZE_MULTIPLIERS = {
+    None: 1,
+    "": 1,
+    "b": 1,
+    "k": 1024,
+    "kb": 1024,
+    "kib": 1024,
+    "m": 1024**2,
+    "mb": 1024**2,
+    "mib": 1024**2,
+    "g": 1024**3,
+    "gb": 1024**3,
+    "gib": 1024**3,
+    "t": 1024**4,
+    "tb": 1024**4,
+    "tib": 1024**4,
+}
+
+
+def _parse_byte_size(value: str | int) -> int:
+    if isinstance(value, int):
+        if value <= 0:
+            raise ValueError("byte size must be positive")
+        return value
+    match = _BYTE_SIZE_RE.fullmatch(value)
+    if match is None:
+        raise ValueError(f"invalid byte size: {value!r}")
+    size = (
+        int(match.group(1))
+        * _BYTE_SIZE_MULTIPLIERS[match.group(2).lower() if match.group(2) else None]
+    )
+    if size <= 0:
+        raise ValueError("byte size must be positive")
+    return size
+
+
+class B12xRoceAllReduce:
+    """Route eligible TP all-reduces and all-gathers through B12X RoCE."""
+
+    backend_name = "B12X_ROCENANTE"
+
+    def __init__(
+        self,
+        group: ProcessGroup,
+        device_group: ProcessGroup | None,
+        device: torch.device,
+        *,
+        global_ranks: Sequence[int] | None = None,
+    ) -> None:
+        self.disabled = True
+        self.group = group
+        self.device_group = device_group
+        self.device = device
+        self.rank = dist.get_rank(group=group)
+        self.world_size = dist.get_world_size(group=group)
+        self.global_ranks = tuple(
+            int(rank)
+            for rank in (
+                global_ranks if global_ranks is not None else range(self.world_size)
+            )
+        )
+        if len(self.global_ranks) != self.world_size:
+            raise ValueError("RoCE global ranks must match the process group")
+        self._runtime: Any | None = None
+        self._plan: Any | None = None
+        self._announced_reduce = False
+        self._announced_gather = False
+
+        if device_group is None:
+            logger.warning("RoCEnante requires a CUDA process group.")
+            return
+        if all(in_the_same_node_as(group, source_rank=0)):
+            logger.info("RoCEnante skipped: tensor-parallel group is single-node.")
+            return
+
+        reason, limits = self._local_capability()
+        verdict = self._exchange_vote(reason, limits)
+        if verdict is not None:
+            logger.warning("RoCEnante disabled on every rank: %s", verdict)
+            return
+        assert limits is not None
+        max_size, max_gather_size = limits
+
+        from b12x.comm import roce
+
+        try:
+            self._runtime = roce.AllReduce.from_exchange_group(
+                exchange_group=group,
+                device=device,
+                max_size=max_size,
+                max_gather_bytes=max_gather_size,
+            )
+        except Exception as exc:  # noqa: BLE001 - setup is coordinated by B12X
+            logger.warning("RoCEnante initialization failed: %s", exc)
+            return
+        self.disabled = False
+        if self.rank == 0:
+            logger.info(
+                "Using RoCEnante: world=%d, HCAs=%s, all-reduce max=%d bytes, "
+                "all-gather shard max=%d bytes.",
+                self.world_size,
+                ",".join(self._runtime.hca_names),
+                max_size,
+                max_gather_size,
+            )
+
+    def _local_capability(self) -> tuple[str | None, tuple[int, int] | None]:
+        try:
+            from b12x.comm import roce
+        except ImportError as exc:
+            return f"b12x.comm.roce is not importable: {exc}", None
+        api_version = getattr(roce, "API_VERSION", None)
+        if api_version != REQUIRED_B12X_ROCE_API_VERSION:
+            reason = (
+                "b12x.comm.roce API version "
+                f"{api_version}, adapter requires {REQUIRED_B12X_ROCE_API_VERSION}"
+            )
+            return (
+                reason,
+                None,
+            )
+        if not roce.is_supported(self.device):
+            return "requires an integrated GPU with an active RDMA device", None
+        try:
+            limits = (
+                _parse_byte_size(envs.VLLM_ROCE_ALLREDUCE_MAX_SIZE),
+                _parse_byte_size(envs.VLLM_ROCE_ALLGATHER_MAX_SIZE),
+            )
+        except (TypeError, ValueError) as exc:
+            return f"invalid RoCEnante size limit: {exc}", None
+        return None, limits
+
+    def _exchange_vote(
+        self, reason: str | None, limits: tuple[int, int] | None
+    ) -> str | None:
+        votes: list[tuple[str | None, tuple[int, int] | None]] = [
+            (None, None)
+        ] * self.world_size
+        dist.all_gather_object(votes, (reason, limits), group=self.group)
+        failures = [
+            f"rank {rank}: {error}" for rank, (error, _) in enumerate(votes) if error
+        ]
+        if failures:
+            return "; ".join(failures)
+        reference = votes[0][1]
+        differences = [
+            f"rank {rank}: {candidate}"
+            for rank, (_, candidate) in enumerate(votes)
+            if candidate != reference
+        ]
+        if differences:
+            return (
+                f"size limits differ across ranks (rank 0: {reference}; "
+                + "; ".join(differences)
+                + ")"
+            )
+        return None
+
+    def _request_name(self) -> str:
+        return "distributed.roce." + "-".join(map(str, self.global_ranks))
+
+    def _ensure_plan(self) -> Any:
+        if self._plan is not None:
+            return self._plan
+        if self.disabled or self._runtime is None:
+            raise RuntimeError("RoCEnante is not available")
+        from b12x.comm import roce
+
+        query = roce.query_from_runtime(
+            self._runtime,
+            surface="AllReduce.all_reduce",
+            call={"dtypes": ("float16", "bfloat16", "float32")},
+            topology="roce_rdma",
+            peer_hosts=tuple(f"rank:{rank}" for rank in self.global_ranks),
+        )
+        self._plan = roce.plan(query, runtime=self._runtime)
+        return self._plan
+
+    def get_b12x_warmup_unit(
+        self,
+        owner: object,
+        token_counts: tuple[int, ...],
+        output_dtype: torch.dtype,
+    ) -> B12xWarmupUnit:
+        del token_counts, output_dtype
+        if owner is not self:
+            raise ValueError("RoCE warmup owner mismatch")
+        plan = self._ensure_plan()
+        return B12xWarmupUnit(
+            name="RoCEnante collectives",
+            key=(self.backend_name, self.global_ranks),
+            compile=lambda: self._prepare_plan(plan),
+        )
+
+    get_b12x_pre_profile_unit = get_b12x_warmup_unit
+
+    def _prepare_plan(self, plan: Any) -> None:
+        from b12x.comm.roce import _preparation
+        from b12x.preparation import PreparedCall, prepare_default
+
+        if plan.prepared is not None:
+            return
+
+        def prepare(state: object) -> PreparedCall:
+            buffers = [
+                torch.zeros(16 // dtype.itemsize, dtype=dtype, device=self.device)
+                for dtype in (torch.float16, torch.bfloat16, torch.float32)
+            ]
+            calls = [
+                _preparation.prepared_call(state, inp=buffer) for buffer in buffers
+            ]
+            gather = _preparation.prepared_gather_call(state, inp=buffers[1])
+            all_calls = (*calls, gather)
+
+            def prime_collectives() -> list[Any]:
+                # Local model-plan preparation can finish at different times on
+                # each rank. Rendezvous after this RoCE plan is materialized and
+                # immediately before its first real collective, otherwise an
+                # early rank can exhaust the runtime spin limit while another
+                # rank is still compiling an unrelated local plan.
+                dist.barrier(group=self.group)
+                return [call.run() for call in all_calls]
+
+            return PreparedCall(
+                run=prime_collectives,
+                output=tuple(call.output for call in all_calls),
+                owners=(*buffers, *all_calls),
+            )
+
+        prepare_default(plan.request(name=self._request_name(), prepare_call=prepare))
+
+    def _prepared_plan(self) -> Any:
+        plan = self._ensure_plan()
+        if plan.prepared is None:
+            raise RuntimeError("RoCEnante plan was not prepared during startup")
+        return plan
+
+    def should_custom_ar(self, inp: torch.Tensor) -> bool:
+        return (
+            not self.disabled
+            and self._runtime is not None
+            and self._runtime.should_allreduce(inp)
+        )
+
+    def custom_all_reduce(self, inp: torch.Tensor) -> torch.Tensor | None:
+        if not self.should_custom_ar(inp):
+            return None
+        assert self._runtime is not None
+        if not self._announced_reduce:
+            self._announced_reduce = True
+            log = logger.info if self.rank == 0 else logger.debug
+            log(
+                "RoCEnante all-reduce is live: first routed tensor is %d bytes "
+                "(%s); NCCL remains the fallback above %s.",
+                inp.numel() * inp.element_size(),
+                str(inp.dtype).removeprefix("torch."),
+                envs.VLLM_ROCE_ALLREDUCE_MAX_SIZE,
+            )
+        return self._runtime.all_reduce(inp, plan=self._prepared_plan())
+
+    def should_all_gather(self, inp: torch.Tensor, dim: int) -> bool:
+        return (
+            not self.disabled
+            and self._runtime is not None
+            and self._runtime.should_all_gather(inp, dim)
+        )
+
+    def all_gather(self, inp: torch.Tensor, dim: int) -> torch.Tensor:
+        assert self._runtime is not None
+        if not self._announced_gather:
+            self._announced_gather = True
+            log = logger.info if self.rank == 0 else logger.debug
+            log(
+                "RoCEnante all-gather is live: first routed shard is %s %s "
+                "along dim %d.",
+                tuple(inp.shape),
+                str(inp.dtype).removeprefix("torch."),
+                dim,
+            )
+        return self._runtime.all_gather(inp, dim=dim, plan=self._prepared_plan())
+
+    def check_health(self) -> None:
+        if not self.disabled and self._runtime is not None:
+            self._runtime.check_health()
+
+    @contextmanager
+    def capture(self, stream: torch.cuda.Stream | None = None):
+        if self.disabled:
+            yield
+            return
+        self._prepared_plan()
+        assert self._runtime is not None
+        with self._runtime.capture(stream=stream):
+            yield
+
+    def close(self) -> None:
+        if self._runtime is not None:
+            self._runtime.close()
+            self._runtime = None
+        self._plan = None
+        self.disabled = True
+
+
+__all__ = ["B12xRoceAllReduce"]

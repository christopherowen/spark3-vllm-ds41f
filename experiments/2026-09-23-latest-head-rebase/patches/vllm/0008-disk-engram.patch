+def _make_disk_plan(layout: EngramLayout, layer_hash_index: int):
+    native = get_b12x_engram()
+    if native is None:
+        raise RuntimeError("disk Engram requires the current B12X package")
+    vllm_config = get_current_vllm_config()
+    model_config = vllm_config.model_config
+    config = model_config.hf_config
+    token_map, compressed_size = _disk_token_map(
+        model_config.tokenizer,
+        model_config.revision,
+        model_config.trust_remote_code,
+    )
+    if compressed_size != layout.compressed_vocab_size:
+        raise ValueError("Engram tokenizer compressed vocabulary mismatch")
+    geometry = native.build_geometry(
+        layer_ids=layout.layer_ids,
+        base_table_size=config.engram_vocab_size,
+        compressed_vocab_size=layout.compressed_vocab_size,
+    )
+    if tuple(geometry.num_embeddings) != layout.num_embeddings:
+        raise ValueError("B12X Engram table rows do not match the upstream layout")
+    layer_id = layout.layer_ids[layer_hash_index]
+    caps = native.Caps(
+        device=torch.device("cuda", torch.cuda.current_device()),
+        max_tokens=vllm_config.scheduler_config.max_num_batched_tokens,
+        max_seqs=vllm_config.scheduler_config.max_num_seqs,
+        max_requests=vllm_config.scheduler_config.max_num_seqs,
+        vocab_size=config.vocab_size,
+        layer_id=layer_id,
+        tp_size=get_tensor_model_parallel_world_size(),
+        tp_rank=get_tensor_model_parallel_rank(),
+    )
+    plan = native.plan(
+        caps,
+        token_map=token_map,
+        geometry=geometry,
+        invocation={"operation": "lookup", "compact_rows": True},
+    )
+    expected_heads = tuple(
+        size for order in layout.primes[layer_hash_index] for size in order
+    )
+    geometry_index = geometry.layer_ids.index(layer_id)
+    if tuple(geometry.primes[geometry_index]) != expected_heads:
+        raise ValueError("B12X Engram hash geometry does not match upstream")
+    return native, plan, caps
+

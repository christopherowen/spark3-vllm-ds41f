+    def load_weights(self, weights) -> set[str]:
+        if self.disk_table is None or self.disk_plan is None:
+            if self.disk_plan is None or self._disk_native is None:
+                raise RuntimeError("load_weights is only used by disk-backed Engram")
+            from b12x.preparation import require_prepared
+
+            state = require_prepared(self.disk_plan, "sequence.engram")
+            self.disk_table = self._disk_native.DiskTable(state)
+        loaded = set()
+        for name, value in weights:
+            if name not in ("weight", "weight_scale_inv"):
+                raise ValueError(f"Unknown Engram table weight: {name}")
+            source = get_file_tensor_source(value)
+            if source is None:
+                raise ValueError("disk Engram requires a file-backed checkpoint table")
+            scale = name == "weight_scale_inv"
+            width = 8 if scale else 256
+            if source.shape != (self.disk_plan.query.table_rows, width):
+                raise ValueError("Engram source must be the unpadded global table")
+            dtypes = (
+                (torch.uint8, torch.float8_e8m0fnu) if scale else (torch.float8_e4m3fn,)
+            )
+            if source.dtype not in dtypes:
+                raise TypeError(f"Invalid Engram {name} dtype: {source.dtype}")
+            self.disk_table.add_shard(0, source.path, source.offset, scale=scale)
+            loaded.add(name)
+        return loaded
+
+    def prepare_disk(self, indices: torch.Tensor, out: torch.Tensor) -> None:
+        if self.disk_table is None or self.disk_plan is None:
+            raise RuntimeError("Engram table is not disk-backed")
+        if torch.compiler.is_compiling() or torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("disk Engram preparation must run outside capture")
+        token_count = indices.shape[0]
+        self.disk_hashes[:token_count].copy_(indices)
+        self.disk_num_tokens.fill_(token_count)
+        flat_out = out.flatten(1)
+        if (
+            self._disk_binding is None
+            or self._disk_binding.out.data_ptr() != flat_out.data_ptr()
+        ):
+            self._disk_binding = self._disk_native.bind_lookup(
+                self.disk_plan,
+                weight=None,
+                scales=None,
+                hash_ids=self.disk_hashes,
+                num_tokens=self.disk_num_tokens,
+                out=flat_out,
+                disk_table=self.disk_table,
+            )
+            out.zero_()
+            self._disk_prepared_rows = 0
+        if token_count < self._disk_prepared_rows:
+            out[token_count : self._disk_prepared_rows].zero_()
+        self._disk_native.run_lookup(
+            self._disk_binding,
+            token_count=token_count,
+            clear_tail=False,
+        )
+        self._disk_prepared_rows = token_count
+

diff --git a/b12x/loader/_managed_pool.c b/b12x/loader/_managed_pool.c
new file mode 100644
index 0000000..045613b
--- /dev/null
+++ b/b12x/loader/_managed_pool.c
@@ -0,0 +1,41 @@
+/* PyTorch owns suballocation and stream bookkeeping for final model weights. */
+#include <sys/mman.h>
+
+/* MemPool retains a raw allocator pointer past Python scope exit. */
+static PyObject *managed_allocators;
+
+static PyObject *py_keep_managed_allocator(PyObject *self, PyObject *allocator) {
+    (void)self;
+    if (!managed_allocators) managed_allocators = PyList_New(0);
+    if (!managed_allocators || PyList_Append(managed_allocators, allocator) < 0)
+        return NULL;
+    Py_RETURN_NONE;
+}
+
+void *b12x_managed_alloc(size_t bytes, int device, cudaStream_t stream) {
+    (void)stream;
+    void *pointer = NULL;
+    int previous;
+    if (cudaGetDevice(&previous) != cudaSuccess || cudaSetDevice(device) != cudaSuccess)
+        return NULL;
+    size_t length = bytes ? bytes : 1;
+    cudaError_t status = cudaMallocManaged(&pointer, length, cudaMemAttachGlobal);
+    if (status == cudaSuccess && mlock(pointer, length) != 0) {
+        fprintf(stderr, "b12x could not lock managed model weights: %s\n", strerror(errno));
+        cudaFree(pointer);
+        pointer = NULL;
+    } else if (status != cudaSuccess) {
+        fprintf(stderr, "b12x managed model allocation failed: %s\n",
+                cudaGetErrorString(status));
+    }
+    cudaSetDevice(previous);
+    return pointer;
+}
+
+void b12x_managed_free(void *pointer, size_t bytes, int device, cudaStream_t stream) {
+    (void)device;
+    (void)stream;
+    if (!pointer) return;
+    munlock(pointer, bytes ? bytes : 1);
+    cudaFree(pointer);
+}
diff --git a/b12x/loader/_managed_pool.py b/b12x/loader/_managed_pool.py
new file mode 100644
index 0000000..3c2908d
--- /dev/null
+++ b/b12x/loader/_managed_pool.py
@@ -0,0 +1,52 @@
+"""Scope coherent model weights to a PyTorch CUDA memory pool."""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+
+from ._native import load
+
+
+@contextmanager
+def managed_weight_pool(device: int):
+    import torch
+
+    caps = load().capabilities(device)
+    if not all(
+        caps[key]
+        for key in (
+            "managed_memory",
+            "concurrent_managed_access",
+            "pageable_memory_access",
+            "host_page_tables",
+        )
+    ):
+        raise RuntimeError("coherent managed model weights require GPU host page tables")
+    if torch.cuda.get_allocator_backend() != "native":
+        raise RuntimeError("managed model weights require PyTorch's native CUDA allocator")
+
+    native = load()
+    allocator = torch.cuda.memory.CUDAPluggableAllocator(
+        native.__file__, "b12x_managed_alloc", "b12x_managed_free"
+    )
+    native.keep_managed_allocator(allocator)
+    settings = torch.cuda.memory._snapshot()["allocator_settings"]
+    expandable = settings["expandable_segments"]
+    if expandable:
+        torch.cuda.memory._set_allocator_settings("expandable_segments:False")
+    pool = torch.cuda.MemPool(allocator.allocator())
+
+    @contextmanager
+    def allocate():
+        if pool is None:
+            raise RuntimeError("managed model weight pool is closed")
+        with torch.cuda.device(device), torch.cuda.use_mem_pool(pool, device=device):
+            yield
+
+    try:
+        yield allocate
+    finally:
+        pool = None
+        torch.cuda.empty_cache()
+        if expandable:
+            torch.cuda.memory._set_allocator_settings("expandable_segments:True")

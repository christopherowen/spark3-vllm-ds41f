diff --git a/tests/loader/test_managed_pool.py b/tests/loader/test_managed_pool.py
new file mode 100644
index 0000000..b0f28bb
--- /dev/null
+++ b/tests/loader/test_managed_pool.py
@@ -0,0 +1,30 @@
+"""Small end-to-end copy into final coherent model weight storage."""
+
+import pytest
+import torch
+from safetensors.torch import save_file
+
+pytest.importorskip("vllm")
+
+from b12x.loader._checkpoint import DirectWeightSession
+from b12x.loader._managed_pool import managed_weight_pool
+from vllm.model_executor.weight_transfer import allocate_weights, weight_transfer
+
+
+def test_bounce_copy_into_managed_weight_survives_pool_scope(tmp_path):
+    if not torch.cuda.is_available():
+        pytest.skip("requires CUDA")
+    source = torch.arange(1 << 18, dtype=torch.float32)
+    path = tmp_path / "weights.safetensors"
+    save_file({"weight": source}, path)
+
+    with managed_weight_pool(0) as allocate, DirectWeightSession(read_mode="bounce") as session:
+        with weight_transfer(session, allocator=allocate):
+            weight = allocate_weights(
+                torch.empty, source.shape, dtype=source.dtype, device="cuda"
+            )
+            checkpoint_view = dict(session.weights([path]))["weight"]
+            assert session(weight, checkpoint_view)
+            session.finish()
+
+    torch.testing.assert_close(weight.cpu(), source, rtol=0, atol=0)

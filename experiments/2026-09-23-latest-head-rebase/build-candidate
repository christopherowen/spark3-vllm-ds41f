#!/usr/bin/env python3
"""Check or build the pinned September 23 source candidate."""

import argparse
import json
import os
import subprocess
from pathlib import Path


EXPERIMENT = Path(__file__).resolve().parent
REPO = EXPERIMENT.parents[1]
SOURCES = REPO / ".work/experiments/2026-09-23-latest-head-rebase"


def git(directory, *args):
    return subprocess.check_output(["git", *args], cwd=directory, text=True).strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("check", "build"), nargs="?", default="check")
    parser.add_argument("--source-root", type=Path, default=SOURCES)
    args = parser.parse_args()
    series = json.loads((EXPERIMENT / "series.json").read_text())
    source_root = args.source_root.resolve()

    if git(REPO, "status", "--porcelain"):
        raise SystemExit("deployment repository is dirty; commit before building")
    for project, record in series.items():
        source = source_root / project
        if not source.is_dir() or git(source, "status", "--porcelain"):
            raise SystemExit(f"{project}: prepared source is missing or dirty")
        head = git(source, "rev-parse", "HEAD")
        tree = git(source, "rev-parse", "HEAD^{tree}")
        if head != record["patch_head"] or tree != record["expected_tree"]:
            raise SystemExit(f"{project}: prepared source identity differs from series.json")
    if args.mode == "check":
        print("latest-head source and deployment identities OK")
        return

    containers = subprocess.check_output(
        ["docker", "ps", "--format", "{{.Names}}"], text=True
    ).splitlines()
    if any(name.startswith("dsv41-") for name in containers):
        raise SystemExit("local DS4.1 service is running; build on an idle host")

    deployment_commit = git(REPO, "rev-parse", "HEAD")
    vllm = series["vllm"]
    b12x = series["b12x"]
    tag = os.environ.get(
        "CANDIDATE_TAG",
        "vllm-ds41f-latest:"
        f"{vllm['patch_head'][:12]}-{b12x['patch_head'][:12]}-d{deployment_commit[:12]}",
    )
    command = [
        "docker", "buildx", "build", "--platform", "linux/arm64", "--network", "host",
        "--load",
        "--build-context", f"vllm-source={source_root / 'vllm'}",
        "--build-context", f"b12x-source={source_root / 'b12x'}",
        "--build-arg", f"VLLM_BASE={vllm['upstream_base']}",
        "--build-arg", f"VLLM_PATCH_HEAD={vllm['patch_head']}",
        "--build-arg", f"VLLM_TREE={vllm['expected_tree']}",
        "--build-arg", f"B12X_BASE={b12x['upstream_base']}",
        "--build-arg", f"B12X_PATCH_HEAD={b12x['patch_head']}",
        "--build-arg", f"B12X_TREE={b12x['expected_tree']}",
        "--build-arg", f"DEPLOYMENT_COMMIT={deployment_commit}",
        "--tag", tag,
        "--file", str(EXPERIMENT / "Dockerfile"),
    ]
    if os.environ.get("GITHUB_TOKEN"):
        command += ["--secret", "id=github_token,env=GITHUB_TOKEN"]
    command.append(str(EXPERIMENT))
    subprocess.run(command, check=True)
    print(f"built {tag}")


if __name__ == "__main__":
    main()

@@ -0,0 +1,16 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek-V4.1 kernels in TileLang for SM120 / SM121.
+
+Selected by ``VLLM_DS41_KERNEL_BACKEND=tilelang``:
+
+
+- ``sparse_mla``: compressed sparse MLA over the SWA and indexed caches;
+- ``indexer``: MXFP4 index scores, exact top-k and candidate lists;
+- ``gemm``: MXFP8 block-scaled and BF16 GEMMs;
+- ``moe``: routed-expert dispatch, grouped FP8 x FP4 GEMMs and combine;
+- ``attention``, ``linear``, ``norm``: the vLLM layers and methods built on them.
+
+Importing a kernel module requires TileLang; the layers also use DeepSeek's
+TileKernels for MXFP8 casts, the fused SwiGLU and RMSNorm.
+"""
diff --git a/vllm/models/deepseek_v4_1/tilelang/attention.py b/vllm/models/deepseek_v4_1/tilelang/attention.py
new file mode 100644
index 000000000..5a3aed28e
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/attention.py
@@ -0,0 +1,238 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang kernels behind the DeepSeek-V4.1 attention layer.
+
+``--attention-backend TILELANG`` selects this layer. It keeps the shared
+layer's caches, metadata and Full/Reindex/Reuse ownership, and runs the
+indexer (MXFP4 query quantization, index-key writes, scores, top-k and the
+candidate list) and the sparse MLA with this package's kernels.
+
+The kernels hold no buffers. Their scratch comes from vLLM's workspace,
+reserved for the worst case before memory profiling, beside the attention
+metadata arena exactly as B12X's scratch is.
+"""
+
+import functools
+from types import SimpleNamespace
+
+import torch
+
+from vllm.models.deepseek_v4_1.attention import DeepseekV4Attention
+from vllm.models.deepseek_v4_1.sparse_mla import DeepseekV41B12xBackend
+from vllm.v1.worker.workspace import (
+    current_workspace_manager,
+    retain_cuda_graph_capture_resource,
+)
+
+from .indexer import (
+    CANDIDATE_BLOCK,
+    CANDIDATE_BLOCKS,
+    IndexerV41Plan,
+    page_bytes,
+    quantize_mxfp4,
+    write_index_keys,
+)
+from .sparse_mla import SparseMlaV41Plan
+
+
+class DeepseekV41TileLangBackend(DeepseekV41B12xBackend):
+    """The V4.1 cache layout and metadata builder, under the TileLang name."""
+
+    @staticmethod
+    def get_name() -> str:
+        return "TILELANG"
+
+
+# Plans are kernels only, so layers of one shape share them.
+@functools.cache
+def _mla_plan(heads, swa_width, idx_width, idx_page, swa_page, max_rows, device):
+    return SparseMlaV41Plan(
+        heads,
+        swa_width,
+        idx_width,
+        idx_page,
+        swa_page_size=swa_page,
+        max_rows=max_rows,
+        device=device,
+    )
+
+
+@functools.cache
+def _index_plan(width, page_size, candidates, candidate_blocks):
+    return IndexerV41Plan(
+        width, page_size, candidates=candidates, candidate_blocks=candidate_blocks
+    )
+
+
+class DeepseekV41TileLangAttention(DeepseekV4Attention):
+    backend_cls = DeepseekV41TileLangBackend
+
+    def _declare_mla(self, mode, capacity, metadata_specs, device):
+        return None
+
+    def get_b12x_preparation_units(self, layer, workload):
+        # B12X's state unit prepares its own sparse MLA and indexer plans,
+        # which this layer never launches.
+        return ()
+
+    def _tilelang(self) -> SimpleNamespace:
+        """This layer's plans, built and their scratch reserved on first use."""
+        plans = self.__dict__.get("_tilelang_plans")
+        if plans is None:
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError(
+                    "V4.1 TileLang kernels must be built before CUDA graph capture"
+                )
+            plans = self._tilelang_plans = self._build_tilelang_plans()
+        return plans
+
+    def _check_cache_pages(self) -> None:
+        """Each cache page must be exactly the records the kernels address in it.
+
+        Rows may be strided (BLHNC interleaves layers); a width that differs
+        from the configured page means the page holds a different number of
+        tokens than the plans assume.
+        """
+        caches = [
+            (
+                "SWA",
+                self.swa_cache_layer.kv_cache,
+                self.swa_cache_layer.block_size * 528,
+            )
+        ]
+        if self.compress_ratio:
+            caches.append(("indexed", self._owner().kv_cache, self._main_page * 288))
+        if self.indexer is not None:
+            caches.append(
+                ("index K", self.indexer.k_cache.kv_cache, page_bytes(self._index_page))
+            )
+        for name, cache, page in caches:
+            if cache.dim() != 2 or cache.dtype != torch.uint8 or cache.shape[1] != page:
+                raise ValueError(
+                    f"{self.prefix}: {name} cache pages {tuple(cache.shape)} "
+                    f"{cache.dtype} are not {page}-byte pages"
+                )
+
+    def _build_tilelang_plans(self) -> SimpleNamespace:
+        self._check_cache_pages()
+        device = self.rotary_emb.cos_sin_cache.device
+        mla = _mla_plan(
+            self.n_local_heads,
+            self.swa_width,
+            512 if self.compress_ratio else 0,
+            self._main_page,
+            self.swa_cache_layer.block_size,
+            self.capacity,
+            device,
+        )
+        index, chunks = {}, {}
+        if self.indexer is not None:
+            reindex = self.layer_id > self.candidate_source_layer
+            width = (
+                CANDIDATE_BLOCKS * CANDIDATE_BLOCK
+                if reindex
+                else self._index_width * self._index_page
+            )
+            full = _index_plan(
+                width,
+                self._index_page,
+                reindex,
+                self.layer_id == self.candidate_source_layer,
+            )
+            index = {"decode": full, "prefill": full}
+            chunks = {"decode": self.DECODE_CHUNK, "prefill": self.INDEX_CHUNK}
+            if self._short_index_shape is not None:
+                rows, pages = self._short_index_shape
+                index["prefill_short"] = _index_plan(
+                    pages * self._index_page, self._index_page, False, False
+                )
+                chunks["prefill_short"] = rows
+        # Reserve the largest scratch each phase borrows: indexing, then the
+        # attention metadata arena with the decode route's segment workspace.
+        workspace = current_workspace_manager()
+        for mode, plan in index.items():
+            workspace.reserve_all(*plan.scratch_specs(chunks[mode]))
+        split_rows = min(mla.decode_max_rows, self.capacity)
+        for metadata_specs in self._attention_workspace_specs.values():
+            workspace.reserve_all(*metadata_specs, *mla.scratch_specs(split_rows))
+        return SimpleNamespace(mla=mla, index=index)
+
+    def _check_attention_rows(self, mode: str, rows: int) -> None:
+        capacity = self._tilelang().mla.max_rows
+        if rows > capacity:
+            raise ValueError(f"V4.1 {mode} rows {rows} exceed capacity {capacity}")
+
+    def _attention_scratch_specs(self, mode: str, rows: int):
+        return self._tilelang().mla.scratch_specs(rows)
+
+    def _quantize_index_query(self, mode: str, iq, iq_data, iq_scale) -> None:
+        quantize_mxfp4(iq, iq_data, iq_scale)
+
+    def _write_index_keys(self, key, slot_mapping) -> None:
+        write_index_keys(
+            key, self.indexer.k_cache.kv_cache, slot_mapping, self._index_page
+        )
+
+    def _index_chunk(
+        self,
+        mode: str,
+        rows: int,
+        *,
+        output_indices,
+        q_mxfp4,
+        q_scales,
+        query_weights,
+        page_table,
+        cache_lengths,
+        score_width=None,
+        candidate_indices=None,
+        candidate_lengths=None,
+        candidate_output=None,
+        candidate_output_lengths=None,
+    ):
+        # The kernels bound their work by each row's live length on device,
+        # so the host-side ``score_width`` hint has nothing left to trim.
+        del score_width
+        plan = self._tilelang().index[mode]
+        scratch = current_workspace_manager().get_simultaneous(
+            *plan.scratch_specs(rows)
+        )
+        retain_cuda_graph_capture_resource(scratch)
+        plan.run(
+            q_mxfp4,
+            q_scales,
+            query_weights,
+            self.indexer.k_cache.kv_cache,
+            page_table,
+            cache_lengths,
+            self._active,
+            candidate_indices,
+            candidate_lengths,
+            out=output_indices,
+            candidate_out=candidate_output,
+            candidate_out_lengths=candidate_output_lengths,
+            scratch=scratch,
+        )
+
+    def _attend(self, mode: str, q, output, *, scratch, **indices):
+        indexed = {}
+        if "indexed_indices" in indices:
+            indexed = dict(
+                idx_cache=self._owner().kv_cache,
+                idx_indices=indices["indexed_indices"],
+                idx_lengths=indices["indexed_lengths"],
+                idx_page_table=indices["indexed_page_table"],
+            )
+        self._tilelang().mla.run(
+            q,
+            self.swa_cache_layer.kv_cache,
+            indices["swa_indices"],
+            indices["swa_lengths"],
+            self.attn_sink,
+            output,
+            scratch=scratch or None,
+            **indexed,
+        )
+
+
+__all__ = ["DeepseekV41TileLangAttention", "DeepseekV41TileLangBackend"]
diff --git a/vllm/models/deepseek_v4_1/tilelang/gemm.py b/vllm/models/deepseek_v4_1/tilelang/gemm.py
new file mode 100644
index 000000000..db61cad83
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/gemm.py
@@ -0,0 +1,200 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek-V4.1-Flash block-32 FP8 linear for SM120 / SM121.
+
+V4.1 Flash stores its dense projections as E4M3 weights with one UE8M0 scale
+per 32x32 block (``weight_block_size = [32, 32]``, ``scale_fmt = "ue8m0"``) and
+quantizes activations dynamically to E4M3 with one UE8M0 scale per 32
+elements. Both operands are therefore MXFP8, and the GEMM maps directly onto
+SM120's ``mma.sync.m16n8k32.kind::mxf8f6f4.block_scale.scale_vec::1X``: the
+tensor core applies both scales per K32 atom and accumulates in FP32, so no
+per-block promotion loop is needed.
+
+Scales reach ``T.mma_gemm_blockscaled`` as uint32 words, each packing the
+UE8M0 exponents of four consecutive K32 blocks of one row (byte ``j`` covers
+K block ``4 * word + j``). The weight's 32x32 block scales are broadcast to
+per-row words once on the host.
+"""
+
+import tilelang
+import tilelang.language as T
+import torch
+
+SF_BLOCK = 32  # K elements per UE8M0 scale
+SF_WORD_K = 4 * SF_BLOCK  # K elements per packed scale word
+
+
+def scale_words(k: int) -> int:
+    """Packed UE8M0 words per row of a K-wide operand: four K32 exponents each."""
+    return tilelang.cdiv(k, SF_WORD_K)
+
+
+def block_scale_words(block_K: int) -> int:
+    """Scale words one K block reads: blocks off a 128 boundary straddle two words."""
+    return tilelang.cdiv(block_K + block_K % SF_WORD_K, SF_WORD_K)
+
+
+def pick_block_K(K: int, widest: int = 192) -> int:
+    """128 when it divides K; else the widest multiple of 64 up to ``widest`` that does.
+
+    TP3's 768-wide expert rows take 128; TP4's 576 take 192 (or 64).
+    """
+    for block_K in (128, *range(widest - widest % 64, 0, -64)):
+        if K % block_K == 0:
+            return block_K
+    raise ValueError(f"K={K} must be a multiple of 64")
+
+
+@tilelang.jit
+def mxfp8_gemm(
+    N: int,
+    K: int,
+    block_M: int = 128,
+    block_N: int = 128,
+    block_K: int = 128,
+    num_stages: int = 2,
+    threads: int = 128,
+    out_dtype: T.dtype = T.bfloat16,
+):
+    """``C[M, N] = (A * SFA) @ (B * SFB)^T`` for MXFP8 ``A[M, K]``, ``B[N, K]``.
+
+    M is dynamic. ``SFA`` / ``SFB`` hold ``ceil(K / 128)`` packed UE8M0 words
+    per row. ``block_K`` is any multiple of 64 dividing K; a block that starts
+    off a 128-element boundary reads the two words it straddles and tells the
+    MMA where it starts (``k_start``), so no operand is padded.
+
+    Each output accumulates over K in the same order whatever the tile shape,
+    so a row's result does not depend on M or on the configuration chosen.
+    """
+    assert K % block_K == 0 and block_K % 64 == 0, (
+        "block_K must divide K and be a multiple of 64"
+    )
+    M = T.dynamic("M")
+    in_dtype = T.float8_e4m3fn
+    accum_dtype = T.float32
+    sf_words = scale_words(K)
+    block_words = block_scale_words(block_K)
+
+    @T.prim_func
+    def main(
+        A: T.Tensor((M, K), in_dtype),
+        B: T.Tensor((N, K), in_dtype),
+        SFA: T.Tensor((M, sf_words), T.uint32),
+        SFB: T.Tensor((N, sf_words), T.uint32),
+        C: T.Tensor((M, N), out_dtype),
+    ):
+        with T.Kernel(
+            T.ceildiv(N, block_N), T.ceildiv(M, block_M), threads=threads
+        ) as (bx, by):
+            A_shared = T.alloc_shared((block_M, block_K), in_dtype)
+            B_shared = T.alloc_shared((block_N, block_K), in_dtype)
+            SFA_shared = T.alloc_shared((block_M, block_words), T.uint32)
+            SFB_shared = T.alloc_shared((block_N, block_words), T.uint32)
+            C_local = T.alloc_fragment((block_M, block_N), accum_dtype)
+
+            T.clear(C_local)
+            for ko in T.Pipelined(K // block_K, num_stages=num_stages):
+                T.copy(A[by * block_M, ko * block_K], A_shared)
+                T.copy(B[bx * block_N, ko * block_K], B_shared)
+                # Edge tiles clamp their scale rows; those rows are never stored.
+                word0 = ko * block_K // SF_WORD_K
+                for i, w in T.Parallel(block_M, block_words):
+                    SFA_shared[i, w] = SFA[
+                        T.min(by * block_M + i, M - 1), T.min(word0 + w, sf_words - 1)
+                    ]
+                for j, w in T.Parallel(block_N, block_words):
+                    SFB_shared[j, w] = SFB[
+                        T.min(bx * block_N + j, N - 1), T.min(word0 + w, sf_words - 1)
+                    ]
+                # The staged words start at the block's first word; k_start
+                # places the block inside it.
+                T.mma_gemm_blockscaled(
+                    A_shared,
+                    B_shared,
+                    C_local,
+                    SFA_shared,
+                    SFB_shared,
+                    transpose_B=True,
+                    k_start=ko * block_K % SF_WORD_K,
+                    sf_a_granularity_k=SF_BLOCK,
+                    sf_b_granularity_k=SF_BLOCK,
+                )
+            T.copy(C_local, C[by * block_M, bx * block_N])
+
+    return main
+
+
+@tilelang.jit
+def bf16_gemm(
+    N: int,
+    K: int,
+    block_M: int = 64,
+    block_N: int = 64,
+    block_K: int = 64,
+    num_stages: int = 3,
+    threads: int = 128,
+    out_dtype: T.dtype = T.bfloat16,
+):
+    """``C[M, N] = A @ B^T`` for BF16 ``A[M, K]`` and ``B[N, K]``, accumulated in FP32.
+
+    M is dynamic.
+
+    One configuration serves every M, so a row's result never depends on the
+    batch it runs in.
+    """
+    M = T.dynamic("M")
+    dtype = T.bfloat16
+
+    @T.prim_func
+    def main(
+        A: T.Tensor((M, K), dtype),
+        B: T.Tensor((N, K), dtype),
+        C: T.Tensor((M, N), out_dtype),
+    ):
+        with T.Kernel(
+            T.ceildiv(N, block_N), T.ceildiv(M, block_M), threads=threads
+        ) as (bx, by):
+            A_shared = T.alloc_shared((block_M, block_K), dtype)
+            B_shared = T.alloc_shared((block_N, block_K), dtype)
+            C_local = T.alloc_fragment((block_M, block_N), T.float32)
+            T.clear(C_local)
+            for ko in T.Pipelined(T.ceildiv(K, block_K), num_stages=num_stages):
+                T.copy(A[by * block_M, ko * block_K], A_shared)
+                T.copy(B[bx * block_N, ko * block_K], B_shared)
+                T.gemm(A_shared, B_shared, C_local, transpose_B=True)
+            T.copy(C_local, C[by * block_M, bx * block_N])
+
+    return main
+
+
+# ---------------------------------------------------------------------------
+# Scale packing and tile configuration
+# ---------------------------------------------------------------------------
+
+
+def pack_scale_words(exponents: torch.Tensor, rows: int | None = None) -> torch.Tensor:
+    """Pack ``[..., K / 32]`` UE8M0 bytes into ``[..., ceil(K / 128)]`` uint32 words.
+
+    With ``rows``, a ``[rows / 32, K / 32]`` block-scale grid is first
+    broadcast to every row. Rows whose exponent count is not a multiple of
+    four gain unread padding bytes (TP4's 576-wide rows: 18 bytes become 20).
+    """
+    exponents = exponents.view(torch.uint8)
+    if rows is not None and exponents.shape[0] != rows:
+        exponents = exponents.repeat_interleave(rows // exponents.shape[0], dim=0)
+    pad = -exponents.shape[-1] % 4
+    if pad:
+        exponents = torch.nn.functional.pad(exponents, (0, pad), value=127)
+    return exponents.contiguous().view(torch.uint32)
+
+
+def default_config(M: int, K: int) -> dict:
+    """Tile choice by row count: decode needs more, smaller N tiles to fill the GPU.
+
+    Tiles stay at least 64 rows tall. On SM121, warp-specialized 32x64 tiles
+    with cp.async scale staging intermittently read stale scales. The large
+    tiles keep K blocks of 128 or 64 to stay within 99 KiB of shared memory.
+    """
+    if M <= 64:
+        return dict(block_M=64, block_N=64, block_K=pick_block_K(K), num_stages=3)
+    return dict(block_M=128, block_N=128, block_K=pick_block_K(K, 128), num_stages=2)

@@ -0,0 +1,1187 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek-V4.1-Flash sparse-attention indexer for SM120 / SM121: scores and top-k.
+
+The V4.1 indexer has 32 heads of width 128. It keeps its keys in a paged
+MXFP4 cache: each page holds ``page_size`` rows of 64 bytes of packed E2M1
+(low nibble first), followed by ``page_size`` rows of 4 UE8M0 scales (one per
+32 dims). Queries are quantized to MXFP4 the same way, and per-head weights
+arrive as BF16, already multiplied by ``1/64`` and rounded.
+
+The published score keeps distinct BF16 rounding stages. For each position
+``j`` and head ``h``:
+
+    dot   = bf16(q_h . k_j)                     # FP32 accumulation
+    c_h   = bf16(max(dot, 0) * w_h)
+    score = bf16(c_0 + c_1 + ... + c_31)         # FP32, increasing head order
+
+``indexer_score_v41`` computes ``q . k`` straight from the packed operands with
+SM120's MXFP4 block-scaled MMA
+(``mma.sync.m16n8k64.kind::mxf4nvf4.block_scale.scale_vec::2X.ue8m0``), then
+applies the rounding stages and the ordered head sum in the epilogue. It
+scores either every position of a row's context, or only the positions in a
+candidate list (V4.1's reindex layers).
+
+``IndexerTopK`` selects the top ``k`` entries of each row exactly. Each
+4096-entry segment caches order-preserving 16-bit keys of its BF16 scores in
+shared memory, runs a two-pass 8-bit radix select and an ordered compaction
+(ties at the threshold keep the lowest positions), and keeps its own top
+``k``. Long rows then merge the segment winners with the same selection, so
+small batches still spread over many CTAs. Positions come back in ascending
+order, padded with ``-1``.
+``group=8`` ranks blocks of eight positions by their maximum, always keeping
+the block that holds the last visible position, and expands them: V4.1's
+candidate-domain selection at its candidate source layer.
+
+Selection is deterministic: the same scores give the same positions
+regardless of thread timing or batch composition.
+"""
+
+import tilelang
+import tilelang.language as T
+import torch
+
+from .gemm import SF_BLOCK
+
+INDEX_HEADS = 32
+INDEX_DIM = 128
+INDEX_TOPK = 512
+CANDIDATE_BLOCKS = 2048
+CANDIDATE_BLOCK = 8
+# Order-preserving uint16 key of BF16 -inf: entries at or below it are never selected.
+_KEY_NEG_INF = 0x007F
+
+
+def page_bytes(page_size: int) -> int:
+    """Index-cache page bytes: ``[page_size, 64]`` data, ``[page_size, 4]`` UE8M0."""
+    return page_size * (INDEX_DIM // 2 + INDEX_DIM // SF_BLOCK)
+
+
+def _row_extent(Lengths, Active, row, width):
+    """Positions a row selects from: ``min(Lengths, Active, width)``, at least zero.
+
+    Candidate rows have no ``Active`` cap: their length counts candidates.
+    """
+    extent = T.max(Lengths[row], 0)
+    if Active is not None:
+        extent = T.min(extent, T.max(Active[0], 0))
+    return T.min(extent, width)
+
+
+@tilelang.jit
+def indexer_score_v41(
+    width: int,
+    page_size: int,
+    candidates: bool = False,
+    heads: int = INDEX_HEADS,
+    block_P: int = 64,
+    threads: int = 128,
+    max_ctas: int = 128,
+):
+    """Build the score kernel. Inputs:
+
+    - ``Q``: ``[rows, heads, 128]`` E2M1 queries (``[rows, heads, 64]`` int8 storage);
+    - ``QScale``: ``[rows, heads]`` uint32, the four UE8M0 scales of each head;
+    - ``Weights``: ``[rows, heads]`` BF16 head weights;
+    - ``KPool``: E2M1 view (``[pages, page_bytes * 2]`` logical) of the index cache;
+    - ``KScale``: uint32 view (``[pages, page_bytes / 4]``) of the same cache.
+      Both may keep the allocator's page stride when it pads pages;
+    - ``PageTable``: ``[rows, table_width]`` int32 physical page per logical page;
+    - ``Lengths``: ``[rows]`` int32 positions per row;
+    - ``Active``: ``[1]`` int32 width cap;
+    - candidate mode: ``Candidates`` ``[rows, width]`` int32 positions and
+      ``CandidateLengths`` ``[rows]``.
+
+    Writes ``Scores`` (``[rows, width]`` BF16) up to each row's extent, ``-inf``
+    for masked candidates; entries past the extent are left unwritten and the
+    top-k never reads them. Each row gets at most ``max_ctas`` CTAs, which loop
+    over its live tiles, so the launch scales with the context in use rather
+    than the planned width.
+    """
+    assert page_size % block_P == 0 or candidates, (
+        "dense tiles must not straddle a page"
+    )
+    rows, pool_pages, table_width, pool_stride, scale_stride = T.dynamic(
+        "rows, pool_pages, table_width, pool_stride, scale_stride"
+    )
+    D = INDEX_DIM
+    fp4 = T.float4_e2m1fn
+    accum_dtype = T.float32
+    page_words = page_bytes(page_size) // 4
+    scale_word0 = page_size * D // 2 // 4  # first scale word of a page
+    ctas = min(tilelang.cdiv(width, block_P), max_ctas)
+
+    @T.macro
+    def score_row(
+        Q,
+        QScale,
+        Weights,
+        KPool,
+        KScale,
+        PageTable,
+        row,
+        cta,
+        extent,
+        position,
+        slot_valid,
+        Scores,
+    ):
+        K_shared = T.alloc_shared([block_P, D], fp4)
+        Q_shared = T.alloc_shared([heads, D], fp4)
+        SFK_shared = T.alloc_shared([block_P, 1], T.uint32)
+        SFQ_shared = T.alloc_shared([heads, 1], T.uint32)
+        W_shared = T.alloc_shared([heads], accum_dtype)
+        contrib = T.alloc_shared([block_P, heads], accum_dtype)
+        acc = T.alloc_fragment([block_P, heads], accum_dtype)
+        total = T.alloc_fragment([block_P], accum_dtype)
+
+        for h, d in T.Parallel(heads, D):
+            Q_shared[h, d] = Q[row, h, d]
+        for h in T.Parallel(heads):
+            SFQ_shared[h, 0] = QScale[row, h]
+            W_shared[h] = T.cast(Weights[row, h], accum_dtype)
+        for i in T.serial(T.ceildiv(T.max(T.ceildiv(extent, block_P) - cta, 0), ctas)):
+            p0 = (cta + i * ctas) * block_P
+            # Invalid slots load a clamped, in-pool key and are masked at the end.
+            for p, d in T.Parallel(block_P, D):
+                pos = position(p0, p)
+                page = T.min(
+                    T.max(PageTable[row, T.min(pos // page_size, table_width - 1)], 0),
+                    pool_pages - 1,
+                )
+                K_shared[p, d] = KPool[page, (pos % page_size) * D + d]
+            for p in T.Parallel(block_P):
+                pos = position(p0, p)
+                page = T.min(
+                    T.max(PageTable[row, T.min(pos // page_size, table_width - 1)], 0),
+                    pool_pages - 1,
+                )
+                SFK_shared[p, 0] = KScale[page, scale_word0 + pos % page_size]
+            T.mma_gemm_blockscaled(
+                K_shared,
+                Q_shared,
+                acc,
+                SFK_shared,
+                SFQ_shared,
+                transpose_B=True,
+                clear_accum=True,
+                k_start=0,
+                sf_a_granularity_k=SF_BLOCK,
+                sf_b_granularity_k=SF_BLOCK,
+            )
+            # The published rounding stages: BF16 dot, ReLU, BF16 weighted product.
+            for p, h in T.Parallel(block_P, heads):
+                dot = T.max(T.cast(T.cast(acc[p, h], T.bfloat16), accum_dtype), 0.0)
+                contrib[p, h] = T.cast(
+                    T.cast(T.fmul(dot, W_shared[h]), T.bfloat16), accum_dtype
+                )
+            T.fill(total, 0)
+            for h in T.serial(heads):  # increasing head order, FP32
+                for p in T.Parallel(block_P):
+                    total[p] += contrib[p, h]
+            for p in T.Parallel(block_P):
+                if p0 + p < extent:
+                    Scores[row, p0 + p] = T.if_then_else(
+                        slot_valid(p0, p),
+                        T.cast(total[p], T.bfloat16),
+                        -T.infinity(T.bfloat16),
+                    )
+
+    if not candidates:
+
+        @T.prim_func
+        def main(
+            Q: T.Tensor([rows, heads, D], fp4),
+            QScale: T.Tensor([rows, heads], T.uint32),
+            Weights: T.Tensor([rows, heads], T.bfloat16),
+            KPool: T.StridedTensor([pool_pages, page_words * 8], [pool_stride, 1], fp4),
+            KScale: T.StridedTensor(
+                [pool_pages, page_words], [scale_stride, 1], T.uint32
+            ),
+            PageTable: T.Tensor([rows, table_width], T.int32),
+            Lengths: T.Tensor([rows], T.int32),
+            Active: T.Tensor([1], T.int32),
+            Scores: T.Tensor([rows, width], T.bfloat16),
+        ):
+            with T.Kernel(ctas, rows, threads=threads) as (cta, row):
+                extent = _row_extent(Lengths, Active, row, width)
+                score_row(
+                    Q,
+                    QScale,
+                    Weights,
+                    KPool,
+                    KScale,
+                    PageTable,
+                    row,
+                    cta,
+                    extent,
+                    lambda p0, p: p0 + p,
+                    lambda p0, p: True,
+                    Scores,
+                )
+
+        return main
+
+    @T.prim_func
+    def main(
+        Q: T.Tensor([rows, heads, D], fp4),
+        QScale: T.Tensor([rows, heads], T.uint32),
+        Weights: T.Tensor([rows, heads], T.bfloat16),
+        KPool: T.StridedTensor([pool_pages, page_words * 8], [pool_stride, 1], fp4),
+        KScale: T.StridedTensor([pool_pages, page_words], [scale_stride, 1], T.uint32),
+        PageTable: T.Tensor([rows, table_width], T.int32),
+        Lengths: T.Tensor([rows], T.int32),
+        Active: T.Tensor([1], T.int32),
+        Candidates: T.Tensor([rows, width], T.int32),
+        CandidateLengths: T.Tensor([rows], T.int32),
+        Scores: T.Tensor([rows, width], T.bfloat16),
+    ):
+        with T.Kernel(ctas, rows, threads=threads) as (cta, row):
+            extent = _row_extent(CandidateLengths, None, row, width)
+            score_row(
+                Q,
+                QScale,
+                Weights,
+                KPool,
+                KScale,
+                PageTable,
+                row,
+                cta,
+                extent,
+                lambda p0, p: T.max(Candidates[row, T.min(p0 + p, width - 1)], 0),
+                lambda p0, p: Candidates[row, T.min(p0 + p, width - 1)] >= 0,
+                Scores,
+            )
+
+    return main
+
+
+def _e2m1_code(x):
+    """Nearest-even E2M1 code of FP32 ``x``, saturating at 6 (``cvt.rn.satfinite``)."""
+    m = T.abs(x)
+    # Ties go to the even code: strict at even-lower midpoints, inclusive at odd.
+    code = (
+        T.cast(m > 0.25, T.int32)
+        + T.cast(m >= 0.75, T.int32)
+        + T.cast(m > 1.25, T.int32)
+        + T.cast(m >= 1.75, T.int32)
+        + T.cast(m > 2.5, T.int32)
+        + T.cast(m >= 3.5, T.int32)
+        + T.cast(m > 5.0, T.int32)
+    )
+    sign = T.cast(T.shift_right(T.reinterpret(x, T.uint32), 31), T.int32)
+    return code | (sign << 3)
+
+
+def _mxfp4_byte(X, row, first, scale):
+    """Two scaled values ``X[row, first : first + 2]`` packed low nibble first."""
+    lo = _e2m1_code(T.fmul(T.cast(X[row, first], T.float32), scale))
+    hi = _e2m1_code(T.fmul(T.cast(X[row, first + 1], T.float32), scale))
+    return T.cast(lo | (hi << 4), T.uint8)
+
+
+@tilelang.jit
+def mxfp4_quantize_v41(paged: bool = False, page_size: int = 64, threads: int = 128):
+    """MXFP4-quantize ``[rows, 128]`` BF16 vectors, one thread per 32-value group.
+
+    Each group's UE8M0 scale is ``pow2_ceil(max(amax, 6 * 2^-126) * fp32(1/6))``
+    and its values round to nearest even E2M1, as B12X's quantizer does, so
+    both backends see identical index queries and keys. The output is either
+    contiguous (``Q`` ``[rows, 64]`` packed, ``S`` ``[rows, 4]``) or, with
+    ``paged``, written through ``Slots`` (``[rows]`` int64; negative slots
+    skip) into index-cache pages ``Pool`` (``[pages, page bytes]``, any row
+    stride).
+    """
+    rows, pool_pages, pool_stride = T.dynamic("rows, pool_pages, pool_stride")
+    groups = INDEX_DIM // SF_BLOCK
+    half = SF_BLOCK // 2
+
+    @T.macro
+    def body(X, Q, S, Slots, Pool):
+        with T.Kernel(T.ceildiv(rows * groups, threads), threads=threads) as bx:
+            tx = T.get_thread_binding()
+            g = bx * threads + tx
+            row, k = g // groups, g % groups
+            amax = T.alloc_var(T.float32)
+            if row < rows:
+                amax = 6.0 * 2.0**-126
+                for i in T.serial(SF_BLOCK):
+                    amax = T.max(
+                        amax, T.abs(T.cast(X[row, k * SF_BLOCK + i], T.float32))
+                    )
+                bits = T.reinterpret(T.fmul(amax, T.float32(1.0 / 6.0)), T.uint32)
+                sf = T.cast(T.shift_right(bits, 23) & 0xFF, T.int32) + T.cast(
+                    (bits & 0x7FFFFF) != 0, T.int32
+                )
+                scale = T.reinterpret(
+                    T.cast(T.shift_left(254 - sf, 23), T.uint32), T.float32
+                )
+                if paged:
+                    slot = Slots[row]
+                    page, token = slot // page_size, slot % page_size
+                    if (slot >= 0) & (page < pool_pages):
+                        for i in T.serial(half):
+                            Pool[page, token * (INDEX_DIM // 2) + k * half + i] = (
+                                _mxfp4_byte(X, row, k * SF_BLOCK + 2 * i, scale)
+                            )
+                        Pool[
+                            page, page_size * (INDEX_DIM // 2) + token * groups + k
+                        ] = T.cast(sf, T.uint8)
+                else:
+                    for i in T.serial(half):
+                        Q[row, k * half + i] = _mxfp4_byte(
+                            X, row, k * SF_BLOCK + 2 * i, scale
+                        )
+                    S[row, k] = T.cast(sf, T.uint8)
+
+    if paged:
+
+        @T.prim_func
+        def main(
+            X: T.Tensor([rows, INDEX_DIM], T.bfloat16),
+            Slots: T.Tensor([rows], T.int64),
+            Pool: T.StridedTensor(
+                [pool_pages, page_bytes(page_size)], [pool_stride, 1], T.uint8
+            ),
+        ):
+            body(X, None, None, Slots, Pool)
+
+        return main
+
+    @T.prim_func
+    def main(
+        X: T.Tensor([rows, INDEX_DIM], T.bfloat16),
+        Q: T.Tensor([rows, INDEX_DIM // 2], T.uint8),
+        S: T.Tensor([rows, groups], T.uint8),
+    ):
+        body(X, Q, S, None, None)
+
+    return main
+
+
+def quantize_mxfp4(x, q, scales):
+    """MXFP4-quantize ``[..., 128]`` BF16 into ``q`` and ``scales``.
+
+    ``q`` is ``[..., 64]`` packed E2M1; ``scales`` is ``[..., 4]`` UE8M0.
+    """
+    mxfp4_quantize_v41()(
+        x.reshape(-1, INDEX_DIM),
+        q.view(-1, INDEX_DIM // 2),
+        scales.view(-1, INDEX_DIM // SF_BLOCK),
+    )
+    return q, scales
+
+
+def write_index_keys(keys, pool, slots, page_size):
+    """Quantize ``[rows, 128]`` keys into index-cache pages at ``slots`` (-1 skips)."""
+    kernel = mxfp4_quantize_v41(True, page_size)
+    kernel(keys, slots.to(torch.int64), pool[:, : page_bytes(page_size)])
+
+
+def _key16(x):
+    """Order-preserving uint16 key of a BF16 value, as int32."""
+    bits = T.cast(T.reinterpret(x, T.uint16), T.int32)
+    return T.if_then_else(bits >= 0x8000, bits ^ 0xFFFF, bits | 0x8000)
+
+
+def _value16(key):
+    """The BF16 value of an order-preserving key."""
+    return T.reinterpret(
+        T.cast(T.if_then_else(key >= 0x8000, key ^ 0x8000, key ^ 0xFFFF), T.uint16),
+        T.bfloat16,
+    )
+
+
+_TOPK_THREADS = 512
+_SEGMENT_ENTRIES = _TOPK_THREADS * 8
+
+
+def _select_macros(threads, topk):
+    """Radix threshold and ordered compaction over int32 keys held in shared memory."""
+    radix = 256
+    steps = threads.bit_length() - 1
+
+    @T.macro
+    def block_scan(values, tx, n_steps):
+        # Inclusive Hillis-Steele scan of values[0:threads].
+        carry = T.alloc_var(T.int32)
+        for s in T.serial(n_steps):
+            off = 1 << s
+            carry = T.if_then_else(tx >= off, values[T.max(tx - off, 0)], 0)
+            T.sync_threads()
+            values[tx] += carry
+            T.sync_threads()
+
+    @T.macro
+    def suffix_counts(hist, scan, tx):
+        # hist[b] <- number of keys whose digit is >= b; hist[radix] = 0.
+        if tx < radix:
+            scan[tx] = hist[radix - 1 - tx]
+        T.sync_threads()
+        block_scan(scan, tx, 8)
+        if tx < radix:
+            hist[radix - 1 - tx] = scan[tx]
+        if tx == 0:
+            hist[radix] = 0
+        T.sync_threads()
+
+    @T.macro
+    def threshold(keys, n, tx, hist, scan, params):
+        """Top ``topk`` of keys[0:n]: params[0] <- threshold, params[1] <- ties kept."""
+        key = T.alloc_var(T.int32)
+        if tx < radix + 1:
+            hist[tx] = 0
+        if tx == 0:
+            params[2] = 0
+            params[3] = 0
+        T.sync_threads()
+        for i in T.serial(T.ceildiv(n, threads)):
+            if i * threads + tx < n:
+                key = keys[i * threads + tx]
+                if key > _KEY_NEG_INF:
+                    T.atomic_add(hist[key >> 8], 1)
+        T.sync_threads()
+        suffix_counts(hist, scan, tx)
+        if tx < radix:  # noqa: SIM102 - the guard keeps hist[tx + 1] in bounds; TIR & is not short-circuit
+            if (hist[tx] >= topk) & (hist[tx + 1] < topk):
+                params[2] = tx
+        T.sync_threads()
+        hi = T.alloc_var(T.int32)
+        above = T.alloc_var(T.int32)
+        selectable = T.alloc_var(T.int32)
+        hi = params[2]
+        above = hist[hi + 1]
+        selectable = hist[0]
+        T.sync_threads()
+        if tx < radix + 1:
+            hist[tx] = 0
+        T.sync_threads()
+        for i in T.serial(T.ceildiv(n, threads)):
+            if i * threads + tx < n:
+                key = keys[i * threads + tx]
+                if (key > _KEY_NEG_INF) & ((key >> 8) == hi):
+                    T.atomic_add(hist[key & 0xFF], 1)
+        T.sync_threads()
+        suffix_counts(hist, scan, tx)
+        if tx < radix:  # noqa: SIM102 - the guard keeps hist[tx + 1] in bounds
+            if (above + hist[tx] >= topk) & (above + hist[tx + 1] < topk):
+                params[3] = tx
+        T.sync_threads()
+        if tx == 0:
+            if selectable <= topk:
+                # Everything selectable survives.
+                params[0] = _KEY_NEG_INF + 1
+                params[1] = selectable
+            else:
+                params[0] = (hi << 8) | params[3]
+                params[1] = topk - above - hist[params[3] + 1]
+        T.sync_threads()
+
+    @T.macro
+    def compact(keys, per, tx, scan, params, sel_idx, sel_key):
+        """Write the selected indices and keys to sel_idx/sel_key in index order.
+
+        Ties at the threshold keep the lowest indices. Each thread owns
+        keys[tx * per : (tx + 1) * per]. Leaves the selected count in
+        scan[threads - 1].
+        """
+        key = T.alloc_var(T.int32)
+        n_gt = T.alloc_var(T.int32)
+        n_eq = T.alloc_var(T.int32)
+        sel_eq = T.alloc_var(T.int32)
+        out_pos = T.alloc_var(T.int32)
+        taken = T.alloc_var(T.int32)
+        thr = T.alloc_var(T.int32)
+        need = T.alloc_var(T.int32)
+        thr = params[0]
+        need = params[1]
+        n_gt = 0
+        n_eq = 0
+        for v in T.serial(per):
+            key = keys[tx * per + v]
+            if key > thr:
+                n_gt += 1
+            elif key == thr:
+                n_eq += 1
+        scan[tx] = n_eq
+        T.sync_threads()
+        block_scan(scan, tx, steps)
+        sel_eq = T.max(T.min(need - (scan[tx] - n_eq), n_eq), 0)
+        T.sync_threads()
+        scan[tx] = n_gt + sel_eq
+        T.sync_threads()
+        block_scan(scan, tx, steps)
+        out_pos = scan[tx] - n_gt - sel_eq
+        taken = 0
+        for v in T.serial(per):
+            key = keys[tx * per + v]
+            if (key > thr) | ((key == thr) & (taken < sel_eq)):
+                if key == thr:
+                    taken += 1
+                sel_idx[out_pos] = tx * per + v
+                sel_key[out_pos] = key
+                out_pos += 1
+        T.sync_threads()
+
+    return threshold, compact
+
+
+def _final_writer(threads, topk, group):
+    @T.macro
+    def write_final(
+        Indices, Values, Counts, Gather, row, extent, total, entry, sel_key, params
+    ):
+        """Write the ``total`` selected entries (``entry(slot)``), ``-1`` padded.
+
+        Grouped entries expand to their positions below ``extent``; ``Counts``
+        receives how many positions that leaves.
+        """
+        tx = T.get_thread_binding()
+        count = T.alloc_var(T.int32)
+        count = 0
+        for i in T.serial(T.ceildiv(topk, threads)):
+            slot = i * threads + tx
+            if slot < topk:
+                if slot < total:
+                    e = entry(slot)
+                    Values[row, slot] = _value16(sel_key[slot])
+                    if group == 1:
+                        if Gather is not None:
+                            Indices[row, slot] = Gather[row, e]
+                        else:
+                            Indices[row, slot] = e
+                    else:
+                        for o in T.serial(group):
+                            Indices[row, slot * group + o] = T.if_then_else(
+                                e * group + o < extent, e * group + o, -1
+                            )
+                        count += T.min(group, extent - e * group)
+                else:
+                    Values[row, slot] = -T.infinity(T.bfloat16)
+                    for o in T.serial(group):
+                        Indices[row, slot * group + o] = -1
+        if Counts is not None:
+            T.sync_threads()
+            if tx == 0:
+                params[0] = 0
+            T.sync_threads()
+            T.atomic_add(params[0], count)
+            T.sync_threads()
+            if tx == 0:
+                Counts[row] = params[0]
+
+    return write_final
+
+
+@tilelang.jit(
+    pass_configs={tilelang.PassConfigKey.TL_DISABLE_THREAD_STORAGE_SYNC: True}
+)
+def indexer_topk_segment_v41(
+    width: int,
+    topk: int = INDEX_TOPK,
+    group: int = 1,
+    final: bool = True,
+    candidates: bool = False,
+    threads: int = _TOPK_THREADS,
+):
+    """Stage 1: the exact top-``topk`` of each ``_SEGMENT_ENTRIES``-entry row segment.
+
+    Inputs: ``Scores`` (``[rows, width]`` BF16), ``Lengths`` (``[rows]`` int32)
+    and, unless ``candidates``, ``Active`` (``[1]`` int32): a row selects from
+    its first ``min(Lengths, Active, width)`` positions. With ``group > 1`` an
+    entry is a block of ``group`` positions keyed by its maximum; the block
+    holding the last position always ranks first.
+
+    ``final`` (one segment per row) writes ``Indices`` (``[rows, topk * group]``
+    int32 ascending positions, ``-1`` padded) and ``Values`` (``[rows, topk]``
+    BF16); ``candidates`` maps entries through ``Gather`` (``[rows, width]``),
+    and ``group > 1`` also writes ``Counts`` (``[rows]`` positions kept).
+    Otherwise it writes each live segment's winners, in entry order, to
+    ``WorkValues`` / ``WorkEntries`` (``[rows, segments * topk]``, ``-1``
+    padded); segments past a row's extent are left unwritten.
+    """
+    assert not (candidates and group > 1), "candidate rows select positions, not blocks"
+    rows = T.dynamic("rows")
+    entries = tilelang.cdiv(width, group)
+    segment = _SEGMENT_ENTRIES
+    segments = tilelang.cdiv(entries, segment)
+    assert not final or segments == 1, "a final segment must cover the row"
+    per = segment // threads
+    threshold, compact = _select_macros(threads, topk)
+    write_final = _final_writer(threads, topk, group)
+
+    @T.macro
+    def select_segment(
+        Scores, extent, row, seg, keys, hist, scan, params, sel_idx, sel_key
+    ):
+        tx = T.get_thread_binding()
+        best = T.alloc_var(T.int32)
+        n_entries = T.ceildiv(extent, group)
+        for i in T.serial(per):
+            j = i * threads + tx
+            e = seg * segment + j
+            if group == 1:
+                keys[j] = T.if_then_else(
+                    e < n_entries, _key16(Scores[row, T.min(e, width - 1)]), 0
+                )
+            else:
+                best = 0
+                for o in T.serial(group):
+                    if (e < n_entries) & (e * group + o < extent):
+                        best = T.max(
+                            best, _key16(Scores[row, T.min(e * group + o, width - 1)])
+                        )
+                # The block holding the last visible position always survives.
+                keys[j] = T.if_then_else(
+                    (e < n_entries) & (e == (extent - 1) // group), 0xFF80, best
+                )
+        T.sync_threads()
+        threshold(keys, segment, tx, hist, scan, params)
+        compact(keys, per, tx, scan, params, sel_idx, sel_key)
+
+    @T.macro
+    def body(
+        Scores,
+        Lengths,
+        Active,
+        Gather,
+        Indices,
+        Values,
+        Counts,
+        WorkValues,
+        WorkEntries,
+    ):
+        with T.Kernel(segments, rows, threads=threads) as (seg, row):
+            tx = T.get_thread_binding()
+            keys = T.alloc_shared([segment], T.int32)
+            hist = T.alloc_shared([257], T.int32)
+            scan = T.alloc_shared([threads], T.int32)
+            params = T.alloc_shared([4], T.int32)
+            sel_idx = T.alloc_shared([topk], T.int32)
+            sel_key = T.alloc_shared([topk], T.int32)
+            extent = _row_extent(Lengths, Active, row, width)
+            if final:
+                select_segment(
+                    Scores, extent, row, 0, keys, hist, scan, params, sel_idx, sel_key
+                )
+                write_final(
+                    Indices,
+                    Values,
+                    Counts,
+                    Gather,
+                    row,
+                    extent,
+                    scan[threads - 1],
+                    lambda slot: sel_idx[slot],
+                    sel_key,
+                    params,
+                )
+            elif seg * segment < T.ceildiv(extent, group):
+                # Segments past the row's extent hold nothing; the merges skip them.
+                select_segment(
+                    Scores, extent, row, seg, keys, hist, scan, params, sel_idx, sel_key
+                )
+                total = scan[threads - 1]
+                for i in T.serial(T.ceildiv(topk, threads)):
+                    slot = i * threads + tx
+                    if slot < topk:
+                        if slot < total:
+                            WorkValues[row, seg * topk + slot] = _value16(sel_key[slot])
+                            WorkEntries[row, seg * topk + slot] = (
+                                seg * segment + sel_idx[slot]
+                            )
+                        else:
+                            WorkValues[row, seg * topk + slot] = -T.infinity(T.bfloat16)
+                            WorkEntries[row, seg * topk + slot] = -1
+
+    if not final:
+        if candidates:
+
+            @T.prim_func
+            def main(
+                Scores: T.Tensor([rows, width], T.bfloat16),
+                Lengths: T.Tensor([rows], T.int32),
+                WorkValues: T.Tensor([rows, segments * topk], T.bfloat16),
+                WorkEntries: T.Tensor([rows, segments * topk], T.int32),
+            ):
+                body(
+                    Scores,
+                    Lengths,
+                    None,
+                    None,
+                    None,
+                    None,
+                    None,
+                    WorkValues,
+                    WorkEntries,
+                )
+
+            return main
+
+        @T.prim_func
+        def main(
+            Scores: T.Tensor([rows, width], T.bfloat16),
+            Lengths: T.Tensor([rows], T.int32),
+            Active: T.Tensor([1], T.int32),
+            WorkValues: T.Tensor([rows, segments * topk], T.bfloat16),
+            WorkEntries: T.Tensor([rows, segments * topk], T.int32),
+        ):
+            body(
+                Scores, Lengths, Active, None, None, None, None, WorkValues, WorkEntries
+            )
+
+        return main
+
+    if candidates:
+
+        @T.prim_func
+        def main(
+            Scores: T.Tensor([rows, width], T.bfloat16),
+            Lengths: T.Tensor([rows], T.int32),
+            Gather: T.Tensor([rows, width], T.int32),
+            Indices: T.Tensor([rows, topk], T.int32),
+            Values: T.Tensor([rows, topk], T.bfloat16),
+        ):
+            body(Scores, Lengths, None, Gather, Indices, Values, None, None, None)
+
+        return main
+
+    if group > 1:
+
+        @T.prim_func
+        def main(
+            Scores: T.Tensor([rows, width], T.bfloat16),
+            Lengths: T.Tensor([rows], T.int32),
+            Active: T.Tensor([1], T.int32),
+            Indices: T.Tensor([rows, topk * group], T.int32),
+            Values: T.Tensor([rows, topk], T.bfloat16),
+            Counts: T.Tensor([rows], T.int32),
+        ):
+            body(Scores, Lengths, Active, None, Indices, Values, Counts, None, None)
+
+        return main
+
+    @T.prim_func
+    def main(
+        Scores: T.Tensor([rows, width], T.bfloat16),
+        Lengths: T.Tensor([rows], T.int32),
+        Active: T.Tensor([1], T.int32),
+        Indices: T.Tensor([rows, topk], T.int32),
+        Values: T.Tensor([rows, topk], T.bfloat16),
+    ):
+        body(Scores, Lengths, Active, None, Indices, Values, None, None, None)
+
+    return main
+
+
+@tilelang.jit(
+    pass_configs={tilelang.PassConfigKey.TL_DISABLE_THREAD_STORAGE_SYNC: True}
+)
+def indexer_topk_merge_v41(
+    width: int,
+    topk: int = INDEX_TOPK,
+    group: int = 1,
+    lists: int = 2,
+    span: int = _SEGMENT_ENTRIES,
+    fan_in: int = 16,
+    candidates: bool = False,
+    threads: int = _TOPK_THREADS,
+):
+    """Merge winner lists: the exact top-``topk`` of every ``fan_in`` lists.
+
+    Input list ``l`` of a row holds the winners, in ascending entry order, of
+    entries ``[l * span, (l + 1) * span)``; lists past the row's extent
+    (``Lengths`` and ``Active`` as in ``indexer_topk_segment_v41``) are never
+    read. One output list leaves each group of ``fan_in`` inputs, again in
+    entry order, so ties keep the lowest positions at every level exactly as
+    a one-pass selection would. With one group the merge is final and writes
+    ``Indices``, ``Values`` (and ``Counts``) like the final segment kernel;
+    otherwise it writes ``OutValues`` / ``OutEntries`` (``[rows, groups *
+    topk]``), leaving groups past the extent unwritten.
+    """
+    assert not (candidates and group > 1), "candidate rows select positions, not blocks"
+    rows = T.dynamic("rows")
+    groups = tilelang.cdiv(lists, fan_in)
+    final = groups == 1
+    n = min(lists, fan_in) * topk
+    n_pad = tilelang.cdiv(n, threads) * threads
+    per = n_pad // threads
+    assert n_pad * 4 <= 64 * 1024, f"{n} merge keys exceed shared memory; lower fan_in"
+    threshold, compact = _select_macros(threads, topk)
+    write_final = _final_writer(threads, topk, group)
+
+    @T.macro
+    def body(WorkValues, WorkEntries, Lengths, Active, Gather, Indices, Values, Counts):
+        with T.Kernel(groups, rows, threads=threads) as (g, row):
+            tx = T.get_thread_binding()
+            keys = T.alloc_shared([n_pad], T.int32)
+            hist = T.alloc_shared([257], T.int32)
+            scan = T.alloc_shared([threads], T.int32)
+            params = T.alloc_shared([4], T.int32)
+            sel_idx = T.alloc_shared([topk], T.int32)
+            sel_key = T.alloc_shared([topk], T.int32)
+            extent = _row_extent(Lengths, Active, row, width)
+            live = T.min(
+                T.ceildiv(T.ceildiv(extent, group), span), lists
+            )  # input lists with entries
+            base = g * fan_in * topk
+            # A final merge always writes its row; others skip groups past the extent.
+            selects = True if final else g * fan_in < live
+            if selects:
+                for i in T.serial(per):
+                    j = i * threads + tx
+                    c = T.min(base + j, lists * topk - 1)
+                    keys[j] = T.if_then_else(
+                        (j < n)
+                        & (g * fan_in + j // topk < live)
+                        & (WorkEntries[row, c] >= 0),
+                        _key16(WorkValues[row, c]),
+                        0,
+                    )
+                T.sync_threads()
+                threshold(keys, n_pad, tx, hist, scan, params)
+                compact(keys, per, tx, scan, params, sel_idx, sel_key)
+                total = scan[threads - 1]
+                if final:
+                    write_final(
+                        Indices,
+                        Values,
+                        Counts,
+                        Gather,
+                        row,
+                        extent,
+                        total,
+                        lambda slot: WorkEntries[row, sel_idx[slot]],
+                        sel_key,
+                        params,
+                    )
+                else:
+                    for i in T.serial(T.ceildiv(topk, threads)):
+                        slot = i * threads + tx
+                        if slot < topk:
+                            if slot < total:
+                                Values[row, g * topk + slot] = _value16(sel_key[slot])
+                                Indices[row, g * topk + slot] = WorkEntries[
+                                    row, base + sel_idx[slot]
+                                ]
+                            else:
+                                Values[row, g * topk + slot] = -T.infinity(T.bfloat16)
+                                Indices[row, g * topk + slot] = -1
+
+    if not final:
+        if candidates:
+
+            @T.prim_func
+            def main(
+                WorkValues: T.Tensor([rows, lists * topk], T.bfloat16),
+                WorkEntries: T.Tensor([rows, lists * topk], T.int32),
+                Lengths: T.Tensor([rows], T.int32),
+                OutValues: T.Tensor([rows, groups * topk], T.bfloat16),
+                OutEntries: T.Tensor([rows, groups * topk], T.int32),
+            ):
+                body(
+                    WorkValues,
+                    WorkEntries,
+                    Lengths,
+                    None,
+                    None,
+                    OutEntries,
+                    OutValues,
+                    None,
+                )
+
+            return main
+
+        @T.prim_func
+        def main(
+            WorkValues: T.Tensor([rows, lists * topk], T.bfloat16),
+            WorkEntries: T.Tensor([rows, lists * topk], T.int32),
+            Lengths: T.Tensor([rows], T.int32),
+            Active: T.Tensor([1], T.int32),
+            OutValues: T.Tensor([rows, groups * topk], T.bfloat16),
+            OutEntries: T.Tensor([rows, groups * topk], T.int32),
+        ):
+            body(
+                WorkValues,
+                WorkEntries,
+                Lengths,
+                Active,
+                None,
+                OutEntries,
+                OutValues,
+                None,
+            )
+
+        return main
+
+    if candidates:
+
+        @T.prim_func
+        def main(
+            WorkValues: T.Tensor([rows, lists * topk], T.bfloat16),
+            WorkEntries: T.Tensor([rows, lists * topk], T.int32),
+            Lengths: T.Tensor([rows], T.int32),
+            Gather: T.Tensor([rows, width], T.int32),
+            Indices: T.Tensor([rows, topk], T.int32),
+            Values: T.Tensor([rows, topk], T.bfloat16),
+        ):
+            body(WorkValues, WorkEntries, Lengths, None, Gather, Indices, Values, None)
+
+        return main
+
+    if group > 1:
+
+        @T.prim_func
+        def main(
+            WorkValues: T.Tensor([rows, lists * topk], T.bfloat16),
+            WorkEntries: T.Tensor([rows, lists * topk], T.int32),
+            Lengths: T.Tensor([rows], T.int32),
+            Active: T.Tensor([1], T.int32),
+            Indices: T.Tensor([rows, topk * group], T.int32),
+            Values: T.Tensor([rows, topk], T.bfloat16),
+            Counts: T.Tensor([rows], T.int32),
+        ):
+            body(
+                WorkValues, WorkEntries, Lengths, Active, None, Indices, Values, Counts
+            )
+
+        return main
+
+    @T.prim_func
+    def main(
+        WorkValues: T.Tensor([rows, lists * topk], T.bfloat16),
+        WorkEntries: T.Tensor([rows, lists * topk], T.int32),
+        Lengths: T.Tensor([rows], T.int32),
+        Active: T.Tensor([1], T.int32),
+        Indices: T.Tensor([rows, topk], T.int32),
+        Values: T.Tensor([rows, topk], T.bfloat16),
+    ):
+        body(WorkValues, WorkEntries, Lengths, Active, None, Indices, Values, None)
+
+    return main
+
+
+_MERGE_KEYS = 8192  # keys one merge CTA holds in shared memory (32 KiB)
+
+
+def _take(scratch, specs):
+    """Split caller scratch into ``specs`` tensors, allocating any that are missing."""
+    if scratch is None:
+        return [
+            torch.empty(shape, dtype=dtype, device="cuda") for shape, dtype in specs
+        ]
+    assert len(scratch) == len(specs), (
+        f"expected {len(specs)} scratch tensors, got {len(scratch)}"
+    )
+    return list(scratch)
+
+
+class IndexerTopK:
+    """Exact top-k over BF16 row scores: one pass, or segments plus merges.
+
+    Rows longer than one segment select each segment's winners, then merge
+    them ``fan_in`` lists at a time until one list remains, so any width fits
+    SM120 shared memory. Every route returns the same positions: each merge
+    sees exact winners in entry order and applies the same score-then-position
+    order. Segments and merge groups past a row's extent are skipped.
+    ``candidates`` rows select from their first ``Lengths`` candidates and
+    return the candidates' positions.
+    """
+
+    def __init__(self, width, topk=INDEX_TOPK, group=1, candidates=False):
+        self.topk, self.group, self.candidates = topk, group, candidates
+        entries = tilelang.cdiv(width, group)
+        self.segments = tilelang.cdiv(entries, _SEGMENT_ENTRIES)
+        self.levels = []  # (kernel, input lists, output lists)
+        if self.segments == 1:
+            self.single = indexer_topk_segment_v41(width, topk, group, True, candidates)
+            return
+        self.stage1 = indexer_topk_segment_v41(width, topk, group, False, candidates)
+        fan_in = max(2, _MERGE_KEYS // topk)
+        lists, span = self.segments, _SEGMENT_ENTRIES
+        while True:
+            outputs = tilelang.cdiv(lists, fan_in)
+            kernel = indexer_topk_merge_v41(
+                width, topk, group, lists, span, fan_in, candidates
+            )
+            self.levels.append((kernel, lists, outputs))
+            if outputs == 1:
+                break
+            lists, span = outputs, span * fan_in
+
+    def scratch_specs(self, rows):
+        """Two ping-pong winner buffers (values, entries) for the merge levels."""
+        if self.segments == 1:
+            return ()
+        widest = (self.segments * self.topk, self.levels[0][2] * self.topk)
+        return tuple(
+            ((rows * cols,), dtype)
+            for cols in widest
+            for dtype in (torch.bfloat16, torch.int32)
+        )
+
+    def run(
+        self,
+        scores,
+        lengths,
+        active,
+        indices,
+        values,
+        *,
+        gather=None,
+        counts=None,
+        scratch=None,
+    ):
+        """Select into ``indices`` / ``values``; grouped selections fill ``counts``.
+
+        ``active`` is the ``[1]`` width cap of dense rows; candidate rows take
+        ``gather`` (their candidate positions) instead.
+        """
+        rows = scores.shape[0]
+        cap = () if self.candidates else (active,)
+        final = (
+            *((gather,) if self.candidates else ()),
+            indices,
+            values,
+            *((counts,) if self.group > 1 else ()),
+        )
+        if self.segments == 1:
+            self.single(scores, lengths, *cap, *final)
+            return indices
+        flat = _take(scratch, self.scratch_specs(rows))
+        buffers = ((flat[0], flat[1]), (flat[2], flat[3]))
+
+        def lists_of(buffer, lists):
+            return tuple(
+                t[: rows * lists * self.topk].view(rows, lists * self.topk)
+                for t in buffer
+            )
+
+        self.stage1(scores, lengths, *cap, *lists_of(buffers[0], self.segments))
+        for level, (kernel, lists, outputs) in enumerate(self.levels):
+            work = lists_of(buffers[level % 2], lists)
+            if outputs == 1:
+                kernel(*work, lengths, *cap, *final)
+            else:
+                kernel(
+                    *work, lengths, *cap, *lists_of(buffers[(level + 1) % 2], outputs)
+                )
+        return indices
+
+
+class IndexerV41Plan:
+    """Score and top-k kernels for one context width.
+
+    ``candidates=True`` scores only the positions in a candidate list (V4.1's
+    reindex layers). ``candidate_blocks=True`` also selects the top
+    ``CANDIDATE_BLOCKS`` blocks of ``CANDIDATE_BLOCK`` positions, the
+    candidate list a source layer publishes for the reindex layers after it.
+
+    The plan holds no buffers: ``scratch_specs(rows)`` lists the scratch a
+    call needs, which a caller can borrow from a shared workspace.
+    """
+
+    def __init__(
+        self,
+        width,
+        page_size,
+        *,
+        topk=INDEX_TOPK,
+        candidates=False,
+        candidate_blocks=False,
+    ):
+        assert not (candidates and candidate_blocks), (
+            "a layer reads or publishes candidates, not both"
+        )
+        self.width, self.page_size, self.topk = width, page_size, topk
+        self.candidates, self.candidate_blocks = candidates, candidate_blocks
+        self.score = indexer_score_v41(width, page_size, candidates)
+        self.select = IndexerTopK(width, topk, 1, candidates)
+        self.select_blocks = (
+            IndexerTopK(width, CANDIDATE_BLOCKS, CANDIDATE_BLOCK)
+            if candidate_blocks
+            else None
+        )
+
+    def scratch_specs(self, rows):
+        specs = [
+            ((rows, self.width), torch.bfloat16),  # scores
+            ((rows, self.topk), torch.bfloat16),  # selected values
+            *self.select.scratch_specs(rows),
+        ]
+        if self.select_blocks is not None:
+            specs.append(((rows, CANDIDATE_BLOCKS), torch.bfloat16))
+            specs.extend(self.select_blocks.scratch_specs(rows))
+        return tuple(specs)
+
+    def run(
+        self,
+        q_packed,
+        q_scales,
+        weights,
+        pool,
+        page_table,
+        lengths,
+        active,
+        candidates=None,
+        candidate_lengths=None,
+        *,
+        out=None,
+        candidate_out=None,
+        candidate_out_lengths=None,
+        scratch=None,
+    ):
+        """Select each row's top positions into ``out``; returns ``(out, scores)``.
+
+        Reindex plans take ``candidates`` / ``candidate_lengths``; source plans
+        write ``candidate_out`` (``[rows, CANDIDATE_BLOCKS * CANDIDATE_BLOCK]``
+        ascending positions, ``-1`` padded) and ``candidate_out_lengths``
+        (its count of positions). Scores past a row's extent are unwritten.
+        """
+        rows = q_packed.shape[0]
+        buffers = _take(scratch, self.scratch_specs(rows))
+        scores, values = buffers[:2]
+        select_scratch = len(self.select.scratch_specs(rows))
+        select_buffers = buffers[2 : 2 + select_scratch]
+        if out is None:
+            out = torch.empty(
+                (rows, self.topk), dtype=torch.int32, device=q_packed.device
+            )
+        nbytes = page_bytes(self.page_size)
+        args = (
+            q_packed.view(torch.int8),
+            q_scales.view(torch.uint32).reshape(rows, -1),
+            weights,
+            # Pages may carry allocator padding past their records.
+            pool.view(torch.int8)[:, :nbytes],
+            pool.view(torch.uint32)[:, : nbytes // 4],
+            page_table,
+            lengths,
+            active,
+        )
+        if self.candidates:
+            self.score(*args, candidates, candidate_lengths, scores)
+            self.select.run(
+                scores,
+                candidate_lengths,
+                None,
+                out,
+                values,
+                gather=candidates,
+                scratch=select_buffers,
+            )
+            return out, scores
+        self.score(*args, scores)
+        self.select.run(scores, lengths, active, out, values, scratch=select_buffers)
+        if self.select_blocks is not None:
+            block_values, *block_buffers = buffers[2 + select_scratch :]
+            self.select_blocks.run(
+                scores,
+                lengths,
+                active,
+                candidate_out,
+                block_values,
+                counts=candidate_out_lengths,
+                scratch=block_buffers,
+            )
+        return out, scores
diff --git a/vllm/models/deepseek_v4_1/tilelang/linear.py b/vllm/models/deepseek_v4_1/tilelang/linear.py
new file mode 100644
index 000000000..cdc2fd297
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/linear.py
@@ -0,0 +1,175 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang linear methods for DeepSeek-V4.1 (``--linear-backend tilelang``).
+
+Block-32 FP8 projections quantize activations to MXFP8 with TileKernels'
+per-token cast (DeepSeek's E4M3, one UE8M0 scale per 32 elements) and run
+``mxfp8_gemm``. Unquantized projections run ``bf16_gemm``. Both GEMMs keep
+each row's accumulation order fixed, so results do not depend on the batch.
+
+The kernels run inside custom ops, which keeps them opaque to torch.compile,
+and borrow activation scratch from vLLM's workspace.
+"""
+
+from weakref import WeakValueDictionary
+
+import torch
+from torch import nn
+
+from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+from vllm.models.deepseek_v4_1.quant_config import Block32FP8LinearMethod
+from vllm.v1.worker.workspace import (
+    current_preallocated_workspace,
+    current_workspace_manager,
+    retain_cuda_graph_capture_resource,
+)
+
+from .gemm import (
+    SF_BLOCK,
+    bf16_gemm,
+    default_config,
+    mxfp8_gemm,
+    pack_scale_words,
+    scale_words,
+)
+
+_LAYERS: WeakValueDictionary[int, nn.Module] = WeakValueDictionary()
+_SMALL_ROWS = 64  # rows served by the decode tile configuration
+_TORCH_TO_TL = {torch.bfloat16: "bfloat16", torch.float32: "float32"}
+
+
+def _tile_kernels():
+    import tile_kernels
+
+    return tile_kernels
+
+
+def _activation_specs(rows: int, k: int):
+    # TileKernels pads each row's packed UE8M0 exponents to whole words.
+    return (((rows, k), torch.float8_e4m3fn), ((rows, 4 * scale_words(k)), torch.uint8))
+
+
+def _carve(scratch: torch.Tensor, specs):
+    """Views of ``specs`` laid out back to back, 256-byte aligned, in ``scratch``."""
+    views, offset = [], 0
+    for shape, dtype in specs:
+        nbytes = dtype.itemsize
+        for dim in shape:
+            nbytes *= dim
+        views.append(scratch[offset : offset + nbytes].view(dtype).view(shape))
+        offset += (nbytes + 255) // 256 * 256
+    return views
+
+
+@torch.library.custom_op(
+    "vllm::dsv41_tilelang_block32_linear", mutates_args=("out", "scratch")
+)
+def _block32_linear(
+    x: torch.Tensor, out: torch.Tensor, key: int, scratch: torch.Tensor | None
+) -> None:
+    layer = _LAYERS[key]
+    n, k = layer.weight.shape
+    x = x.reshape(-1, k)
+    rows = x.shape[0]
+    specs = _activation_specs(rows, k)
+    if scratch is None:
+        scratch = current_preallocated_workspace()
+    if scratch is not None:
+        xq, sf = _carve(scratch.view(-1).view(torch.uint8), specs)
+    else:
+        xq, sf = current_workspace_manager().get_simultaneous(*specs)
+        retain_cuda_graph_capture_resource(xq)
+    _tile_kernels().quant.per_token_cast(
+        x, "e4m3", SF_BLOCK, round_sf=True, use_packed_ue8m0=True, out=(xq, sf)
+    )
+    gemm = layer.tilelang_gemms[0 if rows <= _SMALL_ROWS else 1]
+    gemm(
+        xq,
+        layer.weight,
+        sf.view(torch.uint32),
+        layer.tilelang_weight_sf,
+        out.view(rows, n),
+    )
+
+
+@_block32_linear.register_fake
+def _block32_linear_fake(x, out, key, scratch):
+    return None
+
+
+@torch.library.custom_op("vllm::dsv41_tilelang_bf16_linear", mutates_args=("out",))
+def _bf16_linear(x: torch.Tensor, out: torch.Tensor, key: int) -> None:
+    layer = _LAYERS[key]
+    n, k = layer.weight.shape
+    rows = x.numel() // k
+    layer.tilelang_gemm(x.reshape(rows, k), layer.weight, out.view(rows, n))
+
+
+@_bf16_linear.register_fake
+def _bf16_linear_fake(x, out, key):
+    return None
+
+
+class TileLangFP8LinearMethod(Block32FP8LinearMethod):
+    """Checkpoint block-32 FP8 weights with MXFP8 activations."""
+
+    def process_weights_after_loading(self, layer):
+        n, k = layer.weight.shape
+        # The 32x32 block scales become per-row words of four K32 exponents.
+        layer.tilelang_weight_sf = pack_scale_words(
+            layer.weight_scale_inv.view(torch.uint8), rows=n
+        )
+        layer.tilelang_gemms = tuple(
+            mxfp8_gemm(n, k, **default_config(rows, k))
+            for rows in (_SMALL_ROWS, _SMALL_ROWS + 1)
+        )
+        layer.tilelang_key = id(layer)
+        _LAYERS[layer.tilelang_key] = layer
+
+    def get_workspace_size(self, layer, num_tokens: int) -> int:
+        k = layer.weight.shape[1]
+        return sum(
+            (dtype.itemsize * rows_ * cols + 255) // 256 * 256
+            for (rows_, cols), dtype in _activation_specs(num_tokens, k)
+        )
+
+    def apply(self, layer, x, bias=None):
+        if bias is not None:
+            raise ValueError("V4.1 block32 projections require bias-free weights")
+        out = torch.empty(
+            (*x.shape[:-1], layer.weight.shape[0]),
+            dtype=torch.bfloat16,
+            device=x.device,
+        )
+        scratch = (
+            None if torch.compiler.is_compiling() else current_preallocated_workspace()
+        )
+        _block32_linear(x, out, layer.tilelang_key, scratch)
+        return out
+
+
+class TileLangLinearMethod(UnquantizedLinearMethod):
+    """BF16 weights, BF16 or FP32 output (``layer.out_dtype``)."""
+
+    def process_weights_after_loading(self, layer: nn.Module) -> None:
+        n, k = layer.weight.shape
+        out_dtype = getattr(layer, "out_dtype", torch.bfloat16)
+        layer.tilelang_gemm = bf16_gemm(n, k, out_dtype=_TORCH_TO_TL[out_dtype])
+        layer.tilelang_key = id(layer)
+        _LAYERS[layer.tilelang_key] = layer
+
+    def apply(
+        self, layer: nn.Module, x: torch.Tensor, bias: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        if bias is not None:
+            raise ValueError("V4.1 native projections require bias-free weights")
+        out = torch.empty(
+            (*x.shape[:-1], layer.weight.shape[0]),
+            dtype=getattr(layer, "out_dtype", torch.bfloat16),
+            device=x.device,
+        )
+        _bf16_linear(x, out, layer.tilelang_key)
+        return out
+
+
+__all__ = ["TileLangFP8LinearMethod", "TileLangLinearMethod"]
diff --git a/vllm/models/deepseek_v4_1/tilelang/moe.py b/vllm/models/deepseek_v4_1/tilelang/moe.py
new file mode 100644
index 000000000..9b24708c5
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/moe.py
@@ -0,0 +1,938 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek-V4.1-Flash MoE dispatch and combine for SM120 / SM121.
+
+V4.1 Flash routes every token to 6 of 384 experts (the drafter: 3 of 128).
+A router, such as TileKernels' ``moe_topk_gate_forward`` or vLLM's
+``dsv4_topk``, writes the experts as ``topk_idx[rows, topk]`` (``-1`` for
+padding tokens) and their weights as ``topk_weights[rows, topk]``. Each
+(row, slot) pair is a route, numbered ``row * topk + slot``.
+
+``moe_dispatch_v41`` groups the routes by expert in the contiguous layout of
+grouped GEMMs (as in DeepGEMM's ``m_grouped_*_contiguous``): each expert's
+routes are consecutive, in route order, and padded to a multiple of
+``block_M``. It writes:
+
+- ``order[tiles * block_M]``: the route at each row of the layout, ``-1`` for
+  padding;
+- ``route_pos[rows, topk]``: the layout row of each route, ``-1`` for
+  padding tokens;
+- ``layout_weights[tiles * block_M]``: the route weight at each row, ``0``
+  for padding;
+- ``tile_expert[tiles]``: the expert of each ``block_M`` tile, ``-1`` past
+  the last used tile, so a grouped GEMM with a fixed grid can stop early;
+- ``expert_count[E]``, ``expert_offset[E]``, ``num_tiles[1]``, and
+  ``psum[E] = expert_offset + expert_count``, the end of each expert's routes
+  as TileKernels' ``psum_num_tokens_per_expert`` expects (with
+  ``tile_kernels.config.set_token_alignment(block_M)``).
+
+A route's rank within its expert is its position among that expert's routes
+in route order, computed with warp match masks and per-warp counts. The
+layout is therefore a pure function of ``topk_idx``.
+
+DeepSeek applies each route's weight before the down projection: TileKernels'
+``swiglu_forward_and_per_token_cast`` takes ``layout_weights`` and fuses the
+weight, the SwiGLU clamp and the MXFP8 cast of the down projection's input.
+``moe_combine_v41`` then sums each token's expert outputs, read from the
+layout through ``route_pos``, in slot order in FP32, and optionally adds the
+shared expert's output. With ``weighted=True`` it applies the weights itself
+with explicit ``T.fma``. Neither kernel uses atomics on
+results, so a token's output does not depend on the rest of the batch.
+"""
+
+import tilelang
+import tilelang.language as T
+import torch
+
+from .gemm import (
+    SF_BLOCK,
+    SF_WORD_K,
+    block_scale_words,
+    pack_scale_words,
+    pick_block_K,
+    scale_words,
+)
+
+# Routes handled by one CTA of the dispatch kernels.
+_CHUNK = 512
+
+
+def _dispatch_macros(num_experts, threads):
+    warps = threads // 32
+    steps = threads.bit_length() - 1
+    assert threads >= num_experts and threads & (threads - 1) == 0
+
+    @T.macro
+    def rank_routes(TopkIdx, routes, base, topk, tx, warp_count):
+        """For route base + tx: its expert, and its rank among the chunk's routes to it.
+
+        Leaves the chunk's per-expert counts in warp_count[warps, :].
+        """
+        expert = T.alloc_var(T.int32)
+        rank = T.alloc_var(T.int32)
+        peers = T.alloc_var(T.uint32)
+        run = T.alloc_var(T.int32)
+        held = T.alloc_var(T.int32)
+        lane = tx % 32
+        warp = tx // 32
+        for i in T.serial(T.ceildiv((warps + 1) * num_experts, threads)):
+            if i * threads + tx < (warps + 1) * num_experts:
+                warp_count[
+                    (i * threads + tx) // num_experts, (i * threads + tx) % num_experts
+                ] = 0
+        T.sync_threads()
+        r = T.min(base + tx, routes - 1)
+        expert = T.if_then_else(
+            base + tx < routes, T.cast(TopkIdx[r // topk, r % topk], T.int32), -1
+        )
+        peers = T.match_any_sync(expert)
+        rank = T.cast(
+            T.popcount(
+                peers
+                & (T.shift_left(T.uint32(1), T.cast(lane, T.uint32)) - T.uint32(1))
+            ),
+            T.int32,
+        )
+        if (expert >= 0) & (rank == 0):
+            warp_count[warp, expert] = T.cast(T.popcount(peers), T.int32)
+        T.sync_threads()
+        # Exclusive per-warp bases of each expert, in warp order.
+        if tx < num_experts:
+            run = 0
+            for w in T.serial(warps):
+                held = warp_count[w, tx]
+                warp_count[w, tx] = run
+                run += held
+            warp_count[warps, tx] = run
+        T.sync_threads()
+        if expert >= 0:
+            rank += warp_count[warp, expert]
+        return expert, rank
+
+    @T.macro
+    def layout(
+        count,
+        block_M,
+        tx,
+        scan,
+        ExpertCount,
+        ExpertOffset,
+        Psum,
+        Order,
+        LayoutWeights,
+        TileExpert,
+        NumTiles,
+        tiles,
+    ):
+        """From per-expert route counts: padded offsets, tile map and padding rows."""
+        padded = T.alloc_var(T.int32)
+        carry = T.alloc_var(T.int32)
+        offset = T.alloc_var(T.int32)
+        used_tiles = T.alloc_var(T.int32)
+        padded = T.if_then_else(
+            tx < num_experts, T.ceildiv(count, block_M) * block_M, 0
+        )
+        # scan may share storage with buffers the caller read last.
+        T.sync_threads()
+        scan[tx] = padded
+        T.sync_threads()
+        for s in T.serial(steps):
+            carry = T.if_then_else(tx >= (1 << s), scan[T.max(tx - (1 << s), 0)], 0)
+            T.sync_threads()
+            scan[tx] += carry
+            T.sync_threads()
+        offset = scan[tx] - padded
+        used_tiles = scan[threads - 1] // block_M
+        if tx < num_experts:
+            ExpertCount[tx] = count
+            ExpertOffset[tx] = offset
+            Psum[tx] = offset + count
+            for i in T.serial(padded - count):
+                Order[offset + count + i] = -1
+                LayoutWeights[offset + count + i] = 0
+            for t in T.serial(padded // block_M):
+                TileExpert[offset // block_M + t] = tx
+        if tx == 0:
+            NumTiles[0] = used_tiles
+        for i in T.serial(T.ceildiv(tiles, threads)):
+            if (i * threads + tx < tiles) & (i * threads + tx >= used_tiles):
+                TileExpert[i * threads + tx] = -1
+        return offset
+
+    return rank_routes, layout
+
+
+@tilelang.jit(
+    pass_configs={tilelang.PassConfigKey.TL_DISABLE_THREAD_STORAGE_SYNC: True}
+)
+def moe_dispatch_v41(
+    num_experts: int,
+    topk: int,
+    block_M: int,
+    part: str = "fused",
+    idx_dtype=T.int64,
+    threads: int = _CHUNK,
+):
+    """Build one dispatch kernel.
+
+    ``part="fused"`` handles up to ``threads`` routes in one CTA. Larger batches
+    run ``"count"`` (per-chunk ranks and counts), ``"layout"`` (offsets and the
+    tile map) and ``"scatter"`` (positions).
+    """
+    rows, tiles, chunks = T.dynamic("rows, tiles, chunks")
+    warps = threads // 32
+    rank_routes, layout = _dispatch_macros(num_experts, threads)
+
+    if part == "fused":
+
+        @T.prim_func
+        def main(
+            TopkIdx: T.Tensor([rows, topk], idx_dtype),
+            TopkWeights: T.Tensor([rows, topk], T.float32),
+            Order: T.Tensor([tiles * block_M], T.int32),
+            LayoutWeights: T.Tensor([tiles * block_M], T.float32),
+            RoutePos: T.Tensor([rows, topk], T.int32),
+            TileExpert: T.Tensor([tiles], T.int32),
+            ExpertCount: T.Tensor([num_experts], T.int32),
+            ExpertOffset: T.Tensor([num_experts], T.int32),
+            Psum: T.Tensor([num_experts], T.int32),
+            NumTiles: T.Tensor([1], T.int32),
+        ):
+            with T.Kernel(1, threads=threads):
+                warp_count = T.alloc_shared([warps + 1, num_experts], T.int32)
+                scan = T.alloc_shared([threads], T.int32)
+                count = T.alloc_var(T.int32)
+                tx = T.get_thread_binding()
+                routes = rows * topk
+                expert, rank = rank_routes(TopkIdx, routes, 0, topk, tx, warp_count)
+                count = T.if_then_else(
+                    tx < num_experts, warp_count[warps, T.min(tx, num_experts - 1)], 0
+                )
+                offset = layout(
+                    count,
+                    block_M,
+                    tx,
+                    scan,
+                    ExpertCount,
+                    ExpertOffset,
+                    Psum,
+                    Order,
+                    LayoutWeights,
+                    TileExpert,
+                    NumTiles,
+                    tiles,
+                )
+                T.sync_threads()
+                if tx < num_experts:
+                    scan[tx] = offset
+                T.sync_threads()
+                if tx < routes:
+                    if expert >= 0:
+                        Order[scan[expert] + rank] = tx
+                        LayoutWeights[scan[expert] + rank] = TopkWeights[
+                            tx // topk, tx % topk
+                        ]
+                        RoutePos[tx // topk, tx % topk] = scan[expert] + rank
+                    else:
+                        RoutePos[tx // topk, tx % topk] = -1
+
+        return main
+
+    if part == "count":
+
+        @T.prim_func
+        def main(
+            TopkIdx: T.Tensor([rows, topk], idx_dtype),
+            ChunkCount: T.Tensor([chunks, num_experts], T.int32),
+            Rank: T.Tensor([rows * topk], T.int32),
+        ):
+            with T.Kernel(chunks, threads=threads) as c:
+                warp_count = T.alloc_shared([warps + 1, num_experts], T.int32)
+                tx = T.get_thread_binding()
+                expert, rank = rank_routes(
+                    TopkIdx, rows * topk, c * threads, topk, tx, warp_count
+                )
+                if tx < num_experts:
+                    ChunkCount[c, tx] = warp_count[warps, tx]
+                if c * threads + tx < rows * topk:
+                    Rank[c * threads + tx] = rank
+
+        return main
+
+    if part == "layout":
+
+        @T.prim_func
+        def main(
+            ChunkCount: T.Tensor([chunks, num_experts], T.int32),
+            Order: T.Tensor([tiles * block_M], T.int32),
+            LayoutWeights: T.Tensor([tiles * block_M], T.float32),
+            TileExpert: T.Tensor([tiles], T.int32),
+            ExpertCount: T.Tensor([num_experts], T.int32),
+            ExpertOffset: T.Tensor([num_experts], T.int32),
+            Psum: T.Tensor([num_experts], T.int32),
+            NumTiles: T.Tensor([1], T.int32),
+        ):
+            with T.Kernel(1, threads=threads):
+                scan = T.alloc_shared([threads], T.int32)
+                count = T.alloc_var(T.int32)
+                tx = T.get_thread_binding()
+                # Exclusive per-expert bases of each chunk, in chunk order.
+                held = T.alloc_var(T.int32)
+                count = 0
+                if tx < num_experts:
+                    for c in T.serial(chunks):
+                        held = ChunkCount[c, tx]
+                        ChunkCount[c, tx] = count
+                        count += held
+                layout(
+                    count,
+                    block_M,
+                    tx,
+                    scan,
+                    ExpertCount,
+                    ExpertOffset,
+                    Psum,
+                    Order,
+                    LayoutWeights,
+                    TileExpert,
+                    NumTiles,
+                    tiles,
+                )
+
+        return main
+
+    assert part == "scatter", part
+
+    @T.prim_func
+    def main(
+        TopkIdx: T.Tensor([rows, topk], idx_dtype),
+        TopkWeights: T.Tensor([rows, topk], T.float32),
+        ChunkCount: T.Tensor([chunks, num_experts], T.int32),
+        Rank: T.Tensor([rows * topk], T.int32),
+        ExpertOffset: T.Tensor([num_experts], T.int32),
+        Order: T.Tensor([tiles * block_M], T.int32),
+        LayoutWeights: T.Tensor([tiles * block_M], T.float32),
+        RoutePos: T.Tensor([rows, topk], T.int32),
+    ):
+        with T.Kernel(chunks, threads=threads) as c:
+            tx = T.get_thread_binding()
+            expert = T.alloc_var(T.int32)
+            r = c * threads + tx
+            if r < rows * topk:
+                expert = T.cast(TopkIdx[r // topk, r % topk], T.int32)
+                if expert >= 0:
+                    pos = ExpertOffset[expert] + ChunkCount[c, expert] + Rank[r]
+                    Order[pos] = r
+                    LayoutWeights[pos] = TopkWeights[r // topk, r % topk]
+                    RoutePos[r // topk, r % topk] = pos
+                else:
+                    RoutePos[r // topk, r % topk] = -1
+
+    return main
+
+
+@tilelang.jit
+def moe_combine_v41(
+    hidden: int,
+    topk: int,
+    shared: bool = False,
+    weighted: bool = False,
+    block_D: int = 1024,
+    threads: int = 128,
+):
+    """``Out[t] = sum_k [Weights[t, k] *] Y[RoutePos[t, k]] (+ Shared[t])``.
+
+    FP32 in slot order, BF16 out.
+    """
+    rows, layout_rows = T.dynamic("rows, layout_rows")
+    while hidden % block_D:
+        block_D //= 2
+    assert block_D >= 8, f"hidden={hidden} must be a multiple of 8"
+
+    @T.prim_func
+    def main(
+        Y: T.Tensor([layout_rows, hidden], T.bfloat16),
+        RoutePos: T.Tensor([rows, topk], T.int32),
+        Weights: T.Tensor([rows, topk], T.float32),
+        Shared: T.Tensor([rows, hidden], T.bfloat16),
+        Out: T.Tensor([rows, hidden], T.bfloat16),
+    ):
+        with T.Kernel(hidden // block_D, rows, threads=threads) as (bd, row):
+            acc = T.alloc_fragment([block_D], T.float32)
+            T.clear(acc)
+            for k in T.serial(topk):
+                pos = RoutePos[row, k]
+                if pos >= 0:
+                    for d in T.Parallel(block_D):
+                        if weighted:
+                            acc[d] = T.fma(
+                                Weights[row, k],
+                                T.cast(Y[pos, bd * block_D + d], T.float32),
+                                acc[d],
+                            )
+                        else:
+                            acc[d] = acc[d] + T.cast(
+                                Y[pos, bd * block_D + d], T.float32
+                            )
+            for d in T.Parallel(block_D):
+                if shared:
+                    Out[row, bd * block_D + d] = T.cast(
+                        acc[d] + T.cast(Shared[row, bd * block_D + d], T.float32),
+                        T.bfloat16,
+                    )
+                else:
+                    Out[row, bd * block_D + d] = T.cast(acc[d], T.bfloat16)
+
+    return main
+
+
+def layout_tiles(rows: int, topk: int, block_M: int, num_experts: int) -> int:
+    """Tiles of the contiguous layout.
+
+    Each used tile holds a route, plus at most one partial tile per expert.
+    """
+    routes = rows * topk
+    return min(routes, tilelang.cdiv(routes, block_M) + num_experts)
+
+
+class MoeDispatchV41Plan:
+    """Dispatch and combine kernels for one routing shape.
+
+    The plan holds no buffers: ``workspace_specs(rows)`` lists the layout a
+    call needs, which a caller can borrow from a shared workspace.
+    ``dispatch`` and ``combine`` only launch kernels, so they can be captured
+    in a CUDA graph.
+    """
+
+    _LAYOUT = (
+        "order",
+        "layout_weights",
+        "route_pos",
+        "tile_expert",
+        "expert_count",
+        "expert_offset",
+        "psum",
+        "num_tiles",
+    )
+
+    def __init__(self, num_experts, topk, block_M, hidden, idx_dtype=torch.int64):
+        self.num_experts, self.topk, self.block_M, self.hidden = (
+            num_experts,
+            topk,
+            block_M,
+            hidden,
+        )
+        tl_idx = {torch.int64: T.int64, torch.int32: T.int32}[idx_dtype]
+        self.fused = moe_dispatch_v41(num_experts, topk, block_M, "fused", tl_idx)
+        self.count = moe_dispatch_v41(num_experts, topk, block_M, "count", tl_idx)
+        self.layout = moe_dispatch_v41(num_experts, topk, block_M, "layout", tl_idx)
+        self.scatter = moe_dispatch_v41(num_experts, topk, block_M, "scatter", tl_idx)
+        self.combine_kernels = {
+            (s, w): moe_combine_v41(hidden, topk, s, w)
+            for s in (False, True)
+            for w in (False, True)
+        }
+
+    def tiles(self, rows):
+        return layout_tiles(rows, self.topk, self.block_M, self.num_experts)
+
+    def workspace_specs(self, rows):
+        routes, tiles, experts = rows * self.topk, self.tiles(rows), self.num_experts
+        specs = [
+            ((tiles * self.block_M,), torch.int32),  # order
+            ((tiles * self.block_M,), torch.float32),  # layout_weights
+            ((rows, self.topk), torch.int32),  # route_pos
+            ((tiles,), torch.int32),  # tile_expert
+            ((experts,), torch.int32),  # expert_count
+            ((experts,), torch.int32),  # expert_offset
+            ((experts,), torch.int32),  # psum
+            ((1,), torch.int32),  # num_tiles
+        ]
+        if routes > _CHUNK:
+            specs += [
+                ((tilelang.cdiv(routes, _CHUNK), experts), torch.int32),
+                ((routes,), torch.int32),
+            ]
+        return tuple(specs)
+
+    def dispatch(self, topk_idx, topk_weights, workspace):
+        """Lay the routes out by expert in ``workspace`` (from ``workspace_specs``).
+
+        Returns the named layout.
+        """
+        rows = topk_idx.shape[0]
+        layout = dict(zip(self._LAYOUT, workspace))
+        if rows * self.topk <= _CHUNK:
+            self.fused(topk_idx, topk_weights, *(layout[name] for name in self._LAYOUT))
+        else:
+            chunk_count, rank = workspace[len(self._LAYOUT) :]
+            self.count(topk_idx, chunk_count, rank)
+            self.layout(
+                chunk_count,
+                layout["order"],
+                layout["layout_weights"],
+                layout["tile_expert"],
+                layout["expert_count"],
+                layout["expert_offset"],
+                layout["psum"],
+                layout["num_tiles"],
+            )
+            self.scatter(
+                topk_idx,
+                topk_weights,
+                chunk_count,
+                rank,
+                layout["expert_offset"],
+                layout["order"],
+                layout["layout_weights"],
+                layout["route_pos"],
+            )
+        return layout
+
+    def combine(self, y, layout, out, topk_weights=None, shared=None):
+        """Sum each token's expert outputs into ``out``.
+
+        Pass ``topk_weights`` only if the experts did not apply them.
+        """
+        rows = layout["route_pos"].shape[0]
+        weights = (
+            layout["layout_weights"][: rows * self.topk].view(rows, self.topk)
+            if topk_weights is None
+            else topk_weights
+        )
+        kernel = self.combine_kernels[(shared is not None, topk_weights is not None)]
+        kernel(y, layout["route_pos"], weights, out if shared is None else shared, out)
+        return out
+
+
+@tilelang.jit(pass_configs={tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True})
+def grouped_fp8_fp4_gemm(
+    num_experts: int,
+    N: int,
+    K: int,
+    topk: int = 6,
+    gather: bool = True,
+    block_M: int = 32,
+    block_N: int = 128,
+    block_K: int = 128,
+    num_stages: int = 3,
+    tiled: bool = False,
+    threads: int = 128,
+    out_dtype: T.dtype = T.bfloat16,
+):
+    """``C[r] = (A[row(r)] * SFA) @ (B[e] * SFB[e])^T``, ``e`` the expert of row ``r``.
+
+    ``A``: ``[rows, K]`` E4M3 with packed UE8M0 words ``SFA[rows, ceil(K / 128)]``;
+    ``B``: ``[experts, N, K]`` E2M1 (packed bytes) with
+    ``SFB[experts, N, ceil(K / 128)]``. With ``tiled=True``, ``B`` is in the
+    tile-major layout of ``tile_expert_weights``, so each tile is contiguous.
+
+    ``block_K`` is any multiple of 64 dividing K. A block that starts off a
+    128-element boundary reads the two scale words it straddles and tells the
+    MMA where it starts (``k_start``), so no operand is padded.
+
+    A ``num_stages``-deep pipeline loads the next K blocks while the current
+    one multiplies: the expert's weights by TMA, the gathered activation rows
+    and the scale words by ``cp.async``.
+    """
+    assert K % block_K == 0 and block_K % 64 == 0, (
+        "block_K must divide K and be a multiple of 64"
+    )
+    tokens, tiles = T.dynamic("tokens, tiles")
+    a_rows = tokens if gather else tiles * block_M
+    accum_dtype = T.float32
+    sf_words = scale_words(K)
+    block_words = block_scale_words(block_K)
+    k_blocks = K // block_K
+    a_segments = block_M * block_K // 16  # 16-byte cp.async copies of one A block
+    a_copies = tilelang.cdiv(a_segments, threads)
+    sfa_copies = tilelang.cdiv(block_M * block_words, threads)
+    sfb_copies = tilelang.cdiv(block_N * block_words, threads)
+    stages = num_stages
+    assert stages >= 2
+    assert N % block_N == 0, "N must be a multiple of block_N"
+    n_blocks = N // block_N
+    b_shape = (
+        (num_experts * n_blocks * k_blocks, block_N, block_K)
+        if tiled
+        else (num_experts, N, K)
+    )
+
+    @T.macro
+    def load(
+        A,
+        SFA,
+        B,
+        SFB,
+        A_shared,
+        B_shared,
+        SFA_shared,
+        SFB_shared,
+        a_row,
+        sfa_row,
+        loaded,
+        expert,
+        bx,
+        t,
+        tx,
+        ko,
+        s,
+    ):
+        if tiled:
+            tile = (expert * n_blocks + bx) * k_blocks + ko
+            T.tma_copy(
+                B[tile : tile + 1, 0:block_N, 0:block_K],
+                B_shared[s : s + 1, :, :],
+                barrier=loaded[s],
+            )
+        else:
+            T.tma_copy(
+                B[expert, bx * block_N, ko * block_K],
+                B_shared[s, :, :],
+                barrier=loaded[s],
+            )
+        # Padding rows (row -1) are zero-filled without reading memory.
+        for c in T.unroll(a_copies):
+            e = c * threads + tx
+            if e < a_segments:
+                T.ptx_cp_async(
+                    T.access_ptr(
+                        A_shared[s, e // (block_K // 16), e % (block_K // 16) * 16],
+                        "w",
+                        16,
+                    ),
+                    T.access_ptr(
+                        A[T.max(a_row[c], 0), ko * block_K + e % (block_K // 16) * 16],
+                        "r",
+                        16,
+                    ),
+                    16,
+                    a_row[c] >= 0,
+                )
+        # The block's scale words; the last row word may lie past a short row.
+        word0 = ko * block_K // SF_WORD_K
+        for c in T.unroll(sfa_copies):
+            e = c * threads + tx
+            if e < block_M * block_words:
+                w = e % block_words
+                T.ptx_cp_async(
+                    T.access_ptr(SFA_shared[s, e // block_words, w], "w", 1),
+                    T.access_ptr(
+                        SFA[T.max(sfa_row[c], 0), T.min(word0 + w, sf_words - 1)],
+                        "r",
+                        1,
+                    ),
+                    1,
+                    sfa_row[c] >= 0,
+                )
+        for c in T.unroll(sfb_copies):
+            e = c * threads + tx
+            if e < block_N * block_words:
+                w = e % block_words
+                T.ptx_cp_async(
+                    T.access_ptr(SFB_shared[s, e // block_words, w], "w", 1),
+                    T.access_ptr(
+                        SFB[
+                            expert,
+                            bx * block_N + e // block_words,
+                            T.min(word0 + w, sf_words - 1),
+                        ],
+                        "r",
+                        1,
+                    ),
+                    1,
+                )
+        T.ptx_commit_group()
+        T.barrier_arrive(loaded[s])
+
+    @T.prim_func
+    def main(
+        A: T.Tensor((a_rows, K), T.float8_e4m3fn),
+        SFA: T.Tensor((a_rows, sf_words), T.uint32),
+        B: T.Tensor(b_shape, T.float4_e2m1fn),
+        SFB: T.Tensor((num_experts, N, sf_words), T.uint32),
+        Order: T.Tensor((tiles * block_M,), T.int32),
+        TileExpert: T.Tensor((tiles,), T.int32),
+        C: T.Tensor((tiles * block_M, N), out_dtype),
+    ):
+        with T.Kernel(T.ceildiv(N, block_N), tiles, threads=threads) as (bx, t):
+            A_shared = T.alloc_shared((stages, block_M, block_K), T.float8_e4m3fn)
+            B_shared = T.alloc_shared(
+                (stages, block_N, block_K), T.float4_e2m1_unpacked
+            )
+            SFA_shared = T.alloc_shared((stages, block_M, block_words), T.uint32)
+            SFB_shared = T.alloc_shared((stages, block_N, block_words), T.uint32)
+            rows_shared = T.alloc_shared((block_M,), T.int32)
+            a_row = T.alloc_local((a_copies,), T.int32)
+            sfa_row = T.alloc_local((sfa_copies,), T.int32)
+            loaded = T.alloc_barrier([threads] * stages)
+            C_local = T.alloc_fragment((block_M, block_N), accum_dtype)
+            tx = T.get_thread_binding()
+
+            expert = TileExpert[t]
+            if expert < 0:
+                T.thread_return()
+            for i in T.Parallel(block_M):
+                route = Order[t * block_M + i]
+                rows_shared[i] = T.if_then_else(
+                    route >= 0, route // topk if gather else t * block_M + i, -1
+                )
+            T.sync_threads()
+            # Each thread copies the same rows at every K block.
+            for c in T.unroll(a_copies):
+                a_row[c] = rows_shared[
+                    T.min((c * threads + tx) // (block_K // 16), block_M - 1)
+                ]
+            for c in T.unroll(sfa_copies):
+                sfa_row[c] = rows_shared[
+                    T.min((c * threads + tx) // block_words, block_M - 1)
+                ]
+
+            T.clear(C_local)
+            for p in T.unroll(stages - 1):
+                if p < k_blocks:
+                    load(
+                        A,
+                        SFA,
+                        B,
+                        SFB,
+                        A_shared,
+                        B_shared,
+                        SFA_shared,
+                        SFB_shared,
+                        a_row,
+                        sfa_row,
+                        loaded,
+                        expert,
+                        bx,
+                        t,
+                        tx,
+                        p,
+                        p,
+                    )
+                else:
+                    T.ptx_commit_group()
+            for ko in T.serial(k_blocks):
+                # The stage loaded next was last read by iteration ko - 1.
+                T.sync_threads()
+                nxt = ko + stages - 1
+                if nxt < k_blocks:
+                    load(
+                        A,
+                        SFA,
+                        B,
+                        SFB,
+                        A_shared,
+                        B_shared,
+                        SFA_shared,
+                        SFB_shared,
+                        a_row,
+                        sfa_row,
+                        loaded,
+                        expert,
+                        bx,
+                        t,
+                        tx,
+                        nxt,
+                        nxt % stages,
+                    )
+                else:
+                    T.ptx_commit_group()
+                T.ptx_wait_group(stages - 1)
+                T.barrier_wait(loaded[ko % stages], (ko // stages) % 2)
+                T.sync_threads()
+                # The staged words start at the block's first word; k_start
+                # places the block inside it.
+                T.mma_gemm_blockscaled(
+                    A_shared[ko % stages, :, :],
+                    B_shared[ko % stages, :, :],
+                    C_local,
+                    SFA_shared[ko % stages, :, :],
+                    SFB_shared[ko % stages, :, :],
+                    transpose_B=True,
+                    k_start=ko * block_K % SF_WORD_K,
+                    sf_a_granularity_k=SF_BLOCK,
+                    sf_b_granularity_k=SF_BLOCK,
+                )
+            # Only real rows are stored; padding rows of the layout stay untouched.
+            for i, j in T.Parallel(block_M, block_N):
+                if rows_shared[i] >= 0:
+                    C[t * block_M + i, bx * block_N + j] = C_local[i, j]
+
+    return main
+
+
+def tile_expert_weights(b_packed, block_N, block_K):
+    """Tile-major copy of ``[E, N, K / 2]`` packed E2M1 expert weights.
+
+    Tile ``(e, n, k)`` (``block_N`` rows by ``block_K`` columns) becomes one
+    contiguous ``[block_N, block_K / 2]`` slab, at index
+    ``(e * N / block_N + n) * K / block_K + k``.
+    """
+    E, N, half_k = b_packed.shape
+    K = 2 * half_k
+    b = b_packed.view(E, N // block_N, block_N, K // block_K, block_K // 2)
+    return b.permute(0, 1, 3, 2, 4).reshape(-1, block_N, block_K // 2).contiguous()
+
+
+def _spans(specs):
+    """Byte offset and size of each spec laid out back to back, 256-byte aligned."""
+    spans, offset = [], 0
+    for shape, dtype in specs:
+        nbytes = dtype.itemsize
+        for dim in shape:
+            nbytes *= dim
+        spans.append((offset, nbytes))
+        offset += (nbytes + 255) // 256 * 256
+    return spans, offset
+
+
+def carve(scratch, specs):
+    """Views of ``specs`` in ``scratch``, laid out as ``workspace_bytes``."""
+    spans, _ = _spans(specs)
+    return [
+        scratch[offset : offset + nbytes].view(dtype).view(shape)
+        for (offset, nbytes), (shape, dtype) in zip(spans, specs)
+    ]
+
+
+def workspace_bytes(specs) -> int:
+    return _spans(specs)[1]
+
+
+class MoeExpertsV41Plan:
+    """Routed MXFP4 experts, MXFP8 activations: dispatch, two grouped GEMMs, combine.
+
+    Expert weights come from ``prepare_weights``: ``w13`` (``[E, 2I, H / 2]``
+    packed E2M1, gate rows first) and ``w2`` (``[E, H, I / 2]``), each with
+    its UE8M0 bytes, become tile-major. The TileKernels MXFP8 cast and fused
+    SwiGLU (DeepSeek's clamp, route weight before the down projection) run
+    between the GEMMs. The plan holds no buffers; ``workspace_specs(rows)``
+    lists one call's scratch.
+    """
+
+    def __init__(
+        self,
+        num_experts,
+        topk,
+        hidden,
+        intermediate,
+        *,
+        swiglu_limit=None,
+        block_M=32,
+        block_N=128,
+        num_stages=3,
+    ):
+        self.num_experts, self.topk, self.hidden, self.intermediate = (
+            num_experts,
+            topk,
+            hidden,
+            intermediate,
+        )
+        self.block_M, self.block_N = block_M, block_N
+        # Each GEMM's K block divides its own K: TP3's 768-wide expert rows
+        # take 128, TP4's 576 take 192.
+        self.gate_up_block_K = pick_block_K(hidden)
+        self.down_block_K = pick_block_K(intermediate)
+        config = dict(block_N=block_N, num_stages=num_stages, tiled=True)
+        self.gate_up = grouped_fp8_fp4_gemm(
+            num_experts, 2 * intermediate, hidden, topk, True, block_M,
+            block_K=self.gate_up_block_K, **config,
+        )  # fmt: skip
+        self.down = grouped_fp8_fp4_gemm(
+            num_experts, hidden, intermediate, topk, False, block_M,
+            block_K=self.down_block_K, **config,
+        )  # fmt: skip
+        # Routers emit int32 or int64 expert ids.
+        self.dispatch = {
+            dtype: MoeDispatchV41Plan(num_experts, topk, block_M, hidden, dtype)
+            for dtype in (torch.int32, torch.int64)
+        }
+        self.tk = _tile_kernels(block_M)
+        self.swiglu = _swiglu_kernel(self.tk, intermediate, num_experts, swiglu_limit)
+
+    def prepare_weights(self, w13, w13_scale, w2, w2_scale):
+        """``(w13 tiles, w13 words, w2 tiles, w2 words)`` from E2M1 and UE8M0."""
+        block_N = self.block_N
+        return (
+            tile_expert_weights(w13.view(torch.int8), block_N, self.gate_up_block_K),
+            pack_scale_words(w13_scale),
+            tile_expert_weights(w2.view(torch.int8), block_N, self.down_block_K),
+            pack_scale_words(w2_scale),
+        )
+
+    def workspace_specs(self, rows, idx_dtype=torch.int64):
+        dispatch = self.dispatch[idx_dtype]
+        layout_rows = dispatch.tiles(rows) * self.block_M
+        hidden, inter = self.hidden, self.intermediate
+        return (
+            *dispatch.workspace_specs(rows),
+            ((rows, hidden), torch.float8_e4m3fn),  # tokens, MXFP8
+            ((rows, 4 * scale_words(hidden)), torch.uint8),
+            ((layout_rows, 2 * inter), torch.bfloat16),  # gate/up output
+            ((layout_rows, inter), torch.float8_e4m3fn),  # down input, MXFP8
+            ((layout_rows, 4 * scale_words(inter)), torch.uint8),
+            ((layout_rows, hidden), torch.bfloat16),  # down output
+        )
+
+    def run(self, x, topk_ids, topk_weights, weights, out, workspace=None):
+        """``out[t] = sum_k w[t, k] * down_e(swiglu(gate_up_e(x[t])))``.
+
+        ``e`` is the token's k-th expert. ``weights`` comes from
+        ``prepare_weights``; ``workspace`` is a byte buffer of at least
+        ``workspace_bytes(workspace_specs(rows))``.
+        """
+        rows = x.shape[0]
+        dispatch = self.dispatch[topk_ids.dtype]
+        specs = self.workspace_specs(rows, topk_ids.dtype)
+        if workspace is None:
+            workspace = torch.empty(
+                workspace_bytes(specs), dtype=torch.uint8, device=x.device
+            )
+        buffers = carve(workspace, specs)
+        count = len(dispatch.workspace_specs(rows))
+        xq, x_sf, h, hq, h_sf, y = buffers[count:]
+        w13, w13_words, w2, w2_words = weights
+        layout = dispatch.dispatch(topk_ids, topk_weights, buffers[:count])
+        self.tk.quant.per_token_cast(
+            x, "e4m3", SF_BLOCK, round_sf=True, use_packed_ue8m0=True, out=(xq, x_sf)
+        )
+        order, tile_expert = layout["order"], layout["tile_expert"]
+        self.gate_up(xq, x_sf.view(torch.uint32), w13, w13_words, order, tile_expert, h)
+        self.swiglu(h, hq, h_sf, layout["psum"], layout["layout_weights"], 1.0, None)
+        self.down(hq, h_sf.view(torch.uint32), w2, w2_words, order, tile_expert, y)
+        return dispatch.combine(y, layout, out)
+
+
+def _tile_kernels(block_M):
+    import tile_kernels
+
+    # Expert segments in the dispatch layout start on block_M rows.
+    tile_kernels.config.set_token_alignment(block_M)
+    return tile_kernels
+
+
+def _swiglu_kernel(tk, intermediate, num_experts, limit):
+    """TileKernels' fused SwiGLU, route weight and MXFP8 cast, into caller buffers.
+
+    ``swiglu_forward_and_per_token_cast`` allocates its outputs; its kernel
+    writes into ours.
+    """
+    from tile_kernels.quant.common import get_cast_output_config
+    from tile_kernels.quant.swiglu_forward_cuda import (
+        get_swiglu_forward_and_per_token_cast_kernel_cuda,
+    )
+
+    return get_swiglu_forward_and_per_token_cast_kernel_cuda(
+        intermediate,
+        num_experts,
+        tk.config.get_token_alignment(),
+        True,  # route weights
+        False,  # routed scaling factor
+        limit,
+        False,  # clamped count
+        in_dtype=T.dtype(torch.bfloat16),
+        out_config=get_cast_output_config("e4m3", (1, SF_BLOCK), False, True, True),
+        num_sms=tk.config.get_num_sms(),
+        use_pdl=tk.config.get_pdl(),
+    )

@@ -0,0 +1,115 @@
+from types import SimpleNamespace
+
+import pytest
+
+from b12x.comm.roce._preparation import query_from_runtime
+from b12x.comm.roce.roce_oneshot import (
+    _peer_hca_names_from_env,
+    _resolve_hca_topology,
+)
+
+
+def test_preparation_uses_route_stripes_for_switchless_flag_layout() -> None:
+    runtime = SimpleNamespace(
+        world_size=3,
+        rank=0,
+        hca_names=("mlx5_0", "mlx5_1", "mlx5_2", "mlx5_3"),
+        stripe_count=2,
+        _threads=512,
+        _layout=SimpleNamespace(slots=2, flag_stride=128),
+    )
+
+    query = query_from_runtime(
+        runtime,
+        surface="AllReduce.all_reduce",
+        call={"dtypes": ("bfloat16",)},
+        topology="roce_rdma",
+        peer_hosts=("rank:0", "rank:1", "rank:2"),
+    )
+
+    assert query.hca_names == runtime.hca_names
+    assert query.setup["hca_count"] == runtime.stripe_count
+
+
+def test_clique_topology_preserves_shared_hca_routes(monkeypatch) -> None:
+    monkeypatch.delenv("B12X_ROCE_PEER_HCAS", raising=False)
+
+    names, routes, stripes = _resolve_hca_topology(
+        world_size=3,
+        rank=1,
+        hca_names=("mlx5_0", "mlx5_1"),
+        peer_hca_names=None,
+        gid_index=3,
+    )
+
+    assert names == ("mlx5_0", "mlx5_1")
+    assert routes == (
+        ("mlx5_0", "mlx5_1"),
+        (),
+        ("mlx5_0", "mlx5_1"),
+    )
+    assert stripes == 2
+
+
+def test_switchless_topology_opens_union_and_routes_each_peer() -> None:
+    names, routes, stripes = _resolve_hca_topology(
+        world_size=3,
+        rank=0,
+        hca_names=None,
+        peer_hca_names={1: ("mlx5_0",), 2: ("mlx5_2",)},
+        gid_index=3,
+    )
+
+    assert names == ("mlx5_0", "mlx5_2")
+    assert routes == ((), ("mlx5_0",), ("mlx5_2",))
+    assert stripes == 1
+
+
+def test_peer_hca_environment_is_unambiguous_json(monkeypatch) -> None:
+    monkeypatch.setenv(
+        "B12X_ROCE_PEER_HCAS",
+        '{"0": ["mlx5_0", "mlx5_1"], "2": ["mlx5_2", "mlx5_3"]}',
+    )
+
+    assert _peer_hca_names_from_env() == {
+        0: ("mlx5_0", "mlx5_1"),
+        2: ("mlx5_2", "mlx5_3"),
+    }
+
+
+@pytest.mark.parametrize(
+    ("routes", "message"),
+    [
+        ({1: ("mlx5_0",)}, "every non-self rank"),
+        (
+            {1: ("mlx5_0",), 2: ("mlx5_1", "mlx5_2")},
+            "same 1..2 stripe count",
+        ),
+        (
+            {1: ("mlx5_0", "mlx5_0"), 2: ("mlx5_1", "mlx5_2")},
+            "empty or duplicate",
+        ),
+    ],
+)
+def test_switchless_topology_rejects_incomplete_or_asymmetric_routes(
+    routes, message
+) -> None:
+    with pytest.raises(ValueError, match=message):
+        _resolve_hca_topology(
+            world_size=3,
+            rank=0,
+            hca_names=None,
+            peer_hca_names=routes,
+            gid_index=3,
+        )
+
+
+def test_switchless_topology_rejects_unopened_hca() -> None:
+    with pytest.raises(ValueError, match="unopened devices"):
+        _resolve_hca_topology(
+            world_size=3,
+            rank=0,
+            hca_names=("mlx5_0", "mlx5_1"),
+            peer_hca_names={1: ("mlx5_0",), 2: ("mlx5_2",)},
+            gid_index=3,
+        )

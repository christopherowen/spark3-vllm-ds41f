#!/usr/bin/env python3
"""Prepare and verify the pinned Karmic Kraken reference sources."""

import argparse
import json
import shutil
import subprocess
import tempfile
from pathlib import Path


EXPERIMENT = Path(__file__).resolve().parent
REPO = EXPERIMENT.parents[1]
PROJECTS = ("vllm", "b12x")


def git(directory, *args, capture=False):
    result = subprocess.run(
        ["git", *args],
        cwd=directory,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
    )
    return result.stdout.strip() if capture else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "destination",
        nargs="?",
        type=Path,
        default=REPO / ".work/experiments" / EXPERIMENT.name,
    )
    args = parser.parse_args()
    destination = args.destination.resolve()
    sources = json.loads((EXPERIMENT / "sources.json").read_text())
    if any((destination / project).exists() for project in PROJECTS):
        parser.error("destination already contains a prepared project")
    destination.mkdir(parents=True, exist_ok=True)

    for project in PROJECTS:
        record = sources[project]
        temporary = Path(tempfile.mkdtemp(prefix=f".{project}.", dir=destination))
        try:
            git(temporary, "init", "--quiet")
            git(temporary, "remote", "add", "lil", record["repository"])
            git(
                temporary,
                "fetch", "--quiet", "--filter=blob:none", "--no-tags",
                "lil", record["revision"],
            )
            git(temporary, "switch", "--quiet", "--create", "spark3/reference", "FETCH_HEAD")
            for patch in record["patches"]:
                git(
                    temporary,
                    "-c", "user.name=Christopher Owen",
                    "-c", "user.email=3221756+christopherowen@users.noreply.github.com",
                    "am", "--quiet", "--committer-date-is-author-date",
                    str(EXPERIMENT / patch),
                )
            actual = git(temporary, "rev-parse", "HEAD^{tree}", capture=True)
            if actual != record["expected_tree"]:
                raise RuntimeError(
                    f"{project}: expected tree {record['expected_tree']}, got {actual}"
                )
            git(temporary, "diff", "--check", record["revision"], "HEAD")
            git(temporary, "submodule", "update", "--init", "--recursive")
            temporary.rename(destination / project)
            head = git(destination / project, "rev-parse", "HEAD", capture=True)
            print(f"{project}: head {head} tree {actual}")
        except BaseException:
            shutil.rmtree(temporary, ignore_errors=True)
            raise


if __name__ == "__main__":
    main()

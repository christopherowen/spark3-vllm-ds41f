#!/usr/bin/env bash
set -euo pipefail

tag=spark-management-health

if ! systemctl is-active --quiet ssh.service \
  || [[ -z "$(ss -H -ltn 'sport = :22')" ]]; then
  logger -t "$tag" "SSH listener is unavailable; restarting ssh.service"
  systemctl restart ssh.service
elif grep -q 'beginning MaxStartups throttling' \
  < <(journalctl --quiet --unit ssh.service --since '90 seconds ago' --no-pager); then
  logger -t "$tag" "SSH entered MaxStartups throttling; restarting its listener"
  systemctl restart ssh.service
fi

if ! systemctl is-active --quiet tailscaled.service \
  || ! timeout --kill-after=5s 10s tailscale status --json >/dev/null 2>&1; then
  logger -t "$tag" "Tailscale control socket is unresponsive; restarting tailscaled.service"
  systemctl restart tailscaled.service
fi

+def _make_mxf8f6f4_emitter(a_dtype=T.float8_e4m3fn, b_dtype=T.float8_e4m3fn, **kwargs):
+    return TensorCoreIntrinEmitterSM120(
+        is_blockscaled=True,
+        kind="mxf8f6f4",
+        scale_vec_size=1,
+        stype="ue8m0",
+        a_dtype=a_dtype,
+        b_dtype=b_dtype,
+        accum_dtype=T.float32,
+        a_transposed=False,
+        b_transposed=True,
+        block_row_warps=2,
+        block_col_warps=2,
+        warp_row_tiles=32,
+        warp_col_tiles=32,
+        chunk=128,
+        **kwargs,
+    )

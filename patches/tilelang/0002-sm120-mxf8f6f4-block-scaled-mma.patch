+        (T.float8_e4m3fn, T.float4_e2m1fn, ("mxf8f6f4", 1, "ue8m0")),
+    ],
+)
+def test_block_scale_kind_follows_operand_dtypes(a_dtype, b_dtype, expected):
+    assert block_scale_mma_kind_for_dtypes(str(a_dtype), str(b_dtype)) == expected

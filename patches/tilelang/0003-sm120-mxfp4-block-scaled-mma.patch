+def block_scale_mma_kind_for_dtypes(a_dtype: str, b_dtype: str, sf_granularity_k: int = 16) -> tuple[str, int, str]:
     """Return the SM120 ``(kind, scale_vec_size, scale_type)`` for operand dtypes.
 

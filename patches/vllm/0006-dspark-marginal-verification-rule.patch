From 9e03aeaa1bc68ab9e4e411bda141c858f05f37f4 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 26 Sep 2026 23:10:28 +0200
Subject: [PATCH] feat(spec-decode): marginal-rate rule for DSpark adaptive
 verification

Adaptive verification picks the draft budget that maximizes each step's
expected tokens divided by that step's modeled cost. When confidence
varies from step to step that is not the budget that maximizes long-run
tokens per millisecond: a confident step refuses drafts that would lower
its own (above-average) ratio even though they earn more than the average
rate, and a weak step accepts drafts that earn less. A cost scale above 1
only corrects the second case.

SPARK3_DSPARK_VERIFY_RULE=marginal instead maximizes expected tokens minus
rate times cost, where rate is an exponential average (weight
SPARK3_DSPARK_RATE_ALPHA, default 0.1) of the chosen budgets' expected
tokens per modeled millisecond, kept per request count and floored at the
batch's no-draft rate. This is Dinkelbach's fixed point for maximizing a
ratio of sums. Every rank derives the rate from the same broadcast
confidences and cost tables, so draft budgets stay identical across ranks.
The default rule is unchanged. Output is unchanged: the target verifies
every draft it keeps.
---
 .../spec_decode/test_adaptive_verification.py | 29 +++++++++++++++
 .../gpu/spec_decode/adaptive_verification.py  | 35 +++++++++++++++++--
 2 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/tests/v1/spec_decode/test_adaptive_verification.py b/tests/v1/spec_decode/test_adaptive_verification.py
index bc5d1fb0e5..4fccbf6876 100644
--- a/tests/v1/spec_decode/test_adaptive_verification.py
+++ b/tests/v1/spec_decode/test_adaptive_verification.py
@@ -698,3 +698,32 @@ def test_pinned_cost_curves_only_from_rank_zero(monkeypatch, tmp_path):
     curves = ([(1, 2.0)], [(4, 40.0)], {1: [(4, 40.0)]})
     assert _pinning_manager()._pin_cost_curves(*curves) == curves
     assert not list(tmp_path.iterdir())
+
+
+def test_marginal_rule_verifies_confident_drafts_beyond_the_step_ratio():
+    # Survival 0.9, 0.72, 0.504. The third draft lowers this step's own
+    # tokens per ms (3.124/14 < 2.62/11), so the ratio rule stops at two, but
+    # it still earns 0.168 tokens/ms, above the achieved rate of 0.15.
+    confidences = np.array([[0.9, 0.8, 0.7]], dtype=np.float32)
+    verify_cost_ms = np.array([10.0, 10.0, 10.5, 11.0, 14.0])
+
+    ratio = make_manager(confidences, verify_cost_ms)
+    assert ratio.get_num_tokens({"low": 4}, {"low": [1, 2, 3]}) == 3
+
+    marginal = make_manager(confidences, verify_cost_ms)
+    marginal._verify_rule = "marginal"
+    marginal._rates = {1: 0.15}
+    assert marginal.get_num_tokens({"low": 4}, {"low": [1, 2, 3]}) == 4
+    # The achieved rate moves toward the chosen step's rate.
+    assert 0.15 < marginal._rates[1] < 3.124 / 14.0
+
+
+def test_marginal_rate_never_falls_below_the_no_draft_rate():
+    confidences = np.array([[0.2, 0.2]], dtype=np.float32)
+    verify_cost_ms = np.array([10.0, 10.0, 11.0, 12.0])
+    manager = make_manager(confidences, verify_cost_ms)
+    manager._verify_rule = "marginal"
+    manager._rates = {1: 0.0}
+    # At the floor (1 token / 10 ms) a 0.2-survival draft costing 1 ms pays.
+    assert manager.get_num_tokens({"low": 3}, {"low": [1, 2]}) == 2
+    assert manager._rates[1] >= 0.1
diff --git a/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py b/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py
index 8e7b94c22e..90c4261b44 100644
--- a/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py
+++ b/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py
@@ -32,6 +32,11 @@ _PROFILE_REPLAYS = int(os.environ.get("SPARK3_DSPARK_PROFILE_REPLAYS", "5"))
 # set and every later boot with the same shapes reuses it, so the draft
 # budget no longer depends on one boot's startup timing noise.
 _COST_DIR = os.environ.get("SPARK3_DSPARK_COST_DIR") or None
+# "ratio" maximizes each step's expected tokens per millisecond. "marginal"
+# maximizes expected tokens minus the achieved rate times cost, the rule that
+# maximizes long-run tokens per millisecond when step confidence varies.
+_VERIFY_RULE = os.environ.get("SPARK3_DSPARK_VERIFY_RULE", "ratio")
+_RATE_ALPHA = float(os.environ.get("SPARK3_DSPARK_RATE_ALPHA", "0.1"))
 
 if TYPE_CHECKING:
     from vllm.config import VllmConfig
@@ -148,6 +153,8 @@ def preparation_tail_sizes(
 
 
 class AdaptiveVerificationManager:
+    _verify_rule = "ratio"
+
     def __init__(
         self,
         req_states: "RequestState",
@@ -167,6 +174,14 @@ class AdaptiveVerificationManager:
         # address the compacted layout, so the budget must fit one chunk.
         self._max_total_logits = max_total_logits
         self.cost_scale = cost_scale
+        if _VERIFY_RULE not in ("ratio", "marginal"):
+            raise ValueError(
+                f"SPARK3_DSPARK_VERIFY_RULE must be ratio or marginal, got {_VERIFY_RULE!r}"
+            )
+        self._verify_rule = _VERIFY_RULE
+        # Achieved expected tokens per millisecond, per request count. Every
+        # rank derives it from the same broadcast confidences and cost tables.
+        self._rates: dict[int, float] = {}
         self.query_start_loc = query_start_loc
         self.cost_tables: tuple[np.ndarray, np.ndarray] | None = None
         # Largest cudagraph-captured token count; above it nothing pads.
@@ -545,8 +560,24 @@ class AdaptiveVerificationManager:
             req_id: int(num_tokens)
             for req_id, num_tokens in zip(req_ids, num_non_draft_tokens, strict=True)
         }
-        utilities = num_tokens_to_estimated_accepted_tokens / costs
-        draft_budget = int(np.argmax(utilities))
+        if self._verify_rule == "marginal":
+            # Maximize tokens - rate * cost with rate the achieved expected
+            # tokens per ms (Dinkelbach's fixed point for tokens / time). A
+            # confident step then verifies every draft that beats the average
+            # rate, not only those that raise its own ratio. The rate never
+            # falls below this batch's no-draft rate.
+            plain_rate = num_tokens_to_estimated_accepted_tokens[0] / costs[0]
+            rate = max(self._rates.get(num_reqs, plain_rate), plain_rate)
+            utilities = num_tokens_to_estimated_accepted_tokens - rate * costs
+            draft_budget = int(np.argmax(utilities))
+            chosen_rate = (
+                num_tokens_to_estimated_accepted_tokens[draft_budget]
+                / costs[draft_budget]
+            )
+            self._rates[num_reqs] = (1.0 - _RATE_ALPHA) * rate + _RATE_ALPHA * chosen_rate
+        else:
+            utilities = num_tokens_to_estimated_accepted_tokens / costs
+            draft_budget = int(np.argmax(utilities))
         logger.debug(
             "DSpark adaptive verification selected %d/%d draft rows for %d "
             "requests at cost scale %.3g (selected utility %.4g, full utility "

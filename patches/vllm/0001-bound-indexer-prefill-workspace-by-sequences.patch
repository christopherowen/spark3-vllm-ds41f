From: spark3-vllm-ds41f maintainers
Subject: [PATCH] Bound sparse indexer prefill workspace by admitted sequences
Upstream-Base: c687594b8a8082e18af9fe2f64eb5f9ee442e251
Upstream-Status: candidate
Quality-Impact: none; allocation sizing only

Allow an explicit factor and otherwise cap the prefill workspace factor at the
configured maximum sequence count. The deployed baseline sets the factor to 1.

---
 vllm/v1/attention/backends/mla/indexer.py | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/vllm/v1/attention/backends/mla/indexer.py b/vllm/v1/attention/backends/mla/indexer.py
index 0000000..0000000 100644
--- a/vllm/v1/attention/backends/mla/indexer.py
+++ b/vllm/v1/attention/backends/mla/indexer.py
@@ -470,7 +470,14 @@ def compute_max_num_query_len(vllm_config: VllmConfig) -> int:
     # within the flashmla_sparse workspace.
     # For DeepSeek-V3.2, the max_model_len is 163840.
     #   40 * 163840 * 132 = 865075200 bytes = 825 MB
-    return max_model_len * 40
+    factor_override = __import__("os").environ.get(
+        "DSV41_INDEXER_PREFILL_FACTOR", ""
+    )
+    if factor_override.strip():
+        return max_model_len * max(1, int(factor_override))
+    return max_model_len * max(
+        1, min(40, int(vllm_config.scheduler_config.max_num_seqs))
+    )
 
 
 def _supports_varlen_paged_mqa_logits() -> bool:

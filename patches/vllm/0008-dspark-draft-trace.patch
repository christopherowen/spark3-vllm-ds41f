+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Per-step DSpark draft trace for offline verification-policy replay.
+
+With ``SPARK3_DSPARK_TRACE=<path>``, TP rank 0 appends one JSON line per
+request per step: the tokens sampled this step, how many of the previous
+step's drafts were verified, and the drafts and raw confidences proposed
+for the next step. At temperature 0 the committed stream is the target's
+greedy output, so a draft token is correct exactly when it equals the
+committed token at its position, whether or not it was verified. One traced
+run therefore prices every verification cap and rule offline.
+
+Tracing copies GPU tensors to the host every step; use it only for replay
+runs, never for timing.
+"""
+
+import json
+import os
+
+import torch
+
+from vllm.distributed.parallel_state import get_tp_group
+
+_TRACE_PATH = os.environ.get("SPARK3_DSPARK_TRACE") or None
+
+
+class DSparkTrace:
+    def __init__(self, path: str) -> None:
+        self._file = open(path, "a", buffering=1 << 20)  # noqa: SIM115
+        self._step = 0
+
+    def record(
+        self,
+        req_ids: list[str],
+        sampled_token_ids: torch.Tensor,
+        num_sampled: torch.Tensor,
+        num_verified: torch.Tensor | None,
+        draft_tokens: torch.Tensor,
+        confidences: torch.Tensor | None,
+    ) -> None:
+        num_reqs = len(req_ids)
+        sampled = sampled_token_ids[:num_reqs].tolist()
+        counts = num_sampled[:num_reqs].tolist()
+        verified = (
+            num_verified[:num_reqs].tolist() if num_verified is not None else None
+        )
+        drafts = draft_tokens[:num_reqs].tolist()
+        confs = (
+            confidences[:num_reqs].float().tolist() if confidences is not None else None
+        )
+        for i, req_id in enumerate(req_ids):
+            record = {
+                "t": self._step,
+                "b": num_reqs,
+                "r": req_id,
+                "s": sampled[i][: counts[i]],
+                "d": drafts[i],
+            }
+            if verified is not None:
+                record["v"] = verified[i]
+            if confs is not None:
+                record["c"] = [round(c, 5) for c in confs[i]]
+            self._file.write(json.dumps(record, separators=(",", ":")) + "\n")
+        self._step += 1
+        if self._step % 256 == 0:
+            self._file.flush()
+
+
+def maybe_create_dspark_trace() -> DSparkTrace | None:
+    if _TRACE_PATH is None or get_tp_group().rank_in_group != 0:
+        return None
+    return DSparkTrace(_TRACE_PATH)

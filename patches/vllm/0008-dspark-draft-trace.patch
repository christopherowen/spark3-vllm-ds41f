+import json
+
+import torch
+
+from vllm.v1.worker.gpu.spec_decode.dspark.trace import DSparkTrace
+
+
+def test_trace_records_sampled_drafts_and_confidences(tmp_path):
+    path = tmp_path / "trace.jsonl"
+    trace = DSparkTrace(str(path))
+    trace.record(
+        ["a", "b"],
+        torch.tensor([[5, 6, -1, -1], [7, -1, -1, -1], [0, 0, 0, 0]]),
+        torch.tensor([2, 1, 0]),
+        torch.tensor([1, 0, 0]),
+        torch.tensor([[1, 2, 3], [4, 5, 6], [0, 0, 0]]),
+        torch.tensor([[0.9, 0.5, 0.25], [0.1, 0.2, 0.3], [0, 0, 0]]),
+    )
+    trace._file.flush()
+    rows = [json.loads(line) for line in path.read_text().splitlines()]
+    assert rows == [
+        {"t": 0, "b": 2, "r": "a", "s": [5, 6], "d": [1, 2, 3], "v": 1,
+         "c": [0.9, 0.5, 0.25]},
+        {"t": 0, "b": 2, "r": "b", "s": [7], "d": [4, 5, 6], "v": 0,
+         "c": [0.1, 0.2, 0.3]},
+    ]

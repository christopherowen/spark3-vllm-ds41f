#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
destination="$repo_root/.work/wheels/cutlass-dsl"
parent=$(dirname -- "$destination")

mkdir -p "$parent"
temporary=$(mktemp -d "$parent/.cutlass-dsl.XXXXXX")
cleanup() {
  rm -rf -- "$temporary"
}
trap cleanup EXIT HUP INT TERM

python3 -m pip download \
  --dest "$temporary" \
  --require-hashes \
  --no-deps \
  --only-binary=:all: \
  --platform manylinux_2_28_aarch64 \
  --implementation cp \
  --python-version 3.12 \
  --abi cp312 \
  --requirement "$repo_root/requirements/cutlass-dsl-aarch64.txt"

previous="$parent/.cutlass-dsl.previous.$$"
if [ -e "$destination" ]; then
  mv -- "$destination" "$previous"
fi
if mv -- "$temporary" "$destination"; then
  temporary="$parent/.cutlass-dsl.consumed.$$"
  rm -rf -- "$previous"
else
  if [ -e "$previous" ]; then
    mv -- "$previous" "$destination"
  fi
  exit 1
fi

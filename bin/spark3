import transport_profiles
import model_layout



def read_json(relative: str) -> dict:
    with (ROOT / relative).open(encoding="utf-8") as handle:
        return json.load(handle)


def cluster_config_path(args: argparse.Namespace | None = None) -> tuple[Path, str]:
    raw = getattr(args, "cluster_config", DEFAULT_CLUSTER_CONFIG)
    relative = Path(raw)
    if relative.is_absolute():
        raise SystemExit("--cluster-config must be relative to the repository root")
    resolved = (ROOT / relative).resolve()
    try:
        canonical = resolved.relative_to(ROOT.resolve()).as_posix()
    except ValueError as error:
        raise SystemExit("--cluster-config must remain inside the repository") from error
    if not resolved.is_file():
        raise SystemExit(f"cluster configuration does not exist: {canonical}")
    return resolved, canonical


# The site's nodes: names, ranks, management IPs and RoCE cabling. Each site
# keeps its own copy (git-ignored), started from config/nodes.example.json;
# cluster sync copies the head node's file to every node.
NODES_FILE = "config/nodes.json"


def site_nodes() -> dict:
    if not (ROOT / NODES_FILE).is_file():
        raise SystemExit(
            f"{NODES_FILE} is missing: copy config/nodes.example.json to it and edit "
            "it for your site (docs/replicate.md, Site configuration)"
        )
    return read_json(NODES_FILE)


def configuration(
    args: argparse.Namespace | None = None,
) -> tuple[dict, dict, dict]:
    cluster_path, _ = cluster_config_path(args)
    cluster = json.loads(cluster_path.read_text(encoding="utf-8"))
    nodes_path = repository_config_path(cluster.get("nodes_config", "config/nodes.json"))
    upstreams_path = repository_config_path(cluster.get("upstreams_config", "upstreams.lock.json"))
    return cluster, (site_nodes() if nodes_path == ROOT / NODES_FILE else json.loads(nodes_path.read_text())), json.loads(upstreams_path.read_text())


def repository_config_path(raw: str) -> Path:
    path = Path(raw)
    resolved = (ROOT / path).resolve()
    if path.is_absolute() or not resolved.is_relative_to(ROOT.resolve()):
        raise SystemExit("configuration paths must remain relative to the repository root")
    return resolved


def node_by_name(nodes: dict, name: str) -> dict:
    for node in nodes["nodes"]:
        if node["name"] == name:
            return node
    raise SystemExit(f"unknown node {name!r}")


def expected_environment(cluster: dict, node: dict) -> dict[str, str]:
    return topology.node_environment(cluster, node)


def expected_command(cluster: dict, node: dict) -> list[str]:
    command = list(cluster["serve_args"])
    command.extend(
        [
            "--node-rank",
            str(node["rank"]),
            "--master-addr",
            cluster["distributed"]["master_addr"],
            "--master-port",
            cluster["distributed"]["master_port"],
        ]
    )
    if not node["head"]:
        command.append("--headless")
    return command


def rendered_docker_command(cluster: dict, node: dict) -> list[str]:
    container = cluster["container"]
    home = cluster["host"]["home"]
    command = ["docker", "run", "-d", "--name", container["name"]]
    command.extend(container["docker_run_args"])
    for key, value in sorted(expected_environment(cluster, node).items()):
        command.extend(["--env", f"{key}={value}"])
    for source, destination, mode in container["mounts"]:
        source = source.format(home=home)
        command.extend(["--volume", f"{source}:{destination}:{mode}"])
    command.append(container["image"])
    command.extend(expected_command(cluster, node))
    return command


def ssh_target(nodes: dict, node: dict) -> str:
    return f"{nodes['ssh_user']}@{node.get('ssh_host', node['name'])}"


SSH_CONTROL_DIR = Path(tempfile.gettempdir()) / f"spark3-ssh-{os.getuid()}"


def ssh_options() -> list[str]:
    """Batch-mode SSH options that reuse one connection per node.

    A fresh connection between the Sparks takes about 0.3 s and a
    multiplexed call about 6 ms; a cluster start makes dozens of calls.
    """
    SSH_CONTROL_DIR.mkdir(mode=0o700, exist_ok=True)
    return [
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=10",
        "-o", "ControlMaster=auto",
        "-o", f"ControlPath={SSH_CONTROL_DIR}/%C",
        "-o", "ControlPersist=120",
    ]


def run_ssh(nodes: dict, node: dict, *command: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            "ssh",
            *ssh_options(),
            ssh_target(nodes, node),
            shlex.join(command),
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def remote_shell(nodes: dict, node: dict, script: str) -> subprocess.CompletedProcess[str]:
    return run_ssh(nodes, node, "bash", "-lc", script)


def write_remote_file(nodes: dict, node: dict, path: str, text: str) -> subprocess.CompletedProcess[str]:
    """Replace a file on a node atomically with the given text."""
    quoted = shlex.quote(path)
    script = f"cat > {quoted}.tmp && mv {quoted}.tmp {quoted}"
    return subprocess.run(
        ["ssh", *ssh_options(), ssh_target(nodes, node), shlex.join(["bash", "-c", script])],
        input=text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def repository_path(cluster: dict) -> str:
    return cluster["deployment"]["path"].format(home=cluster["host"]["home"])


def repository_revision(revision: str = "HEAD") -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--verify", f"{revision}^{{commit}}"],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        raise SystemExit(result.stderr.strip() or f"cannot resolve {revision!r}")
    return result.stdout.strip()


def repository_dirty() -> str:
    result = subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=all"],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        raise SystemExit(result.stderr.strip() or "cannot inspect repository status")
    return result.stdout.strip()


def tracked_secret_problems() -> list[str]:
    result = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        return ["cannot enumerate tracked files for secret checks"]
    paths = [Path(item.decode()) for item in result.stdout.split(b"\0") if item]
    forbidden_names = {".env", "id_rsa", "id_ed25519", "credentials.json"}
    forbidden_suffixes = (".pem", ".key", ".local.env", ".local.json")
    signatures = (
        b"-----BEGIN " + b"PRIVATE KEY-----",
        b"-----BEGIN OPENSSH " + b"PRIVATE KEY-----",
    )
    token_patterns = (
        re.compile(rb"\bgithub_pat_[A-Za-z0-9_]{20,}\b"),
        re.compile(rb"\bghp_[A-Za-z0-9]{20,}\b"),
        re.compile(rb"\bhf_[A-Za-z0-9]{20,}\b"),
        re.compile(rb"\btskey-[A-Za-z0-9-]{20,}\b"),
    )
    problems: list[str] = []
    for relative in paths:
        if relative.name in forbidden_names or relative.name.endswith(forbidden_suffixes):
            problems.append(f"tracked secret-like path: {relative}")
            continue
        candidate = ROOT / relative
        if not candidate.is_file() or candidate.stat().st_size > 2 * 1024 * 1024:
            continue
        contents = candidate.read_bytes()
        if any(signature in contents for signature in signatures) or any(
            pattern.search(contents) for pattern in token_patterns
        ):
            problems.append(f"tracked file contains a secret-like signature: {relative}")
    return problems


class Warn(str):
    """A doctor finding that does not fail doctor or block a benchmark.

    Errors are what breaks serving, safety or a required capability now: the
    display carve-out and the kept text console (modeset, fbdev, DRM master,
    console mode), fan control, RoCE GIDs, the GPU clock and any difference from
    the promoted configuration. Warnings are latent (effective at the next
    boot), cost a little, or could not be read.
    """


def local_doctor(cluster: dict, nodes: dict, upstreams: dict) -> list[str]:
    problems: list[str] = topology.problems(cluster, nodes)
    problems.extend(kernel_backend.problems(cluster))
    if cluster.get("promoted_baseline") != upstreams.get("generated_from_baseline"):
        problems.append("cluster and upstream locks name different baselines")
    host = cluster.get("host", {})
    for key in (
        "memguard_gib",
        "startup_memguard_gib",
        "startup_memguard_wait_seconds",
    ):
        value = host.get(key)
        if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
            problems.append(f"host.{key} must be a positive integer")
    for key in ("memguard_interval_seconds", "startup_memguard_interval_seconds"):
        value = host.get(key)
        if (
            not isinstance(value, (int, float))
            or isinstance(value, bool)
            or value <= 0
        ):
            problems.append(f"host.{key} must be a positive number")
    if (
        isinstance(host.get("startup_memguard_gib"), int)
        and isinstance(host.get("memguard_gib"), int)
        and host["startup_memguard_gib"] <= host["memguard_gib"]
    ):
        problems.append(
            "host.startup_memguard_gib must exceed host.memguard_gib"
        )
    deployment = cluster.get("deployment", {})
    for key in ("repository", "path", "ready_url", "ready_timeout_seconds"):
        if not deployment.get(key):
            problems.append(f"deployment.{key} is not configured")
    if "branch" in deployment and not deployment["branch"]:
        problems.append("deployment.branch must be omitted or name a branch")
    if not isinstance(deployment.get("launch_enabled"), bool):
        problems.append("deployment.launch_enabled must be true or false")
    for name, source in upstreams["sources"].items():
        if not source.get("upstream"):
            problems.append(f"{name}: canonical upstream is not recorded")
        if source["kind"] == "git":
            if len(source["revision"]) != 40:
                problems.append(f"{name}: revision is not a full commit SHA")
            if not source.get("tracking_ref"):
                problems.append(f"{name}: upstream tracking ref is not recorded")
        series = source.get("patch_series")
        if series:
            series_path = ROOT / series
            if not series_path.is_file():
                problems.append(f"{name}: missing patch series {series}")
            else:
                for patch_name in read_series(series_path):
                    if not patch_name.startswith("TODO-") and not (
                        series_path.parent / patch_name
                    ).is_file():
                        problems.append(f"{name}: missing patch {patch_name} (listed in {series})")
        lockfile = source.get("lockfile")
        if lockfile and not (ROOT / lockfile).is_file():
            problems.append(f"{name}: missing dependency lock {lockfile}")
    watchlist_path = ROOT / "docs/inspiration.md"
    watchlist = (
        watchlist_path.read_text(encoding="utf-8") if watchlist_path.is_file() else ""
    )
    if not watchlist:
        problems.append(Warn("missing improvement watchlist docs/inspiration.md"))
    for name, reference in upstreams.get("references", {}).items():
        if reference.get("kind") != "git-watch":
            problems.append(Warn(f"{name}: reference kind must be git-watch"))
        if not reference.get("url") or not reference.get("role"):
            problems.append(Warn(f"{name}: reference URL and role are required"))
        elif reference["url"] not in watchlist:
            problems.append(Warn(f"{name}: reference URL is absent from the watchlist"))
    source_manifest = read_json(
        upstreams.get("source_manifest", "manifests/sources/2026-09-20-active-source.json")
    )
    problems.extend(kernel_backend.source_problems(cluster, upstreams, source_manifest))
    listed = [name for name in OPTIONAL_BUILD_PROJECTS if name in upstreams["sources"]]
    if listed and len(listed) != len(OPTIONAL_BUILD_PROJECTS):
        problems.append(f"{' and '.join(OPTIONAL_BUILD_PROJECTS)} are built together; the lock lists only {listed[0]}")
    for name in listed:
        if not upstreams["sources"][name].get("version"):
            problems.append(f"{name}: package version is not recorded in the lock")
    if topology.transport(cluster) in ("rocenante-ring4", "rocenante-mesh4"):
        mode = topology.transport(cluster)
        record = source_manifest["b12x"]
        if mode not in record.get("capabilities", []):
            problems.append(f"{mode} requires a source manifest with its transport patch")
        label = cluster.get("container", {}).get("expected_labels", {}).get("local.spark3.b12x.tree")
        if label != record["expected_tree"]:
            problems.append(f"{mode} image tree does not match its source manifest")
    if topology.transport(cluster) == "rocenante-mesh4":
        if cluster.get("fabric", {}).get("mesh_paths", 2) == 4 and "rocenante-mesh4-fourpaths" not in source_manifest["b12x"].get("capabilities", []):
            problems.append("four-path mesh requires its source capability")
        problems.extend(mesh_fabric.site_problems(nodes))
        if cluster.get("deployment", {}).get("launch_enabled"):
            problems.append("mesh4 is available for bounded collective qualification only; serving lifecycle is not qualified")
    for name in build_projects(upstreams["sources"]):
        source = upstreams["sources"][name]
        if missing_patches(source):
            continue  # reported above
        record = source_manifest.get(name)
        if record is None:
            problems.append(f"{name}: source manifest has no record")
            continue
        if record.get("patchset_sha256") != patchset_sha256(source):
            problems.append(f"{name}: patch-set fingerprint differs from source manifest")
        if source.get("submodules") and not isinstance(record.get("submodules"), dict):
            problems.append(f"{name}: source manifest does not record its submodule commits")
    for relative, wanted in source_manifest.get("deployment_artifacts", {}).items():
        candidate = ROOT / relative
        if not candidate.is_file():
            problems.append(f"missing deployment artifact {relative}")
        elif sha256(candidate) != wanted:
            problems.append(f"deployment artifact differs from manifest: {relative}")
    problems.extend(tracked_secret_problems())
    return problems


DESKTOP_QUERY = "systemctl get-default; systemctl is-active display-manager.service"


def desktop_problems(node_name: str, output: str) -> list[str]:
    """Problems when a node boots to a desktop or runs its display manager.

    The display stack's processes and GPU buffers come out of the same unified
    memory as the model, and dgx1 has little to spare above its startup guard.
    """
    default_target, manager = (output.split() + ["", ""])[:2]
    problems = []
    if default_target != "multi-user.target":
        problems.append(
            Warn(
                f"{node_name}: boots to {default_target or 'an unknown target'}, "
                "expected multi-user.target (no desktop); run "
                "sudo systemctl set-default multi-user.target"
            )
        )
    if manager in ("active", "activating", "reloading"):
        problems.append(
            f"{node_name}: display manager is {manager}; run "
            "sudo systemctl disable --now display-manager.service"
        )
    return problems


def boot_order_problems(node_name: str, output: str) -> list[str]:
    """Problems when UEFI tries another boot entry before the installed OS.

    A network (PXE) entry first costs about a minute of DHCP timeouts on every
    boot; a firmware update left dgx3 that way.
    """
    order: list[str] = []
    entries: dict[str, str] = {}
    for line in output.splitlines():
        if line.startswith("BootOrder:"):
            order = [item.strip().upper() for item in line.split(":", 1)[1].split(",") if item.strip()]
        elif match := re.match(r"Boot([0-9A-Fa-f]{4})\*?\s+(.*)", line):
            entries[match.group(1).upper()] = match.group(2)
    if not order:
        return [Warn(f"{node_name}: cannot read the UEFI boot order")]
    def installed(entry: str) -> bool:
        return (
            entry.split("\t")[0].strip().lower() == "ubuntu"
            or "\\efi\\ubuntu\\" in entry.lower()
        )

    first = entries.get(order[0], "")
    label = first.split("\t")[0].strip()
    if installed(first):
        return []
    ubuntu = next((number for number in order if installed(entries.get(number, ""))), None)
    ubuntu = ubuntu or next((number for number, entry in entries.items() if installed(entry)), None)
    fix = (
        "run sudo efibootmgr --bootorder "
        + ",".join([ubuntu] + [number for number in order if number != ubuntu])
        if ubuntu
        else "no installed-OS boot entry exists; reinstall the boot loader with grub-install"
    )
    return [
        Warn(
            f"{node_name}: UEFI boots {label or 'entry ' + order[0]!r} before the "
            f"installed OS (BootOrder {','.join(order)}); {fix}"
        )
    ]


# Desktop services that serve nothing on a headless inference node:
# scripts/host-recovery disables them (the display manager has its own check).
IDLE_SERVICES = (
    "bluetooth.service",
    "cups.service",
    "cups.socket",
    "cups.path",
    "cups-browsed.service",
    "snapd.service",
    "snapd.socket",
    "snapd.seeded.service",
    "snapd.snap-repair.timer",
    "fwupd-refresh.timer",
    "dgx-dashboard.service",
    "dgx-dashboard-admin.service",
)

HOST_FACTS_QUERY = """
printf 'modeset=%s\\n' "$(sudo -n cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null)"
printf 'fbdev=%s\\n' "$(sudo -n cat /sys/module/nvidia_drm/parameters/fbdev 2>/dev/null)"
printf 'cmdline_splash=%s\\n' "$(grep -cw splash /proc/cmdline)"
printf 'grub_splash=%s\\n' "$(sudo -n grep -E '^[[:space:]]*linux[[:space:]]' /boot/grub/grub.cfg 2>/dev/null | grep -cw splash)"
card=""
for entry in /sys/class/drm/card[0-9]*; do
  [ "$(basename "$(readlink "$entry/device/driver")")" = nvidia ] && card=${entry##*/card}
done
printf 'drm_card=%s\\n' "$card"
clients=/sys/kernel/debug/dri/$card/clients
if sudo -n test -r "$clients"; then
  printf 'drm_masters=%s\\n' "$(sudo -n cat "$clients" | awk 'NR > 1 && $4 == "y" {print $1 "/" $2}' | paste -sd, -)"
else
  printf 'drm_masters=unreadable\\n'
fi
vt=$(cat /sys/class/tty/tty0/active 2>/dev/null)
printf 'console=%s:%s\\n' "$vt" "$(sudo -n python3 -c 'import fcntl, struct, sys; f = open(sys.argv[1], "rb"); print(struct.unpack("i", fcntl.ioctl(f, 0x4B3B, struct.pack("i", 0)))[0])' "/dev/$vt" 2>/dev/null)"
printf 'kernel=%s\\n' "$(uname -r)"
printf 'fan_dkms=%s\\n' "$(dkms status -m dgx-spark-fan-control -k "$(uname -r)" 2>/dev/null | head -1)"
printf 'fan_module=%s\\n' "$(grep -c '^dgx_ec_fan_control ' /proc/modules)"
printf 'fan_cooling_device=%s\\n' "$(grep -lx dgx_ec_fan_floor /sys/class/thermal/cooling_device*/type 2>/dev/null | wc -l)"
printf 'fan_service=%s/%s\\n' "$(systemctl is-enabled dgx-fan-control.service 2>/dev/null)" \\
  "$(systemctl is-active dgx-fan-control.service 2>/dev/null)"
printf 'gpu=%s\\n' "$(nvidia-smi --query-gpu=clocks.sm,power.draw --format=csv,noheader,nounits 2>/dev/null | head -1)"
"""
HOST_FACTS_QUERY += (
    r"""printf 'idle_services=%s\n' "$(for unit in """
    + " ".join(IDLE_SERVICES)
    + r"""; do
  state=$(systemctl is-enabled "$unit" 2>/dev/null)
  if systemctl is-active --quiet "$unit" || [ "$state" = enabled ] || [ "$state" = alias ]; then
    printf '%s\n' "$unit"
  fi
done | paste -sd, -)"
"""
)
HOST_FACTS_QUERY += r"""printf 'nvme_coalescing=%s\n' "$(for c in /dev/nvme[0-9]*; do
  [ -c "$c" ] || continue
  printf '%s:%s\n' "${c#/dev/}" "$(sudo -n nvme get-feature "$c" -f 8 2>/dev/null | awk -F'value:' 'NF > 1 {print $2}')"
done | paste -sd, -)"
printf 'nvme_coalescing_service=%s\n' "$(systemctl is-enabled nvidia-nvme-interrupt-coalescing.service 2>/dev/null)"
"""


def host_facts(output: str) -> dict[str, str]:
    facts = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            facts[key.strip()] = value.strip()
    return facts


def modeset_problems(node_name: str, facts: dict[str, str]) -> list[str]:
    """Problems when nvidia-drm does not drive displays (kernel mode setting, required).

    Without it only the firmware framebuffer shows a console, and only for a
    display attached at boot: a monitor or KVM connected later stays dark.
    nvidia-drm also offers DRM dumb buffers only with mode setting, so the
    display carve-out that holds the embedding and output head (vLLM patch
    0021) cannot be allocated and the worker refuses to start.
    """
    value = facts.get("modeset", "")
    if value == "Y":
        return []
    return [
        f"{node_name}: nvidia-drm modeset is {value or 'unreadable'}, expected Y "
        "(a display attached after boot stays dark and the display carve-out cannot "
        "be allocated); run sudo apt purge nvidia-drm-options-modeset0 and reboot "
        "with the service stopped"
    ]


def fbdev_problems(node_name: str, facts: dict[str, str]) -> list[str]:
    """Problems when nvidia-drm provides no framebuffer console (required).

    With fbdev off, a display attached to the node shows no text console. The
    console framebuffer takes 8 MiB of the display carve-out at 1920x1080,
    which the serving configuration leaves free.
    """
    value = facts.get("fbdev", "")
    if value == "Y":
        return []
    return [
        f"{node_name}: nvidia-drm fbdev is {value or 'unreadable'}, expected Y "
        "(an attached display gets no text console); remove the nvidia-drm fbdev=0 "
        "option (grep -rn fbdev /etc/modprobe.d), run sudo update-initramfs -u, and "
        "reboot with the service stopped"
    ]


def drm_card_problems(node_name: str, facts: dict[str, str]) -> list[str]:
    """Problems when no DRM card belongs to the nvidia driver.

    The display carve-out (vLLM patch 0021) allocates through that card, which
    the container bind-mounts by its PCI path (Docker device flags split on its colons)
    (/dev/dri/by-path/pci-000f:01:00.0-card): a node that boots with a display
    attached registers simpledrm first, so the GPU can be card1 there.
    """
    if facts.get("drm_card"):
        return []
    return [
        f"{node_name}: no DRM card belongs to the nvidia driver, so the display "
        "carve-out cannot be allocated; check that nvidia-drm is loaded with "
        "modeset=Y (ls -l /dev/dri/by-path)"
    ]


def drm_master_problems(node_name: str, facts: dict[str, str]) -> list[str]:
    """Problems when a userspace process holds DRM master.

    The kernel's framebuffer console stops drawing while a userspace master
    exists. The serving worker closes its DRM file right after importing the
    display carve-out, so nothing should hold master on these headless nodes.
    """
    value = facts.get("drm_masters", "unreadable")
    if not value:
        return []
    if value == "unreadable":
        return [
            Warn(
                f"{node_name}: cannot read the DRM clients "
                "(/sys/kernel/debug/dri/<card>/clients)"
            )
        ]
    return [
        f"{node_name}: {value} holds DRM master, so the text console cannot draw; stop "
        "or restart that process (the serving worker releases the device right after "
        "startup)"
    ]


def console_mode_problems(node_name: str, facts: dict[str, str]) -> list[str]:
    """Problems when the active virtual console is in graphics mode.

    The boot splash can leave it there after Plymouth quits; the kernel then
    draws no text on an attached display although fbcon is available.
    """
    console, _, mode = facts.get("console", "").partition(":")
    if mode == "0":
        return []
    if mode == "1":
        return [
            f"{node_name}: the active console ({console}) is in graphics mode, so an "
            "attached display shows no text; run scripts/host-recovery apply on the node "
            "(it switches the console to text mode now and removes splash from later boots)"
        ]
    return [Warn(f"{node_name}: cannot read the active console mode")]


def splash_problems(node_name: str, facts: dict[str, str]) -> list[str]:
    """Warnings when the kernel boots with the Plymouth splash.

    Latent until the next boot: console_mode_problems reports a console that
    is in graphics mode now.

    Plymouth leaves the active console in graphics mode after it quits, so an
    attached display shows no text console after a boot. host-recovery
    installs /etc/default/grub.d/zz-spark-console.cfg, which drops splash from
    the command line that dgxstation-grub's menu.cfg sets.
    """
    if facts.get("cmdline_splash", "0") == "0":
        return []
    if facts.get("grub_splash") == "0":
        return [
            Warn(
                f"{node_name}: booted with splash, but the boot configuration omits it "
                "now; reboot with the service stopped to apply"
            )
        ]
    return [
        Warn(
            f"{node_name}: the kernel command line has splash, which leaves the console "
            "in graphics mode after boot; run scripts/host-recovery apply on the node (it "
            "installs /etc/default/grub.d/zz-spark-console.cfg and runs update-grub), "
            "then reboot with the service stopped"
        )
    ]


def idle_service_warnings(node_name: str, facts: dict[str, str]) -> list[str]:
    """Warnings when desktop services run on a headless inference node.

    Bluetooth, CUPS, cups-browsed and snapd (every installed snap is a desktop
    application) each hold memory on every node, up to about 50 MiB, and
    cups-browsed listens on the network. fwupd's daily refresh timer keeps its
    daemon resident; fwupdmgr starts the daemon on demand without it. NVIDIA's
    DGX Dashboard runs periodic update checks (spark-ota-check) that peak near
    850 MiB and wake fwupd and PackageKit.
    host-recovery disables them. These are warnings: they cost a little memory
    and do not fail doctor or block a benchmark.
    """
    units = [unit for unit in facts.get("idle_services", "").split(",") if unit]
    if not units:
        return []
    return [
        Warn(
            f"{node_name}: {', '.join(units)} enabled or running, though unused on a "
            f"headless inference node; run sudo systemctl disable --now "
            f"{' '.join(units)} (scripts/host-recovery apply does the same)"
        )
    ]


NVME_COALESCING_FIX = (
    "sudo systemctl mask --now nvidia-nvme-interrupt-coalescing.service && "
    "sudo /usr/bin/nvidia-nvme-interrupt-coalescing.sh disable"
)


def nvme_coalescing_warnings(node_name: str, facts: dict[str, str]) -> list[str]:
    """NVMe interrupt coalescing (feature 0x08), which this site keeps off.

    DGX OS's nvidia-nvme-interrupt-coalescing.service sets it to 0x107 at every
    boot: one interrupt per 8 completions or 100 us. Engram's disk rows are
    small direct reads, and a lone read then waits for the timer. The drives
    default to 0 (off) and cannot save the feature, so masking the service and
    running its disable action keeps it off across boots. These are warnings:
    coalescing costs read latency, not correctness.
    """
    values = {}
    for entry in filter(None, facts.get("nvme_coalescing", "").split(",")):
        controller, _, value = entry.partition(":")
        values[controller] = value.strip()
    if not values:
        return []
    warnings = []
    unreadable = sorted(c for c, v in values.items() if not v)
    if unreadable:
        warnings.append(Warn(
            f"{node_name}: cannot read NVMe interrupt coalescing on {', '.join(unreadable)} "
            "(nvme get-feature -f 8 needs passwordless sudo and nvme-cli)"
        ))
    enabled = sorted(f"{c}={v}" for c, v in values.items() if v and int(v, 16) != 0)
    if enabled:
        warnings.append(Warn(
            f"{node_name}: NVMe interrupt coalescing is on ({', '.join(enabled)}), "
            f"but this site keeps it off; run {NVME_COALESCING_FIX}"
        ))
    service = facts.get("nvme_coalescing_service", "")
    if service not in ("masked", "masked-runtime", "not-found", ""):
        warnings.append(Warn(
            f"{node_name}: nvidia-nvme-interrupt-coalescing.service is {service} and turns "
            f"coalescing back on at the next boot; run {NVME_COALESCING_FIX}"
        ))
    return warnings


def fan_control_problems(node_name: str, facts: dict[str, str]) -> list[str]:
    """The first missing layer of the DGX Spark additive fan-floor control.

    Each layer needs the one before it: the signed DKMS module for the running
    kernel, the loaded module, its dgx_ec_fan_floor cooling device, and the
    dgx-fan-control daemon, enabled and running.
    """
    kernel = facts.get("kernel") or "the running kernel"
    if "installed" not in facts.get("fan_dkms", ""):
        return [
            f"{node_name}: DKMS dgx-spark-fan-control is not installed for {kernel}; run "
            f"sudo dkms autoinstall -k {facts.get('kernel') or '$(uname -r)'}"
        ]
    if facts.get("fan_module") != "1":
        return [
            f"{node_name}: dgx_ec_fan_control is not loaded; run sudo modprobe "
            "dgx_ec_fan_control (if it is refused, check that the fleet signing key is "
            "enrolled with mokutil --list-enrolled)"
        ]
    if facts.get("fan_cooling_device") != "1":
        return [
            f"{node_name}: dgx_ec_fan_control is loaded but its dgx_ec_fan_floor cooling device "
            "is missing (the driver refused it at probe; see dmesg)"
        ]
    if facts.get("fan_service") != "enabled/active":
        return [
            f"{node_name}: dgx-fan-control.service is {facts.get('fan_service') or 'unknown'}, "
            "expected enabled/active; run sudo systemctl enable --now dgx-fan-control.service"
        ]
    return []


def roce_gid_setting(cluster: dict, node: dict) -> tuple[int, list[str]]:
    """The GID index B12X and NCCL are configured to use, and the node's HCAs."""
    env = expected_environment(cluster, node)
    key = "NCCL_IB_GID_INDEX" if topology.transport(cluster) == "nccl-ring" else "B12X_ROCE_GID_INDEX"
    index = int(env.get(key) or env.get("NCCL_IB_GID_INDEX") or 3)
    hcas = sorted({hca for peers in node["roce_peer_hcas"].values() for hca in peers})
    return index, hcas


def roce_gid_query(hcas: list[str]) -> str:
    """Every populated GID slot of each HCA as `hca index type gid ndev`."""
    return (
        f"for d in {' '.join(shlex.quote(hca) for hca in hcas)}; do "
        'p=/sys/class/infiniband/$d/ports/1; '
        '[ -d $p ] || { echo "$d missing"; continue; }; '
        'for g in $p/gids/*; do i=${g##*/}; '
        't=$(cat $p/gid_attrs/types/$i 2>/dev/null | tr -d " "); [ -n "$t" ] || continue; '
        'echo "$d $i $t $(cat $g) $(cat $p/gid_attrs/ndevs/$i 2>/dev/null)"; done; done'
    )


def roce_gid_problems(node_name: str, index: int, hcas: list[str], output: str) -> list[str]:
    """Problems when an HCA's configured GID slot is not its IPv4 RoCE v2 address.

    B12X and NCCL both use one fixed GID index. The kernel files a re-added
    address in the lowest free slot, so a link flap while RDMA resources still
    hold the old entry moves the IPv4 RoCE v2 GID (dgx3 moved from 3 to 4 when
    its peers rebooted under a starting service), and NCCL then fails with an
    unhandled system error.
    """
    slots: dict[str, dict[int, tuple[str, str, str]]] = {hca: {} for hca in hcas}
    for line in output.splitlines():
        fields = line.split()
        if len(fields) == 2 and fields[1] == "missing" and fields[0] in slots:
            slots.pop(fields[0])
        elif len(fields) >= 4 and fields[0] in slots and fields[1].isdigit():
            ndev = fields[4] if len(fields) > 4 else ""
            slots[fields[0]][int(fields[1])] = (fields[2], fields[3], ndev)
    problems = []
    for hca in hcas:
        if hca not in slots:
            problems.append(f"{node_name}: RDMA device {hca} is missing")
            continue
        entries = slots[hca]
        kind, gid, _ = entries.get(index, ("", "", ""))
        if kind == "RoCEv2" and gid.startswith("0000:0000:0000:0000:0000:ffff:"):
            continue
        found = [
            (slot, ndev) for slot, (slot_kind, slot_gid, ndev) in sorted(entries.items())
            if slot_kind == "RoCEv2" and slot_gid.startswith("0000:0000:0000:0000:0000:ffff:")
        ]
        where = (
            f"its IPv4 RoCE v2 GID is at index {found[0][0]}; re-activate {found[0][1]} "
            "with nmcli while nothing uses RDMA"
            if found else "it has no IPv4 RoCE v2 GID"
        )
        problems.append(
            f"{node_name}: {hca} GID index {index} is "
            f"{kind + ' ' + gid if kind else 'empty'}; {where}"
        )
    return problems


LATCHED_CLOCK_MHZ = 1000


def clock_latch_problems(node_name: str, facts: dict[str, str], serving: bool) -> list[str]:
    """Problems when a serving GB10 GPU is held far below its normal clock.

    With the service running, a healthy GB10 stays in P0 at about 2,400 MHz
    even between requests. The known GB10 clock latch holds it at about
    500-720 MHz and 10-14 W with no throttle reason; nvidia-smi -lgc and a warm
    reboot do not clear it, removing AC power does (docs/recovery.md).
    """
    if not serving:
        return []
    clock, _, power = facts.get("gpu", "").partition(",")
    try:
        clock_mhz = float(clock)
    except ValueError:
        return [Warn(f"{node_name}: cannot read the GPU clock")]
    if clock_mhz >= LATCHED_CLOCK_MHZ:
        return []
    return [
        f"{node_name}: GPU clock is {clock_mhz:.0f} MHz at {power.strip() or '?'} W while serving; "
        "the GB10 clock latch holds it there until AC power is removed (docs/recovery.md)"
    ]


def node_kernel_inventory(nodes: dict, node: dict, policy: dict) -> dict:
    query = shlex.join(["sudo", "-n", "python3", "-c",
                        (ROOT / "scripts/kernel_readiness.py").read_text(), json.dumps(policy)])
    result = remote_shell(nodes, node, query)
    try:
        inventory = json.loads(result.stdout)
        if result.returncode or not isinstance(inventory, dict):
            raise ValueError(result.stderr.strip() or "kernel inventory failed")
        return inventory
    except (ValueError, TypeError) as error:
        return {"errors": [str(error)]}


def kernel_policy_path(cluster: dict) -> Path:
    relative = Path(cluster.get("host", {}).get("kernel_policy", "config/kernel-trial.json"))
    path = (ROOT / relative).resolve()
    if relative.is_absolute() or not path.is_relative_to(ROOT.resolve()):
        raise ValueError("host.kernel_policy must remain inside the repository")
    return path


def live_doctor(cluster: dict, nodes: dict) -> list[str]:
    """Findings about the live cluster: errors, and Warn for the minor ones."""
    problems: list[str] = []
    trial_path = kernel_policy_path(cluster)
    trial = json.loads(trial_path.read_text()) if trial_path.exists() else None
    kernel_inventories = {}
    corrections = []
    name = cluster["container"]["name"]
    for node in nodes["nodes"]:
        if topology.transport(cluster) == "rocenante-mesh4":
            query = shlex.join(["python3", "-c", (ROOT / "scripts/mesh_fabric.py").read_text(),
                                "inventory", "--node-json", json.dumps(node)])
            result = remote_shell(nodes, node, query)
            try:
                if result.returncode:
                    raise ValueError(result.stderr.strip())
                errors, fixes = mesh_fabric.findings(node, json.loads(result.stdout))
                problems.extend(errors)
                corrections.extend(fixes)
            except (ValueError, TypeError) as error:
                problems.append(f"{node['name']}: mesh NIC inventory failed: {error}")
        if trial:
            inventory = node_kernel_inventory(nodes, node, trial)
            kernel_inventories[node["name"]] = inventory
            warnings, fixes = kernel_readiness.findings(node["name"], inventory, trial)
            problems.extend(Warn(warning) for warning in warnings)
            corrections.extend(fixes)
            problems.extend(kernel_readiness.profile_problems(
                node["name"], inventory, cluster["host"].get("kernel"), trial))
        desktop = remote_shell(nodes, node, DESKTOP_QUERY)
        problems.extend(desktop_problems(node["name"], desktop.stdout))
        boot = run_ssh(nodes, node, "efibootmgr")
        problems.extend(boot_order_problems(node["name"], boot.stdout))
        facts = host_facts(remote_shell(nodes, node, HOST_FACTS_QUERY).stdout)
        problems.extend(modeset_problems(node["name"], facts))
        problems.extend(fbdev_problems(node["name"], facts))
        problems.extend(drm_card_problems(node["name"], facts))
        problems.extend(drm_master_problems(node["name"], facts))
        problems.extend(console_mode_problems(node["name"], facts))
        problems.extend(splash_problems(node["name"], facts))
        problems.extend(idle_service_warnings(node["name"], facts))
        problems.extend(nvme_coalescing_warnings(node["name"], facts))
        problems.extend(fan_control_problems(node["name"], facts))
        gid_index, hcas = roce_gid_setting(cluster, node)
        gids = remote_shell(nodes, node, roce_gid_query(hcas))
        problems.extend(roce_gid_problems(node["name"], gid_index, hcas, gids.stdout))
        problems.extend(topology.gid_subnet_problems(node, gid_index, gids.stdout))
        result = run_ssh(nodes, node, "docker", "inspect", name)
        if result.returncode:
            problems.append(f"{node['name']}: cannot inspect {name}: {result.stderr.strip()}")
            continue
        inspection = json.loads(result.stdout)[0]
        if not inspection["State"]["Running"]:
            problems.append(f"{node['name']}: container is not running")
        problems.extend(
            clock_latch_problems(node["name"], facts, bool(inspection["State"]["Running"]))
        )
        if inspection["Config"]["Image"] != cluster["container"]["image"]:
            problems.append(
                f"{node['name']}: image tag {inspection['Config']['Image']!r} differs"
            )
        actual_command = inspection["Config"]["Cmd"]
        wanted_command = expected_command(cluster, node)
        if actual_command != wanted_command:
            problems.append(f"{node['name']}: vLLM command differs from promoted config")
        actual_env = dict(item.split("=", 1) for item in inspection["Config"]["Env"])
        for key, wanted in expected_environment(cluster, node).items():
            if actual_env.get(key) != wanted:
                problems.append(
                    f"{node['name']}: {key}={actual_env.get(key)!r}, expected {wanted!r}"
                )
        label_result = run_ssh(
            nodes,
            node,
            "docker",
            "image",
            "inspect",
            cluster["container"]["image"],
        )
        if label_result.returncode:
            problems.append(f"{node['name']}: cannot inspect image labels")
            continue
        labels = json.loads(label_result.stdout)[0]["Config"].get("Labels") or {}
        for key, wanted in cluster["container"]["expected_labels"].items():
            if labels.get(key) != wanted:
                problems.append(
                    f"{node['name']}: image label {key}={labels.get(key)!r}, expected {wanted!r}"
                )
    if trial:
        problems.extend(kernel_readiness.alignment(kernel_inventories))
        if corrections:
            problems.append(Warn("Kernel corrections (not executed):\n  " + "\n  ".join(dict.fromkeys(corrections))))
    return problems


def split_findings(findings: list[str]) -> tuple[list[str], list[str]]:
    """Errors and warnings, each in their original order."""
    errors = [finding for finding in findings if not isinstance(finding, Warn)]
    warnings = [finding for finding in findings if isinstance(finding, Warn)]
    return errors, warnings


def report_doctor(problems: list[str], warnings: list[str], live: bool) -> int:
    """Print warnings and problems; only problems fail."""
    for warning in warnings:
        print(f"WARN: {warning}")
    for problem in problems:
        print(f"ERROR: {problem}")
    if problems:
        return 1
    summary = "configuration OK" + ("; live cluster matches" if live else "")
    if warnings:
        summary += f" with {len(warnings)} warning" + ("s" if len(warnings) > 1 else "")
    print(summary)
    return 0


def command_doctor(args: argparse.Namespace) -> int:
    cluster, nodes, upstreams = configuration(args)
    findings = local_doctor(cluster, nodes, upstreams)
    if args.live and not split_findings(findings)[0]:
        findings.extend(live_doctor(cluster, nodes))
    problems, warnings = split_findings(findings)
    return report_doctor(problems, warnings, args.live)


def command_tuning(args: argparse.Namespace) -> int:
    if args.cluster_config != DEFAULT_CLUSTER_CONFIG:
        raise SystemExit("tuning profiles select their pinned base; omit --cluster-config")
    try:
        profile, resolved = transport_profiles.resolve(ROOT, args.profiles_config, args.profile)
        layout = model_layout.describe(ROOT, resolved, transport_profiles.size_bytes(
            resolved["environment"]["VLLM_ROCE_ALLREDUCE_MAX_SIZE"]))
        if args.tuning_command == "show":
            print(json.dumps({**profile, "derived_layout": layout}, indent=2))
            return 0
        nodes_path = repository_config_path(args.nodes_config)
        output = repository_config_path(args.output)
        if not output.is_relative_to((ROOT / "experiments").resolve()):
            raise ValueError("new tuning candidates belong under experiments/")
        nodes = json.loads(nodes_path.read_text())
        candidate = transport_profiles.materialize(
            profile, resolved, nodes, nodes_path.relative_to(ROOT.resolve()).as_posix())
        candidate["tuning_origin"] = {
            "catalog": args.profiles_config,
            "catalog_sha256": hashlib.sha256(repository_config_path(args.profiles_config).read_bytes()).hexdigest(),
            "profile": args.profile,
            "base_config": profile["base_config"],
            "base_sha256": profile["base_sha256"],
            "derived_layout": layout,
        }
        output.parent.mkdir(parents=True, exist_ok=True)
        with output.open("x") as handle:
            json.dump(candidate, handle, indent=2)
            handle.write("\n")
    except (ValueError, OSError) as error:
        raise SystemExit(f"invalid tuning profile: {error}") from error
    print(f"created {output.relative_to(ROOT.resolve())} ({args.profile}, launch disabled)")
    return 0


def command_topology_create(args: argparse.Namespace) -> int:
    cluster, _, _ = configuration(args)
    nodes_path = repository_config_path(args.nodes_config)
    output = repository_config_path(args.output)
    nodes = json.loads(nodes_path.read_text())
    try:
        candidate = topology.candidate(cluster, nodes, nodes_path.relative_to(ROOT.resolve()).as_posix())
    except (ValueError, StopIteration) as error:
        raise SystemExit(f"invalid topology: {error}") from error
    output.parent.mkdir(parents=True, exist_ok=True)
    # A new candidate must never overwrite the promoted config or another run.
    with output.open("x") as handle:
        json.dump(candidate, handle, indent=2)
        handle.write("\n")
    print(f"created {output.relative_to(ROOT.resolve())} ({len(nodes['nodes'])} nodes, "
          f"{topology.transport(candidate)}, launch disabled)")
    return 0


def collective_probe_command(cluster: dict, nodes: dict, node: dict, port: int) -> list[str]:
    env = expected_environment(cluster, node)
    env.update(NCCL_DEBUG="INFO", NCCL_DEBUG_SUBSYS="INIT,GRAPH,NET")
    command = ["docker", "run", "--rm", "--name=spark3-collective-probe",
               "--network=host", "--gpus=all", "--memory=12g", "--memory-swap=12g",
               "--device=/dev/infiniband:/dev/infiniband:rwm", "--cap-add=IPC_LOCK",
               "--ulimit=memlock=-1:-1", "--shm-size=256m",
               "--entrypoint=/usr/bin/timeout"]
    for key, value in sorted(env.items()):
        command.extend(["--env", f"{key}={value}"])
    command.extend(["--volume", f"{repository_path(cluster)}/scripts/probe_collectives.py:/probe.py:ro",
                    cluster["container"]["image"], "--signal=TERM", "--kill-after=10s", "600s",
                    "python3", "/probe.py", "--rank", str(node["rank"]),
                    "--world-size", str(len(nodes["nodes"])), "--master-addr",
                    cluster["distributed"]["master_addr"], "--master-port", str(port)])
    if topology.transport(cluster) == "rocenante-mesh4":
        command = ["sudo", "python3", f"{repository_path(cluster)}/scripts/mesh_probe.py",
                   "--nodes", f"{repository_path(cluster)}/{cluster['nodes_config']}",
                   "--rank", str(node["rank"]), "--paths", str(cluster.get("fabric", {}).get("mesh_paths", 2)),
                   "--serving-container", cluster["container"]["name"],
                   "--marker", "/usr/local/libexec/spark3-roce-marker", "--"] + command
    return command


def command_topology_probe(args: argparse.Namespace) -> int:
    cluster, nodes, upstreams = configuration(args)
    errors, warnings = split_findings(local_doctor(cluster, nodes, upstreams))
    if errors:
        return report_doctor(errors, warnings, False)
    if not 1 <= args.master_port <= 65535 or str(args.master_port) == str(cluster["distributed"]["master_port"]):
        raise SystemExit("probe port must be valid and different from the serving rendezvous port")
    node = node_by_name(nodes, args.node)
    print("# Plan only. Run on this node during a coordinated window with serving stopped.")
    print(shlex.join(collective_probe_command(cluster, nodes, node, args.master_port)))
    return 0


def command_status(args: argparse.Namespace) -> int:
    cluster, nodes, _ = configuration(args)
    name = cluster["container"]["name"]
    failed = False
    for node in nodes["nodes"]:
        result = run_ssh(
            nodes,
            node,
            "docker",
            "ps",
            "--filter",
            f"name=^{name}$",
            "--format",
            "{{.Names}}|{{.Image}}|{{.Status}}",
        )
        guard = run_ssh(
            nodes,
            node,
            "systemctl",
            "is-active",
            f"{name}-memguard.service",
        )
        output = result.stdout.strip() if result.returncode == 0 else result.stderr.strip()
        guard_state = guard.stdout.strip() if guard.returncode == 0 else "inactive"
        print(f"{node['name']}\t{output or 'not running'}\tmemguard={guard_state}")
        failed |= result.returncode != 0 or not bool(result.stdout.strip())
    return int(failed)


def deployment_order(nodes: dict) -> list[dict]:
    workers = sorted(
        (node for node in nodes["nodes"] if not node["head"]),
        key=lambda node: node["rank"],
    )
    heads = [node for node in nodes["nodes"] if node["head"]]
    return workers + heads


def require_local_deployment_state(cluster: dict, nodes: dict, upstreams: dict) -> str:
    problems, warnings = split_findings(local_doctor(cluster, nodes, upstreams))
    for warning in warnings:
        print(f"WARN: {warning}", file=sys.stderr)
    dirty = repository_dirty()
    if dirty:
        problems.append("deployment requires a clean local repository")
    if problems:
        for problem in problems:
            print(f"ERROR: {problem}", file=sys.stderr)
        raise SystemExit(1)
    return repository_revision()


def normalized_repository_url(url: str) -> str:
    return url.rstrip("/").removesuffix(".git")


def remote_status_command(cluster: dict) -> str:
    repo = Path(repository_path(cluster))
    pathspecs = ["."]
    for source, _, mode in cluster["container"]["mounts"]:
        if mode != "rw":
            continue
        source_path = Path(source.format(home=cluster["host"]["home"]))
        try:
            relative = source_path.relative_to(repo)
        except ValueError:
            continue
        pathspecs.append(f":(exclude){relative.as_posix()}")
    return shlex.join(
        ["git", "status", "--porcelain", "--untracked-files=all", "--", *pathspecs]
    )


def remote_repository_state(
    cluster: dict, nodes: dict, node: dict
) -> tuple[str, str, str]:
    path = shlex.quote(repository_path(cluster))
    result = remote_shell(
        nodes,
        node,
        f"cd {path} && printf '%s\\n' \"$(git rev-parse HEAD)\" && "
        "git remote get-url origin && "
        f"{remote_status_command(cluster)}",
    )
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"{node['name']}: cannot inspect checkout: {detail}")
    lines = result.stdout.splitlines()
    if len(lines) < 2:
        raise RuntimeError(f"{node['name']}: checkout returned incomplete identity")
    return lines[0], lines[1], "\n".join(lines[2:]).strip()


def remote_runtime_problems(
    cluster: dict,
    nodes: dict,
    revision: str,
    *,
    allow_existing: bool,
    cluster_config: str,
) -> list[str]:
    """Pre-launch checks of every node, the nodes concurrently; findings keep node order."""
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(nodes["nodes"])) as pool:
        findings = pool.map(
            lambda node: node_runtime_problems(
                cluster, nodes, node, revision,
                allow_existing=allow_existing, cluster_config=cluster_config,
            ),
            nodes["nodes"],
        )
        return [problem for node_problems in findings for problem in node_problems]


def mount_test_script(cluster: dict) -> str:
    """One remote script testing every mount source (writable for rw, readable for ro)."""
    lines = []
    for source, _, mode in cluster["container"]["mounts"]:
        source = source.format(home=cluster["host"]["home"])
        test = "-w" if mode == "rw" else "-r"
        lines.append(
            f"test {test} {shlex.quote(source)} || printf '%s %s\\n' {mode} {shlex.quote(source)}"
        )
    return "\n".join(lines) + "\ntrue\n"


def node_runtime_problems(
    cluster: dict,
    nodes: dict,
    node: dict,
    revision: str,
    *,
    allow_existing: bool,
    cluster_config: str,
) -> list[str]:
    problems: list[str] = []
    repo = repository_path(cluster)
    name = cluster["container"]["name"]
    try:
        remote_revision, remote_origin, dirty = remote_repository_state(cluster, nodes, node)
    except RuntimeError as error:
        return [str(error)]
    if remote_revision != revision:
        problems.append(
            f"{node['name']}: checkout {remote_revision} differs from deployment {revision}"
        )
    if normalized_repository_url(remote_origin) != normalized_repository_url(
        cluster["deployment"]["repository"]
    ):
        problems.append(
            f"{node['name']}: origin {remote_origin!r} differs from deployment repository"
        )
    if dirty:
        problems.append(f"{node['name']}: checkout has uncommitted files")
    if cluster["host"].get("kernel"):
        policy = json.loads(kernel_policy_path(cluster).read_text())
        inventory = node_kernel_inventory(nodes, node, policy)
        problems.extend(kernel_readiness.profile_problems(
            node["name"], inventory, cluster["host"]["kernel"], policy))
    gid_index, hcas = roce_gid_setting(cluster, node)
    gids = remote_shell(nodes, node, roce_gid_query(hcas))
    problems.extend(roce_gid_problems(node["name"], gid_index, hcas, gids.stdout))
    problems.extend(topology.gid_subnet_problems(node, gid_index, gids.stdout))
    doctor = run_ssh(
        nodes,
        node,
        f"{repo}/bin/spark3",
        "--cluster-config",
        cluster_config,
        "doctor",
    )
    if doctor.returncode:
        detail = doctor.stdout.strip() or doctor.stderr.strip()
        problems.append(f"{node['name']}: repository doctor failed: {detail}")
    mounts = run_ssh(nodes, node, "sh", "-c", mount_test_script(cluster))
    for line in mounts.stdout.splitlines():
        mode, _, source = line.partition(" ")
        problems.append(f"{node['name']}: {mode} mount source is unavailable: {source}")
    image = run_ssh(
        nodes,
        node,
        "docker",
        "image",
        "inspect",
        cluster["container"]["image"],
    )
    if image.returncode:
        problems.append(
            f"{node['name']}: image is unavailable: {cluster['container']['image']}"
        )
    else:
        labels = json.loads(image.stdout)[0]["Config"].get("Labels") or {}
        for key, wanted in cluster["container"]["expected_labels"].items():
            if labels.get(key) != wanted:
                problems.append(
                    f"{node['name']}: image label {key}={labels.get(key)!r}, "
                    f"expected {wanted!r}"
                )
    existing = run_ssh(nodes, node, "docker", "inspect", name)
    if existing.returncode == 0 and not allow_existing:
        problems.append(
            f"{node['name']}: container {name} already exists; use --replace explicitly"
        )
    sudo = run_ssh(nodes, node, "sudo", "-n", "true")
    if sudo.returncode:
        problems.append(f"{node['name']}: passwordless sudo is unavailable for memguard")
    return problems


def command_cluster_sync(args: argparse.Namespace) -> int:
    cluster, nodes, upstreams = configuration(args)
    _, config_relative = cluster_config_path(args)
    revision = repository_revision(args.revision or "HEAD")
    path = repository_path(cluster)
    for node in nodes["nodes"]:
        print(f"{node['name']}: fetch origin and detach {path} at {revision}")
    if not args.apply:
        print("plan only; pass --apply to synchronize")
        return 0

    local_revision = require_local_deployment_state(cluster, nodes, upstreams)
    if revision != local_revision and args.revision is None:
        raise SystemExit("resolved deployment revision changed unexpectedly")
    # Only published commits deploy. A configured branch (the promoted config
    # uses main) restricts deployment to that branch; without one, any commit
    # reachable from a branch on origin qualifies, so experiment configs keep
    # working after their branch is merged and deleted.
    branch = cluster["deployment"].get("branch")
    checked(["git", "fetch", "--quiet", "--prune", "origin"], cwd=ROOT)
    containing = [
        ref.removeprefix("origin/")
        for ref in subprocess.run(
            ["git", "branch", "--remotes", "--contains", revision,
             "--format=%(refname:short)"],
            cwd=ROOT,
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout.split()
        if ref.startswith("origin/") and ref != "origin/HEAD"
    ]
    if branch is not None and branch not in containing:
        raise SystemExit(
            f"refusing to deploy {revision}: it is not published on origin/{branch}"
        )
    if not containing:
        raise SystemExit(
            f"refusing to deploy {revision}: it is not published on any origin branch"
        )

    previous: dict[str, str] = {}
    for node in nodes["nodes"]:
        try:
            old_revision, remote_origin, dirty = remote_repository_state(
                cluster, nodes, node
            )
        except RuntimeError as error:
            raise SystemExit(str(error)) from error
        if dirty:
            raise SystemExit(
                f"{node['name']}: checkout is dirty; preserve or remove its changes explicitly"
            )
        if normalized_repository_url(remote_origin) != normalized_repository_url(
            cluster["deployment"]["repository"]
        ):
            raise SystemExit(
                f"{node['name']}: origin {remote_origin!r} is not the configured repository"
            )
        previous[node["name"]] = old_revision

    # Read before any checkout: on the head node the checkout can be ROOT, and
    # moving it off a commit that still tracked the file removes it.
    site_paths = {NODES_FILE, cluster.get("nodes_config", NODES_FILE)}
    site_texts = {relative: repository_config_path(relative).read_text(encoding="utf-8") for relative in site_paths}
    quoted_path = shlex.quote(path)
    fetch_script = (
        f"cd {quoted_path} && git fetch --quiet --prune origin && "
        f"git cat-file -e {shlex.quote(revision)}^{{commit}}"
    )
    for node in nodes["nodes"]:
        result = remote_shell(nodes, node, fetch_script)
        if result.returncode:
            detail = result.stderr.strip() or result.stdout.strip()
            raise SystemExit(f"{node['name']}: fetch failed: {detail}")

    changed: list[dict] = []
    try:
        for node in nodes["nodes"]:
            checkout = remote_shell(
                nodes,
                node,
                f"cd {quoted_path} && git checkout --quiet --detach {shlex.quote(revision)}",
            )
            if checkout.returncode:
                detail = checkout.stderr.strip() or checkout.stdout.strip()
                raise RuntimeError(f"{node['name']}: checkout failed: {detail}")
            changed.append(node)
            for relative, site_text in site_texts.items():
                copied = write_remote_file(nodes, node, f"{path}/{relative}", site_text)
                if copied.returncode:
                    detail = copied.stderr.strip() or copied.stdout.strip()
                    raise RuntimeError(f"{node['name']}: cannot copy {relative}: {detail}")
            doctor = run_ssh(
                nodes,
                node,
                f"{path}/bin/spark3",
                "--cluster-config",
                config_relative,
                "doctor",
            )
            if doctor.returncode:
                detail = doctor.stdout.strip() or doctor.stderr.strip()
                raise RuntimeError(f"{node['name']}: doctor failed after checkout: {detail}")
    except RuntimeError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        print("rolling changed checkouts back", file=sys.stderr)
        for node in reversed(changed):
            remote_shell(
                nodes,
                node,
                f"cd {quoted_path} && git checkout --quiet --detach "
                f"{shlex.quote(previous[node['name']])}",
            )
        return 1

    print(f"all nodes now use deployment commit {revision}")
    return 0


def stop_memguard(cluster: dict, nodes: dict, node: dict) -> subprocess.CompletedProcess[str]:
    unit = f"{cluster['container']['name']}-memguard.service"
    return run_ssh(nodes, node, "sudo", "-n", "systemctl", "stop", unit)


def memguard_is_active(cluster: dict, nodes: dict, node: dict) -> bool:
    unit = f"{cluster['container']['name']}-memguard.service"
    result = run_ssh(nodes, node, "systemctl", "is-active", "--quiet", unit)
    return result.returncode == 0


def wait_for_api(cluster: dict, nodes: dict) -> None:
    head = next(node for node in nodes["nodes"] if node["head"])
    name = cluster["container"]["name"]
    url = cluster["deployment"]["ready_url"]
    timeout = int(cluster["deployment"]["ready_timeout_seconds"])
    deadline = time.monotonic() + timeout
    unreachable_since: dict[str, float] = {}
    print(f"waiting up to {timeout}s for {head['name']} API readiness", flush=True)
    while time.monotonic() < deadline:
        unavailable = False
        for node in nodes["nodes"]:
            state = run_ssh(
                nodes,
                node,
                "docker",
                "inspect",
                "--format",
                "{{.State.Running}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}}",
                name,
            )
            if state.returncode:
                unavailable = True
                if node["name"] not in unreachable_since:
                    unreachable_since[node["name"]] = time.monotonic()
                    detail = state.stderr.strip() or "SSH unavailable"
                    print(
                        f"WARN: {node['name']} temporarily unreachable during "
                        f"startup ({detail}); waiting for an inspectable state",
                        file=sys.stderr,
                        flush=True,
                    )
                continue
            if node["name"] in unreachable_since:
                elapsed = int(time.monotonic() - unreachable_since.pop(node["name"]))
                print(
                    f"{node['name']}: control path recovered after {elapsed}s",
                    flush=True,
                )
            if not state.stdout.startswith("true "):
                state_detail = state.stdout.strip() or state.stderr.strip() or "absent"
                logs = run_ssh(nodes, node, "docker", "logs", "--tail", "20", name)
                log_detail = (logs.stdout or logs.stderr).strip()
                if len(log_detail) > 4000:
                    log_detail = log_detail[-4000:]
                raise RuntimeError(
                    f"{node['name']}: {name} stopped before readiness "
                    f"({state_detail})\n{log_detail}"
                )
            if not memguard_is_active(cluster, nodes, node):
                raise RuntimeError(
                    f"{node['name']}: startup memguard is no longer active; "
                    "refusing to continue an unguarded launch"
                )
        if unavailable:
            time.sleep(10)
            continue
        result = run_ssh(
            nodes,
            head,
            "curl",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            "3",
            url,
        )
        if result.returncode == 0:
            print("API ready; JIT/autotuning startup has completed", flush=True)
            return
        time.sleep(1)
    unreachable = ", ".join(sorted(unreachable_since))
    suffix = f"; unreachable nodes: {unreachable}" if unreachable else ""
    raise RuntimeError(f"API did not become ready within {timeout}s{suffix}")


def start_memguard(
    cluster: dict,
    nodes: dict,
    node: dict,
    cluster_config: str,
    phase: str,
    *,
    prelaunch: bool = False,
) -> None:
    script = f"{repository_path(cluster)}/scripts/memguard-start.sh"
    arguments = [script, cluster_config, phase]
    if prelaunch:
        arguments.append("prelaunch")
    result = run_ssh(nodes, node, *arguments)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(
            f"{node['name']}: cannot arm {phase} memguard: {detail}"
        )
    print(f"{node['name']}: {result.stdout.strip()}", flush=True)


def start_memguards(
    cluster: dict,
    nodes: dict,
    cluster_config: str,
    phase: str,
) -> None:
    for node in nodes["nodes"]:
        start_memguard(cluster, nodes, node, cluster_config, phase)


def preserve_failed_start_logs(
    cluster: dict,
    nodes: dict,
    started: list[dict],
    cluster_config: str,
) -> Path | None:
    """Copy complete container logs locally before rollback removes containers."""
    if not started:
        return None

    config_path = ROOT / cluster_config
    if config_path.parent.parent == ROOT / "experiments":
        base = config_path.parent / "runs" / "failed-starts"
    else:
        base = ROOT / "results" / "private" / "failed-starts"
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    destination = base / f"{stamp}-{cluster['container']['name']}"
    destination.mkdir(parents=True, exist_ok=False)

    name = cluster["container"]["name"]
    for node in started:
        state = run_ssh(nodes, node, "docker", "inspect", name)
        logs = remote_shell(
            nodes,
            node,
            f"docker logs --timestamps {shlex.quote(name)} 2>&1",
        )
        content = (
            f"node: {node['name']}\n"
            f"container: {name}\n"
            f"inspect_returncode: {state.returncode}\n"
            "\n[docker inspect]\n"
            f"{state.stdout}{state.stderr}"
            "\n[docker logs]\n"
            f"{logs.stdout}{logs.stderr}"
        )
        (destination / f"{node['name']}.log").write_text(content, encoding="utf-8")
    return destination


def restore_containers(
    cluster: dict,
    nodes: dict,
    backups: dict[str, str],
    started: list[dict],
    cluster_config: str,
) -> None:
    name = cluster["container"]["name"]
    for node in nodes["nodes"]:
        stop_memguard(cluster, nodes, node)
    for node in started:
        run_ssh(nodes, node, "docker", "rm", "--force", name)
    for node in deployment_order(nodes):
        backup = backups.get(node["name"])
        if not backup:
            continue
        renamed = run_ssh(nodes, node, "docker", "rename", backup, name)
        if renamed.returncode:
            print(f"WARN: {node['name']}: could not restore container name", file=sys.stderr)
            continue
        try:
            start_memguard(
                cluster,
                nodes,
                node,
                cluster_config,
                "startup",
                prelaunch=True,
            )
        except RuntimeError as error:
            print(
                f"WARN: {error}; did not start restored container unguarded",
                file=sys.stderr,
            )
            continue
        start_result = run_ssh(nodes, node, "docker", "start", name)
        if start_result.returncode:
            stop_memguard(cluster, nodes, node)
            print(f"WARN: {node['name']}: could not restart previous container", file=sys.stderr)
            continue


def command_cluster_start(args: argparse.Namespace) -> int:
    cluster, nodes, upstreams = configuration(args)
    _, config_relative = cluster_config_path(args)
    if args.apply and not cluster["deployment"]["launch_enabled"]:
        print(
            "ERROR: this cluster configuration is not authorized for launch",
            file=sys.stderr,
        )
        return 1
    name = cluster["container"]["name"]
    order = deployment_order(nodes)
    print("start plan (fail-closed startup memory guards):")
    for node in order:
        print(f"  {node['name']}: pre-arm startup memguard")
        print(f"  {node['name']}: {shlex.join(rendered_docker_command(cluster, node))}")
    print("  wait for API/JIT readiness, then switch every node to steady memguard")
    if not args.apply:
        print("plan only; pass --apply to start the cluster")
        return 0

    revision = require_local_deployment_state(cluster, nodes, upstreams)
    problems = remote_runtime_problems(
        cluster,
        nodes,
        revision,
        allow_existing=args.replace,
        cluster_config=config_relative,
    )
    if problems:
        for problem in problems:
            print(f"ERROR: {problem}", file=sys.stderr)
        return 1

    backup_suffix = f"pre-{int(time.time())}"
    backups: dict[str, str] = {}
    started: list[dict] = []
    launch_began = time.monotonic()

    def elapsed() -> str:
        return f"+{time.monotonic() - launch_began:.1f}s"

    try:
        for node in nodes["nodes"]:
            stop_memguard(cluster, nodes, node)
            if memguard_is_active(cluster, nodes, node):
                raise RuntimeError(
                    f"{node['name']}: stale memguard is still active; refusing startup"
                )
        if args.replace:
            def replace(node: dict) -> tuple[str | None, str | None]:
                """Stop and keep one node's old container; return (backup, error)."""
                exists = run_ssh(nodes, node, "docker", "inspect", name)
                if exists.returncode:
                    return None, None
                backup = f"{name}-{backup_suffix}"
                stopped = run_ssh(nodes, node, "docker", "stop", "--time", "60", name)
                if stopped.returncode:
                    return None, f"{node['name']}: could not stop {name}"
                renamed = run_ssh(nodes, node, "docker", "rename", name, backup)
                if renamed.returncode:
                    run_ssh(nodes, node, "docker", "start", name)
                    return None, f"{node['name']}: could not preserve {name}"
                return backup, None

            # The nodes stop their old containers concurrently (a vLLM shutdown takes
            # several seconds per node); any failure rolls back every stopped node.
            with concurrent.futures.ThreadPoolExecutor(max_workers=len(nodes["nodes"])) as pool:
                outcomes = list(pool.map(replace, nodes["nodes"]))
            errors = []
            for node, (backup, error) in zip(nodes["nodes"], outcomes):
                if backup:
                    backups[node["name"]] = backup
                if error:
                    errors.append(error)
            if errors:
                raise RuntimeError("; ".join(errors))
        for node in order:
            start_memguard(
                cluster,
                nodes,
                node,
                config_relative,
                "startup",
                prelaunch=True,
            )
            if not memguard_is_active(cluster, nodes, node):
                raise RuntimeError(
                    f"{node['name']}: pre-armed startup memguard is not active; "
                    "refusing launch"
                )
            result = run_ssh(nodes, node, *rendered_docker_command(cluster, node))
            if result.returncode:
                detail = result.stderr.strip() or result.stdout.strip()
                raise RuntimeError(f"{node['name']}: launch failed: {detail}")
            started.append(node)
            print(f"{node['name']}: launched {result.stdout.strip()} ({elapsed()})", flush=True)
        wait_for_api(cluster, nodes)
        print(f"API ready at {elapsed()}", flush=True)
        start_memguards(cluster, nodes, config_relative, "steady")
    except (RuntimeError, KeyboardInterrupt) as error:
        detail = str(error) if str(error) else "cluster start interrupted"
        print(f"ERROR: {detail}", file=sys.stderr)
        log_directory = preserve_failed_start_logs(
            cluster, nodes, started, config_relative
        )
        if log_directory is not None:
            print(
                f"preserved complete failed-start logs in "
                f"{log_directory.relative_to(ROOT)}",
                file=sys.stderr,
            )
        print("rolling back containers started by this command", file=sys.stderr)
        restore_containers(cluster, nodes, backups, started, config_relative)
        if backups:
            try:
                wait_for_api(cluster, nodes)
                start_memguards(cluster, nodes, config_relative, "steady")
            except RuntimeError as rollback_error:
                print(f"WARN: rollback health check failed: {rollback_error}", file=sys.stderr)
        return 130 if isinstance(error, KeyboardInterrupt) else 1

    def remove_backup(node: dict) -> str | None:
        backup = backups.get(node["name"])
        if backup and run_ssh(nodes, node, "docker", "rm", backup).returncode:
            return f"WARN: {node['name']}: retained backup container {backup}"
        return None

    with concurrent.futures.ThreadPoolExecutor(max_workers=len(nodes["nodes"])) as pool:
        for warning in pool.map(remove_backup, nodes["nodes"]):
            if warning:
                print(warning)
    print(f"cluster ready; memory guards are active on all nodes ({elapsed()})")
    return 0


def command_cluster_stop(args: argparse.Namespace) -> int:
    cluster, nodes, _ = configuration(args)
    name = cluster["container"]["name"]
    action = "stop and remove" if args.remove else "stop"
    for node in nodes["nodes"]:
        print(f"{node['name']}: {action} exact container {name} and stop its memguard")
    if not args.apply:
        print("plan only; pass --apply to stop the cluster")
        return 0

    def stop_node(node: dict) -> tuple[list[str], list[str]]:
        """Stop one node's memguard and container; return (messages, errors)."""
        guard = stop_memguard(cluster, nodes, node)
        if memguard_is_active(cluster, nodes, node):
            detail = guard.stderr.strip() or "unit remains active"
            return [], [f"{node['name']}: could not stop memguard: {detail}"]
        exists = run_ssh(nodes, node, "docker", "inspect", name)
        if exists.returncode:
            return [f"{node['name']}: {name} is already absent"], []
        stopped = run_ssh(nodes, node, "docker", "stop", "--time", "60", name)
        if stopped.returncode:
            return [], [f"{node['name']}: {stopped.stderr.strip()}"]
        if args.remove:
            removed = run_ssh(nodes, node, "docker", "rm", name)
            if removed.returncode:
                return [], [f"{node['name']}: {removed.stderr.strip()}"]
        return [], []

    if getattr(args, "parallel", False):
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(nodes["nodes"])) as pool:
            outcomes = list(pool.map(stop_node, nodes["nodes"]))
    else:
        outcomes = [stop_node(node) for node in nodes["nodes"]]
    failed = False
    for messages, errors in outcomes:
        for message in messages:
            print(message)
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
            failed = True
    return int(failed)


def command_render(args: argparse.Namespace) -> int:
    cluster, nodes, _ = configuration(args)
    node = node_by_name(nodes, args.node)
    print(shlex.join(rendered_docker_command(cluster, node)))
    return 0


def read_series(path: Path) -> list[str]:
    return [
        line.strip()
        for line in path.read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]


def checked(command: list[str], cwd: Path | None = None) -> None:
    subprocess.run(command, cwd=cwd, check=True)


def command_upstream(args: argparse.Namespace) -> int:
    _, _, upstreams = configuration(args)
    sources = upstreams["sources"]
    git_sources = {key: value for key, value in sources.items() if value["kind"] == "git"}
    if args.upstream_command == "list":
        for name, source in git_sources.items():
            print(f"{name}\t{source['revision']}\t{source['upstream']}")
        return 0

    source = git_sources.get(args.name)
    if source is None:
        raise SystemExit(f"unknown Git upstream {args.name!r}")
    destination = ROOT / ".work" / "upstreams" / args.name
    if destination.exists():
        raise SystemExit(f"{destination} already exists; remove it explicitly to recreate")
    destination.parent.mkdir(parents=True, exist_ok=True)
    checked(["git", "clone", source["upstream"], str(destination)])
    checked(["git", "remote", "rename", "origin", "upstream"], cwd=destination)
    contribution = source.get("contribution_remote")
    if contribution:
        checked(["git", "remote", "add", "origin", contribution], cwd=destination)
    # Release commits are not always reachable from the canonical default branch.
    # Fetch the full pinned object explicitly before detaching at it.
    checked(["git", "fetch", "upstream", source["revision"]], cwd=destination)
    checked(["git", "checkout", "--detach", source["revision"]], cwd=destination)
    if source.get("submodules"):
        checked(["git", "submodule", "update", "--init", "--recursive"], cwd=destination)
    for commit in source.get("applied_upstream_commits", []):
        checked(["git", "fetch", "upstream", commit["revision"]], cwd=destination)
        checked(
            ["git", "cherry-pick", "--no-commit", commit["revision"]],
            cwd=destination,
        )
    pending: list[str] = []
    series = source.get("patch_series")
    if series:
        series_path = ROOT / series
        for patch_name in read_series(series_path):
            if patch_name.startswith("TODO-"):
                pending.append(patch_name)
                continue
            checked(["git", "apply", str(series_path.parent / patch_name)], cwd=destination)
    print(f"prepared {args.name} in {destination}")
    print("remotes:")
    checked(["git", "remote", "-v"], cwd=destination)
    if pending:
        print("pending local patches not yet exported:", file=sys.stderr)
        for patch_name in pending:
            print(f"  {patch_name}", file=sys.stderr)
        return 2
    return 0


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*")):
        relative = path.relative_to(root)
        if ".git" in relative.parts or "__pycache__" in relative.parts:
            continue
        digest.update(str(relative).encode())
        if path.is_symlink():
            digest.update(b"L")
            digest.update(path.readlink().as_posix().encode())
        elif path.is_file():
            digest.update(b"F")
            digest.update(oct(path.stat().st_mode & 0o777).encode())
            with path.open("rb") as handle:
                for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                    digest.update(chunk)
        elif path.is_dir():
            digest.update(b"D")
    return digest.hexdigest()


def expected_wheel_hashes() -> dict[str, str]:
    lock = ROOT / "requirements/cutlass-dsl-aarch64.txt"
    expected: dict[str, str] = {}
    package = ""
    for raw_line in lock.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "==" in line:
            package = line.split("==", 1)[0].replace("-", "_")
        if "--hash=sha256:" in line and package:
            expected[package] = line.split("--hash=sha256:", 1)[1].rstrip(" \\")
    return expected


def patchset_sha256(source: dict) -> str:
    digest = hashlib.sha256()
    for commit in source.get("applied_upstream_commits", []):
        digest.update(commit["revision"].encode())
        digest.update(b"\0")
    series = source.get("patch_series")
    if series:
        series_path = ROOT / series
        digest.update(series_path.read_bytes())
        for patch_name in read_series(series_path):
            if patch_name.startswith("TODO-"):
                continue
            digest.update(patch_name.encode())
            digest.update(b"\0")
            digest.update((series_path.parent / patch_name).read_bytes())
    return digest.hexdigest()


BUILD_ROOT = ROOT / ".work/build"
# Bump when the directory layout or context export changes, so older
# directories are re-prepared.
BUILD_LAYOUT = 2
BUILD_PROJECTS = ("vllm", "b12x", "nccl")
# Built only when the lock lists them (the TileLang kernel backend); each adds
# its own <name>-source context.
OPTIONAL_BUILD_PROJECTS = ("tilelang", "tile_kernels")
BUILD_PARTS = ("vllm", "b12x", "nccl", "cutlass", "wheels")
BUILD_CONTEXTS = (
    "vllm-source", "b12x-source", "nccl-source", "cutlass-source", "cutlass-dsl-wheels", "vllm-deletions"
)
# git am with a fixed committer and committer date reproduces the recorded
# patch heads byte for byte.
PATCH_COMMITTER = ("Christopher Owen", "3221756+christopherowen@users.noreply.github.com")
GIB = 1024**3
BUILD_MIN_AVAILABLE_GIB = 64
BUILD_RESERVE_GIB = 24
BUILD_MEMORY_PER_JOB_GIB = 8
BUILD_NVCC_THREADS = 2
BUILD_CPU_RESERVE = 4
BUILD_MAX_JOBS = 10
SMOKE_MEMORY_GIB = 16
BUILD_LOCK = Path("/tmp/spark3-build.lock")
SMOKE_SCRIPT = """\
import torch

assert torch.cuda.is_available()
print("device", torch.cuda.get_device_name(0), torch.cuda.get_device_capability(0))
import vllm.distributed.device_communicators.b12x_roce_all_reduce  # noqa: F401
import vllm.models.deepseek_v4_1.nvidia.dspark  # noqa: F401
import vllm.models.deepseek_v4_1.nvidia.model  # noqa: F401
import vllm.models.deepseek_v4_1.nvidia.vl_model  # noqa: F401
import vllm.v1.attention.backends.mla.b12x_mla_sparse  # noqa: F401
from vllm.models.deepseek_v41 import DeepseekV41ForCausalLM

print("DS4.1 SM12x class:", DeepseekV41ForCausalLM.__module__)
assert DeepseekV41ForCausalLM.__module__.startswith("vllm.models.deepseek_v4_1")
print("GPU import smoke passed")
"""


def build_projects(sources: dict) -> tuple[str, ...]:
    """The required projects, then each optional one the lock or inputs list."""
    return BUILD_PROJECTS + tuple(name for name in OPTIONAL_BUILD_PROJECTS if name in sources)


def build_contexts(inputs: dict) -> tuple[str, ...]:
    return BUILD_CONTEXTS + tuple(f"{name}-source" for name in OPTIONAL_BUILD_PROJECTS if name in inputs)


def missing_patches(source: dict) -> list[str]:
    """Repository paths of a source's series and patches that do not exist yet."""
    series = source.get("patch_series")
    if not series:
        return []
    series_path = ROOT / series
    if not series_path.is_file():
        return [series]
    return [
        (series_path.parent / name).resolve().relative_to(ROOT.resolve()).as_posix()
        for name in read_series(series_path)
        if not name.startswith("TODO-") and not (series_path.parent / name).is_file()
    ]


def smoke_script(upstreams: dict) -> str:
    """The GPU import smoke, extended for an image with the TileLang sources."""
    if "tilelang" not in upstreams["sources"]:
        return SMOKE_SCRIPT
    version = upstreams["sources"]["tilelang"]["version"]
    script = SMOKE_SCRIPT + (
        "import importlib.metadata\n\n"
        "import tilelang\n"
        "import tile_kernels  # noqa: F401\n\n"
        f"assert importlib.metadata.version(\"tilelang\") == {version!r}, tilelang.__version__\n"
        "print(\"TileLang\", tilelang.__version__)\n"
    )
    manifest = read_json(upstreams["source_manifest"])
    if kernel_backend.CAPABILITY in manifest["vllm"].get("capabilities", []):
        script += "import vllm.models.deepseek_v4_1.tilelang  # noqa: F401\n"
    return script + "print(\"TileLang import smoke passed\")\n"


def git_output(directory: Path, *arguments: str) -> str:
    return subprocess.run(
        ["git", *arguments], cwd=directory, check=True, text=True, stdout=subprocess.PIPE
    ).stdout.strip()


def build_inputs(upstreams: dict, parts: list[str] | None = None) -> dict:
    """Everything that determines the build contexts, read from the lock.

    A project whose series lists a patch that does not exist yet stops the
    build. With an explicit list of parts, an unlisted project's inputs are
    recorded as incomplete instead, so the other series can still be prepared.
    """
    manifest = read_json(upstreams["source_manifest"])
    sources = upstreams["sources"]
    listed = [name for name in OPTIONAL_BUILD_PROJECTS if name in sources]
    if listed and len(listed) != len(OPTIONAL_BUILD_PROJECTS):
        raise SystemExit(f"{' and '.join(OPTIONAL_BUILD_PROJECTS)} are built together; the lock lists only {listed[0]}")
    base = sources["vllm_base_image"]
    inputs = {
        "base_image": f"{base['upstream']}@{base['recorded_base_digest']}",
        "base_source_revision": base["source_revision"],
        "cutlass": {key: sources["cutlass"][key] for key in ("upstream", "revision", "release_tag")},
        "cutlass_dsl_wheels": expected_wheel_hashes(),
    }
    for name in build_projects(sources):
        source = sources[name]
        missing = missing_patches(source)
        if missing and (parts is None or name in parts):
            raise SystemExit(
                f"{name}: missing patch {', '.join(missing)}; add it and record its patch head, "
                f"tree and fingerprint in {upstreams['source_manifest']}"
            )
        if missing:
            inputs[name] = {
                "upstream": source["upstream"],
                "tracking_ref": source["tracking_ref"],
                "revision": source["revision"],
                "patch_series": source.get("patch_series"),
                "missing_patches": missing,
            }
            continue
        record = manifest.get(name)
        if record is None:
            raise SystemExit(f"{name}: {upstreams['source_manifest']} has no record")
        patchset = patchset_sha256(source)
        if patchset != record["patchset_sha256"]:
            raise SystemExit(
                f"{name}: the patch series differs from {upstreams['source_manifest']}; "
                "record its new patch head and tree there first"
            )
        inputs[name] = {
            "upstream": source["upstream"],
            "tracking_ref": source["tracking_ref"],
            "revision": source["revision"],
            "patch_series": source.get("patch_series"),
            "patchset_sha256": patchset,
            "patch_head": record["patch_head"],
            "expected_tree": record["expected_tree"],
        }
        if name in OPTIONAL_BUILD_PROJECTS:
            if not source.get("version"):
                raise SystemExit(f"{name}: record its package version in the upstreams lock")
            inputs[name]["version"] = source["version"]
        if source.get("submodules"):
            if not isinstance(record.get("submodules"), dict):
                raise SystemExit(f"{name}: record its submodule commits in {upstreams['source_manifest']}")
            inputs[name]["submodules"] = record["submodules"]
    if sources["vllm"].get("canonical_base"):
        inputs["vllm"]["canonical_upstream"] = sources["vllm"]["canonical_base"]["upstream"]
    return inputs


def build_directory(inputs: dict) -> Path:
    """One directory per set of build inputs: same lock, same directory."""
    digest = hashlib.sha256(json.dumps(inputs, sort_keys=True).encode()).hexdigest()
    return BUILD_ROOT / (
        f"vllm-{inputs['vllm']['revision'][:12]}-b12x-{inputs['b12x']['revision'][:12]}-{digest[:8]}"
    )


def project_problems(source: Path, record: dict) -> list[str]:
    if not (source / ".git").exists():
        return [f"{source.name}: source checkout is missing"]
    problems = []
    if git_output(source, "status", "--porcelain", "--untracked-files=all"):
        problems.append(f"{source.name}: source checkout has local changes")
    head = git_output(source, "rev-parse", "HEAD")
    tree = git_output(source, "rev-parse", "HEAD^{tree}")
    if tree != record["expected_tree"]:
        problems.append(f"{source.name}: tree {tree}, expected {record['expected_tree']}")
    if head != record["patch_head"]:
        problems.append(f"{source.name}: patch head {head}, expected {record['patch_head']}")
    if record.get("submodules") is not None and submodule_commits(source) != record["submodules"]:
        problems.append(f"{source.name}: submodule checkouts differ from the source manifest")
    return problems


def submodule_commits(source: Path) -> dict[str, str] | None:
    """Each submodule's checked-out commit, or None when one is missing or
    differs from the commit its superproject records."""
    output = subprocess.run(
        ["git", "submodule", "status", "--recursive"],
        cwd=source, check=True, text=True, stdout=subprocess.PIPE,
    ).stdout
    commits = {}
    for line in output.splitlines():
        if not line.startswith(" "):
            return None
        commit, path = line[1:].split()[:2]
        commits[path] = commit
    return commits


def replace_directory(temporary: Path, destination: Path) -> None:
    if destination.exists():
        shutil.rmtree(destination)
    temporary.rename(destination)


def prepare_project(directory: Path, name: str, record: dict) -> None:
    source = directory / "src" / name
    if source.is_dir() and not project_problems(source, record):
        print(f"{name}: reusing {source.relative_to(ROOT)}")
        return
    source.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=f".{name}.", dir=source.parent))
    try:
        checked(["git", "init", "--quiet"], cwd=temporary)
        checked(["git", "remote", "add", "upstream", record["upstream"]], cwd=temporary)
        checked(
            ["git", "fetch", "--quiet", "--filter=blob:none", "--no-tags", "upstream", record["revision"]],
            cwd=temporary,
        )
        checked(["git", "switch", "--quiet", "--create", "spark3/build", "FETCH_HEAD"], cwd=temporary)
        if record.get("patch_series"):
            series = ROOT / record["patch_series"]
            for patch_name in read_series(series):
                checked(
                    [
                        "git", "-c", f"user.name={PATCH_COMMITTER[0]}",
                        "-c", f"user.email={PATCH_COMMITTER[1]}",
                        "am", "--quiet", "--committer-date-is-author-date",
                        str(series.parent / patch_name),
                    ],
                    cwd=temporary,
                )
        checked(["git", "diff", "--check", record["revision"], "HEAD"], cwd=temporary)
        if record.get("submodules") is not None:
            # The commits the patched superproject records, nested ones
            # included; project_problems compares them with the manifest.
            checked(
                ["git", "submodule", "update", "--quiet", "--init", "--recursive",
                 "--depth", "1", "--jobs", "4"],
                cwd=temporary,
            )
        problems = project_problems(temporary, record)
        if problems:
            raise SystemExit("; ".join(problems))
        replace_directory(temporary, source)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    print(f"{name}: prepared {record['patch_head'][:12]} (tree {record['expected_tree'][:12]})")


def prepare_cutlass(directory: Path, record: dict) -> None:
    source = directory / "src/cutlass"
    if (source / ".git").exists() and git_output(source, "rev-parse", "HEAD") == record["revision"]:
        print(f"cutlass: reusing {source.relative_to(ROOT)}")
        return
    source.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".cutlass.", dir=source.parent))
    try:
        checked(["git", "init", "--quiet"], cwd=temporary)
        checked(["git", "remote", "add", "upstream", record["upstream"]], cwd=temporary)
        checked(["git", "fetch", "--quiet", "--depth", "1", "upstream", record["revision"]], cwd=temporary)
        checked(["git", "checkout", "--quiet", "--detach", "FETCH_HEAD"], cwd=temporary)
        if git_output(temporary, "rev-parse", "HEAD") != record["revision"]:
            raise SystemExit("cutlass: fetched revision differs from the lock")
        replace_directory(temporary, source)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    print(f"cutlass: prepared {record['release_tag']} ({record['revision'][:12]})")


def wheel_problems(wheel_dir: Path) -> list[str]:
    if not wheel_dir.is_dir():
        return ["cutlass-dsl-wheels: missing"]
    problems = []
    expected = expected_wheel_hashes()
    found: set[str] = set()
    for wheel in sorted(wheel_dir.iterdir()):
        normalized = wheel.name.replace("-", "_").lower()
        package = next(
            (name for name in sorted(expected, key=len, reverse=True)
             if normalized.startswith(name.lower() + "_")),
            None,
        )
        if package is None or not wheel.name.endswith(".whl"):
            problems.append(f"cutlass-dsl-wheels: unlocked file {wheel.name}")
            continue
        found.add(package)
        if sha256(wheel) != expected[package]:
            problems.append(f"cutlass-dsl-wheels: {wheel.name} differs from the lock hash")
    for package in sorted(set(expected) - found):
        problems.append(f"cutlass-dsl-wheels: missing {package}")
    return problems


def prepare_wheels(directory: Path, upstreams: dict) -> None:
    destination = directory / "context/cutlass-dsl-wheels"
    if not wheel_problems(destination):
        print("cutlass-dsl wheels: reusing verified wheels")
        return
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".wheels.", dir=destination.parent))
    try:
        checked([
            sys.executable, "-m", "pip", "download", "--quiet", "--dest", str(temporary),
            "--require-hashes", "--no-deps", "--only-binary=:all:",
            "--platform", "manylinux_2_28_aarch64", "--implementation", "cp",
            "--python-version", "3.12", "--abi", "cp312",
            "--requirement", str(ROOT / upstreams["sources"]["cutlass_dsl"]["lockfile"]),
        ])
        problems = wheel_problems(temporary)
        if problems:
            raise SystemExit("; ".join(problems))
        replace_directory(temporary, destination)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    print("cutlass-dsl wheels: downloaded and verified")


def export_source(source: Path, destination: Path) -> None:
    """Copy a checkout without Git metadata or bytecode, replacing atomically."""
    temporary = destination.with_name(f".{destination.name}.export")
    shutil.rmtree(temporary, ignore_errors=True)
    shutil.copytree(
        source, temporary, symlinks=True, ignore=shutil.ignore_patterns(".git", "__pycache__")
    )
    replace_directory(temporary, destination)


def normalize_modes(root: Path) -> None:
    """Git's two file modes, so contexts do not depend on the host umask."""
    for path in [root, *root.rglob("*")]:
        if path.is_symlink():
            continue
        if path.is_dir():
            path.chmod(0o755)
        else:
            path.chmod(0o755 if path.stat().st_mode & 0o111 else 0o644)


def vllm_deletions(directory: Path, inputs: dict) -> list[str]:
    """Files the pinned vLLM deletes relative to the base image's revision."""
    source = directory / "src/vllm"
    base = inputs["base_source_revision"]
    present = subprocess.run(
        ["git", "cat-file", "-e", f"{base}^{{commit}}"], cwd=source, stderr=subprocess.DEVNULL
    )
    if present.returncode:
        checked(
            ["git", "fetch", "--quiet", "--filter=blob:none", "--no-tags",
             inputs["vllm"]["canonical_upstream"], base],
            cwd=source,
        )
    output = git_output(source, "diff", "--name-only", "--diff-filter=D", base, "HEAD", "--", "vllm")
    return [path.removeprefix("vllm/") for path in output.splitlines()]


def build_problems(directory: Path, inputs: dict) -> list[str]:
    record_path = directory / "inputs.json"
    if not record_path.is_file():
        return [f"{directory.relative_to(ROOT)} is not prepared; run bin/spark3 build prepare"]
    record = json.loads(record_path.read_text(encoding="utf-8"))
    problems = []
    if record.get("schema") != BUILD_LAYOUT:
        problems.append(f"prepared with build layout {record.get('schema')}, now {BUILD_LAYOUT}")
    if record.get("inputs") != inputs:
        problems.append("inputs.json does not match the lock")
    for name in build_projects(inputs):
        problems.extend(project_problems(directory / "src" / name, inputs[name]))
    for name, digest in record.get("contexts", {}).items():
        context = directory / "context" / name
        if not context.is_dir():
            problems.append(f"{name}: context is missing")
        elif tree_digest(context) != digest:
            problems.append(f"{name}: context changed since it was prepared")
    if sorted(record.get("contexts", {})) != sorted(build_contexts(inputs)):
        problems.append("inputs.json does not record every build context")
    problems.extend(wheel_problems(directory / "context/cutlass-dsl-wheels"))
    if not (directory / "context/cutlass-source/include/cutlass/cutlass.h").is_file():
        problems.append("cutlass-source: include/cutlass/cutlass.h is missing")
    return problems


def command_build_prepare(args: argparse.Namespace) -> int:
    _, _, upstreams = configuration(args)
    parts = args.only.split(",") if args.only else None
    if parts:
        unknown = sorted(set(parts) - set(BUILD_PARTS) - set(OPTIONAL_BUILD_PROJECTS))
        if unknown:
            raise SystemExit(f"unknown build parts: {', '.join(unknown)}")
        unlisted = [part for part in parts if part in OPTIONAL_BUILD_PROJECTS and part not in upstreams["sources"]]
        if unlisted:
            raise SystemExit(f"{', '.join(unlisted)}: not listed in the upstreams lock")
    inputs = build_inputs(upstreams, parts)
    directory = build_directory(inputs)
    parts = parts or [*BUILD_PARTS, *build_projects(inputs)]
    if not args.only and not build_problems(directory, inputs):
        print(f"build inputs ready: {directory.relative_to(ROOT)}")
        return 0
    directory.mkdir(parents=True, exist_ok=True)
    (directory / "inputs.json").unlink(missing_ok=True)
    print(f"preparing {directory.relative_to(ROOT)}", flush=True)
    for name in build_projects(inputs):
        if name in parts:
            prepare_project(directory, name, inputs[name])
    if "cutlass" in parts:
        prepare_cutlass(directory, inputs["cutlass"])
    if "wheels" in parts:
        prepare_wheels(directory, upstreams)
    if args.only:
        print("partial preparation; run bin/spark3 build prepare for the complete inputs")
        return 0
    context = directory / "context"
    for name in (*build_projects(inputs), "cutlass"):
        export_source(directory / "src" / name, context / f"{name}-source")
    deleted = vllm_deletions(directory, inputs)
    deletions = context / "vllm-deletions"
    deletions.mkdir(exist_ok=True)
    (deletions / "deleted.txt").write_text("".join(f"{path}\n" for path in deleted), encoding="utf-8")
    (context / "empty").mkdir(exist_ok=True)
    normalize_modes(context)
    record = {
        "schema": BUILD_LAYOUT,
        "inputs": inputs,
        "contexts": {name: tree_digest(context / name) for name in build_contexts(inputs)},
        "vllm_deletions": len(deleted),
    }
    temporary = directory / ".inputs.json"
    temporary.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.rename(directory / "inputs.json")
    problems = build_problems(directory, inputs)
    if problems:
        for problem in problems:
            print(f"WARN: {problem}")
        return 1
    print(f"build inputs ready: {directory.relative_to(ROOT)} ({len(deleted)} vLLM deletions)")
    return 0


def command_build_check(args: argparse.Namespace) -> int:
    _, _, upstreams = configuration(args)
    inputs = build_inputs(upstreams)
    directory = build_directory(inputs)
    problems = build_problems(directory, inputs)
    if problems:
        for problem in problems:
            print(f"WARN: {problem}")
        return 1
    print(f"build inputs OK: {directory.relative_to(ROOT)}")
    return 0


def available_memory_gib() -> float:
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) * 1024 / GIB
    except (OSError, ValueError) as error:
        raise SystemExit(f"cannot read host MemAvailable: {error}") from error
    raise SystemExit("cannot read host MemAvailable")


def compile_jobs(available_gib: float) -> int:
    if available_gib < BUILD_MIN_AVAILABLE_GIB:
        raise SystemExit(
            f"the build needs {BUILD_MIN_AVAILABLE_GIB} GiB MemAvailable to start; "
            f"found {available_gib:.1f} GiB"
        )
    cpu_jobs = max(1, (len(os.sched_getaffinity(0)) - BUILD_CPU_RESERVE) // BUILD_NVCC_THREADS)
    memory_jobs = int((available_gib - BUILD_RESERVE_GIB) // BUILD_MEMORY_PER_JOB_GIB)
    return min(BUILD_MAX_JOBS, cpu_jobs, memory_jobs)


def cancel_process_group(process: subprocess.Popen) -> None:
    for signal_number, seconds in ((signal.SIGINT, 30), (signal.SIGTERM, 10), (signal.SIGKILL, 5)):
        if process.poll() is not None:
            return
        try:
            os.killpg(process.pid, signal_number)
        except ProcessLookupError:
            return
        try:
            process.wait(timeout=seconds)
            return
        except subprocess.TimeoutExpired:
            pass


def run_memory_guarded(command: list[str], reserve_gib: float) -> float:
    """Run a command, cancelling it if MemAvailable falls below the reserve."""
    minimum = available_memory_gib()
    process = subprocess.Popen(command, start_new_session=True)
    try:
        while True:
            try:
                result = process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                available = available_memory_gib()
                minimum = min(minimum, available)
                if available < reserve_gib:
                    cancel_process_group(process)
                    raise SystemExit(
                        f"canceled: MemAvailable fell to {available:.1f} GiB, "
                        f"below the {reserve_gib} GiB reserve"
                    )
                continue
            if result:
                raise SystemExit(f"{command[0]} {command[1]} failed with exit status {result}")
            return minimum
    except KeyboardInterrupt:
        cancel_process_group(process)
        raise SystemExit("canceled") from None
    except BaseException:
        cancel_process_group(process)
        raise


def require_idle_build_host(cluster: dict) -> None:
    running = subprocess.run(
        ["docker", "ps", "--format", "{{.Names}}"], check=True, text=True, stdout=subprocess.PIPE
    ).stdout.split()
    service = cluster["container"]["name"]
    if any(name == service or name.startswith("dsv41-") for name in running):
        raise SystemExit("a DS4.1 service is running on this host; stop it before building")


def image_labels(tag: str) -> dict | None:
    result = subprocess.run(
        ["docker", "image", "inspect", tag], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
    )
    if result.returncode:
        return None
    inspection = json.loads(result.stdout)[0]
    return {"id": inspection["Id"], "labels": inspection["Config"].get("Labels") or {}}


def smoke_image(cluster: dict, tag: str, script: str = SMOKE_SCRIPT) -> None:
    require_idle_build_host(cluster)
    available = available_memory_gib()
    if available < SMOKE_MEMORY_GIB + 8:
        raise SystemExit(
            f"the GPU import smoke needs {SMOKE_MEMORY_GIB + 8} GiB MemAvailable; found {available:.1f} GiB"
        )
    subprocess.run(
        [
            "docker", "run", "--rm", "-i", "--gpus", "all",
            f"--memory={SMOKE_MEMORY_GIB}g", f"--memory-swap={SMOKE_MEMORY_GIB}g",
            "--entrypoint", "/usr/bin/python3", tag, "-",
        ],
        input=script,
        text=True,
        check=True,
    )


def command_build_image(args: argparse.Namespace) -> int:
    cluster, _, upstreams = configuration(args)
    inputs = build_inputs(upstreams)
    directory = build_directory(inputs)
    problems = build_problems(directory, inputs)
    if problems:
        for problem in problems:
            print(f"WARN: {problem}")
        return 1
    if repository_dirty():
        print("WARN: the image records the deployment commit; commit changes first")
        return 1
    tag = args.tag or cluster["container"]["image"]
    context = directory / "context"
    base = upstreams["sources"]["vllm_base_image"]
    deployment_commit = repository_revision()

    def command(jobs: int | str) -> list[str]:
        rendered = [
            "docker", "buildx", "build", "--platform", "linux/arm64", "--network", "host", "--load",
            "--file", str(ROOT / "docker/Dockerfile"), "--tag", tag,
        ]
        for name in build_contexts(inputs):
            rendered += ["--build-context", f"{name}={context / name}"]
        build_args = {
            "BASE_IMAGE": inputs["base_image"],
            "BASE_IMAGE_NAME": base["upstream"],
            "BASE_IMAGE_DIGEST": base["recorded_base_digest"],
            "DEPLOYMENT_COMMIT": deployment_commit,
            "VLLM_COMPILE_JOBS": str(jobs),
            "VLLM_NVCC_THREADS": str(BUILD_NVCC_THREADS),
        }
        for name in build_projects(inputs):
            record = inputs[name]
            prefix = name.upper()
            build_args.update({
                f"{prefix}_UPSTREAM": record["upstream"].removesuffix(".git"),
                f"{prefix}_REF": record["tracking_ref"].removeprefix("refs/heads/"),
                f"{prefix}_REVISION": record["revision"],
                f"{prefix}_PATCH_HEAD": record["patch_head"],
                f"{prefix}_TREE": record["expected_tree"],
            })
            if "version" in record:
                build_args[f"{prefix}_VERSION"] = record["version"]
        if "tilelang" in inputs:
            build_args.update(RUNTIME_STAGE="runtime-tilelang", TILELANG_COMPILE_JOBS=str(jobs))
        for key, value in build_args.items():
            rendered += ["--build-arg", f"{key}={value}"]
        if os.environ.get("GITHUB_TOKEN"):
            rendered += ["--secret", "id=github_token,env=GITHUB_TOKEN"]
        return rendered + [str(context / "empty")]

    if not args.apply:
        print(shlex.join(command("<sized from MemAvailable>")))
        print("plan only; pass --apply on an idle build host to build and smoke-test")
        return 0
    lock = BUILD_LOCK.open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit("another image build is running on this host") from None
    require_idle_build_host(cluster)
    if image_labels(tag) is not None:
        raise SystemExit(f"{tag} already exists here; pass --tag with a new tag rather than overwrite it")
    available = available_memory_gib()
    jobs = compile_jobs(available)
    print(
        f"building {tag} from {directory.relative_to(ROOT)}: {jobs} compile jobs x "
        f"{BUILD_NVCC_THREADS} NVCC threads, {available:.1f} GiB available, "
        f"cancel below {BUILD_RESERVE_GIB} GiB",
        flush=True,
    )
    started = time.monotonic()
    minimum = run_memory_guarded(command(jobs), BUILD_RESERVE_GIB)
    elapsed = time.monotonic() - started
    image = image_labels(tag)
    if image is None:
        raise SystemExit(f"the build finished but {tag} is not present")
    for name in build_projects(inputs):
        label = image["labels"].get(f"local.spark3.{name}.tree")
        if label != inputs[name]["expected_tree"]:
            raise SystemExit(f"{tag}: label local.spark3.{name}.tree is {label!r}")
    print(f"built {tag} {image['id']} in {elapsed:.0f}s; lowest MemAvailable {minimum:.1f} GiB", flush=True)
    smoke_image(cluster, tag, smoke_script(upstreams))
    receipts = directory / "images"
    receipts.mkdir(exist_ok=True)
    receipt = {
        "tag": tag,
        "image_id": image["id"],
        "deployment_commit": deployment_commit,
        "compile_jobs": jobs,
        "elapsed_seconds": round(elapsed),
        "min_available_gib": round(minimum, 1),
        "built_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    (receipts / f"{image['id'].removeprefix('sha256:')[:16]}.json").write_text(
        json.dumps(receipt, indent=2) + "\n", encoding="utf-8"
    )
    return 0


def command_build_smoke(args: argparse.Namespace) -> int:
    cluster, _, upstreams = configuration(args)
    smoke_image(cluster, args.image or cluster["container"]["image"], smoke_script(upstreams))
    return 0



def git_output(directory: Path, *arguments: str) -> str:
    return subprocess.run(
        ["git", *arguments], cwd=directory, check=True, text=True, stdout=subprocess.PIPE
    ).stdout.strip()


def build_inputs(upstreams: dict) -> dict:
    """Everything that determines the build contexts, read from the lock."""
    manifest = read_json(upstreams["source_manifest"])
    sources = upstreams["sources"]
    base = sources["vllm_base_image"]
    inputs = {
        "base_image": f"{base['upstream']}@{base['recorded_base_digest']}",
        "base_source_revision": base["source_revision"],
        "cutlass": {key: sources["cutlass"][key] for key in ("upstream", "revision", "release_tag")},
        "cutlass_dsl_wheels": expected_wheel_hashes(),
    }
    for name in BUILD_PROJECTS:
        source = sources[name]
        record = manifest[name]
        patchset = patchset_sha256(source)
        if patchset != record["patchset_sha256"]:
            raise SystemExit(
                f"{name}: the patch series differs from {upstreams['source_manifest']}; "
                "record its new patch head and tree there first"
            )
        inputs[name] = {
            "upstream": source["upstream"],
            "tracking_ref": source["tracking_ref"],
            "revision": source["revision"],
            "patch_series": source.get("patch_series"),
            "patchset_sha256": patchset,
            "patch_head": record["patch_head"],
            "expected_tree": record["expected_tree"],
        }
    if sources["vllm"].get("canonical_base"):
        inputs["vllm"]["canonical_upstream"] = sources["vllm"]["canonical_base"]["upstream"]
    return inputs


def build_directory(inputs: dict) -> Path:
    """One directory per set of build inputs: same lock, same directory."""
    digest = hashlib.sha256(json.dumps(inputs, sort_keys=True).encode()).hexdigest()
    return BUILD_ROOT / (
        f"vllm-{inputs['vllm']['revision'][:12]}-b12x-{inputs['b12x']['revision'][:12]}-{digest[:8]}"
    )


def project_problems(source: Path, record: dict) -> list[str]:
    if not (source / ".git").exists():
        return [f"{source.name}: source checkout is missing"]
    problems = []
    if git_output(source, "status", "--porcelain", "--untracked-files=all"):
        problems.append(f"{source.name}: source checkout has local changes")
    head = git_output(source, "rev-parse", "HEAD")
    tree = git_output(source, "rev-parse", "HEAD^{tree}")
    if tree != record["expected_tree"]:
        problems.append(f"{source.name}: tree {tree}, expected {record['expected_tree']}")
    if head != record["patch_head"]:
        problems.append(f"{source.name}: patch head {head}, expected {record['patch_head']}")
    return problems


def replace_directory(temporary: Path, destination: Path) -> None:
    if destination.exists():
        shutil.rmtree(destination)
    temporary.rename(destination)


def prepare_project(directory: Path, name: str, record: dict) -> None:
    source = directory / "src" / name
    if source.is_dir() and not project_problems(source, record):
        print(f"{name}: reusing {source.relative_to(ROOT)}")
        return
    source.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=f".{name}.", dir=source.parent))
    try:
        checked(["git", "init", "--quiet"], cwd=temporary)
        checked(["git", "remote", "add", "upstream", record["upstream"]], cwd=temporary)
        checked(
            ["git", "fetch", "--quiet", "--filter=blob:none", "--no-tags", "upstream", record["revision"]],
            cwd=temporary,
        )
        checked(["git", "switch", "--quiet", "--create", "spark3/build", "FETCH_HEAD"], cwd=temporary)
        if record.get("patch_series"):
            series = ROOT / record["patch_series"]
            for patch_name in read_series(series):
                checked(
                    [
                        "git", "-c", f"user.name={PATCH_COMMITTER[0]}",
                        "-c", f"user.email={PATCH_COMMITTER[1]}",
                        "am", "--quiet", "--committer-date-is-author-date",
                        str(series.parent / patch_name),
                    ],
                    cwd=temporary,
                )
        checked(["git", "diff", "--check", record["revision"], "HEAD"], cwd=temporary)
        problems = project_problems(temporary, record)
        if problems:
            raise SystemExit("; ".join(problems))
        replace_directory(temporary, source)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    print(f"{name}: prepared {record['patch_head'][:12]} (tree {record['expected_tree'][:12]})")


def prepare_cutlass(directory: Path, record: dict) -> None:
    source = directory / "src/cutlass"
    if (source / ".git").exists() and git_output(source, "rev-parse", "HEAD") == record["revision"]:
        print(f"cutlass: reusing {source.relative_to(ROOT)}")
        return
    source.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".cutlass.", dir=source.parent))
    try:
        checked(["git", "init", "--quiet"], cwd=temporary)
        checked(["git", "remote", "add", "upstream", record["upstream"]], cwd=temporary)
        checked(["git", "fetch", "--quiet", "--depth", "1", "upstream", record["revision"]], cwd=temporary)
        checked(["git", "checkout", "--quiet", "--detach", "FETCH_HEAD"], cwd=temporary)
        if git_output(temporary, "rev-parse", "HEAD") != record["revision"]:
            raise SystemExit("cutlass: fetched revision differs from the lock")
        replace_directory(temporary, source)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    print(f"cutlass: prepared {record['release_tag']} ({record['revision'][:12]})")


def wheel_problems(wheel_dir: Path) -> list[str]:
    if not wheel_dir.is_dir():
        return ["cutlass-dsl-wheels: missing"]
    problems = []
    expected = expected_wheel_hashes()
    found: set[str] = set()
    for wheel in sorted(wheel_dir.iterdir()):
        normalized = wheel.name.replace("-", "_").lower()
        package = next(
            (name for name in sorted(expected, key=len, reverse=True)
             if normalized.startswith(name.lower() + "_")),
            None,
        )
        if package is None or not wheel.name.endswith(".whl"):
            problems.append(f"cutlass-dsl-wheels: unlocked file {wheel.name}")
            continue
        found.add(package)
        if sha256(wheel) != expected[package]:
            problems.append(f"cutlass-dsl-wheels: {wheel.name} differs from the lock hash")
    for package in sorted(set(expected) - found):
        problems.append(f"cutlass-dsl-wheels: missing {package}")
    return problems


def prepare_wheels(directory: Path, upstreams: dict) -> None:
    destination = directory / "context/cutlass-dsl-wheels"
    if not wheel_problems(destination):
        print("cutlass-dsl wheels: reusing verified wheels")
        return
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".wheels.", dir=destination.parent))
    try:
        checked([
            sys.executable, "-m", "pip", "download", "--quiet", "--dest", str(temporary),
            "--require-hashes", "--no-deps", "--only-binary=:all:",
            "--platform", "manylinux_2_28_aarch64", "--implementation", "cp",
            "--python-version", "3.12", "--abi", "cp312",
            "--requirement", str(ROOT / upstreams["sources"]["cutlass_dsl"]["lockfile"]),
        ])
        problems = wheel_problems(temporary)
        if problems:
            raise SystemExit("; ".join(problems))
        replace_directory(temporary, destination)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    print("cutlass-dsl wheels: downloaded and verified")


def export_source(source: Path, destination: Path) -> None:
    """Copy a checkout without Git metadata or bytecode, replacing atomically."""
    temporary = destination.with_name(f".{destination.name}.export")
    shutil.rmtree(temporary, ignore_errors=True)
    shutil.copytree(
        source, temporary, symlinks=True, ignore=shutil.ignore_patterns(".git", "__pycache__")
    )
    replace_directory(temporary, destination)


def normalize_modes(root: Path) -> None:
    """Git's two file modes, so contexts do not depend on the host umask."""
    for path in [root, *root.rglob("*")]:
        if path.is_symlink():
            continue
        if path.is_dir():
            path.chmod(0o755)
        else:
            path.chmod(0o755 if path.stat().st_mode & 0o111 else 0o644)


def vllm_deletions(directory: Path, inputs: dict) -> list[str]:
    """Files the pinned vLLM deletes relative to the base image's revision."""
    source = directory / "src/vllm"
    base = inputs["base_source_revision"]
    present = subprocess.run(
        ["git", "cat-file", "-e", f"{base}^{{commit}}"], cwd=source, stderr=subprocess.DEVNULL
    )
    if present.returncode:
        checked(
            ["git", "fetch", "--quiet", "--filter=blob:none", "--no-tags",
             inputs["vllm"]["canonical_upstream"], base],
            cwd=source,
        )
    output = git_output(source, "diff", "--name-only", "--diff-filter=D", base, "HEAD", "--", "vllm")
    return [path.removeprefix("vllm/") for path in output.splitlines()]


def build_problems(directory: Path, inputs: dict) -> list[str]:
    record_path = directory / "inputs.json"
    if not record_path.is_file():
        return [f"{directory.relative_to(ROOT)} is not prepared; run bin/spark3 build prepare"]
    record = json.loads(record_path.read_text(encoding="utf-8"))
    problems = []
    if record.get("schema") != BUILD_LAYOUT:
        problems.append(f"prepared with build layout {record.get('schema')}, now {BUILD_LAYOUT}")
    if record.get("inputs") != inputs:
        problems.append("inputs.json does not match the lock")
    for name in BUILD_PROJECTS:
        problems.extend(project_problems(directory / "src" / name, inputs[name]))
    for name, digest in record.get("contexts", {}).items():
        context = directory / "context" / name
        if not context.is_dir():
            problems.append(f"{name}: context is missing")
        elif tree_digest(context) != digest:
            problems.append(f"{name}: context changed since it was prepared")
    if sorted(record.get("contexts", {})) != sorted(BUILD_CONTEXTS):
        problems.append("inputs.json does not record every build context")
    problems.extend(wheel_problems(directory / "context/cutlass-dsl-wheels"))
    if not (directory / "context/cutlass-source/include/cutlass/cutlass.h").is_file():
        problems.append("cutlass-source: include/cutlass/cutlass.h is missing")
    return problems


def command_build_prepare(args: argparse.Namespace) -> int:
    _, _, upstreams = configuration(args)
    inputs = build_inputs(upstreams)
    directory = build_directory(inputs)
    parts = args.only.split(",") if args.only else list(BUILD_PARTS)
    unknown = sorted(set(parts) - set(BUILD_PARTS))
    if unknown:
        raise SystemExit(f"unknown build parts: {', '.join(unknown)}")
    if not args.only and not build_problems(directory, inputs):
        print(f"build inputs ready: {directory.relative_to(ROOT)}")
        return 0
    directory.mkdir(parents=True, exist_ok=True)
    (directory / "inputs.json").unlink(missing_ok=True)
    print(f"preparing {directory.relative_to(ROOT)}", flush=True)
    for name in BUILD_PROJECTS:
        if name in parts:
            prepare_project(directory, name, inputs[name])
    if "cutlass" in parts:
        prepare_cutlass(directory, inputs["cutlass"])
    if "wheels" in parts:
        prepare_wheels(directory, upstreams)
    if args.only:
        print("partial preparation; run bin/spark3 build prepare for the complete inputs")
        return 0
    context = directory / "context"
    for name in ("vllm", "b12x", "cutlass"):
        export_source(directory / "src" / name, context / f"{name}-source")
    deleted = vllm_deletions(directory, inputs)
    deletions = context / "vllm-deletions"
    deletions.mkdir(exist_ok=True)
    (deletions / "deleted.txt").write_text("".join(f"{path}\n" for path in deleted), encoding="utf-8")
    (context / "empty").mkdir(exist_ok=True)
    normalize_modes(context)
    record = {
        "schema": BUILD_LAYOUT,
        "inputs": inputs,
        "contexts": {name: tree_digest(context / name) for name in BUILD_CONTEXTS},
        "vllm_deletions": len(deleted),
    }
    temporary = directory / ".inputs.json"
    temporary.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.rename(directory / "inputs.json")
    problems = build_problems(directory, inputs)
    if problems:
        for problem in problems:
            print(f"WARN: {problem}")
        return 1
    print(f"build inputs ready: {directory.relative_to(ROOT)} ({len(deleted)} vLLM deletions)")
    return 0


def command_build_check(args: argparse.Namespace) -> int:
    _, _, upstreams = configuration(args)
    inputs = build_inputs(upstreams)
    directory = build_directory(inputs)
    problems = build_problems(directory, inputs)
    if problems:
        for problem in problems:
            print(f"WARN: {problem}")
        return 1
    print(f"build inputs OK: {directory.relative_to(ROOT)}")
    return 0


def available_memory_gib() -> float:
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) * 1024 / GIB
    except (OSError, ValueError) as error:
        raise SystemExit(f"cannot read host MemAvailable: {error}") from error
    raise SystemExit("cannot read host MemAvailable")


def compile_jobs(available_gib: float) -> int:
    if available_gib < BUILD_MIN_AVAILABLE_GIB:
        raise SystemExit(
            f"the build needs {BUILD_MIN_AVAILABLE_GIB} GiB MemAvailable to start; "
            f"found {available_gib:.1f} GiB"
        )
    cpu_jobs = max(1, (len(os.sched_getaffinity(0)) - BUILD_CPU_RESERVE) // BUILD_NVCC_THREADS)
    memory_jobs = int((available_gib - BUILD_RESERVE_GIB) // BUILD_MEMORY_PER_JOB_GIB)
    return min(BUILD_MAX_JOBS, cpu_jobs, memory_jobs)


def cancel_process_group(process: subprocess.Popen) -> None:
    for signal_number, seconds in ((signal.SIGINT, 30), (signal.SIGTERM, 10), (signal.SIGKILL, 5)):
        if process.poll() is not None:
            return
        try:
            os.killpg(process.pid, signal_number)
        except ProcessLookupError:
            return
        try:
            process.wait(timeout=seconds)
            return
        except subprocess.TimeoutExpired:
            pass


def run_memory_guarded(command: list[str], reserve_gib: float) -> float:
    """Run a command, cancelling it if MemAvailable falls below the reserve."""
    minimum = available_memory_gib()
    process = subprocess.Popen(command, start_new_session=True)
    try:
        while True:
            try:
                result = process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                available = available_memory_gib()
                minimum = min(minimum, available)
                if available < reserve_gib:
                    cancel_process_group(process)
                    raise SystemExit(
                        f"canceled: MemAvailable fell to {available:.1f} GiB, "
                        f"below the {reserve_gib} GiB reserve"
                    )
                continue
            if result:
                raise SystemExit(f"{command[0]} {command[1]} failed with exit status {result}")
            return minimum
    except KeyboardInterrupt:
        cancel_process_group(process)
        raise SystemExit("canceled") from None
    except BaseException:
        cancel_process_group(process)
        raise


def require_idle_build_host(cluster: dict) -> None:
    running = subprocess.run(
        ["docker", "ps", "--format", "{{.Names}}"], check=True, text=True, stdout=subprocess.PIPE
    ).stdout.split()
    service = cluster["container"]["name"]
    if any(name == service or name.startswith("dsv41-") for name in running):
        raise SystemExit("a DS4.1 service is running on this host; stop it before building")


def image_labels(tag: str) -> dict | None:
    result = subprocess.run(
        ["docker", "image", "inspect", tag], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
    )
    if result.returncode:
        return None
    inspection = json.loads(result.stdout)[0]
    return {"id": inspection["Id"], "labels": inspection["Config"].get("Labels") or {}}


def smoke_image(cluster: dict, tag: str) -> None:
    require_idle_build_host(cluster)
    available = available_memory_gib()
    if available < SMOKE_MEMORY_GIB + 8:
        raise SystemExit(
            f"the GPU import smoke needs {SMOKE_MEMORY_GIB + 8} GiB MemAvailable; found {available:.1f} GiB"
        )
    subprocess.run(
        [
            "docker", "run", "--rm", "-i", "--gpus", "all",
            f"--memory={SMOKE_MEMORY_GIB}g", f"--memory-swap={SMOKE_MEMORY_GIB}g",
            "--entrypoint", "/usr/bin/python3", tag, "-",
        ],
        input=SMOKE_SCRIPT,
        text=True,
        check=True,
    )


def command_build_image(args: argparse.Namespace) -> int:
    cluster, _, upstreams = configuration(args)
    inputs = build_inputs(upstreams)
    directory = build_directory(inputs)
    problems = build_problems(directory, inputs)
    if problems:
        for problem in problems:
            print(f"WARN: {problem}")
        return 1
    if repository_dirty():
        print("WARN: the image records the deployment commit; commit changes first")
        return 1
    tag = args.tag or cluster["container"]["image"]
    context = directory / "context"
    base = upstreams["sources"]["vllm_base_image"]
    deployment_commit = repository_revision()

    def command(jobs: int | str) -> list[str]:
        rendered = [
            "docker", "buildx", "build", "--platform", "linux/arm64", "--network", "host", "--load",
            "--file", str(ROOT / "docker/Dockerfile"), "--tag", tag,
        ]
        for name in BUILD_CONTEXTS:
            rendered += ["--build-context", f"{name}={context / name}"]
        build_args = {
            "BASE_IMAGE": inputs["base_image"],
            "BASE_IMAGE_NAME": base["upstream"],
            "BASE_IMAGE_DIGEST": base["recorded_base_digest"],
            "DEPLOYMENT_COMMIT": deployment_commit,
            "VLLM_COMPILE_JOBS": str(jobs),
            "VLLM_NVCC_THREADS": str(BUILD_NVCC_THREADS),
        }
        for name in BUILD_PROJECTS:
            record = inputs[name]
            prefix = name.upper()
            build_args.update({
                f"{prefix}_UPSTREAM": record["upstream"].removesuffix(".git"),
                f"{prefix}_REF": record["tracking_ref"].removeprefix("refs/heads/"),
                f"{prefix}_REVISION": record["revision"],
                f"{prefix}_PATCH_HEAD": record["patch_head"],
                f"{prefix}_TREE": record["expected_tree"],
            })
        for key, value in build_args.items():
            rendered += ["--build-arg", f"{key}={value}"]
        if os.environ.get("GITHUB_TOKEN"):
            rendered += ["--secret", "id=github_token,env=GITHUB_TOKEN"]
        return rendered + [str(context / "empty")]

    if not args.apply:
        print(shlex.join(command("<sized from MemAvailable>")))
        print("plan only; pass --apply on an idle build host to build and smoke-test")
        return 0
    lock = BUILD_LOCK.open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit("another image build is running on this host") from None
    require_idle_build_host(cluster)
    if image_labels(tag) is not None:
        raise SystemExit(f"{tag} already exists here; pass --tag with a new tag rather than overwrite it")
    available = available_memory_gib()
    jobs = compile_jobs(available)
    print(
        f"building {tag} from {directory.relative_to(ROOT)}: {jobs} compile jobs x "
        f"{BUILD_NVCC_THREADS} NVCC threads, {available:.1f} GiB available, "
        f"cancel below {BUILD_RESERVE_GIB} GiB",
        flush=True,
    )
    started = time.monotonic()
    minimum = run_memory_guarded(command(jobs), BUILD_RESERVE_GIB)
    elapsed = time.monotonic() - started
    image = image_labels(tag)
    if image is None:
        raise SystemExit(f"the build finished but {tag} is not present")
    for name in BUILD_PROJECTS:
        label = image["labels"].get(f"local.spark3.{name}.tree")
        if label != inputs[name]["expected_tree"]:
            raise SystemExit(f"{tag}: label local.spark3.{name}.tree is {label!r}")
    print(f"built {tag} {image['id']} in {elapsed:.0f}s; lowest MemAvailable {minimum:.1f} GiB", flush=True)
    smoke_image(cluster, tag)
    receipts = directory / "images"
    receipts.mkdir(exist_ok=True)
    receipt = {
        "tag": tag,
        "image_id": image["id"],
        "deployment_commit": deployment_commit,
        "compile_jobs": jobs,
        "elapsed_seconds": round(elapsed),
        "min_available_gib": round(minimum, 1),
        "built_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    (receipts / f"{image['id'].removeprefix('sha256:')[:16]}.json").write_text(
        json.dumps(receipt, indent=2) + "\n", encoding="utf-8"
    )
    return 0


def command_build_smoke(args: argparse.Namespace) -> int:
    cluster, _, _ = configuration(args)
    smoke_image(cluster, args.image or cluster["container"]["image"])
    return 0


BENCH_SCHEMA = 1
BENCH_SUITES = ("quality", "decode", "sampled", "prefill", "prefix", "admission")
BENCH_TIMEOUT_SECONDS = 1800
# These prompts and settings match the client behind every baseline manifest
# since 2026-09-20, so decode means stay comparable with published figures.
DECODE_PROMPTS = {
    "prose": (
        "Explain, in precise technical prose, how speculative decoding can "
        "increase language-model serving throughput while preserving the "
        "target model's output distribution. Discuss acceptance rate, "
        "verification cost, batching, and latency."
    ),
    "code": (
        "Write a complete Python implementation of an LRU cache using only "
        "the standard library. Include type hints, O(1) get and put methods, "
        "capacity validation, and a short executable example. Explain the "
        "complexity after the code."
    ),
}
SAMPLED_PROMPTS = {
    "prose": (
        "Write a short essay about how rivers shape the land and the people "
        "who live near them."
    ),
    "code": (
        "Write a Python module with a thread-safe LRU cache class (get, put, "
        "delete, clear) and unit tests using unittest."
    ),
}
LRU_PROMPT = (
    "Write a short Python LRU cache class with get and put methods using "
    "OrderedDict. Give code and one sentence on complexity."
)
FILLER_WORDS = (
    "river stone lantern orchard meadow harbor canyon glacier prairie "
    "summit valley forest desert island marsh delta ridge basin"
).split()
BENCH_METRICS = (
    "vllm:num_requests_running",
    "vllm:num_requests_waiting",
    "vllm:kv_cache_usage_perc",
    "vllm:request_success_total",
    "vllm:num_preemptions_total",
    "vllm:prefix_cache_queries_total",
    "vllm:prefix_cache_hits_total",
    "vllm:spec_decode_num_drafts_total",
    "vllm:spec_decode_num_draft_tokens_total",
    "vllm:spec_decode_num_accepted_tokens_total",
)
# Two-sided 95% Student t quantiles by degrees of freedom (lower bound).
T_95 = (
    (1, 12.706), (2, 4.303), (3, 3.182), (4, 2.776), (5, 2.571), (6, 2.447),
    (7, 2.365), (8, 2.306), (9, 2.262), (10, 2.228), (12, 2.179), (15, 2.131),
    (20, 2.086), (30, 2.042), (60, 2.000), (120, 1.980),
)


class BenchAbort(RuntimeError):
    """Stop issuing requests; the partial report is still written."""


def t_95(degrees: float) -> float:
    quantile = T_95[0][1]
    for bound, value in T_95:
        if degrees >= bound:
            quantile = value
    return quantile


def describe(values: list[float]) -> dict:
    count = len(values)
    if not count:
        return {"n": 0}
    mean = sum(values) / count
    ordered = sorted(values)
    middle = count // 2
    median = ordered[middle] if count % 2 else (ordered[middle - 1] + ordered[middle]) / 2
    summary = {
        "n": count,
        "mean": round(mean, 3),
        "median": round(median, 3),
        "min": round(ordered[0], 3),
        "max": round(ordered[-1], 3),
        "sd": None,
        "ci95": None,
        "ci95_pct": None,
    }
    if count > 1:
        sd = (sum((value - mean) ** 2 for value in values) / (count - 1)) ** 0.5
        half = t_95(count - 1) * sd / count**0.5
        summary.update(sd=round(sd, 3), ci95=round(half, 3))
        if mean:
            summary["ci95_pct"] = round(100 * half / mean, 2)
    return summary


def difference(new: dict, reference: dict) -> tuple[float, float, float] | None:
    """Percent change of the new mean and its Welch 95% interval."""
    if not new.get("n") or not reference.get("n") or not reference.get("mean"):
        return None
    new_var = (new.get("sd") or 0.0) ** 2 / new["n"]
    ref_var = (reference.get("sd") or 0.0) ** 2 / reference["n"]
    denominator = 0.0
    if new["n"] > 1:
        denominator += new_var**2 / (new["n"] - 1)
    if reference["n"] > 1:
        denominator += ref_var**2 / (reference["n"] - 1)
    degrees = (new_var + ref_var) ** 2 / denominator if denominator else 120
    change = new["mean"] / reference["mean"] - 1
    half = t_95(degrees) * (new_var + ref_var) ** 0.5 / reference["mean"]
    return 100 * change, 100 * (change - half), 100 * (change + half)


def scrape_metrics(base: str) -> dict[str, float]:
    with urllib.request.urlopen(f"{base}/metrics", timeout=10) as response:
        text = response.read().decode("utf-8", errors="replace")
    return parse_metrics(text)


def parse_metrics(text: str) -> dict[str, float]:
    values = dict.fromkeys(BENCH_METRICS, 0.0)
    for line in text.splitlines():
        name = line.split("{", 1)[0].split(" ", 1)[0]
        if name in values:
            values[name] += float(line.rsplit(" ", 1)[1])
    return values


def stream_request(
    url: str, payload: dict, stop: threading.Event, keep_content: bool = False
) -> dict:
    """Stream one request; every failure stays in the receipt."""
    body = dict(payload, stream=True, stream_options={"include_usage": True})
    request = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    started = time.perf_counter()
    first: float | None = None
    status: int | None = None
    usage: dict = {}
    content: list[str] = []
    digest = hashlib.sha256()
    error: str | None = None
    try:
        with urllib.request.urlopen(request, timeout=BENCH_TIMEOUT_SECONDS) as response:
            status = response.status
            for raw in response:
                if stop.is_set():
                    error = "aborted by bench"
                    break
                line = raw.decode("utf-8", errors="replace").strip()
                if not line.startswith("data: "):
                    continue
                if line == "data: [DONE]":
                    break
                event = json.loads(line[6:])
                usage = event.get("usage") or usage
                for choice in event.get("choices") or []:
                    delta = choice.get("delta") or {}
                    pieces = (
                        delta.get("reasoning_content"),
                        delta.get("reasoning"),
                        delta.get("content"),
                        choice.get("text"),
                    )
                    emitted = "".join(piece for piece in pieces if isinstance(piece, str))
                    # Completions stream their first token directly; chat
                    # streams open with an empty role delta.
                    if first is None and (emitted or "text" in choice):
                        first = time.perf_counter()
                    if not emitted:
                        continue
                    digest.update(emitted.encode())
                    if isinstance(delta.get("content"), str):
                        content.append(delta["content"])
    except Exception as exception:
        error = f"{type(exception).__name__}: {exception}"
    ended = time.perf_counter()
    tokens = usage.get("completion_tokens")
    decode = None
    if tokens and tokens > 1 and first is not None and ended > first:
        decode = (tokens - 1) / (ended - first)
    result = {
        "ok": error is None and status == 200 and first is not None,
        "ttft_s": None if first is None else round(first - started, 4),
        "elapsed_s": round(ended - started, 4),
        "prompt_tokens": usage.get("prompt_tokens"),
        "completion_tokens": tokens,
        "decode_tps": None if decode is None else round(decode, 2),
        "output_sha256": digest.hexdigest()[:16],
        "error": error,
    }
    if keep_content:
        result["content"] = "".join(content)
    return result


THERMAL_FIELDS = (
    "temperature.gpu",
    "temperature.gpu.tlimit",
    "clocks.sm",
    "power.draw",
    "clocks_event_reasons_counters.sw_thermal_slowdown",
    "clocks_event_reasons_counters.hw_thermal_slowdown",
    "clocks_event_reasons_counters.sw_power_cap",
    "clocks_event_reasons_counters.hw_power_brake_slowdown",
)
# Stop measuring when a GPU comes within this many degrees of its slowdown limit.
THERMAL_HEADROOM_FLOOR_C = 5.0
# DGX Spark board zones trip a critical shutdown at 104 C; stop well before it.
BOARD_CEILING_C = 98.0


def parse_thermal(text: str) -> dict:
    """One node sample: nvidia-smi fields, then the hottest thermal zone (m°C)."""

    def number(value: str) -> float | None:
        try:
            return float(value)
        except ValueError:
            return None

    values = [number(value) for value in text.strip().split(",")]
    values += [None] * (len(THERMAL_FIELDS) + 1 - len(values))
    gpu, headroom, clock, power, sw_thermal, hw_thermal, sw_power, hw_brake, zone = values[: len(THERMAL_FIELDS) + 1]

    def total(*parts: float | None) -> float | None:
        known = [part for part in parts if part is not None]
        return sum(known) if known else None

    return {
        "gpu_c": gpu,
        "headroom_c": headroom,
        "sm_mhz": clock,
        "power_w": power,
        "thermal_slowdown_us": total(sw_thermal, hw_thermal),
        "power_cap_us": total(sw_power, hw_brake),
        "system_c": None if zone is None else zone / 1000,
    }


class MemoryWatch:
    """Per-node memory each second and GPU/board temperatures every five."""

    SCRIPT = (
        "i=0; while :; do "
        "awk '/^(MemAvailable|SwapTotal|SwapFree):/{v[$1]=$2} "
        'END{print "M", v["MemAvailable:"], v["SwapTotal:"]-v["SwapFree:"]}\' /proc/meminfo; '
        'if [ $((i % 5)) -eq 0 ]; then echo "T $(nvidia-smi --query-gpu='
        + ",".join(THERMAL_FIELDS)
        + " --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' '),"
        + '$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1)"; fi; '
        "i=$((i + 1)); sleep 1; done"
    )

    def __init__(self, nodes: dict, floor_gib: float, halt) -> None:
        self.floor_kib = floor_gib * 1048576
        self.floor_gib = floor_gib
        self.halt = halt
        self.lock = threading.Lock()
        self.state: dict[str, dict] = {}
        self.thermal: dict[str, dict] = {}
        self.processes: list[subprocess.Popen] = []
        for node in nodes["nodes"]:
            process = subprocess.Popen(
                [
                    "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                    "-o", "ServerAliveInterval=5", ssh_target(nodes, node),
                    shlex.join(["bash", "-c", self.SCRIPT]),
                ],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
            self.processes.append(process)
            self.state[node["name"]] = {"last": None}
            self.thermal[node["name"]] = {}
            threading.Thread(
                target=self._read, args=(node["name"], process), daemon=True
            ).start()

    def _read(self, name: str, process: subprocess.Popen) -> None:
        for line in process.stdout:
            kind, _, rest = line.strip().partition(" ")
            if kind == "M":
                self._memory(name, rest)
            elif kind == "T":
                self._temperature(name, parse_thermal(rest))

    def _memory(self, name: str, text: str) -> None:
        try:
            available, swap = (int(float(value)) for value in text.split())
        except ValueError:
            return
        with self.lock:
            state = self.state[name]
            state["last"] = time.monotonic()
            state["min_available_kib"] = min(state.get("min_available_kib", available), available)
            state.setdefault("swap_start_kib", swap)
            state["swap_max_kib"] = max(state.get("swap_max_kib", swap), swap)
        if available < self.floor_kib:
            self.halt(
                f"{name}: MemAvailable {available / 1048576:.2f} GiB fell below "
                f"the {self.floor_gib:g} GiB bench floor"
            )

    def _temperature(self, name: str, sample: dict) -> None:
        with self.lock:
            state = self.thermal[name]
            for key, better in (("gpu_c", max), ("system_c", max), ("power_w", max), ("headroom_c", min)):
                if sample[key] is not None:
                    state[key] = better(state.get(key, sample[key]), sample[key])
            for key in ("thermal_slowdown_us", "power_cap_us"):
                if sample[key] is not None:
                    state.setdefault(f"{key}_start", sample[key])
                    state[f"{key}_last"] = sample[key]
        board = sample["system_c"]
        if board is not None and board >= BOARD_CEILING_C:
            self.halt(
                f"{name}: board thermal zone at {board:g} C reached the {BOARD_CEILING_C:g} C "
                "bench ceiling (critical trip 104 C)"
            )
        headroom = sample["headroom_c"]
        if headroom is not None and headroom <= THERMAL_HEADROOM_FLOOR_C:
            self.halt(
                f"{name}: GPU at {sample['gpu_c']:g} C is within {headroom:g} C of its "
                "thermal slowdown limit"
            )

    def wait_ready(self, timeout: float = 30) -> None:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            with self.lock:
                if all(state["last"] is not None for state in self.state.values()):
                    return
            time.sleep(0.5)
        raise BenchAbort("memory telemetry did not start on every node")

    def check(self) -> None:
        now = time.monotonic()
        with self.lock:
            for name, state in self.state.items():
                if state["last"] is None or now - state["last"] > 15:
                    raise BenchAbort(f"{name}: memory telemetry stopped reporting")

    def thermal_summary(self) -> dict:
        summary = {}
        with self.lock:
            for name, state in self.thermal.items():
                if not state:
                    continue
                entry = {
                    "max_gpu_c": state.get("gpu_c"),
                    "min_headroom_c": state.get("headroom_c"),
                    "max_system_c": state.get("system_c"),
                    "max_power_w": state.get("power_w"),
                }
                for key, label in (("thermal_slowdown_us", "thermal_slowdown_ms"), ("power_cap_us", "power_cap_ms")):
                    if f"{key}_last" in state:
                        entry[label] = round((state[f"{key}_last"] - state[f"{key}_start"]) / 1000, 1)
                summary[name] = entry
        return summary

    def close(self) -> dict:
        for process in self.processes:
            process.terminate()
        for process in self.processes:
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
        with self.lock:
            return {
                name: {
                    "min_available_gib": round(state["min_available_kib"] / 1048576, 2),
                    "swap_growth_gib": round(
                        (state["swap_max_kib"] - state["swap_start_kib"]) / 1048576, 2
                    ),
                }
                for name, state in self.state.items()
                if state["last"] is not None
            }


class PeakWatch:
    """Peak KV use and request counts while one sample runs."""

    def __init__(self, base: str) -> None:
        self.base = base
        self.peak = {"kv_cache_usage": 0.0, "running": 0.0, "active": 0.0}
        self.done = threading.Event()
        self.thread = threading.Thread(target=self._poll, daemon=True)
        self.thread.start()

    def _poll(self) -> None:
        while not self.done.wait(1.0):
            try:
                metrics = scrape_metrics(self.base)
            except Exception:
                continue
            running = metrics["vllm:num_requests_running"]
            active = running + metrics["vllm:num_requests_waiting"]
            self.peak["kv_cache_usage"] = max(self.peak["kv_cache_usage"], metrics["vllm:kv_cache_usage_perc"])
            self.peak["running"] = max(self.peak["running"], running)
            self.peak["active"] = max(self.peak["active"], active)

    def finish(self) -> dict:
        self.done.set()
        self.thread.join()
        return self.peak


class Bench:
    def __init__(self, base: str, nodes: dict, floor_gib: float) -> None:
        self.base = base
        self.stop = threading.Event()
        self.reason: str | None = None
        self.sent = 0
        self.foreign = 0
        self.start_total: float | None = None
        self.discarded: list[dict] = []
        self.memory = MemoryWatch(nodes, floor_gib, self.halt)

    def halt(self, reason: str) -> None:
        if not self.stop.is_set():
            self.reason = reason
            self.stop.set()

    def wait_idle(self, timeout: float = 300) -> dict:
        deadline = time.monotonic() + timeout
        while True:
            if self.stop.is_set():
                raise BenchAbort(self.reason)
            self.memory.check()
            metrics = scrape_metrics(self.base)
            if not metrics["vllm:num_requests_running"] and not metrics["vllm:num_requests_waiting"]:
                # Let the success counter settle before attributing requests.
                time.sleep(0.5)
                metrics = scrape_metrics(self.base)
                if self.start_total is None:
                    self.start_total = metrics["vllm:request_success_total"]
                finished = metrics["vllm:request_success_total"] - self.start_total
                self.foreign = max(self.foreign, int(finished) - self.sent)
                return metrics
            if time.monotonic() > deadline:
                raise BenchAbort("the service stayed busy with other requests")
            time.sleep(2)

    def run(
        self,
        label: str,
        payloads: list[tuple[str, dict]],
        concurrency: int | None = None,
        keep_content: bool = False,
        retries: int = 3,
    ) -> dict:
        """Send one sample; repeat it when other traffic overlapped."""
        concurrency = concurrency or len(payloads)
        for attempt in range(retries + 1):
            before = self.wait_idle()
            peak = PeakWatch(self.base)
            started = time.perf_counter()
            with concurrent.futures.ThreadPoolExecutor(concurrency) as pool:
                try:
                    results = list(
                        pool.map(
                            lambda item: stream_request(
                                f"{self.base}{item[0]}", item[1], self.stop, keep_content
                            ),
                            payloads,
                        )
                    )
                except BaseException:
                    self.halt("interrupted")
                    raise
            wall = time.perf_counter() - started
            peaks = peak.finish()
            self.sent += len(payloads)
            if self.stop.is_set():
                raise BenchAbort(self.reason)
            after = scrape_metrics(self.base)
            finished = after["vllm:request_success_total"] - self.start_total
            foreign = int(finished) - self.sent - self.foreign
            # A closed loop may briefly show a finished request beside its successor.
            slack = 1 if len(payloads) > concurrency else 0
            if foreign > 0 or peaks["active"] > concurrency + slack:
                self.foreign += max(foreign, 0)
                self.discarded.append({"label": label, "attempt": attempt, "foreign": foreign})
                print(f"  {label}: other traffic overlapped; repeating", flush=True)
                continue
            metrics = {
                name.removeprefix("vllm:").removesuffix("_total"): after[name] - before[name]
                for name in BENCH_METRICS
                if name.endswith("_total")
            }
            return {"wall_s": wall, "requests": results, "metrics": metrics, "peak": peaks}
        raise BenchAbort(f"{label}: other traffic overlapped {retries + 1} attempts")


def chat_payload(model: str, prompt: str, max_tokens: int, **extra) -> tuple[str, dict]:
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": max_tokens,
    }
    payload.update(extra)
    return "/v1/chat/completions", payload


def filler(tokens: int, seed: int) -> str:
    # About one token per word for these plain lowercase words.
    body = " ".join(FILLER_WORDS[(i * 7 + seed) % len(FILLER_WORDS)] for i in range(tokens))
    return f"Document {seed}:\n{body}"


def acceptance(metrics: dict) -> float | None:
    drafts = metrics["spec_decode_num_drafts"]
    return round(metrics["spec_decode_num_accepted_tokens"] / drafts, 4) if drafts else None


def step_times_ms(samples: list[dict]) -> list[float]:
    """Milliseconds per decode step for single-stream samples.

    Each step emits one token plus the accepted drafts, so the step time is
    (1 + accepted per draft) / decode tok/s. It is independent of how many
    drafts the text lets the model accept, which makes it far steadier than
    tok/s for changes to kernels or host overhead.
    """
    times = []
    for sample in samples:
        accepted = sample.get("accepted_per_draft")
        requests = sample.get("requests") or []
        if accepted is None or len(requests) != 1:
            continue
        rate = requests[0].get("decode_tps")
        if requests[0].get("ok") and rate:
            times.append(1000 * (1 + accepted) / rate)
    return times


def compact(results: list[dict]) -> list[dict]:
    keys = ("ok", "ttft_s", "prompt_tokens", "completion_tokens", "decode_tps", "output_sha256", "error")
    return [{key: result[key] for key in keys} for result in results]


def assess_lru(content: str) -> str:
    match = re.search(r"```(?:python)?\s*\n(.*?)```", content, re.DOTALL)
    if match is None:
        return "missing Python code block"
    try:
        tree = ast.parse(match.group(1))
    except SyntaxError as error:
        return f"Python syntax error: {error.msg} at line {error.lineno}"
    for node in tree.body:
        if not isinstance(node, ast.ClassDef):
            continue
        methods = {item.name: item for item in node.body if isinstance(item, ast.FunctionDef)}
        if {"get", "put"} <= methods.keys():
            arguments = [argument.arg for argument in methods["put"].args.args]
            if arguments != ["self", "key", "value"]:
                return f"put signature uses {arguments!r}"
            return "pass"
    return "missing LRU class with get and put methods"


def suite_quality(bench: Bench, options: argparse.Namespace, rng: random.Random) -> dict:
    """The fixed LRU request, five times; every answer must pass."""
    runs = []
    for index in range(5):
        sample = bench.run(
            f"quality {index + 1}/5",
            [chat_payload(options.model, LRU_PROMPT, 256, temperature=0, seed=42,
                          chat_template_kwargs={"thinking": False})],
            keep_content=True,
        )
        result = sample["requests"][0]
        verdict = assess_lru(result["content"]) if result["ok"] else f"request failed: {result['error']}"
        runs.append({"verdict": verdict, "content": result["content"]})
        print(f"  quality {index + 1}/5: {verdict}", flush=True)
    passed = sum(run["verdict"] == "pass" for run in runs)
    return {"passed": passed, "runs": runs, "ok": passed == len(runs)}


def suite_decode(bench: Bench, options: argparse.Namespace, rng: random.Random) -> dict:
    """Temperature-0 serving matrix, sampled until every point is precise."""
    points = [f"{case}-c{concurrency}" for case in DECODE_PROMPTS for concurrency in options.concurrency]

    def sample(point: str) -> dict:
        case, concurrency = point.rsplit("-c", 1)
        payload = chat_payload(options.model, DECODE_PROMPTS[case], 256, temperature=0, seed=42)
        return bench.run(point, [payload] * int(concurrency))

    print("  warmup: one discarded sample per point", flush=True)
    for point in rng.sample(points, len(points)):
        sample(point)
    samples: dict[str, list[dict]] = {point: [] for point in points}
    active = list(points)
    rounds = 0
    while active:
        rounds += 1
        rng.shuffle(active)
        for point in active:
            result = sample(point)
            requests = result["requests"]
            tokens = sum(request["completion_tokens"] or 0 for request in requests if request["ok"])
            metrics = result["metrics"]
            drafts = metrics["spec_decode_num_drafts"]
            samples[point].append({
                "tps": round(tokens / result["wall_s"], 3),
                "accepted_per_draft": acceptance(metrics),
                # Adaptive verification trims draft rows per step; step time
                # follows the rows it keeps, so record them with each sample.
                "verified_per_draft": round(metrics["spec_decode_num_draft_tokens"] / drafts, 4) if drafts else None,
                "requests": compact(requests),
            })
        remaining = []
        for point in active:
            summary = describe([entry["tps"] for entry in samples[point]])
            if summary["n"] >= options.max_samples:
                continue
            if summary["n"] < options.min_samples or (summary["ci95_pct"] or 100) > options.precision:
                remaining.append(point)
        status = ", ".join(
            f"{point} ±{describe([entry['tps'] for entry in samples[point]])['ci95_pct'] or '-'}%"
            for point in sorted(remaining)
        )
        print(f"  round {rounds}: {status or 'all points converged'}", flush=True)
        active = remaining
    summary = {}
    for point in points:
        entries = samples[point]
        requests = [request for entry in entries for request in entry["requests"]]
        ok = [request for request in requests if request["ok"]]
        summary[point] = {
            "tps": describe([entry["tps"] for entry in entries]),
            "per_stream_decode_tps": describe([request["decode_tps"] for request in ok if request["decode_tps"]]),
            "ttft_s": describe([request["ttft_s"] for request in ok]),
            "accepted_per_draft": describe([entry["accepted_per_draft"] for entry in entries if entry["accepted_per_draft"] is not None]),
            "step_ms": describe(step_times_ms(entries)),
            "verified_per_draft": describe([entry["verified_per_draft"] for entry in entries if entry.get("verified_per_draft") is not None]),
            "failed_requests": len(requests) - len(ok),
            "distinct_outputs": len({request["output_sha256"] for request in ok}),
        }
    return {"points": summary, "samples": samples}


def suite_sampled(bench: Bench, options: argparse.Namespace, rng: random.Random) -> dict:
    """DSpark acceptance on temperature-1.0 traffic, from the engine counters."""
    points = {}
    for case, prompt in SAMPLED_PROMPTS.items():
        for concurrency in (1, 4):
            label = f"{case}-c{concurrency}"
            payloads = [
                chat_payload(options.model, prompt, 256, temperature=1.0, top_p=0.95,
                             seed=1000 + index, chat_template_kwargs={"thinking": False})
                for index in range(options.sampled_requests)
            ]
            result = bench.run(label, payloads, concurrency=concurrency)
            requests = result["requests"]
            tokens = sum(request["completion_tokens"] or 0 for request in requests if request["ok"])
            metrics = result["metrics"]
            draft_tokens = metrics["spec_decode_num_draft_tokens"]
            points[label] = {
                "requests": len(requests),
                "failed_requests": sum(not request["ok"] for request in requests),
                "aggregate_tps": round(tokens / result["wall_s"], 2),
                "accepted_per_draft": acceptance(metrics),
                "acceptance_rate": round(metrics["spec_decode_num_accepted_tokens"] / draft_tokens, 4) if draft_tokens else None,
                "drafts": metrics["spec_decode_num_drafts"],
            }
            print(f"  {label}: {points[label]['accepted_per_draft']} accepted per draft", flush=True)
    return {"points": points}


def suite_prefill(bench: Bench, options: argparse.Namespace, rng: random.Random) -> dict:
    """Cold prefill: unique uncached prompts, one output token."""
    sizes = [size for size in options.prefill_sizes if size < options.max_model_len - 64]
    samples: dict[str, list[dict]] = {str(size): [] for size in sizes}
    for _ in range(options.prefill_repeats):
        for size in rng.sample(sizes, len(sizes)):
            payload = {
                "model": options.model,
                "prompt": filler(int(size * 0.97), rng.randrange(1 << 30)) + "\n\nReply with the word ok.",
                "max_tokens": 1,
                "temperature": 0,
                "cache_salt": uuid.uuid4().hex,
            }
            request = bench.run(f"prefill {size}", [("/v1/completions", payload)])["requests"][0]
            samples[str(size)].append(compact([request])[0])
            if request["ok"]:
                print(f"  prefill {size}: {request['prompt_tokens'] / request['ttft_s']:.0f} tok/s", flush=True)
    summary = {}
    for size, requests in samples.items():
        ok = [request for request in requests if request["ok"]]
        summary[size] = {
            "prefill_tps": describe([request["prompt_tokens"] / request["ttft_s"] for request in ok]),
            "ttft_s": describe([request["ttft_s"] for request in ok]),
            "prompt_tokens": ok[0]["prompt_tokens"] if ok else None,
            "failed_requests": len(requests) - len(ok),
        }
    return {"points": summary, "samples": samples}


def suite_prefix(bench: Bench, options: argparse.Namespace, rng: random.Random) -> dict:
    """Prefix-cache replay: one cold request, then two identical replays."""
    runs = []
    for index in range(3):
        payload = {
            "model": options.model,
            "prompt": filler(int(options.prefix_tokens * 0.97), rng.randrange(1 << 30)) + "\n\nReply with the word ok.",
            "max_tokens": 1,
            "temperature": 0,
            "cache_salt": uuid.uuid4().hex,
        }
        cold = bench.run(f"prefix cold {index + 1}/3", [("/v1/completions", payload)])
        warm = [bench.run(f"prefix warm {index + 1}/3", [("/v1/completions", payload)]) for _ in range(2)]
        queries = sum(sample["metrics"]["prefix_cache_queries"] for sample in warm)
        hits = sum(sample["metrics"]["prefix_cache_hits"] for sample in warm)
        runs.append({
            "cold_ttft_s": cold["requests"][0]["ttft_s"],
            "warm_ttft_s": [sample["requests"][0]["ttft_s"] for sample in warm],
            "warm_hit_rate": round(hits / queries, 4) if queries else None,
            "ok": all(sample["requests"][0]["ok"] for sample in [cold, *warm]),
        })
        print(f"  prefix {index + 1}/3: cold {runs[-1]['cold_ttft_s']} s, warm {runs[-1]['warm_ttft_s']} s", flush=True)
    return {
        "prompt_tokens": options.prefix_tokens,
        "cold_ttft_s": describe([run["cold_ttft_s"] for run in runs if run["ok"]]),
        "warm_ttft_s": describe([value for run in runs if run["ok"] for value in run["warm_ttft_s"]]),
        "warm_hit_rate": describe([run["warm_hit_rate"] for run in runs if run["warm_hit_rate"] is not None]),
        "runs": runs,
    }


def suite_admission(bench: Bench, options: argparse.Namespace, rng: random.Random) -> dict:
    """Four concurrent long contexts must all be admitted without preemption."""
    tokens = min(options.admission_tokens, options.max_model_len - 1024)
    payloads = [
        chat_payload(
            options.model,
            filler(int(tokens * 0.97), rng.randrange(1 << 30))
            + "\n\nWrite a 400-word story that uses words from the document above.",
            256,
            temperature=0,
            seed=42,
            chat_template_kwargs={"thinking": False},
        )
        for _ in range(4)
    ]
    for _, payload in payloads:
        payload["cache_salt"] = uuid.uuid4().hex
    result = bench.run("admission 4 x %d" % tokens, payloads)
    requests = result["requests"]
    ok = [request for request in requests if request["ok"]]
    admitted = (
        len(ok) == len(requests)
        and not result["metrics"]["num_preemptions"]
        and result["peak"]["running"] >= len(requests)
    )
    print(f"  admission: {'pass' if admitted else 'FAIL'}; peak KV {result['peak']['kv_cache_usage']:.0%}", flush=True)
    return {
        "context_tokens": tokens,
        "ok": admitted,
        "preemptions": result["metrics"]["num_preemptions"],
        "peak_running": result["peak"]["running"],
        "peak_kv_cache_usage": round(result["peak"]["kv_cache_usage"], 4),
        "wall_s": round(result["wall_s"], 2),
        "ttft_s": [request["ttft_s"] for request in requests],
        "per_stream_decode_tps": describe([request["decode_tps"] for request in ok if request["decode_tps"]]),
        "requests": compact(requests),
    }


BENCH_SUITE_FUNCTIONS = {
    "quality": suite_quality,
    "decode": suite_decode,
    "sampled": suite_sampled,
    "prefill": suite_prefill,
    "prefix": suite_prefix,
    "admission": suite_admission,
}


def serve_arg(cluster: dict, flag: str) -> str | None:
    arguments = cluster["serve_args"]
    return arguments[arguments.index(flag) + 1] if flag in arguments else None


def bench_identity(cluster: dict, nodes: dict, config_name: str, config_path: Path) -> dict:
    name = cluster["container"]["name"]
    identity = {
        "cluster_config": config_name,
        "cluster_config_sha256": sha256(config_path),
        "promoted_baseline": cluster.get("promoted_baseline"),
        "image": cluster["container"]["image"],
        "client_commit": repository_revision(),
        "client_dirty": bool(repository_dirty()),
        "client_host": socket.gethostname(),
        "nodes": {},
    }
    for node in nodes["nodes"]:
        container = run_ssh(nodes, node, "docker", "inspect", "--format", "{{.Image}} {{.State.StartedAt}}", name)
        checkout = run_ssh(nodes, node, "git", "-C", repository_path(cluster), "rev-parse", "HEAD")
        image_id, _, started_at = container.stdout.strip().partition(" ")
        identity["nodes"][node["name"]] = {
            "image_id": image_id or None,
            "container_started_at": started_at or None,
            "checkout": checkout.stdout.strip() or None,
        }
    identity["live_problems"] = live_doctor(cluster, nodes)
    return identity


def bench_rows(report: dict, reference: dict | None, tolerance: float) -> tuple[list[str], list[str]]:
    """Summary lines and regressions against the reference run."""
    lines: list[str] = []
    regressions: list[str] = []
    suites = report["suites"]
    ref_suites = (reference or {}).get("suites", {})

    def compare(label: str, new: dict, ref: dict | None, unit: str) -> None:
        text = f"  {label:<18} {new['mean']:>9.1f} ±{new['ci95_pct'] or 0:>4.1f}% n={new['n']:<3}"
        change = difference(new, ref) if ref else None
        if change:
            mean, low, high = change
            verdict = "faster" if low > 0 else "slower" if high < 0 else "same"
            text += f" ref {ref['mean']:>8.1f}  {mean:+5.1f}% [{low:+.1f}, {high:+.1f}] {verdict}"
            if verdict == "slower" and mean < -tolerance:
                regressions.append(f"{label} {unit} {mean:+.1f}%")
        lines.append(text)

    if "quality" in suites:
        quality = suites["quality"]
        lines.append(f"quality: LRU {quality['passed']}/{len(quality['runs'])}")
    if "decode" in suites:
        lines.append("decode (aggregate tok/s, 95% CI):")
        ref_points = ref_suites.get("decode", {}).get("points", {})
        for point, summary in suites["decode"]["points"].items():
            if summary["tps"]["n"]:
                compare(point, summary["tps"], ref_points.get(point, {}).get("tps"), "tok/s")
        ref_samples = ref_suites.get("decode", {}).get("samples", {})
        steps = [
            (point, describe(step_times_ms(entries)))
            for point, entries in suites["decode"].get("samples", {}).items()
        ]
        steps = [(point, summary) for point, summary in steps if summary["n"]]
        if steps:
            lines.append("single-stream step time (ms, lower is better; independent of acceptance):")
        for point, summary in steps:
            ref = describe(step_times_ms(ref_samples.get(point, [])))
            text = f"  {point:<18} {summary['mean']:>9.2f} ±{summary['ci95_pct'] or 0:>4.1f}% n={summary['n']:<3}"
            change = difference(summary, ref) if ref["n"] else None
            if change:
                mean, low, high = change
                verdict = "faster" if high < 0 else "slower" if low > 0 else "same"
                text += f" ref {ref['mean']:>8.2f}  {mean:+5.1f}% [{low:+.1f}, {high:+.1f}] {verdict}"
                if verdict == "slower" and mean > tolerance:
                    regressions.append(f"{point} step time {mean:+.1f}%")
            lines.append(text)
    if "sampled" in suites:
        lines.append("sampled (accepted drafts per step, temperature 1.0):")
        ref_points = ref_suites.get("sampled", {}).get("points", {})
        for point, summary in suites["sampled"]["points"].items():
            ref = ref_points.get(point, {}).get("accepted_per_draft")
            suffix = f" ref {ref}" if ref is not None else ""
            lines.append(f"  {point:<18} {summary['accepted_per_draft']}  {summary['aggregate_tps']} tok/s{suffix}")
    if "prefill" in suites:
        lines.append("prefill (tok/s):")
        ref_points = ref_suites.get("prefill", {}).get("points", {})
        for size, summary in suites["prefill"]["points"].items():
            if summary["prefill_tps"]["n"]:
                compare(f"{size} tokens", summary["prefill_tps"], ref_points.get(size, {}).get("prefill_tps"), "prefill tok/s")
    if "prefix" in suites:
        prefix = suites["prefix"]
        lines.append(
            f"prefix replay: cold {prefix['cold_ttft_s'].get('mean')} s, warm "
            f"{prefix['warm_ttft_s'].get('mean')} s, hit rate {prefix['warm_hit_rate'].get('mean')}"
        )
    if "admission" in suites:
        admission = suites["admission"]
        lines.append(
            f"admission 4 x {admission['context_tokens']}: {'pass' if admission['ok'] else 'FAIL'}, "
            f"peak KV {admission['peak_kv_cache_usage']:.0%}, per-stream "
            f"{admission['per_stream_decode_tps'].get('mean')} tok/s"
        )
    for name, memory in report.get("memory", {}).items():
        lines.append(
            f"{name}: min MemAvailable {memory['min_available_gib']} GiB, "
            f"swap growth {memory['swap_growth_gib']} GiB"
        )
    for name, thermal in report.get("thermal", {}).items():
        lines.append(
            f"{name}: GPU max {thermal.get('max_gpu_c')} C "
            f"({thermal.get('min_headroom_c')} C below its limit at the closest), "
            f"board max {thermal.get('max_system_c')} C, power max {thermal.get('max_power_w')} W, "
            f"thermal slowdown {thermal.get('thermal_slowdown_ms')} ms"
        )
        if thermal.get("thermal_slowdown_ms"):
            regressions.append(
                f"{name} spent {thermal['thermal_slowdown_ms']} ms in thermal slowdown; "
                "results are not comparable"
            )
    return lines, regressions


def command_bench(args: argparse.Namespace) -> int:
    cluster, nodes, _ = configuration(args)
    config_path, config_name = cluster_config_path(args)
    if args.suites is None:
        args.suites = ",".join(BENCH_SUITES) if args.full else "quality,decode"
    if args.min_samples is None:
        args.min_samples = 6 if args.full else 3
    if args.max_samples is None:
        args.max_samples = 40 if args.full else 4
    suites = [suite.strip() for suite in args.suites.split(",") if suite.strip()]
    unknown = sorted(set(suites) - set(BENCH_SUITES))
    if unknown:
        raise SystemExit(f"unknown suites: {', '.join(unknown)}")
    head = next(node for node in nodes["nodes"] if node["head"])
    base = (args.url or f"http://{head['management_ip']}:{serve_arg(cluster, '--port')}").rstrip("/")
    args.model = serve_arg(cluster, "--served-model-name")
    args.max_model_len = int(serve_arg(cluster, "--max-model-len"))
    max_seqs = int(serve_arg(cluster, "--max-num-seqs") or 1)
    if not args.concurrency or max(args.concurrency) > max_seqs or min(args.concurrency) < 1:
        raise SystemExit(f"--concurrency values must be between 1 and --max-num-seqs ({max_seqs})")
    if args.min_samples < 2 or args.max_samples < args.min_samples:
        raise SystemExit("--min-samples must be at least 2 and no more than --max-samples")
    floor_gib = float(cluster["host"]["memguard_gib"]) + 1

    reference_path = None
    if args.compare != "none":
        reference_path = Path(args.compare) if args.compare else ROOT / "manifests/benchmarks" / f"{cluster.get('promoted_baseline')}.json"
        if not reference_path.is_absolute():
            reference_path = ROOT / reference_path
        if not reference_path.is_file():
            if args.compare:
                raise SystemExit(f"reference does not exist: {args.compare}")
            reference_path = None
    reference = json.loads(reference_path.read_text(encoding="utf-8")) if reference_path else None

    if args.report:
        report = json.loads(Path(args.report).read_text(encoding="utf-8"))
        lines, regressions = bench_rows(report, reference, args.tolerance)
        print("\n".join(lines))
        if reference_path:
            print(f"reference: {reference_path}")
        for regression in regressions:
            print(f"FAIL: regression: {regression}")
        return 1 if regressions else 0

    identity = bench_identity(cluster, nodes, config_name, config_path)
    if identity["live_problems"]:
        for problem in identity["live_problems"]:
            print(f"WARN: {problem}")
        if not args.allow_mismatch:
            print("refusing to benchmark a cluster that differs from its configuration")
            return 1
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    output = Path(args.output) if args.output else ROOT / "results/private/bench" / stamp
    output.mkdir(parents=True, exist_ok=True)
    report_path = output / "bench.json"
    report = {
        "schema": BENCH_SCHEMA,
        "started_utc": stamp,
        "identity": identity,
        "workload": {
            "url": base,
            "suites": suites,
            "seed": args.seed,
            "precision_pct": args.precision,
            "min_samples": args.min_samples,
            "max_samples": args.max_samples,
            "concurrency": args.concurrency,
            "sampled_requests": args.sampled_requests,
            "prefill_sizes": args.prefill_sizes,
            "prefill_repeats": args.prefill_repeats,
            "prefix_tokens": args.prefix_tokens,
            "admission_tokens": args.admission_tokens,
            "memory_floor_gib": floor_gib,
            "prompts_sha256": hashlib.sha256(
                json.dumps([DECODE_PROMPTS, SAMPLED_PROMPTS, LRU_PROMPT], sort_keys=True).encode()
            ).hexdigest(),
        },
        "reference": str(reference_path.relative_to(ROOT)) if reference_path and reference_path.is_relative_to(ROOT) else (str(reference_path) if reference_path else None),
        "suites": {},
    }

    def save() -> None:
        report_path.write_text(json.dumps(report, indent=1) + "\n", encoding="utf-8")

    print(f"benchmarking {base} ({config_name}); writing {report_path}", flush=True)
    rng = random.Random(args.seed)
    bench = Bench(base, nodes, floor_gib)
    try:
        bench.memory.wait_ready()
        for suite in BENCH_SUITES:
            if suite not in suites:
                continue
            print(f"{suite}:", flush=True)
            report["suites"][suite] = BENCH_SUITE_FUNCTIONS[suite](bench, args, rng)
            save()
            if suite == "quality" and not report["suites"][suite]["ok"]:
                raise BenchAbort("the quality gate failed; performance numbers would be meaningless")
    except BenchAbort as abort:
        report["aborted"] = str(abort)
    except OSError as error:
        bench.halt(str(error))
        report["aborted"] = f"API or telemetry error: {error}"
    except KeyboardInterrupt:
        bench.halt("interrupted")
        report["aborted"] = "interrupted"
    finally:
        report["thermal"] = bench.memory.thermal_summary()
        report["memory"] = bench.memory.close()
        report["discarded_samples"] = bench.discarded
        report["finished_utc"] = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        save()

    lines, regressions = bench_rows(report, reference, args.tolerance)
    print("\n".join(lines))
    failures = []
    if report.get("aborted"):
        failures.append(f"aborted: {report['aborted']}")
    if "quality" in report["suites"] and not report["suites"]["quality"]["ok"]:
        failures.append("quality gate failed")
    if "admission" in report["suites"] and not report["suites"]["admission"]["ok"]:
        failures.append("admission failed")
    failed_requests = sum(
        point.get("failed_requests", 0)
        for suite in ("decode", "sampled", "prefill")
        for point in report["suites"].get(suite, {}).get("points", {}).values()
    )
    if failed_requests:
        failures.append(f"{failed_requests} requests failed")
    failures.extend(f"regression: {item}" for item in regressions)
    if reference_path:
        print(f"reference: {report['reference']}")
    for failure in failures:
        print(f"FAIL: {failure}")
    print(f"report: {report_path}")
    return 1 if failures else 0


def int_list(value: str) -> list[int]:
    try:
        return [int(item) for item in value.split(",") if item.strip()]
    except ValueError as error:
        raise argparse.ArgumentTypeError(f"expected comma-separated integers: {value!r}") from error


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="spark3")
    root.add_argument(
        "--cluster-config",
        default=DEFAULT_CLUSTER_CONFIG,
        metavar="PATH",
        help="repository-relative cluster config (default: config/cluster.json)",
    )
    commands = root.add_subparsers(dest="command", required=True)
    doctor = commands.add_parser("doctor", help="validate repository and optional live state")
    doctor.add_argument("--live", action="store_true")
    doctor.set_defaults(func=command_doctor)
    status = commands.add_parser("status", help="show the three live containers")
    status.set_defaults(func=command_status)
    cluster = commands.add_parser(
        "cluster", help="plan or apply coordinated three-node operations"
    )
    cluster_commands = cluster.add_subparsers(dest="cluster_command", required=True)
    cluster_sync = cluster_commands.add_parser(
        "sync", help="detach every clean node checkout at one published commit"
    )
    cluster_sync.add_argument("--revision", help="published commit; defaults to local HEAD")
    cluster_sync.add_argument(
        "--apply", action="store_true", help="perform the planned synchronization"
    )
    cluster_sync.set_defaults(func=command_cluster_sync)
    cluster_start = cluster_commands.add_parser(
        "start", help="preflight and start workers, head, then memory guards"
    )
    cluster_start.add_argument(
        "--replace", action="store_true", help="replace existing exact containers"
    )
    cluster_start.add_argument(
        "--apply", action="store_true", help="perform the planned coordinated start"
    )
    cluster_start.set_defaults(func=command_cluster_start)
    cluster_stop = cluster_commands.add_parser(
        "stop", help="stop the exact promoted container on every node"
    )
    cluster_stop.add_argument(
        "--remove", action="store_true", help="remove stopped containers as well"
    )
    cluster_stop.add_argument(
        "--apply", action="store_true", help="perform the planned coordinated stop"
    )
    cluster_stop.set_defaults(func=command_cluster_stop)
    render = commands.add_parser("render", help="render, but do not execute, one rank launch")
    render.add_argument("node", choices=("dgx1", "dgx2", "dgx3"))
    render.set_defaults(func=command_render)
    upstream = commands.add_parser("upstream", help="inspect or prepare pinned upstreams")
    upstream_commands = upstream.add_subparsers(dest="upstream_command", required=True)
    upstream_list = upstream_commands.add_parser("list")
    upstream_list.set_defaults(func=command_upstream)
    upstream_prepare = upstream_commands.add_parser("prepare")
    upstream_prepare.add_argument("name", help="Git source key from upstreams.lock.json")
    upstream_prepare.set_defaults(func=command_upstream)
    build = commands.add_parser("build", help="prepare, verify, and build the pinned image")
    build_commands = build.add_subparsers(dest="build_command", required=True)
    build_prepare = build_commands.add_parser(
        "prepare", help="create or repair the build directory the lock determines"
    )
    build_prepare.add_argument(
        "--only",
        metavar="PARTS",
        help="comma-separated subset of: " + ", ".join(BUILD_PARTS) + " (sources only, no contexts)",
    )
    build_prepare.set_defaults(func=command_build_prepare)
    build_check = build_commands.add_parser("check", help="verify the prepared build directory")
    build_check.set_defaults(func=command_build_check)
    build_image = build_commands.add_parser(
        "image", help="plan, or build and smoke-test, the image on an idle host"
    )
    build_image.add_argument(
        "--tag", help="image tag (default: container.image from the cluster config)"
    )
    build_image.add_argument(
        "--apply", action="store_true", help="build under the memory guard, then run the GPU smoke"
    )
    build_image.set_defaults(func=command_build_image)
    build_smoke = build_commands.add_parser(
        "smoke", help="GPU import smoke of a built image on an idle host"
    )
    build_smoke.add_argument(
        "--image", help="image to test (default: container.image from the cluster config)"
    )
    build_smoke.set_defaults(func=command_build_smoke)
    bench = commands.add_parser(
        "bench", help="benchmark the live service and compare it with a reference run"
    )
    bench.add_argument(
        "--full",
        action="store_true",
        help="every suite, each decode point sampled to --precision (about 35 minutes); "
        "the default is the quality gate and decode with 3-4 samples (about 6 minutes)",
    )
    bench.add_argument(
        "--suites",
        help="comma-separated subset of: " + ", ".join(BENCH_SUITES),
    )
    bench.add_argument("--url", help="API base URL (default: head node management IP)")
    bench.add_argument(
        "--output", metavar="DIR", help="report directory (default: results/private/bench/<UTC time>)"
    )
    bench.add_argument(
        "--compare",
        metavar="PATH",
        help="reference bench.json (default: manifests/benchmarks/<promoted_baseline>.json "
        "when present; 'none' skips the comparison)",
    )
    bench.add_argument(
        "--precision",
        type=float,
        default=2.0,
        help="sample each decode point until its 95%% CI is within this percent of the mean",
    )
    bench.add_argument("--min-samples", type=int, help="default 3, or 6 with --full")
    bench.add_argument("--max-samples", type=int, help="default 4, or 40 with --full")
    bench.add_argument("--concurrency", type=int_list, default=[1, 2, 4, 8])
    bench.add_argument("--sampled-requests", type=int, default=32)
    bench.add_argument("--prefill-sizes", type=int_list, default=[2048, 32768, 65536, 131072])
    bench.add_argument("--prefill-repeats", type=int, default=3)
    bench.add_argument("--prefix-tokens", type=int, default=32768)
    bench.add_argument("--admission-tokens", type=int, default=65536)
    bench.add_argument(
        "--tolerance",
        type=float,
        default=3.0,
        help="fail when a point is significantly slower than the reference by more than this percent",
    )
    bench.add_argument("--seed", type=int, default=0, help="seed for sample order and prompts")
    bench.add_argument(
        "--report",
        metavar="PATH",
        help="summarize an existing bench.json against --compare instead of measuring",
    )
    bench.add_argument(
        "--allow-mismatch",
        action="store_true",
        help="benchmark even when doctor --live reports differences",
    )
    bench.set_defaults(func=command_bench)
    return root


if __name__ == "__main__":
    arguments = parser().parse_args()
    raise SystemExit(arguments.func(arguments))
